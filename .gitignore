# Transient / log
*.log
*.tmp
*.pid

# Editor swap / backup
*.swp
*.swo
.*.swp
.*.swo
*~
*.bak
*.orig
*.rej
.netrwhist

# Secrets / env (do NOT weaken this — see corefall AGENTS.md "Secrets Posture")
.env
.env.*
!.env.example
.envrc

# Rust / Cargo
target/
**/*.rs.bk

# Save files (cf-save forward-compat)
*.cfsave

# Python (game/tools/ vendors prototype_run_check.py; future tools may grow)
__pycache__/
*.pyc
*.pyo
*.pyd
.python-version
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
pip-log.txt
.coverage
coverage/
htmlcov/

# Profiling / debugging artifacts
flamegraph.svg
perf.data
perf.data.old
*.profraw
*.profdata

# Generated prototype evidence (run bundles are gitignored — keep README marker only)
prototype_runs/*
!prototype_runs/native/
prototype_runs/native/*
!prototype_runs/native/README.md
# BP closure artifacts — the AI-Agent Self-Test Report + BP Goal Coverage Report
# live inside `bp<N>_<UTC>_<hash>/notes.md` and are the source-of-truth closure
# evidence per `corefall/AGENTS.md` Build Point Closure Gate. Force-include the
# notes.md only; the rest of bp<N>_* (events.jsonl, summary.json, captures/)
# stays gitignored alongside every other bundle.
!prototype_runs/native/bp[0-9]*_*/
prototype_runs/native/bp[0-9]*_*/*
!prototype_runs/native/bp[0-9]*_*/notes.md
!prototype_runs/native/bp[0-9]*_*/grading.json
# M3B (replay viewer + cause-chain + debrief) — closure evidence dir mirrors
# the BP-closure pattern: `prototype_runs/native/m3b_<UTC>_<hash>/` is force-
# included via its notes.md + the markdown / PNG / JSON outputs the viewer
# produces. Other milestone-prefixed dirs stay gitignored (they are sim-run
# bundles and churn every sweep). M3B is a tooling milestone — its outputs
# are stable review artifacts, not sim runs.
!prototype_runs/native/m3b_*/
prototype_runs/native/m3b_*/*
!prototype_runs/native/m3b_*/notes.md
!prototype_runs/native/m3b_*/*.md
!prototype_runs/native/m3b_*/*.png
!prototype_runs/native/m3b_*/*.json
!prototype_runs/native/m3b_*/*.txt
# LLM-graded test verdicts produced for fun-proof bundles (BP2 onward) per
# `.claude/skills/corefall-review/SKILL.md` / `.agents/skills/corefall-review/SKILL.md`
# §LLM-Graded Test Verdicts Gate
# live ONLY inside `bp<N>_<UTC>_<hash>/` (the BP closure-exemplar dir)
# alongside the AI-Agent Self-Test Report notes.md. Sweep-produced
# `m<milestone>_*` bundles are NOT in git (they churn every sweep run and
# would clutter the diff with empty scaffolds). The whitelist for
# `bp[0-9]*_*/grading.json` above is the only exception. Agents that want a
# graded sweep bundle copy its grading.json into the bp closure dir + commit
# it there.
run_bundles/
captures/
screenshots/

# IDE / editor / tool
.idea/
.vscode/
*.iml
.fleet/
.zed/
.cursor/

