        ( canonical_name: "menu_focus_ring", kind: "shell-focus", prompt: "focus ring overlay with accent color outline + corner indicators" ),

        // FRE wizard step indicators
        ( canonical_name: "menu_fre_step_complete", kind: "shell-fre", prompt: "FRE wizard step complete dot with check mark" ),
        ( canonical_name: "menu_fre_step_active", kind: "shell-fre", prompt: "FRE wizard step active dot with pulse" ),
        ( canonical_name: "menu_fre_step_pending", kind: "shell-fre", prompt: "FRE wizard step pending dot empty" ),

        // Brand logo (placeholder)
        ( canonical_name: "menu_brand_logo_full", kind: "shell-brand", prompt: "Corefall full brand logo with wordmark + emblem" ),
        ( canonical_name: "menu_brand_logo_compact", kind: "shell-brand", prompt: "Corefall compact brand mark only" ),
        ( canonical_name: "menu_brand_studio", kind: "shell-brand", prompt: "studio brand splash with motto" ),
