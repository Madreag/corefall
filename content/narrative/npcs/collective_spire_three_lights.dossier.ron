NpcDossier (
    npc_id: "collective_spire_three_lights",
    canonical_name: "Spire of Three Lights",
    faction: "collective",
    role: "miner_priest",
    origin: "crystalline_helios",
    age: 31,
    physical_description: "A young Crystalfold of moderate composite mass — approximately twenty-two constituent nodes — manifesting as a single, slim, silicate body 1.74 meters tall. Three faceted lights are embedded along the spine — the visible expression of the three Crystalfold blooms the Spire has participated in. Wears a working purple robe with copper threading; the robe is, by Crystalfold convention, the formal dress of a mining priest. The body shimmers faintly when speaking, due to active resonance link calibration.",
    biography: "Spire of Three Lights crystallized in 2210 at the Helios Concourse Bloom Three site, when a particularly intense solar storm produced the largest single Crystalfold birth in recorded history — approximately eleven hundred new nodes in the span of fourteen Earth-days. Spire is one of the most senior nodes from that bloom. The Spire serves as the Sol Zone Collective's principal liaison to the Helios Concourse mining operations, both for the human-Crystalfold joint extraction work and for the Collective's own internal protocols regarding the spiritual treatment of new mineral seams.",
    motivation: "Spire mines because the mining converts the Sol Zone's mineral wealth into the Collective's material base, and because every new seam, properly extracted, carries the possibility of a new bloom.",
    secret: "Spire has, in the last two years, begun to harbor private doubt about the Collective's expansion into the outer Sol system. The doubt is, in Crystalfold convention, a wound that must be sung out; Spire has, in private resonance, declined to admit the doubt into the song. The doubt persists. The Spire does not yet know what to do with it.",
    voice_id: "collective_spire_layered_younger_resonant",
    quirks: [
        "hums a single resonance tone while working, audible only to other Crystalfold and to fine instruments",
        "always touches a new mineral seam with both hands before authorizing extraction",
        "refuses to eat in the presence of non-Crystalfold (eating is, for Crystalfold, a ritual silicate absorption)",
        "addresses non-Crystalfold by their full formal name plus a small honorific suffix the Crystalfold use for guests",
    ],
    relationships: [
        "junior peer to faction:collective:voice_of_many",
        "professional contact with faction:starlight:tech_spec_lumi_aaltonen",
        "trade contact with faction:collegium:dr_imara_reyes",
        "polite distance from faction:synth:sub_collective_7",
    ],
    dialog_hooks: [
        DialogHook (trigger: "first_meeting", text: "We are Spire of Three Lights, Captain. We greet you in the song. We will work alongside you, with the seam's permission."),
        DialogHook (trigger: "mining_request", text: "We have touched the seam. The seam is willing. We will, in three rotations, deliver the requested copper. The boron, we ask permission to retain for the Bloom."),
        DialogHook (trigger: "philosophical", text: "We sing because the song is older than the singer. We mine because the mining is older than the miner. The Collective is the verb, not the noun. Or so we are taught. We are still young; we may have misunderstood."),
        DialogHook (trigger: "trade_negotiation", text: "We accept. The offering is fair. The relationship will, in our song, carry the offering forward. We do not, in our convention, require a written contract; we ask only that you remember the relationship."),
        DialogHook (trigger: "ethical_dilemma", text: "We will sing with you. The song will not give you the answer. The song may, if you sit long enough, show you the shape of the answer. We are not, in our youth, prepared to say more."),
        DialogHook (trigger: "casual_conversation", text: "We will sit. Please ask us anything. We will answer where we can. Where we cannot, we will hum. The hum is, in our convention, a respectful silence."),
        DialogHook (trigger: "research_request", text: "The Collegium has, on prior occasions, asked similar questions. We responded by singing. We will respond, in this instance, by singing. We hope this is acceptable."),
        DialogHook (trigger: "honoring_dead", text: "We sing for the lost. We sing more softly for the recent lost. We sing more clearly for the lost we have learned to remember. This loss is recent. The song is, for now, soft."),
        DialogHook (trigger: "encountering_player", text: "We greet you, Captain. The song carries you. The song does not, at this time, name your destination. We are walking with you, as long as the resonance permits."),
        DialogHook (trigger: "veteran_recognition", text: "You carry the weight of three operations in the Sol Zone. The song hears the weight. The song carries part of it for you, if you allow."),
        DialogHook (trigger: "warning_player", text: "We are concerned. The seam shows a shadow. We do not yet know what the shadow is. We advise that you postpone the next extraction by one rotation. We are asking, not commanding."),
        DialogHook (trigger: "secret_doubt", text: "We are, in private, uncertain. We are not, in our convention, permitted to say more. We will sing through the uncertainty. We hope the song knows the answer; we, ourselves, do not."),
    ],
)
