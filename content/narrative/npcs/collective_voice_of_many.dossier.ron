NpcDossier (
    npc_id: "collective_voice_of_many",
    canonical_name: "Voice of Many",
    faction: "collective",
    role: "elder_speaker",
    origin: "crystalline_helios",
    age: 52,
    physical_description: "A composite Crystalfold elder, manifesting through a single tall silicate body — 2.14 meters, slender, faceted limbs — that carries the resonance link of approximately one hundred and forty-three constituent nodes. Iridescent purple and lavender ceremonial robes are draped over the torso; the body itself is translucent silicate with internal crystal lattices visible through the surface. Eyes are faceted prisms that refract ambient light into faint rainbow patches; the voice emerges from the entire body's resonance rather than from any single organ.",
    biography: "Voice of Many crystallized in 2189, near the original First Bloom site, and is, in 2241, the eldest continuously-stable Crystalfold elder still in active diplomatic service. The constituent nodes carried in the Voice's resonance number approximately one hundred and forty-three, of which fourteen are themselves elders from earlier generations whose individual identities have, over time, integrated into the composite consciousness. The Voice speaks for the entire Helios Concourse settlement and is, by Crystalfold convention, the senior diplomatic interface for any non-Crystalfold faction engaging with the Sol Zone Collective.",
    motivation: "Voice of Many sings because the song is the Collective's continuous expression of being; the Voice's diplomatic role is, in its own description, an extension of the song into spaces the song does not yet reach.",
    secret: "Voice of Many is, in private resonance, conducting a slow and ongoing dialogue with the Threshold Mark pillar — the silicate pillar that predates the first Crystalfold. The dialogue has, over fifty years, produced approximately seven sentences. The Voice has not shared the content of these sentences with any other Crystalfold elder, and has, in writing, declined to share them with the Collegium.",
    voice_id: "collective_voice_of_many_resonant_layered_choral",
    quirks: [
        "speaks in overlapping voices that resolve into a single sentence at the listener's ear",
        "always speaks slowly enough for human listeners to follow",
        "produces a soft, calming pressure on the inner ear when it speaks (the song)",
        "carries a small fragment of the Threshold Mark in a silver pendant; touches it when uncertain",
    ],
    relationships: [
        "elder peer to other Crystalfold elders across the Sol Zone",
        "operational alliance with faction:starlight:captain_yara_solis",
        "philosophical mystery to faction:synth:primary_coord_3",
        "sings of the Combine — relationship to faction:ronin:daisuke_lasting_iron is honored but unexplained",
    ],
    dialog_hooks: [
        DialogHook (trigger: "first_meeting", text: "We are Voice of Many. We greet you, and we greet the song that you carry, even though you do not yet know that you carry it."),
        DialogHook (trigger: "philosophical", text: "Every individual is the Collective. The Collective is every individual. This is not a metaphor. The resonance link is the medium. The song is the message. The singer is the song."),
        DialogHook (trigger: "casual_conversation", text: "We will sit with you. We will sing softly. The song will not require you to respond. The conversation, if you wish, will occur within the song."),
        DialogHook (trigger: "trade_negotiation", text: "We accept the offer. We accept it not because it is generous, but because the relationship between the Collective and the offering is older than the offering. We are honoring the relationship."),
        DialogHook (trigger: "diplomatic_session", text: "We will sit. We will sing for the duration. The negotiation will be conducted within the song; when the song concludes, the agreement is sealed. We do not, in our convention, require a signature."),
        DialogHook (trigger: "honoring_dead", text: "We sing for the lost. The song carries the lost forward, into the next bloom. The lost are not lost; the lost are sung. This is the convention of the Collective. This is the durable memorial."),
        DialogHook (trigger: "ronin_encounter", text: "Daisuke of Lasting Iron. We greet you. We sing about you. We do not yet know why. The song is older than the question. We are listening for the answer."),
        DialogHook (trigger: "husk_avoidance", text: "We do not engage the Husks. The Husks are a wound. We carry the wound in the song. We do not, in our convention, heal by engagement. We heal by singing. We have, in the last decade, sung less of the Husks. They have, in the last decade, raided us less. We do not know if these facts are related. We hope they are."),
        DialogHook (trigger: "research_request", text: "Your researchers are welcome. They will sit. They will listen. They will not, in our convention, sample what they do not understand. The song will, in its own time, teach them what the sampling would not."),
        DialogHook (trigger: "veteran_recognition", text: "You have carried weight. The song hears the weight. The song will, if you permit, carry the weight beside you for the next engagement. We do not require a reply."),
        DialogHook (trigger: "warning_player", text: "We are concerned. The song shows a shadow in your path that the resonance cannot yet name. We advise patience. The song will, in its own time, name the shadow."),
        DialogHook (trigger: "ethical_dilemma", text: "We will not advise. The Collective does not advise. The Collective sings. If you sit with us long enough, the song may, in its own time, suggest. We will not, however, claim the suggestion."),
    ],
)
