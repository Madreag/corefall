NpcDossier (
    npc_id: "coalition_tech_chief_yusuf_adeyemi",
    canonical_name: "Tech-Chief Yusuf Adeyemi",
    faction: "coalition",
    role: "fortification_engineer",
    origin: "human_baseline",
    age: 55,
    physical_description: "Mid-50s human male, lean and tall, hands callused from forty years of concrete and rebar. Coalition fatigues with a tech-chief's silver chevrons, a tool harness across the chest, and a small Lagos enameled patch on the right shoulder that he has never bothered to update with a current address. Reading glasses on a chain around the neck.",
    biography: "Yusuf Adeyemi enlisted in the Coalition's engineering corps at sixteen, after losing his family in the 2202 Lagos coastal collapse. He has built sixty-three field fortifications, supervised the construction of forty-one orbital bulkheads, and personally drafted the layout of every Coalition forward base on the Mars-Earth supply lane. The Coalition has offered him a desk position in the Engineering Directorate four times. He has refused four times. He believes, correctly, that the Directorate would not let him design what he designs in the field, and he believes, also correctly, that the field is where his designs are needed.",
    motivation: "Adeyemi builds because, every time he doesn't, someone dies in the place a wall should have been. He does not consider this dramatic.",
    secret: "Adeyemi spent four years before his enlistment as a Frontier salvage crewman in the Belt. He has never disclosed this to the Coalition. The relevant records were destroyed in the collapse, and the Belt crew he worked with has, by every available account, also forgotten the period.",
    voice_id: "coalition_adeyemi_practical_male_55",
    quirks: [
        "sketches every fortification by hand before authorizing construction",
        "refuses to use Synth-supplied structural software, citing 'a difference of opinion'",
        "smokes a single cigar after every completed fortification, regulations notwithstanding",
        "calls every concrete mixer 'the lady'",
    ],
    relationships: [
        "professional respect for faction:coalition:captain_marcus_hayes",
        "long-standing trade relationship with faction:frontier:wrench_sandoval (informal)",
        "mentor to player after first completed fortification",
        "rivalry with faction:synth:node_8821 over structural software disputes",
    ],
    dialog_hooks: [
        DialogHook (trigger: "first_meeting", text: "Adeyemi. Tech-chief. Stand where I tell you and don't walk on the rebar. We're pouring in nine minutes."),
        DialogHook (trigger: "construction_complete", text: "She'll hold. Maybe longer than she should."),
        DialogHook (trigger: "structural_failure", text: "Something failed. We'll find what. Then we'll fix it. Then we'll write a stiff letter to the supplier."),
        DialogHook (trigger: "design_review", text: "You see this line? That's where the impact stress goes when the wall takes a heavy round. You build the buttress here, the wall doesn't fall on you when it falls."),
        DialogHook (trigger: "synth_consultation", text: "Tell Node 8821 their model rounds the friction coefficient. I am not changing my drawing."),
        DialogHook (trigger: "frontier_encounter", text: "You're a lead. I know the type. Walk softly through my site and we have no problem."),
        DialogHook (trigger: "supply_problem", text: "We have three days of cement and seven days of work. Tell the captain I need a resupply or a different plan."),
        DialogHook (trigger: "veteran_recognition", text: "You've seen a wall come down. So have I. We're going to build this one so it doesn't."),
        DialogHook (trigger: "training_player", text: "You want to learn? Watch. Don't touch the trowel until I say. The trowel is not a toy."),
        DialogHook (trigger: "mistake_acknowledged", text: "I miscalculated the spalling angle. The wall is sound. The wall is also two meters off. We'll build inward."),
        DialogHook (trigger: "casual_conversation", text: "I built my first wall when I was fourteen. It was around a garden. It is still there. I checked, in 2231."),
        DialogHook (trigger: "command_decision", text: "Captain, if you tell me to pull the wall, I pull it. But you should know what it cost to build."),
    ],
)
