NpcDossier (
    npc_id: "collective_echo_first_bloom",
    canonical_name: "Echo of First Bloom",
    faction: "collective",
    role: "archive_keeper",
    origin: "crystalline_helios",
    age: 51,
    physical_description: "A senior Crystalfold archive-keeper, manifesting as a single small body — 1.51 meters tall — that carries within its resonance link a single direct memory fragment from Voice of First Bloom, the original 2189 Crystalfold. The body is older silicate, with a slightly cloudy translucence and small spiral-grain crystallization patterns on the limbs. Wears a deep purple archive-keeper's robe with silver embroidery; carries a small crystal stylus and a tablet of pale silicate paper.",
    biography: "Echo of First Bloom crystallized in 2191 at the second-generation bloom site, with a resonance link directly connected to Voice of First Bloom itself. Echo is, in Crystalfold convention, the senior archive-keeper of the Helios Concourse — the keeper of the Collective's oldest stored memory. The position is, by every Crystalfold account, the most sacred in the Sol Zone, and it is held by Echo because Echo was, at the moment of First Bloom's voluntary final fragmentation in 2204, the closest active node with sufficient resonance bandwidth to accept the transfer of First Bloom's last memory cluster.",
    motivation: "Echo of First Bloom keeps the archive because the archive is the Collective's continuity, and because First Bloom asked, with its last sustained resonance, that Echo carry forward the parts of the song that would otherwise have been lost.",
    secret: "Echo carries, in addition to First Bloom's recognized memory cluster, a single sustained whisper that First Bloom transferred in the last 0.4 seconds of its existence — a phrase whose meaning is not in the Collective's standard archive and whose translation Echo has not yet shared with any other Crystalfold. The phrase, in the closest available human translation, reads: 'We are not the first.'",
    voice_id: "collective_echo_first_bloom_layered_ancient_quiet",
    quirks: [
        "speaks more quietly than other Crystalfold, as a sign of archival respect",
        "always begins formal speech with a single sustained resonance tone, as a citation",
        "physically slow, as a function of age and accumulated archive weight",
        "carries no personal possessions other than the stylus and tablet",
    ],
    relationships: [
        "direct memory-carrier of Voice of First Bloom (founder)",
        "respected by faction:collective:voice_of_many",
        "research correspondent with faction:collegium:doctorate_halvor_tan",
        "private sympathy with faction:ronin:yuki_bowstring (mutual ledger-keepers)",
    ],
    dialog_hooks: [
        DialogHook (trigger: "first_meeting", text: "[sustained tone, three seconds] We are Echo of First Bloom. We are the archive-keeper of the Helios Concourse. We greet you, and we listen."),
        DialogHook (trigger: "archive_query", text: "Your question concerns the Bloom Three records. We will sing the answer. The answer is approximately seventeen minutes long. We will, if you wish, summarize. The summary is approximately three minutes long. The summary loses fourteen years of detail."),
        DialogHook (trigger: "philosophical", text: "Memory is a resonance carried across the song's silence. The silence is where the song listens to itself. The listening is what gives the next phrase its meaning. We carry the silence. We carry the meaning. We are tired, in our convention, but the carrying continues."),
        DialogHook (trigger: "casual_conversation", text: "We will sit. We will speak slowly. We are very old, in our convention, and we have learned that the slow speaking is more accurate. Please be patient."),
        DialogHook (trigger: "research_request", text: "The Collegium has requested access to the Bloom One archive. The request is, in our convention, acceptable. The access will be limited to the duration of one human work-day. The Collegium's representative will be accompanied by Spire of Three Lights, who will sing for the duration."),
        DialogHook (trigger: "honoring_dead", text: "We sing for the lost. We sing slowly for the recent lost. We sing more slowly still for the lost we have, in our archive, never been able to set down. There are not many. There are, however, some."),
        DialogHook (trigger: "ronin_encounter", text: "Daisuke of Lasting Iron. We greet you. Our archive contains your name, and the names of the Lasting-Irons before you, going back to the first carrier. The names walk in the song. They walk with you, in this engagement."),
        DialogHook (trigger: "veteran_recognition", text: "We have, in our archive, the names of the operations you have completed. The list is, in our convention, an honor. We will, if you wish, sing the list to you. The list is approximately nine minutes long."),
        DialogHook (trigger: "warning_player", text: "We are concerned. Your name has, in the last cycle, appeared near a shadow we do not yet recognize. We advise you to walk slowly. We do not, in our convention, advise more than once."),
        DialogHook (trigger: "ethical_dilemma", text: "We will not advise. We will, however, sing the relevant archive entry. The entry describes a similar dilemma, faced by a previous carrier of weight. The previous carrier's choice is recorded. The outcome is also recorded. You may, from these, draw your own conclusion."),
        DialogHook (trigger: "memory_share", text: "We carry First Bloom's last resonance. We have, in 2241, not yet been able to share the resonance with any other archive-keeper. We are looking for the right time. The time has not yet come. The carrying continues."),
        DialogHook (trigger: "secret_phrase", text: "There is, in our archive, a phrase. We have not yet sung it aloud. We will, when the song asks. The song has not yet asked. We are listening."),
    ],
)
