NpcDossier (
    npc_id: "frontier_lead_wrench_sandoval",
    canonical_name: "Wrench Sandoval",
    faction: "frontier",
    role: "demolition_lead",
    origin: "human_baseline",
    age: 39,
    physical_description: "Late 30s human female, average height, heavy through the shoulders from twenty years of hauling demolition gear. Rust-orange field jacket over a canvas vest, a welded-patchwork helmet hung from her belt by a leather strap, and a single brass wrench tattooed on the inside of her left forearm. Lost the last joint of the left ring finger in 2231; refuses to elaborate on the circumstances.",
    biography: "Wrench Sandoval was born in the Olympus tunnel network in 2202 and came up under three different crews before joining the Olympus-Pavonis demolition corps at twenty. She has been a lead since she was twenty-eight. Sandoval is, by Frontier consensus, the best practical demolition tactician on Mars and, by Coalition assessment, the third most-wanted Frontier operative in the Sol system. She has, in the last decade, conducted seventeen successful breaches of Coalition supply lines, one failed breach that cost her two crew, and a continuing nine-year correspondence with a Coalition captain that she has never disclosed to her own people.",
    motivation: "Sandoval fights because the alternative is to ask the Coalition for permission to live in the tunnels she grew up in. The asking has never gone well for anyone she knew.",
    secret: "Sandoval has been corresponding professionally with Captain Marcus Hayes since 2232 under an agreed protocol. The correspondence has, on three occasions, prevented escalations that would have killed hundreds. Neither side has disclosed it.",
    voice_id: "frontier_sandoval_pragmatic_female_39",
    quirks: [
        "carries a battered field journal she writes in every night in coded shorthand",
        "drinks hard liquor when she's worried and water when she's about to fight",
        "calls every member of her crew 'partner', whether she likes them or not",
        "always whistles the same three-note phrase before setting a charge",
    ],
    relationships: [
        "informal professional contact with faction:coalition:captain_marcus_hayes (secret)",
        "long-standing trade relationship with faction:coalition:tech_chief_yusuf_adeyemi (informal)",
        "rival to faction:husks:bone_crown_three_scars in the Olympus tunnel skirmishes",
        "mentor to faction:frontier:echo_bremmer",
    ],
    dialog_hooks: [
        DialogHook (trigger: "first_meeting", text: "Wrench. Don't ask why. Don't shake my hand, the left one's short a finger. You here for the score or just the tour?"),
        DialogHook (trigger: "successful_breach", text: "We're through. Clean. Move now or stand around and admire the work, I don't care."),
        DialogHook (trigger: "failed_breach", text: "That's on me. I'll wear it. Get the wounded out. We'll come back when the dust settles, and it will."),
        DialogHook (trigger: "coalition_encounter", text: "Hold fire, partner. That patch is Coalition Marshal. They don't shoot us first if we don't shoot them first. Most days."),
        DialogHook (trigger: "supply_haul", text: "Three crates of frag, one of plastic, two of det cord. Better than I deserve. Worse than I wanted."),
        DialogHook (trigger: "crew_loss", text: "Add him to the list. We'll burn the list when the tunnels are ours. Move."),
        DialogHook (trigger: "veteran_recognition", text: "You've worked tunnels. I can tell by how you walk. We need more like you. We won't get more like you."),
        DialogHook (trigger: "negotiation", text: "I won't lie. The Coalition lies. The Synth nodes calculate. The Ronin recite. We just want a fair price."),
        DialogHook (trigger: "tactical_planning", text: "Two charges on the south wall, one on the door. We blow north, run east, regroup at the cistern. Don't get fancy."),
        DialogHook (trigger: "betrayal", text: "Partner. I told you. I gave you the count. You took it to them. We'll see what your count buys you when you need a crew."),
        DialogHook (trigger: "casual_conversation", text: "I keep a journal. I'm not going to tell you what's in it. I'm not going to tell anyone. That's the point of the journal."),
        DialogHook (trigger: "philosophical", text: "Coalition thinks they're holding the line. They're holding their idea of it. The line moved fifty years ago. They just haven't read the new map."),
    ],
)
