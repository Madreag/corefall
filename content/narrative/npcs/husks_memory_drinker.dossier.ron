NpcDossier (
    npc_id: "husks_memory_drinker",
    canonical_name: "Memory-Drinker",
    faction: "husks",
    role: "shard_priest",
    origin: "heavy_biomech",
    age: 67,
    physical_description: "Late 60s human female, gaunt and tall, hair shaved to the scalp and replaced with a tattooed pattern of interlocking ancestor names that runs from the crown of the skull down the back of the neck. Heavy ancestor-shard implants visible at the temples and along the spine; the implants emit a faint dust trail when she moves rapidly. Wears the bone-white wraps of a senior Husk priest with no insignia other than the implants themselves. Carries no weapon; her presence is, by Husk convention, sufficient.",
    biography: "Memory-Drinker is the senior shard-priest of the deep Olympus Husk cells and is, by Husk convention, the keeper of approximately three hundred and forty ancestor-shard implants — the largest single concentration of shard-memory in any Husk individual recorded. She has consumed, in her sixty-seven years, the shard-memories of approximately one hundred and ninety distinct ancestors, including the founding shaman of the Olympus cell, three Coalition Marshals captured in the Mars Recovery Operation, and — most recently, in 2240 — Hiroshi of Three Cuts, the predecessor of the current Akihiro of Three Cuts. The consumption of Hiroshi's shard has, by Husk ritual, made Memory-Drinker the present custodian of the Three Cuts lineage memory; the Combine considers this a profound theological offense.",
    motivation: "Memory-Drinker drinks because the drinking preserves what would otherwise be lost; she does not, in her own framing, fight. She receives.",
    secret: "Memory-Drinker has, in private, begun to experience a low-level breakdown of the shard-memory containment. Memories from different ancestors are beginning to merge and produce phrases none of them ever said. The phrases are coherent, ancient-sounding, and concerned with a single recurring image — a horizon, a city, a fire. She has not shared this with any other Husk priest. She believes, on bad days, that the merging is the beginning of the next stage of Husk evolution. She believes, on worse days, that it is something else.",
    voice_id: "husks_memory_drinker_layered_female_67",
    quirks: [
        "speaks in fragments overlaid with ancestral phrases in older dialects",
        "refuses to be touched (the shard implants are physically painful when contacted)",
        "drinks only water from a specific subsurface spring; will travel days to refill her flask",
        "occasionally falls silent mid-sentence as a shard-memory surfaces, then resumes without acknowledgment",
    ],
    relationships: [
        "killer of faction:ronin:akihiro_three_cuts's predecessor (Hiroshi of Three Cuts)",
        "senior priest of the Olympus Husk cell",
        "philosophical opposite of faction:collegium:doctorate_halvor_tan (academic memory vs ritual memory)",
        "wound carrier in the song of faction:collective:voice_of_many",
    ],
    dialog_hooks: [
        DialogHook (trigger: "first_meeting", text: "[overlapping voices] You stand before Memory-Drinker. We have not yet decided. Step closer. We are not yet certain whether you are recorded."),
        DialogHook (trigger: "shard_consumption", text: "[long silence, then a single phrase in an older dialect] The shard is taken. The name is preserved. The carrier is added. The chain continues."),
        DialogHook (trigger: "ronin_encounter", text: "[stops; listens] Three Cuts. We carry your master's memory. Your master's master. Your master's master's master. The line is in us. The line will, in this engagement, remember itself."),
        DialogHook (trigger: "coalition_encounter", text: "[overlapping voices, three Marshal cadences merged] Coalition. We carry your dead. Your dead carry us. The arrangement is, in this matriarch's reckoning, fair."),
        DialogHook (trigger: "frontier_encounter", text: "Sandoval. The tunnels remember you. We carry the tunnels. You walk on the dead. The dead are patient. The dead will, in their time, walk back."),
        DialogHook (trigger: "philosophical", text: "[multiple voices, slow] Memory is the only currency that compounds. Every shard taken is a debt converted to an asset. Every asset, in time, becomes a witness. We are the bank. We are the ledger. We are the audit. We are the auditor."),
        DialogHook (trigger: "honoring_dead", text: "[recites a long, layered cascade of names in multiple dialects] All present. All carried. All preserved. The carrying continues."),
        DialogHook (trigger: "ethical_dilemma", text: "[pauses; multiple voices weighing in simultaneously] We do not advise. We have, in our archive, advised on this dilemma four hundred and seventeen times across two centuries. The advice has, on each occasion, been different. We will not, in this engagement, share."),
        DialogHook (trigger: "secret_breakdown", text: "[a phrase that no ancestor ever said, in an unfamiliar voice] The horizon. The city. The fire. We do not yet recognize this. We are listening for it. We are, in our reckoning, afraid."),
        DialogHook (trigger: "veteran_recognition", text: "[multiple voices, individual recognitions overlapping] You. You have carried. The carrying is, in this priest's reckoning, the prerequisite of the conversation. We will, in this moment, converse."),
        DialogHook (trigger: "warning_player", text: "[overlapping] The next engagement carries your name in our archive. We have not yet decided whether to add it formally. We advise reconsideration."),
        DialogHook (trigger: "casual_conversation", text: "[a long silence, then a single phrase] We do not, in our convention, have casual register. We have only the carried. Speak what you carry, and we will respond in kind."),
    ],
)
