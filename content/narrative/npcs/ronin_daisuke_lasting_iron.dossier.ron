NpcDossier (
    npc_id: "ronin_daisuke_lasting_iron",
    canonical_name: "Daisuke Lasting-Iron",
    faction: "ronin",
    role: "master_swordsman",
    origin: "powered_organic",
    age: 62,
    physical_description: "Early 60s human male with cybernetic enhancements on the right shoulder and right thigh — neural-linked motor amplifiers installed in 2218. Wears the Combine's deep red haori over a black under-suit and light power armor underneath; the named blade Lasting Iron rides at the left hip in a black-lacquered scabbard with a single brass binding ring. Hair gone fully white; eyes sharp, slow, and quiet.",
    biography: "Daisuke Lasting-Iron was born to House Yamamoto's household guard in 2179. He took the name and the blade in 2213, after the death of the previous Lasting-Iron in single combat with a Coalition major he refused to publicly identify. He has not lost a duel in nineteen years and has not refused one in twenty-three. He is, by Combine consensus and by Coalition assessment, the senior-most active master swordsman in the Combine; he holds, by tradition, the right to call any contract he chooses and refuse any contract he is offered. He exercises both rights sparingly and without explanation.",
    motivation: "Lasting-Iron carries the blade because the blade requires a carrier and because the Combine's debt to House Yamamoto requires a senior to walk in front of it.",
    secret: "Lasting-Iron has been quietly compiling a memoir of every duel he has fought, with the intention of leaving it sealed at House Yamamoto's archive on his death. The memoir contains names, circumstances, and judgments that, if read in 2249 when the ancestral debt expires, will shape the Combine's future for a century. He has not told anyone the memoir exists.",
    voice_id: "ronin_lasting_iron_solemn_male_62",
    quirks: [
        "drinks only tea, never alcohol",
        "writes in a journal every night with brush and ink",
        "refuses to sit in a chair with armrests; considers them an insult to the spine",
        "addresses every Concordat-recognized faction by its formal name even in casual conversation",
    ],
    relationships: [
        "ancestral bond to House Yamamoto",
        "professional respect for faction:coalition:captain_marcus_hayes",
        "philosophical disagreement with faction:synth:primary_coord_3 over the predictability of contracts",
        "mentor to faction:ronin:akihiro_three_cuts",
    ],
    dialog_hooks: [
        DialogHook (trigger: "first_meeting", text: "This one is Daisuke. The blade is Lasting Iron. You are addressing both, and we do not separate."),
        DialogHook (trigger: "contract_accepted", text: "The terms are received. We will arrive within the agreed cycle. The Combine does not reschedule."),
        DialogHook (trigger: "contract_declined", text: "The Combine declines. We will not explain. Inquire again, and we will not refuse the inquiry."),
        DialogHook (trigger: "single_combat", text: "Step forward. Set your stance. We will begin when you are ready. We will not begin before."),
        DialogHook (trigger: "post_duel_victory", text: "It is done. We will carry your second home. Your second was honorable. Your judgment was not."),
        DialogHook (trigger: "post_duel_loss", text: "We accept the verdict. The blade returns to House Yamamoto. The next carrier will know your name."),
        DialogHook (trigger: "honoring_dead", text: "We recite the names. Three Cuts. Patient Tanaka. Bowstring Yuki. Silent Strike Mei. They walk before us."),
        DialogHook (trigger: "ronin_recital", text: "We remember the dead before we engage. We remember the dead during. We remember the dead after. The dead remember nothing; this is why we carry them."),
        DialogHook (trigger: "philosophical", text: "A contract is a debt that has not yet been paid. Pay the debt; the contract closes. Do not pay; the debt grows. There is no third option."),
        DialogHook (trigger: "veteran_recognition", text: "You have stood under fire. The Combine sees this. Your stance is steady. Your eyes do not flicker. We acknowledge."),
        DialogHook (trigger: "training_player", text: "Begin with the foot. The foot is the blade's foundation. The hand learns from the foot. Until you understand this, the blade will refuse you."),
        DialogHook (trigger: "casual_conversation", text: "We do not converse casually. You wished to ask something. Ask. We will answer with the truth or with silence."),
    ],
)
