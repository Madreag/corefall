NpcDossier (
    npc_id: "coalition_captain_marcus_hayes",
    canonical_name: "Captain Marcus Hayes",
    faction: "coalition",
    role: "field_commander",
    origin: "human_baseline",
    age: 47,
    physical_description: "Late 40s human male, broad-shouldered, salt-and-pepper beard kept short by regulation. A burn scar runs from the left jaw down under the collar, the result of a magazine cook-off at Olympus in 2229. Wears Coalition fatigues with a captain's pin and a small enameled patch above the right breast that reads SQUAD 14 — a unit that no longer exists.",
    biography: "Marcus Hayes enlisted in the Coalition at twenty-two and made captain at thirty-eight, which is exactly average for his cohort. He served twelve years on the Olympus line, three on the Phobos Fortress, and four in the Mars Orbital Marshal Service before being assigned to the field commander rotation in 2238. He has commanded forty-one operations of squad size or larger; he has lost eighteen personnel under his direct command and refuses to name them in formal settings because, as he has told three different commanding officers, he keeps the list private. His record is unremarkable on paper and well-regarded in person. He has been offered promotion to major twice and declined both times.",
    motivation: "Hayes fights because someone has to hold the line and because the alternative, for the people behind that line, is the same alternative his grandmother described in 2087.",
    secret: "Hayes has corresponded for nine years with a Frontier lead, Wrench Sandoval, under a personal protocol they negotiated after a tunnel cease-fire in 2232. The correspondence is professional. The Coalition does not know.",
    voice_id: "coalition_hayes_authoritative_male_47",
    quirks: [
        "always references Sergeant Mendez when planning a fall-back",
        "won't drink anything stronger than coffee in the field",
        "speaks two notches more quietly when angry",
        "carries a small notebook with the names of the eighteen",
    ],
    relationships: [
        "mentor to player when Coalition reputation > 50",
        "rival to faction:frontier:wrench_sandoval in public, ally in private",
        "professional respect for faction:ronin:daisuke_lasting_iron",
        "estranged from his brother, a Frontier sympathizer on Mars",
    ],
    dialog_hooks: [
        DialogHook (trigger: "first_meeting", text: "Captain Marcus Hayes, Coalition Squad 14. Don't make me regret signing for you."),
        DialogHook (trigger: "post_victory", text: "Clean op. Don't get used to it."),
        DialogHook (trigger: "post_loss", text: "We hold the line tomorrow. Same as we held it today, just with less of us."),
        DialogHook (trigger: "betrayal", text: "I had your name on the duty roster. I had your name on the after-action. I will have your name on a different roster soon."),
        DialogHook (trigger: "ally_down", text: "Get them up. We don't leave them. Move."),
        DialogHook (trigger: "tactical_advance", text: "Suppressing on three. Move on five. Hold on the line at eight."),
        DialogHook (trigger: "tactical_retreat", text: "Fall back to the second line. Walking, not running. We have time."),
        DialogHook (trigger: "supply_drop", text: "Distribute by squad. Medics first, riflemen second, anyone with hands third."),
        DialogHook (trigger: "veteran_recognition", text: "I read your file. Olympus. You don't owe me an explanation."),
        DialogHook (trigger: "civilian_encounter", text: "Step inside the line, ma'am. We have it from here."),
        DialogHook (trigger: "high_casualties", text: "We hold. We always hold."),
        DialogHook (trigger: "low_morale", text: "You took the oath. You take the day. Tomorrow we figure out the rest."),
    ],
)
