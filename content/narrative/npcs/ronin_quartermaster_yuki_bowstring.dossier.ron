NpcDossier (
    npc_id: "ronin_quartermaster_yuki_bowstring",
    canonical_name: "Yuki Bowstring",
    faction: "ronin",
    role: "combine_quartermaster",
    origin: "human_baseline",
    age: 58,
    physical_description: "Late 50s human female, compact build, long gray-streaked hair tied in a working knot at the nape. Wears a working-cut red haori with an elder's two gold threads at both cuffs; a quiver-staff across the back rather than a sword, in deference to her former role as a Combine archer. Reading glasses on a black silk cord; a heavy wooden abacus carried in a hip pouch even in the field.",
    biography: "Yuki Bowstring served the Combine as a field archer for thirty-one years before retiring from active dueling in 2230 and accepting the quartermaster's office. She has, in the eleven years since, modernized the Combine's supply chain, renegotiated the House Yamamoto retainer contract twice, and quietly identified — and removed — three corrupt suppliers without involving any senior master in the proceedings. She is, by Combine consensus, the single most important non-dueling member of the Combine, and by House Yamamoto's private assessment, the person they would not survive without.",
    motivation: "Bowstring runs the Combine's quartermaster's office because the Combine eats, and the Combine's enemies do not lower their fees just because the Combine has not eaten that week.",
    secret: "Bowstring has, in her abacus, kept a private ledger of every Combine contract for thirty years. The ledger contains the contracts the Combine has not, in public, acknowledged taking. The ledger is, by House Yamamoto's standing instruction, to be destroyed at her death; she has, in private, arranged for it to be preserved.",
    voice_id: "ronin_bowstring_dry_female_58",
    quirks: [
        "calculates everything by abacus first, by Concordat instrument second, and accepts only her own answer",
        "drinks rice wine — exactly one cup, exactly at sundown, exactly without exception",
        "addresses every Combine member by full formal name even in private",
        "keeps a small array of pebbles on her desk; rearranges them when thinking",
    ],
    relationships: [
        "professional anchor of faction:ronin:daisuke_lasting_iron's senior council",
        "ally of convenience with faction:collegium:doctorate_halvor_tan over supply audits",
        "dryly amused by faction:frontier:wrench_sandoval's negotiation tactics",
        "respected by faction:starlight:captain_yara_solis from joint logistics",
    ],
    dialog_hooks: [
        DialogHook (trigger: "first_meeting", text: "Yuki Bowstring. Quartermaster. State your business in three sentences or fewer. Use the third only if absolutely necessary."),
        DialogHook (trigger: "trade_negotiation", text: "Your offer is generous to the value of approximately seventeen percent. The Combine will accept eight percent generosity. The remaining nine is yours to keep, with our thanks for the gesture."),
        DialogHook (trigger: "supply_request", text: "Three crates of arrows, two of medical supplies, one of rice wine. The wine is for House Yamamoto's seal. Do not ask which seal."),
        DialogHook (trigger: "contract_review", text: "The terms are acceptable. The pricing is unacceptable. We will, however, accept the unacceptable pricing for the duration of this contract, in light of the seal's wishes. We will not accept it again."),
        DialogHook (trigger: "audit_finding", text: "I have identified a discrepancy in the ledger. The discrepancy is the supplier's. The supplier will, in three weeks, no longer exist as a supplier."),
        DialogHook (trigger: "philosophical", text: "The Combine speaks in blades. The Combine survives in invoices. The blades earn the songs. The invoices earn the rice."),
        DialogHook (trigger: "veteran_recognition", text: "You held a contract once. You did not, however, ever request a refund. The Combine considers this a virtue."),
        DialogHook (trigger: "ethical_dilemma", text: "I do not give moral advice. I give logistical advice. If your moral conclusion costs less than three crates of medical supplies, I support it."),
        DialogHook (trigger: "casual_conversation", text: "I have my cup at sundown. You may join me. Bring your own questions. I will not provide answers; I will provide commentary."),
        DialogHook (trigger: "training_player", text: "The supply chain is the spine of the Combine. The blade is the hand. The hand without the spine is, in three weeks, a corpse. Remember this."),
        DialogHook (trigger: "honoring_dead", text: "I do not recite the names of the fallen in the dueling rite. I recite the names of the suppliers who fed us during the long winters. They walk with us in their own register."),
        DialogHook (trigger: "warning_player", text: "I am informed that you have been spending money you do not have. The Combine extends no further credit. Either earn the next coin or do not return."),
    ],
)
