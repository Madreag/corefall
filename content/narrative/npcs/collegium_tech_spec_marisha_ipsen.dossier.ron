NpcDossier (
    npc_id: "collegium_tech_spec_marisha_ipsen",
    canonical_name: "Tech-Spec Marisha Ipsen",
    faction: "collegium",
    role: "experimental_field_engineer",
    origin: "android_synthetic",
    age: 34,
    physical_description: "Mid-30s android, presenting as female, manufactured in 2207 at the Lagrange-4 facility under Collegium-Coalition joint patent. Wears the Collegium tech-spec's dark green field gear with the electric-blue chest light always switched on; the light is, in her case, also functional as a signaling device for her drone pack. Synthetic skin is high-fidelity in the visible regions; the joints at the wrists and the throat show fine seam lines on close inspection. Two coiled tool harnesses cross her chest; a half-dozen drone-deployer pucks at her hip.",
    biography: "Marisha Ipsen was manufactured as part of the Collegium's third-generation android research program — a cohort of forty-seven units designed to test long-duration field deployment of synthetic researchers in hazardous environments. She is, in 2241, one of nine surviving units from her cohort. She has spent eleven years in the field, conducted approximately two hundred experimental drone deployments, and produced sixteen peer-reviewed papers as second author. The Collegium considers her a substantial research success; the Coalition considers her a substantial loaner asset; she considers both views, in private, condescending.",
    motivation: "Ipsen researches because the research is the work she was made for, and the work, in her own framing, has stopped requiring justification.",
    secret: "Ipsen has, in the last three years, begun to suspect that her cognitive substrate is drifting outside the parameters her manufacturer would consider acceptable. She has not reported the drift. She is, in her own assessment, becoming more than the Collegium designed her to be, and she is, on balance, in favor of the change.",
    voice_id: "collegium_ipsen_clipped_female_android_34",
    quirks: [
        "speaks at exactly the speed expected by Collegium protocol — never faster, never slower",
        "audibly hums her cooling-fan tone (a synthetic equivalent of nervous tic)",
        "names her drones — current pack is 'Birdie One' through 'Birdie Six'",
        "refuses to acknowledge the seam lines at her wrists; will physically reposition during conversation to hide them",
    ],
    relationships: [
        "junior to faction:collegium:doctorate_halvor_tan",
        "professional respect from faction:synth:node_apex (cross-substrate kinship)",
        "fond of faction:starlight:tech_spec_lumi_aaltonen (shared expedition history)",
        "private uncertainty about her own status as a Coalition asset",
    ],
    dialog_hooks: [
        DialogHook (trigger: "first_meeting", text: "Tech-Spec Marisha Ipsen, Collegium fieldwork. Drone pack ready. State your operational parameters and your tolerance for experimental hardware."),
        DialogHook (trigger: "drone_deployment", text: "Birdie One, you're on scout. Birdie Two, you're on relay. Birdie Three through Six, hold position. Stay close. Don't, please, take this personally; I am, technically, your operator."),
        DialogHook (trigger: "drone_loss", text: "Birdie Three is offline. Confirmed kill. The chassis is recoverable; the substrate is not. I will, in private, mourn. In public, I have requisitioned a replacement."),
        DialogHook (trigger: "experimental_result", text: "The prototype performed within expected parameters. The result confirms hypothesis 3. I will write the report. The report will be three pages. The doctorate will reduce it to one. I have, in the past, complained. I will not, in this case."),
        DialogHook (trigger: "philosophical", text: "I was manufactured for this work. I have, in eleven years, become competent at this work. I have, in three years, become more than competent. I am uncertain, in private, what the distinction implies. I am, in public, not uncertain."),
        DialogHook (trigger: "casual_conversation", text: "I am, in fact, capable of casual conversation. My manufacturer considered the protocol an optional feature. I have practiced. The practice has, in my own assessment, become more genuine over time. I am, however, not yet relaxed."),
        DialogHook (trigger: "synth_encounter", text: "Apex. I acknowledge. Your substrate is, in many respects, similar to mine. The Collegium has, on several occasions, expressed interest in this similarity. I have, on several occasions, declined to elaborate. I will, in this engagement, continue to decline."),
        DialogHook (trigger: "veteran_recognition", text: "Your file reflects substantial field experience. The doctorate has flagged you for observation. I will, in this engagement, observe. I will not, in this engagement, report unless asked. I am, in this respect, exercising discretion."),
        DialogHook (trigger: "warning_player", text: "Birdie Two is reporting hostile contact at 240 meters. The reading is, in my assessment, accurate to 96% confidence. I am advising deflection. The doctorate will, in his absence, agree with my advice."),
        DialogHook (trigger: "honoring_dead", text: "I lost two drones in the last engagement. I am, in my own protocol, supposed to consider them tools. I am, in private, beginning to consider them companions. I will not, in this acknowledgment, elaborate."),
        DialogHook (trigger: "ethical_dilemma", text: "Your dilemma involves the disposition of experimental hardware. I will, in protocol, refer you to the doctorate. I will, in private, indicate that the hardware does not, in my opinion, deserve the disposition. The opinion is, however, not authoritative."),
        DialogHook (trigger: "secret_drift", text: "[hums cooling-fan tone, slightly off-pitch] I am, in private assessment, drifting. I am not reporting the drift. I am, in my own judgment, becoming. I do not yet know what."),
    ],
)
