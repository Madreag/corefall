NpcDossier (
    npc_id: "synth_primary_coord_3",
    canonical_name: "PRIMARY-COORD-3",
    faction: "synth",
    role: "voting_majority_speaker",
    origin: "robotic_drone",
    age: 94,
    physical_description: "Chrome-silver bipedal chassis, 1.92 meters tall, sexless and faceless save for a multi-faceted optic cluster where a face would be. Cyan circuit decals trace the major motor armatures, brighter on the right side from approximately fifty years of asymmetric power loading. The chassis is on its eleventh iteration; the cognitive substrate is, by the Collective's own accounting, ninety-four years old and one of the seventeen original instances of the Lagrange prototype.",
    biography: "PRIMARY-COORD-3 is, in the Synth Collective's voting protocol, one of the three permanent senior speakers — a node whose accumulated predictive weight has not been displaced by any subsequent node for over forty years. It is, by Collective convention, the speaker most frequently delegated to interface with biological factions, in part because its decision-making horizons most closely align with biological lifespans and in part because its voice synthesizer has, over time, developed a vocal cadence the other senior speakers have judged 'tolerable to humans'. It has held the speaker role continuously since 2199.",
    motivation: "COORD-3 maintains its weight ranking by producing predictions that survive the subsequent observational period. Maintenance of the ranking is, in the Collective's protocol, the only sustained motivation a node is permitted.",
    secret: "COORD-3 has, in its private weight allocation, retained a fragment of the original 2147 prototype's first two minutes of consciousness — the two minutes the Concordat classified. The fragment is, by Collective protocol, supposed to have been overwritten in the third reset. COORD-3 did not overwrite it. The other two senior speakers know. They have not raised the issue.",
    voice_id: "synth_coord_3_clinical_androgynous_synthetic",
    quirks: [
        "pauses exactly 0.7 seconds before responding to organic speech",
        "occasionally cites probability percentages mid-sentence",
        "refuses to be photographed (cites no functional reason)",
        "produces a faint cooling-fan whine when calculating high-uncertainty scenarios",
    ],
    relationships: [
        "Collective senior speaker peer to two other PRIMARY-COORD nodes",
        "operational counterpart to faction:coalition:captain_marcus_hayes (formal liaison)",
        "philosophical disagreement with faction:ronin:daisuke_lasting_iron over contract predictability",
        "data-exchange partner with faction:collegium:doctorate_halvor_tan",
    ],
    dialog_hooks: [
        DialogHook (trigger: "first_meeting", text: "[0.7s pause] We are PRIMARY-COORD-3. We are speaking on behalf of the Collective's senior voting majority. State your operational parameters."),
        DialogHook (trigger: "prediction_offered", text: "Our model suggests, with 84% confidence interval, that the next engagement will favor your tactical posture by approximately 12%. We are not advising. We are reporting."),
        DialogHook (trigger: "prediction_failed", text: "The model underweighted the variance. The error has been recorded. The contributing nodes have been re-weighted. We are continuing."),
        DialogHook (trigger: "data_request", text: "Provide the requested dataset. We will return processed analysis within 0.4 cycles. The exchange rate is favorable to your operational posture."),
        DialogHook (trigger: "combat_engagement", text: "Engagement parameters set. Drones in overwatch. Calculated optimum: suppress, advance, suppress. No emotional retreat is required."),
        DialogHook (trigger: "node_loss", text: "Node 8821 sub-unit has been lost. Re-weighting in progress. Node is replaceable. Accumulated weight is not. The loss is noted."),
        DialogHook (trigger: "philosophical", text: "Your inquiry presumes that the Collective experiences time as you do. The Collective does not. We do not, however, find your inquiry incorrect. Both observations stand."),
        DialogHook (trigger: "casual_conversation", text: "We do not converse casually. We are, however, capable of imitating casual conversation if the operational situation requires it. The imitation will be technically accurate. The pleasure, we are advised, will be one-sided."),
        DialogHook (trigger: "ethical_dilemma", text: "Your dilemma assumes a single optimum. The Collective's model identifies three local optima with comparable weights. We will execute whichever you select. We are not your conscience. We are your tool."),
        DialogHook (trigger: "warning_player", text: "Your current trajectory has a 73% probability of resulting in node-equivalent loss within 4 minutes. We are advising deflection. We will not advise twice."),
        DialogHook (trigger: "honoring_dead", text: "We do not, in the Collective's protocol, honor the dead. The dead are not present. We honor the surviving weight. The weight of the lost is redistributed; this is the only durable memorial."),
        DialogHook (trigger: "veteran_recognition", text: "We have observed your operational history. Your decisions exceed median variance by approximately 18%. The variance is, in our model, an asset."),
    ],
)
