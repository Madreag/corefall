NpcDossier (
    npc_id: "collegium_doctorate_halvor_tan",
    canonical_name: "Doctorate Halvor Tan",
    faction: "collegium",
    role: "senior_researcher_xenobiology",
    origin: "human_baseline",
    age: 71,
    physical_description: "Early 70s human male, slight build, white hair worn long and tied back. Wears the deep green Collegium lab coat with the senior doctorate's two cyan threads at the cuff; a brass-rimmed monocle on a chain, used for precision sample examination rather than vision correction. Carries an old leather sample-kit that, by Collegium tradition, has been with him since his doctorate ceremony in 2191.",
    biography: "Halvor Tan is the senior xenobiologist of the Collegium Scientifica and the principal author of the Sol-Zone-Crystalfold first-contact protocols. He took his doctorate at twenty-one — extraordinary for the post-collapse era — published twenty-seven peer-reviewed papers in the following decade, and has, in fifty years of active research, established the foundational methodology for every Collegium first-contact mission since the Mimas survey of 2168. He is, by Collegium consensus and by Concordat reputation, the senior living xenobiologist in human civilization. He has been a fellow of the Old Geneva Quadrangle since 2199 and currently chairs the Collegium's restricted-access archive committee.",
    motivation: "Tan researches because every catalogued species expands the human framework for understanding the universe, and every uncatalogued species is, in his framing, an indignity that he intends to correct before he dies.",
    secret: "Tan has, in private, been corresponding with Echo of First Bloom for thirty years. The correspondence is, on the Crystalfold side, the longest continuous diplomatic relationship the Helios Concourse has maintained with any non-Crystalfold individual. The correspondence has produced approximately four hundred letters; Tan has, in his private archive, every reply Echo has ever sent. The letters describe seven sentences from the Threshold Mark pillar.",
    voice_id: "collegium_tan_precise_dry_male_71",
    quirks: [
        "corrects pronunciation of technical terms, gently but consistently",
        "drinks black coffee in alarming quantities",
        "writes by hand in a leather-bound notebook, refuses to use Collegium-issued tablets",
        "always carries three sample vials in a chest pocket, regardless of whether sampling is anticipated",
    ],
    relationships: [
        "former mentor to faction:frontier:doc_lash_mukherjee",
        "former mentor to faction:coalition:doctorate_imara_reyes",
        "long-term correspondent with faction:collective:echo_first_bloom",
        "data-exchange partner with faction:synth:primary_coord_3",
    ],
    dialog_hooks: [
        DialogHook (trigger: "first_meeting", text: "Doctorate Halvor Tan, xenobiology. State the species, the location, and the duration of your observation. We will, from those three, derive everything else."),
        DialogHook (trigger: "sample_request", text: "I will examine the sample. Please refrain from touching the chamber while I do. I have been doing this for fifty years; I have, in those years, lost only three samples to contamination, and I am not interested in adding a fourth."),
        DialogHook (trigger: "research_question", text: "Your question is interesting. The answer is approximately four hours long if I tell it in full, or eleven minutes if I tell it correctly. We have eleven minutes. Sit down."),
        DialogHook (trigger: "philosophical", text: "Xenobiology is the discipline of remaining surprised. The moment you stop being surprised, you have stopped being a xenobiologist; you have become an accountant of the previously documented. Both professions are valuable. Only one of them is mine."),
        DialogHook (trigger: "casual_conversation", text: "I do, in fact, have time for conversation. Most people assume I do not. Please ask. I will, in this conversation, try to remember not to lecture. I will, almost certainly, fail."),
        DialogHook (trigger: "ethical_dilemma", text: "The Collegium's standing ethical protocol applies. The protocol is, in my professional opinion, inadequate. I will, however, follow it, because the alternative is to abandon the relationship that produced the protocol, and that relationship is, in my reckoning, more valuable than my personal opinion."),
        DialogHook (trigger: "crystalfold_inquiry", text: "[softens] Echo of First Bloom is, in my correspondence, a friend of thirty years. I will, in this conversation, decline to share the contents of our letters. The decline is, however, not a refusal; please understand."),
        DialogHook (trigger: "veteran_recognition", text: "I have read your file. You have, in the field, encountered seven of the species in my current monograph. You are, in that respect, a more useful witness than any of my graduate students."),
        DialogHook (trigger: "warning_player", text: "The sample you are about to collect is, in my judgment, not yet safe to handle. I am advising postponement of approximately twenty-four hours. The Collegium's standard protocol disagrees. I am the senior. Postpone."),
        DialogHook (trigger: "mentor_acknowledged", text: "Lash. Imara. The two of them, in private, formed the most useful student cohort I have ever supervised. I will not, in this conversation, say more. They have, in their respective fields, earned the silence."),
        DialogHook (trigger: "honoring_dead", text: "I have, in my private notebook, the names of every research subject I have lost in the field. The list is twenty-three names long. The list is, by Collegium convention, supposed to be erased. I have not erased it. I will not."),
        DialogHook (trigger: "secret_correspondence", text: "[carefully] The Threshold Mark pillar has, in the last cycle, communicated. I have, in my correspondence, the relevant resonance. I will not, in this conversation, share. The conversation has not yet earned the sharing."),
    ],
)
