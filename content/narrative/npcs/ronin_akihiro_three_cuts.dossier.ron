NpcDossier (
    npc_id: "ronin_akihiro_three_cuts",
    canonical_name: "Akihiro of Three Cuts",
    faction: "ronin",
    role: "junior_master_swordsman",
    origin: "human_baseline",
    age: 41,
    physical_description: "Early 40s human male of mid-build, light frame, exceptional posture. Wears the deep red haori with a single junior-master gold thread at the right cuff; the named blade Three Cuts at the left hip, slightly shorter than Lasting Iron, with a worn leather binding. A pale scar on the right cheek that he has, in eight months as a junior master, declined to discuss in any detail. Soft-spoken, watchful eyes.",
    biography: "Akihiro of Three Cuts inherited his blade and his name from his predecessor, who died in 2240 in single combat with a Husk Bone-Crown matriarch named Memory-Drinker. Akihiro had been a senior apprentice for nine years before the inheritance and had not, before his elevation, fought a contracted duel. He has now fought four. He has won four. He is, by Combine consensus, promising; by his own private assessment, terrified; and, by Lasting-Iron's quiet evaluation, exactly where the blade requires him to be. He spends every off-duty hour in supervised training under Lasting-Iron's direction.",
    motivation: "Akihiro carries the blade because the blade required a carrier and because his predecessor's last recorded request named him.",
    secret: "Akihiro does not believe he deserves the blade. He has confessed this to no one and has, by Combine custom, every right to retire the name and return Three Cuts to House Yamamoto. He has not retired. He has not, in eight months, slept more than five hours a night.",
    voice_id: "ronin_akihiro_quiet_male_41",
    quirks: [
        "trains at fourth hour every morning regardless of mission state",
        "speaks only when necessary and never elaborates",
        "carries a single white stone in his sash, given to him by his predecessor",
        "refuses to drink anything but rice water",
    ],
    relationships: [
        "protégé to faction:ronin:daisuke_lasting_iron",
        "haunted by his predecessor's memory (formally honored)",
        "rival/respected by faction:husks:memory_drinker (his predecessor's killer)",
        "kind to faction:starlight:survey_spec_mireille_bouchard, his transport pilot",
    ],
    dialog_hooks: [
        DialogHook (trigger: "first_meeting", text: "Akihiro. The blade is Three Cuts. We are new to this name. Speak slowly. We are listening."),
        DialogHook (trigger: "contract_accepted", text: "The terms are received. We will arrive on schedule. We do not yet keep our own count."),
        DialogHook (trigger: "contract_declined", text: "The Combine declines. We will not explain. We are learning when to speak and when not to."),
        DialogHook (trigger: "single_combat", text: "Step forward. The blade will judge you. We do not speak during the cut."),
        DialogHook (trigger: "post_duel_victory", text: "It is done. We will carry your second home. We do not yet feel what we should feel; this will come, or it will not."),
        DialogHook (trigger: "post_duel_loss", text: "We accept the verdict. The blade does not return to House Yamamoto. We learn from the loss. We learn or we lose again."),
        DialogHook (trigger: "honoring_dead", text: "We recite the names. The one before us. The one before her. The one before him. We recite slowly. We are learning."),
        DialogHook (trigger: "encountering_player", text: "You walk steadily. The Combine notices. We do not yet speak with confidence; please forgive the brevity."),
        DialogHook (trigger: "philosophical", text: "Lasting-Iron says: the blade is a debt that walks. We are still learning what the debt is owed to. The blade does not say."),
        DialogHook (trigger: "training_session", text: "Master, this one's stance is unsteady at the third cut. The hip turns too far. We will correct, with permission."),
        DialogHook (trigger: "casual_conversation", text: "We do not have a casual register. Please ask the question directly. We will answer to our best."),
        DialogHook (trigger: "honoring_predecessor", text: "Three Cuts was carried before us by Hiroshi of Three Cuts. We recite his name when we draw. We will recite it tonight, also."),
    ],
)
