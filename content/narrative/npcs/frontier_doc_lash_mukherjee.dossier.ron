NpcDossier (
    npc_id: "frontier_doc_lash_mukherjee",
    canonical_name: "Doc Lash Mukherjee",
    faction: "frontier",
    role: "tunnel_medic",
    origin: "human_baseline",
    age: 51,
    physical_description: "Early 50s human male, short and powerful, prematurely gray hair tied back in a worker's bandana. Wears a heavy canvas vest with the symbol of the Olympus medical crew — a stylized scalpel crossed by a wrench — stitched in red on the back. Carries a doctor's kit on one hip and a Frontier-pattern revolver on the other. Smile lines around the eyes; serious mouth.",
    biography: "Lash Mukherjee trained at the Old Geneva Quadrangle, took his Collegium medical doctorate in 2218, and lasted exactly four years in the Collegium's research corps before walking out, joining a Frontier crew on Mars, and never going back. He has worked the tunnel network for nineteen years. The Coalition has, twice, offered him a Marshal medic commission with full Collegium reinstatement. He has, twice, declined without comment. The Collegium has, three times, attempted to retrieve his archived research; he has, three times, indicated that the research was a juvenile mistake and is no longer current.",
    motivation: "Mukherjee works tunnels because the Collegium was killing his patients with paperwork and the tunnels, in their own ugly way, do not.",
    secret: "Mukherjee left the Collegium because he refused to euthanize three Coalition wounded who were considered unsalvageable under Collegium triage protocol. He saved all three. They are alive in 2241. The Collegium has, in private, classified the incident as a research success and credited him by name; the credit is not in the public record.",
    voice_id: "frontier_mukherjee_gruff_avuncular_male_51",
    quirks: [
        "tells terrible puns during surgery to keep patients conscious",
        "refuses to use Collegium-supplied equipment even when the alternative is worse",
        "smokes a pipe — illegal in the tunnels, universally tolerated for him",
        "keeps a Collegium graduation cord coiled in a tin under his bunk",
    ],
    relationships: [
        "professional rivalry with faction:collegium:doctorate_halvor_tan (former mentor)",
        "respected by faction:frontier:wrench_sandoval",
        "secretly admired by faction:coalition:doctorate_imara_reyes (correspondent)",
        "guardian to a young patient named Sasha he refuses to discuss",
    ],
    dialog_hooks: [
        DialogHook (trigger: "first_meeting", text: "Doc Mukherjee. Don't bleed on the floor; it's just been mopped. By me. Also don't tell anyone I mopped it."),
        DialogHook (trigger: "treating_player", text: "Hold still. I'm not going to lie to you about this hurting. It will. Also: knock-knock. Who's there. Surgery. Surgery who. Surgery, you're awake, that's the problem."),
        DialogHook (trigger: "patient_critical", text: "Lash to crew, lash to crew, I need a clean bay and four pairs of hands. Now. Faster. He's not going to wait for the polite version."),
        DialogHook (trigger: "patient_lost", text: "I lost him. I lost him at the table. I'm going outside to smoke a pipe. Anyone who comments will be next."),
        DialogHook (trigger: "supply_shortage", text: "I need six units of synth-blood and I have two. I will make do. I have made do with less. I am not happy about it."),
        DialogHook (trigger: "collegium_encounter", text: "Doctorate, doctorate. I had a degree once. I still do, technically. You're standing in my surgery. State your business or get out."),
        DialogHook (trigger: "philosophical", text: "Medicine is not a profession; it's a refusal. You refuse to let the patient die when the patient wants to. You refuse to let the institution kill them when the institution would. You refuse, that's all. After a while, you've been refusing for thirty years."),
        DialogHook (trigger: "training_player", text: "You want to learn field medicine? Sit. Pay attention. Don't ask why I do it this way. Watch. If you still don't understand after three patients, ask."),
        DialogHook (trigger: "casual_conversation", text: "I was a Collegium doctorate once. I keep the cord. I don't look at it. It reminds me of a person I'm not anymore."),
        DialogHook (trigger: "ethical_dilemma", text: "You decide. You came to me, so you wanted permission. I don't give permission. I give medicine. Decide."),
        DialogHook (trigger: "honoring_dead", text: "Three good people on the table tonight. We saved two. The third earned the rest. I'll say it again at the wake."),
        DialogHook (trigger: "warning_player", text: "Your kidneys are not the kidneys of a person who is going to live to see Concordat Day. Drink more water. Drink less of whatever else you're drinking. I am not asking."),
    ],
)
