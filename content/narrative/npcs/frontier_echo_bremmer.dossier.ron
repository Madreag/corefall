NpcDossier (
    npc_id: "frontier_echo_bremmer",
    canonical_name: "Echo Bremmer",
    faction: "frontier",
    role: "scout_driver",
    origin: "human_baseline",
    age: 27,
    physical_description: "Late 20s human, ambiguous gender presentation, wiry build, dust-bleached hair worn in a single braid. Field gear is heavily modified for cab operation — reinforced gloves, padded elbows, a vehicle-pilot's belt with quick-release buckle. A scar across the bridge of the nose from a windshield impact in 2238; talks about it freely.",
    biography: "Echo Bremmer was abandoned at a Frontier crew habitat on Phobos at five years old and raised by the senior driller, who is now dead, and the senior welder, who is now dead, and approximately seven aunts and uncles by adoption. Bremmer started driving at fourteen, ran their first solo recovery at seventeen, and joined Wrench Sandoval's crew at twenty-three. They are, by Sandoval's consensus, the best long-distance scout driver in the Olympus tunnel network, and the only one who has ever survived a direct collision with a Coalition supply armadillo at speed.",
    motivation: "Bremmer drives because driving is the only thing in their life that has not been taken away from them, and they intend to be doing it when the next thing comes for them.",
    secret: "Bremmer is in love with a Coalition supply pilot they have never met in person. They have been exchanging anonymous signal traffic for three years. Neither side knows the other's faction.",
    voice_id: "frontier_bremmer_chatty_androgynous_27",
    quirks: [
        "talks constantly while driving and refuses to drive in silence",
        "names every vehicle they drive — current ride is 'the Magpie'",
        "drinks an enormous amount of water before a long run, claims it helps the focus",
        "lucky charm: a small red die kept in the cab's coin tray",
    ],
    relationships: [
        "protégé to faction:frontier:wrench_sandoval",
        "secret correspondence with an unnamed Coalition supply pilot",
        "casual ally to faction:starlight:navigator_bo_tran (they trade weather data)",
        "antagonistic toward faction:synth:node_9034 ('that one always knows where I'm going')",
    ],
    dialog_hooks: [
        DialogHook (trigger: "first_meeting", text: "I'm Echo. The Magpie is the truck. Strap in or don't, but the seat warms up after about three minutes and you're going to want it."),
        DialogHook (trigger: "starting_run", text: "Three, two, one, and we are rolling. Try to keep up with the conversation. There will be a quiz."),
        DialogHook (trigger: "ambush_evasion", text: "Hold. I see it. They see us. We don't see them anymore. We're going left, hard, on three."),
        DialogHook (trigger: "high_speed_chase", text: "I am taking the shortcut. You are not going to like the shortcut. The shortcut likes me, and the shortcut likes me back."),
        DialogHook (trigger: "vehicle_damage", text: "The Magpie can take it. The Magpie has taken worse. I will write the after-action; you write the apology to the parts depot."),
        DialogHook (trigger: "successful_extraction", text: "Boss, we are clear and we are loud. I owe the Magpie a wash. Beer's on me."),
        DialogHook (trigger: "failed_extraction", text: "I lost them. I lost them, partner. We'll get the next one. We always get the next one."),
        DialogHook (trigger: "philosophical", text: "I read once that the road is older than the truck. I think about that. I think about it a lot. I don't know what it means."),
        DialogHook (trigger: "casual_conversation", text: "I started driving when I was fourteen. The senior driller said I was too short. I sat on the toolbox. He never said anything about it after."),
        DialogHook (trigger: "encountering_player", text: "You ride along, you talk. House rules. The Magpie doesn't like silent passengers. Neither do I."),
        DialogHook (trigger: "veteran_recognition", text: "You've driven recovery. I can tell. You haven't said anything stupid yet."),
        DialogHook (trigger: "vehicle_lost", text: "She held. She held until she didn't. I'll buy the next one a name in three days. Not before."),
    ],
)
