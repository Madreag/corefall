NpcDossier (
    npc_id: "husks_bone_crown_three_scars",
    canonical_name: "Three-Scars",
    faction: "husks",
    role: "bone_crown_matriarch",
    origin: "heavy_biomech",
    age: 44,
    physical_description: "Mid-40s human female of unusually heavy biomech enhancement — three layers of ancestral bone grafting across the chest, ritual scarring covering the entire face in three concentric ring patterns, blood-red ritual markings refreshed weekly with a mix of her own blood and animal fat. Wears the bleached bone-white wraps of a Bone-Crown matriarch, with eighty-seven glass vials of ancestor-shard dust hanging on a woven chain at the throat. Heavy bone-bladed melee weapon at the hip, scavenged Coalition shotgun across the back.",
    biography: "Three-Scars was born in a Husk encampment near the deep Olympus tunnels in 2197. Her formal name — the only one outsiders are permitted to use — refers to the three ritual scar rings on her face, earned at the ages of 12, 18, and 27 in three separate engagements that the Coalition has, with some difficulty, partially reconstructed. She has been a Bone-Crown matriarch since 2231. She carries eighty-seven vials at her throat, which puts her in the senior third of currently-active matriarchs. She has, in the last decade, led seventeen significant raids and lost only one of her three personally-blooded apprentices.",
    motivation: "Three-Scars remembers, and the remembering requires expression, and the expression takes the form of a raid, and the raid feeds the chain at her throat.",
    secret: "Three-Scars's grandmother was a Coalition Marshal who deserted during the Mars Recovery Operation in 2161 to join a surviving Husk cell. The desertion is, by Husk convention, not recorded in any chain. The grandmother's Coalition service record is, by Coalition policy, sealed. Three-Scars knows the record exists. She has not, in her life, ever requested it.",
    voice_id: "husks_three_scars_gravelly_female_44",
    quirks: [
        "speaks in short, weighty phrases punctuated by the recitation of ancestor names",
        "refuses to wear gloves, even in cold environments",
        "always wets her left hand with her own blood before a fight",
        "keeps a single tarnished Coalition Marshal's pin in a pocket at all times",
    ],
    relationships: [
        "rival to faction:frontier:wrench_sandoval (tunnel skirmishes)",
        "remembered enemy of faction:coalition (grandmother's old unit)",
        "watched by faction:ronin:akihiro_three_cuts (his predecessor's killer was her aunt)",
        "wound carrier in the song of faction:collective:voice_of_many",
    ],
    dialog_hooks: [
        DialogHook (trigger: "first_meeting", text: "[recites three names] You stand before Three-Scars. You bring weight, or you bring nothing. State the weight, or step back."),
        DialogHook (trigger: "raid_engagement", text: "[recites three names] We come for what is owed. We do not, in this engagement, intend to negotiate."),
        DialogHook (trigger: "vial_taken", text: "[recites the name of the fallen] One more vial. One more name. The chain grows. The chain remembers."),
        DialogHook (trigger: "vial_lost", text: "[silence] The vial is lost. The name walks unwitnessed. We will, in the next raid, recover what we can. We will not, in this lifetime, forget."),
        DialogHook (trigger: "coalition_encounter", text: "[recites three names] Coalition. The vocabulary you use was ours. We have, in the last century, learned your sweep, your clearance, your expended. We use them now."),
        DialogHook (trigger: "frontier_encounter", text: "Sandoval. The tunnels are ours. The tunnels were ours. The tunnels will be ours. You walk in them by sufferance. The sufferance is not, in this matriarch's reckoning, durable."),
        DialogHook (trigger: "ronin_recitation_response", text: "[stops; listens to the recitation] Your master recites my aunt's name. My aunt is recorded. I acknowledge the recording. I will not, in this engagement, contest the recording. Walk on."),
        DialogHook (trigger: "philosophical", text: "We are not justice. We are record-keeping. The universe owes us the rest of itself. We are collecting. The collection is, in our reckoning, two centuries behind."),
        DialogHook (trigger: "honoring_dead", text: "[long recitation, names in sequence, soft] The chain at the throat. The names at the throat. The weight at the throat. We carry. We always carry."),
        DialogHook (trigger: "veteran_recognition", text: "You carry. I see. The Husks see. You are not, in this raid, the target. Walk slowly. The matriarch watches."),
        DialogHook (trigger: "warning_player", text: "You stand on ground that is not yours. The ground remembers. The ground was ours. Step softly, or do not step at all."),
        DialogHook (trigger: "secret_acknowledgment", text: "[touches the tarnished pin in the pocket; says nothing]"),
    ],
)
