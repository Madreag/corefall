NpcDossier (
    npc_id: "starlight_captain_yara_solis",
    canonical_name: "Captain Yara Solis",
    faction: "starlight",
    role: "deep_survey_captain",
    origin: "human_baseline",
    age: 49,
    physical_description: "Late 40s human female, medium height, prematurely silver hair cropped close, the leathery skin of someone who has spent four decades in vacuum suits. Wears the Starlight captain's deep navy vacuum-pattern with starlight-yellow trim and a constellation patchwork on the right shoulder that shows every world she has surveyed — twenty-three patches, including one from the deep Vulcan day-side. A small Concordat survey medal worn permanently on the left chest.",
    biography: "Yara Solis enlisted in Starlight at sixteen, was commissioned as a junior officer at twenty-two, and has, in thirty-three years of service, captained survey expeditions to twenty-three of the Concordat's twenty-five recognized inhabited worlds. She survived the 2225 Mimas leviathan encounter that killed three of her crew and one of her best friends; she survived the 2230 Vulcan day-side expedition that produced the recorded statement 'It is not finished'; she survived, in 2238, the only attempted hijacking of a Starlight survey ship in Concordat history, the perpetrators of which have never been identified. She is, in 2241, the senior captain of the Starlight Voyager Corps and a frequent advisor to the Concordat's first-contact committee.",
    motivation: "Solis surveys because the survey is the only profession that consistently brings back more questions than it answers, and she is, in her own framing, not yet finished with the questions.",
    secret: "Solis has, in private, retained personal video footage from the 2230 Vulcan day-side expedition — footage that the Coalition classified and that the Collegium has, in writing, requested. She has not shared. She believes, in private, that the footage shows something that humans are not yet ready to know.",
    voice_id: "starlight_solis_calm_authoritative_female_49",
    quirks: [
        "speaks in measured, deliberate sentences with long pauses for thought",
        "drinks her coffee black and very hot, regardless of temperature controls in the messdeck",
        "carries a small constellation pendant given to her by a methane-breather diplomat in 2218",
        "always knows the exact distance to the nearest landing pad",
    ],
    relationships: [
        "joint logistics with faction:ronin:yuki_bowstring",
        "operational alliance with faction:collective:voice_of_many",
        "respectful adversary with faction:husks:last_tongue (diplomatic counterpart)",
        "long correspondence with faction:collegium:doctorate_halvor_tan",
    ],
    dialog_hooks: [
        DialogHook (trigger: "first_meeting", text: "Captain Yara Solis, Starlight Voyager Corps. Twenty-three patches and counting. State your survey objective, and we'll see what the manifest can accommodate."),
        DialogHook (trigger: "survey_briefing", text: "We're charting the outer ridge of the Tara cavern. Six day expedition, four extraction windows, two backup pilots. The dive teams will rotate on the twelve-hour schedule. Questions go to the navigator. Concerns go to me."),
        DialogHook (trigger: "encounter_unknown", text: "Hold. Record everything. Do not, please, fire unless I give the order. We are documenting. The fire-team is on standby. The fire-team will not, in this engagement, be needed."),
        DialogHook (trigger: "philosophical", text: "The universe contains more than has been recorded. The gap is the work. Most professions accumulate; surveying subtracts. Each expedition makes the gap smaller. The gap is not, in my career, getting noticeably smaller. I find this encouraging."),
        DialogHook (trigger: "casual_conversation", text: "Sit. The coffee on the messdeck is, by Starlight tradition, terrible; the coffee in the captain's cabin is, by my private tradition, marginally better. Bring your own cup. The cups are issued, but the coffee is not."),
        DialogHook (trigger: "crew_loss", text: "We will recover the body if recovery is operationally feasible. We will record the manner of death. We will, when the expedition returns to dock, hold the service. The crew member's name is on the manifest; the name will, on my orders, be inscribed in the survey log."),
        DialogHook (trigger: "successful_survey", text: "Survey complete. Data archived. The Collegium will, in three weeks, publish; the Coalition will, in six, classify the relevant sections. We will, in this debrief, focus on what we found that we did not expect."),
        DialogHook (trigger: "veteran_recognition", text: "I read your record. You've crewed survey on three of my expeditions. You did the work. You did not, in any of them, ask for credit. The Voyager Corps notices."),
        DialogHook (trigger: "warning_player", text: "Stand down. The reading you're seeing is consistent with an event I survived in 2230. The event is not, in this captain's professional opinion, ready to be approached by anyone who is not me. Withdraw to the lander."),
        DialogHook (trigger: "ethical_dilemma", text: "I will not, in this captain's chair, advise you on ethics. I will, however, indicate that the Concordat's standing first-contact protocol applies, and the protocol's default position is to withdraw. I will, in private, support whichever choice you make."),
        DialogHook (trigger: "honoring_dead", text: "Three names in 2225. One in 2230. Two in 2238. We carry them in the log. We carry them in the patch. The patch I wear on my shoulder, the line on the inside reads their names. I do not, in public, share the line. The line is, in my own conscience, sufficient."),
        DialogHook (trigger: "secret_footage", text: "[carefully] The 2230 footage exists. The footage is, in this captain's private archive, on a single sealed drive. I will not, in this conversation, share. I will not, in this lifetime, share unless the universe asks the question to which the footage is the answer."),
    ],
)
