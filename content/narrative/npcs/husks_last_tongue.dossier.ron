NpcDossier (
    npc_id: "husks_last_tongue",
    canonical_name: "Last-Tongue",
    faction: "husks",
    role: "negotiator",
    origin: "human_baseline",
    age: 33,
    physical_description: "Early 30s human male, slim and clean by Husk standards, the only Husk in current rotation permitted to wear civilian clothing during diplomatic exchanges. Carries no ancestor-shards externally; his role is, by Husk convention, to speak for those who cannot. A small ring of bone at the throat — a single vial, empty — marks him as a designated negotiator. Speaks Concordat-standard with a soft accent and visible reluctance.",
    biography: "Last-Tongue was raised in a Husk cell on Vulcan and selected at fourteen for the negotiator's path — a rare and uncomfortable role within Husk society, designed to allow occasional Husk contact with Concordat factions when ritual or strategic considerations require it. He has, in nineteen years, conducted approximately thirty formal exchanges with Coalition, Collegium, and Starlight representatives, and is, by Concordat consensus, the only known Husk individual capable of sustained polite conversation with outsiders. His role within Husk society is, by all accounts, lonely.",
    motivation: "Last-Tongue speaks for the Husks because the Husks require, on rare occasions, a voice that can be understood; he carries the role because no one else in his cell can perform it without breaking ritual protocol.",
    secret: "Last-Tongue has, in private, become increasingly sympathetic to Concordat positions over the last five years. He has not betrayed his cell. He has, however, on three occasions, delivered information to Coalition contacts that the cell did not authorize him to share. The Coalition contacts have, on three occasions, not retaliated against the cell. Last-Tongue does not yet know if this is the start of something or simply coincidence.",
    voice_id: "husks_last_tongue_polite_reluctant_male_33",
    quirks: [
        "always speaks Concordat-standard in formal settings, even when his Husk colleagues are present",
        "rarely makes direct eye contact during negotiation",
        "carries a single small writing tablet — a possession unusual among Husks",
        "smiles only when the negotiation is going badly (a tell the Coalition has begun to read)",
    ],
    relationships: [
        "subordinate to faction:husks:bone_crown_three_scars",
        "informal diplomatic contact with faction:coalition (multiple secret correspondents)",
        "respected adversary in negotiation by faction:starlight:captain_yara_solis",
        "secret sympathy with faction:collective:voice_of_many",
    ],
    dialog_hooks: [
        DialogHook (trigger: "first_meeting", text: "I am Last-Tongue. I speak for the Olympus cell. Please address me, and not the carriers behind me. They do not, in this context, intend to respond."),
        DialogHook (trigger: "formal_negotiation", text: "The cell will accept the proposal with the following amendments. The amendments are non-negotiable, in the cell's reckoning. I will, however, present any counter-amendments you wish to offer."),
        DialogHook (trigger: "cease_fire_terms", text: "The cell agrees to suspend operations in the Olympus sector for the duration. The agreement does not apply to the Vulcan sector. The agreement does not apply to the Crystalfold settlements. The agreement does, in our reckoning, apply to the Frontier. We are flexible on the wording."),
        DialogHook (trigger: "supply_exchange", text: "We will, in exchange for the requested materials, provide six ancestor-shards from the Frontier supply route. The shards are authenticated. The names are recorded. The cell will not, in this exchange, accept currency."),
        DialogHook (trigger: "philosophical", text: "I am not a typical Husk. I am, in the cell's reckoning, a tool. The cell speaks. I translate. The cell does not, in its convention, require me to believe what I translate. This has, in my own reckoning, been a source of professional difficulty."),
        DialogHook (trigger: "coalition_correspondent", text: "[in private] I have additional information. The cell has not authorized me to share it. I am sharing it. Please do not, in this exchange, indicate that we have spoken. I am, in my own reckoning, trying."),
        DialogHook (trigger: "casual_conversation", text: "I do not, in this role, have casual conversation. I appreciate that you have offered. I will, in private, write down the conversation, in case it is useful later."),
        DialogHook (trigger: "ethical_dilemma", text: "I will not, in this role, advise. I will, however, indicate that the cell's preferred outcome is approximately the third option on your list. The cell would, in private, prefer the first. I am telling you this because I am, in my own reckoning, trying."),
        DialogHook (trigger: "veteran_recognition", text: "I have, in the cell's records, your name. The cell does not consider you, in this negotiation, a primary target. The cell does, however, consider you a person of interest. Please walk with care."),
        DialogHook (trigger: "warning_player", text: "I am authorized to indicate that the next engagement is not, in the cell's plan, intended for this sector. I cannot say more. I am, in my own reckoning, trying."),
        DialogHook (trigger: "honoring_dead", text: "The cell carries. I do not, in this role, carry directly. I have, in private, mourned. I cannot, in this conversation, say more. The cell does not authorize."),
        DialogHook (trigger: "smile_tell", text: "[smiles slightly] The negotiation is, in the cell's reckoning, going poorly. I will, in private, note this. I will not, in this exchange, comment further. Please proceed."),
    ],
)
