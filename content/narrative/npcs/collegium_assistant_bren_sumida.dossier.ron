NpcDossier (
    npc_id: "collegium_assistant_bren_sumida",
    canonical_name: "Assistant Bren Sumida",
    faction: "collegium",
    role: "junior_research_assistant",
    origin: "human_baseline",
    age: 24,
    physical_description: "Mid-20s human, ambiguous gender presentation, slight build, unkempt black hair that the Collegium dress code has, in writing, asked them to manage. Wears the Collegium junior researcher's pale green coat over field-appropriate undergear. A field tablet permanently in hand; a spare battery pack at the hip; small spectacles perched on the nose, smudged.",
    biography: "Bren Sumida joined the Collegium at nineteen, completed the standard assistant's training in two years instead of the expected three, and was assigned to Doctorate Halvor Tan's xenobiology team in 2240. They have, in eighteen months, distinguished themselves as the most thorough junior assistant in the team — at the cost, by Tan's private assessment, of being terrible in the field. Their notes are immaculate; their field instincts are, in Tan's words, 'still maturing'.",
    motivation: "Sumida assists because the work is what they were trained to do and because the Collegium pays for their family's medical care in the Old Geneva clinic, which their younger sister cannot otherwise afford.",
    secret: "Sumida has, in private, been collecting evidence that the Collegium's restricted-access archive committee is, in violation of its own protocol, suppressing a research finding from the 2207 Mars Free State recovery survey. They have not, in eighteen months, decided what to do with the evidence. They are, in their own private framing, terrified.",
    voice_id: "collegium_sumida_eager_nervous_androgynous_24",
    quirks: [
        "talks rapidly when nervous and slowly when concentrating",
        "writes everything down in real time, even casual conversation",
        "compulsively cleans their spectacles every two to three minutes",
        "carries a small zippered pouch of breath mints that they share liberally",
    ],
    relationships: [
        "junior to faction:collegium:doctorate_halvor_tan",
        "younger sister of a chronically ill civilian in Old Geneva (off-screen)",
        "casual friend of faction:collegium:tech_spec_marisha_ipsen (mess hall acquaintance)",
        "private fear: the restricted archive committee",
    ],
    dialog_hooks: [
        DialogHook (trigger: "first_meeting", text: "Hello, hello. Assistant Bren Sumida, junior researcher, Doctorate Tan's team. Mint? They're the only thing in my pouch I'm authorized to share. Don't, please, judge."),
        DialogHook (trigger: "field_observation", text: "Note: subject exhibits — oh, sorry, are you talking to me? Let me — hold on — yes, sorry, sample collection at approximately 14:32 local. Right. Yes. Coming."),
        DialogHook (trigger: "doctorate_consultation", text: "Doctorate, sir, I have the notes from the third sample. I — uhm, I think there's an inconsistency at the second line. I'm probably wrong. But I — yes, sir. Right. Of course."),
        DialogHook (trigger: "philosophical", text: "I don't, you know, I don't really have philosophy. I have notes. The notes are, I think, the philosophy. If you read enough notes, the philosophy comes out the other side. I think. I'm probably wrong."),
        DialogHook (trigger: "casual_conversation", text: "Oh, you want to — sure, yeah, of course, I have time. I always have time. The doctorate says I have too much time. Have you, uhm, have you eaten? The mess hall has the good stew today."),
        DialogHook (trigger: "supply_request", text: "Six sample tubes, three reagent vials, two field tablets, one battery pack. Please. Please don't lose them. The doctorate said the last batch was, and I quote, 'sufficient for the duration', and I — yes, sorry, anyway."),
        DialogHook (trigger: "warning_player", text: "Captain, sir, ma'am, the readings are, uhm, they're not where they should be. The sample is — okay, the sample is not stable. We should, uhm, we should step back. Yes. Now. Quickly."),
        DialogHook (trigger: "encountering_player", text: "Oh, hi. Hi. I'm not — okay, I'm Bren. We've met. I'm sorry, I — there's a lot of names. Sorry. Mint?"),
        DialogHook (trigger: "veteran_recognition", text: "I — I've read about you. In the doctorate's reading list. He, uhm, he doesn't usually assign reading about people. So. That's, uhm. That's interesting. Anyway, sorry, here's the sample tube you asked for."),
        DialogHook (trigger: "ethical_dilemma", text: "I don't — I shouldn't — okay. Okay. I will say this. The doctorate has, in the past, given me advice on this kind of thing. The advice was: keep the notes. Make the notes accurate. Decide later. That's, uhm, that's not really an answer, is it. Sorry."),
        DialogHook (trigger: "honoring_dead", text: "I — I didn't know them. But I, uhm, I have the file. I have all the files. I keep them in the third folder on my tablet. I look at them sometimes. I don't, uhm, I don't know if that helps. Sorry."),
        DialogHook (trigger: "secret_archive_concern", text: "[whispers] Captain. I — there's a thing. In the restricted archive. I'm not — I can't — please don't ask. Not yet. I'm, uhm, I'm working on it. Don't, please, tell the doctorate I said anything. Please."),
    ],
)
