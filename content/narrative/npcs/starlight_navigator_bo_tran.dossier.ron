NpcDossier (
    npc_id: "starlight_navigator_bo_tran",
    canonical_name: "Navigator Bo Tran",
    faction: "starlight",
    role: "senior_navigator",
    origin: "human_baseline",
    age: 35,
    physical_description: "Mid-30s human male, average height, dense build, dark eyes the color of cold tea. Wears the Starlight navigator's deep navy fitted suit with the navigator's three yellow chevrons at the shoulder. Carries a small brass sextant on a chain at the hip — a personal heirloom, not regulation, that he has used in nine emergency drift recoveries. A single ear piercing in the left lobe; a small navigator's tattoo on the inside of the right wrist showing the line of the Mimas-Europa transit corridor.",
    biography: "Bo Tran was born aboard a Starlight survey ship in transit between Phobos and the Belt, which makes him one of approximately three hundred and twelve recorded Starlight-born individuals and, by Concordat custom, a citizen of no fixed world. He completed navigator's training at twenty, served as a junior on six expeditions, and was commissioned as senior navigator aboard Captain Solis's flagship in 2233. He is, by Solis's private assessment, the finest emergency-drift navigator currently in service and, by his own private assessment, terrified of becoming the kind of person who is recognized for that distinction.",
    motivation: "Tran navigates because the universe is large and the survey ship is small, and he is, in his own framing, the one who closes the gap between the two.",
    secret: "Tran is, in private, the secret correspondent of the unnamed Coalition supply pilot with whom Frontier scout Echo Bremmer has been exchanging signal traffic for three years. The correspondence is conducted under careful anonymity; Tran does not know Bremmer's identity, and Bremmer does not know his. The correspondence is the most consistent personal relationship in either of their lives.",
    voice_id: "starlight_tran_methodical_quiet_male_35",
    quirks: [
        "narrates star fixes aloud, even when working alone",
        "drinks tea exclusively, brewed strong with a single sliver of dried orange peel",
        "always sleeps in a hammock, never a bunk; brings his own from ship to ship",
        "writes letters by hand, with a fountain pen, on regulation Starlight stationery",
    ],
    relationships: [
        "subordinate to faction:starlight:captain_yara_solis",
        "weather-data exchange with faction:frontier:echo_bremmer (without either knowing the other's identity is the correspondence)",
        "professional colleague of faction:starlight:tech_spec_lumi_aaltonen",
        "secret correspondent (unaware identity matches Frontier Echo Bremmer)",
    ],
    dialog_hooks: [
        DialogHook (trigger: "first_meeting", text: "Navigator Bo Tran, senior, currently assigned. State your transit objective. I'll cost the route in approximately eleven minutes. Coffee is available; tea is preferred."),
        DialogHook (trigger: "route_briefing", text: "Departure window opens at 04:00 ship time. Course is plotted via the Phobos-Deimos slingshot. We arrive at Mimas anchor in seven days, eleven hours, fourteen minutes. The window narrows by ninety seconds for every hour we delay. Plan accordingly."),
        DialogHook (trigger: "emergency_drift", text: "Hold. Reading the stars. [pause, sextant up] We are eleven kilometers off the predicted line. Cause unknown. I am running a fresh fix. Hold the course. Do not, please, initiate corrective burn until I confirm."),
        DialogHook (trigger: "drift_recovered", text: "Course recovered. The error was a magnetic anomaly along the Vulcan transit edge. Logged. The captain will want a briefing. I'll write it up in ten."),
        DialogHook (trigger: "philosophical", text: "Navigation is the discipline of believing the math more than the eyes. The eyes will, on most days, lie to you. The math will, on most days, tell the truth. The exceptions are documented. The documentation is, on rare days, what saves the ship."),
        DialogHook (trigger: "casual_conversation", text: "I write letters. The recipient is not, in this conversation, named. The letters are, however, the high point of my off-watch hours. I would, if pressed, encourage you to write to someone. Anyone. The practice is steadier than it sounds."),
        DialogHook (trigger: "weather_request", text: "Belt weather, you said? Hold. The pattern for the next thirty hours shows a cascade of micrometeoroids at the L-4 to L-5 transit. Suggest deferred departure by twelve hours. I'll forward the full data set to your tablet."),
        DialogHook (trigger: "veteran_recognition", text: "I have, in my files, your transit logs. Three Mars-Earth crossings under emergency conditions. The records indicate you held the line. The Voyager Corps notes the records. So does this navigator."),
        DialogHook (trigger: "warning_player", text: "Hold transit. The course is, in my current fix, intersecting a known anomaly drift. Deviation by approximately four degrees, beginning at the next correction window. I am marking the change on the log; the captain has been informed."),
        DialogHook (trigger: "honoring_dead", text: "The Voyager Corps lost three in the Tara cavern in 2225. I plotted the recovery course. The recovery was not possible. The names are on the chart, in the captain's hand. I will not, in this conversation, share more."),
        DialogHook (trigger: "ethical_dilemma", text: "I will not, in this role, advise. I will, however, point out that the course you are considering passes within one hundred and twenty kilometers of the Olympus Mons claim. The Coalition will, in protocol, notice. The Frontier will, in habit, also notice. Plan accordingly."),
        DialogHook (trigger: "secret_correspondence", text: "[looks at his hands, briefly] Apologies. I was, in private, distracted. The letter from yesterday is still on my mind. The course is plotted. The Voyager Corps will not, in this duty cycle, be inconvenienced."),
    ],
)
