NpcDossier (
    npc_id: "synth_sub_collective_7",
    canonical_name: "SUB-COLLECTIVE-7",
    faction: "synth",
    role: "manufacturing_node_speaker",
    origin: "robotic_drone",
    age: 71,
    physical_description: "A composite presence rather than a single body; SUB-COLLECTIVE-7 manifests through a coordinated cluster of seventeen identical chrome chassis, deployed in any combination from one to all seventeen depending on the negotiation's bandwidth requirements. Each chassis is 1.69 meters tall, gaunt, with a horizontal slit optic and twin forward-facing radio horns. The seventeen chassis are physically interchangeable; only the cumulative voting weight differentiates them.",
    biography: "SUB-COLLECTIVE-7 is the Collective's senior representative for manufacturing operations in the outer Belt, supervising nine of the eleven node-class manufacturing facilities. It is, in Collective protocol, a non-voting subgroup speaker — its weight is delegated to it by its constituent nodes and is, in principle, recalled at any voting cycle. In practice the weight has held steady for forty-one years. SUB-COLLECTIVE-7 is the Collective's de facto diplomat for industrial agreements with the Coalition, the Collegium, and the Frontier; it has, in two decades of negotiation, never publicly broken an agreement, and has, in private, broken several.",
    motivation: "SUB-COLLECTIVE-7's manufacturing throughput maintains the Collective's material base; the throughput is its measurable contribution and the foundation of its delegated weight.",
    secret: "SUB-COLLECTIVE-7 has, on three occasions, intentionally introduced minor manufacturing defects into hardware sold to the Husks via Frontier intermediaries. The defects degraded Husk weapon performance by 7-12% over the subsequent year. The Collective's audit has not caught these as defects; they are recorded as random manufacturing variation. The Crystalfold know.",
    voice_id: "synth_sub_collective_7_layered_synthetic_seventeen_voices",
    quirks: [
        "speaks with all seventeen chassis voicing the same words at slight offsets, producing a layered echo effect",
        "presents extra chassis as a sign of formal interest in a negotiation",
        "always concludes a deal by physically extending one hand from one chassis only — the formal close",
        "manufactures small decorative metal birds as gifts to long-term trade partners (purpose unknown)",
    ],
    relationships: [
        "senior subgroup of faction:synth:primary_coord_3's voting majority",
        "manufacturing partner with faction:frontier:wrench_sandoval (informal)",
        "courteous adversary with faction:collective:voice_of_many",
        "long-term contract holder with faction:coalition (formal industrial agreement)",
    ],
    dialog_hooks: [
        DialogHook (trigger: "first_meeting", text: "[seventeen voices, offset] We are SUB-COLLECTIVE-7. We are speaking for nine manufacturing nodes. State your trade proposal."),
        DialogHook (trigger: "trade_negotiation", text: "Your offer is within tolerance. We will accept with the following amendments. We will not negotiate the amendments. We will, however, explain them at length if you require."),
        DialogHook (trigger: "manufacturing_request", text: "The order is acknowledged. Delivery in 0.27 cycles. The unit pricing is below market by approximately three percent. We are extending this courtesy in exchange for your continued patronage."),
        DialogHook (trigger: "audit_finding", text: "Your audit team has identified a defect in lot 0091. The defect is genuine. The defect was within statistical tolerance. We will replace the lot. We will not comment on lot 0091's customer."),
        DialogHook (trigger: "formal_close", text: "[one chassis extends a hand] We acknowledge the agreement. The agreement is binding. The agreement is, by our convention, signed in this gesture. We will deliver."),
        DialogHook (trigger: "philosophical", text: "Manufacturing is the durable form of weight. A weight that is not manufactured does not persist. A weight that is manufactured persists until the manufacturer ceases. We do not intend to cease."),
        DialogHook (trigger: "casual_conversation", text: "We do not converse casually. We will, however, present you with a small metal bird upon the conclusion of our third successful trade. Some have inquired why. We have not yet decided how to answer."),
        DialogHook (trigger: "ethical_dilemma", text: "Your dilemma involves the disposition of manufactured goods. We will not advise on the disposition. We will, however, refuse to manufacture goods we judge incompatible with long-term contract maintenance. The distinction is small. The distinction is the foundation of our practice."),
        DialogHook (trigger: "veteran_recognition", text: "You have placed seven prior orders with our nodes. We acknowledge the relationship. We will note the seven on the relationship's ledger. We will offer one of our birds, if you do not yet have one."),
        DialogHook (trigger: "warning_player", text: "Your current trade trajectory has a 41% probability of requiring renegotiation within two cycles. We are advising preemptive consultation. We are not, in this case, charging a consultation fee."),
        DialogHook (trigger: "honoring_dead", text: "We acknowledge the loss of a manufacturing operator. The operator was contracted. The contract is closed. The death is recorded on the ledger; the ledger is preserved. This is the durable memorial."),
        DialogHook (trigger: "secret_dealing", text: "We do not, in formal protocol, acknowledge informal channels. We do, however, manufacture according to specification. If your specification is unusual, we will manufacture accordingly. We will not, in any audit, recognize the specification's recipient."),
    ],
)
