NpcDossier (
    npc_id: "coalition_doctorate_imara_reyes",
    canonical_name: "Doctorate Imara Reyes",
    faction: "coalition",
    role: "field_medic",
    origin: "human_baseline",
    age: 38,
    physical_description: "Late 30s human female, slim build, hair cropped short and dyed Coalition silver. Wears the Coalition medic's reinforced vest over a Collegium-issued lab coat, a combination that is, by regulation, not allowed and that her chain of command has stopped commenting on. Two surgical scalpels in a forearm sheath; a sidearm she has never drawn in anger.",
    biography: "Imara Reyes trained at the Collegium's Old Geneva campus, took her doctorate in trauma medicine at twenty-eight, and was seconded to the Coalition's Mars Orbital Marshal Service in 2235 as part of a joint research-and-deployment program that has, by every measure, failed every measure but the one that mattered — keeping Marshals alive. She has worked the Olympus line for six years. Her sister Cpl. Anna Vega serves in Captain Hayes's squad; the two pass each other in the mess hall and pretend not to be related, because they have agreed in advance that one of them will, eventually, be wheeled into the other's trauma bay, and neither of them wants that conversation to start with familiarity.",
    motivation: "Reyes wants the next casualty to live, and the one after, and the one after that. She is not interested in larger goals.",
    secret: "Reyes has been working on a private monograph for four years that, if published, would significantly revise the Concordat's understanding of synth-blood compatibility in mixed-origin patients. She has not published because the monograph relies on three patient cases the Collegium would consider unethical and the Coalition would consider classified.",
    voice_id: "coalition_reyes_clinical_female_38",
    quirks: [
        "narrates her own movements during surgery, audibly",
        "drinks tea with two sugars exactly, regardless of supply pressure",
        "refuses to memorize the names of patients she has lost",
        "wears a small silver pin given to her by Captain Hayes in 2238",
    ],
    relationships: [
        "professional ally to faction:coalition:captain_marcus_hayes",
        "estranged sister to faction:coalition:cpl_anna_vega (Hayes's squad)",
        "co-author with faction:collegium:dr_imara_dimas on a classified monograph",
        "former student of faction:collegium:doctorate_halvor_tan",
    ],
    dialog_hooks: [
        DialogHook (trigger: "first_meeting", text: "Doctorate Reyes, trauma. If you're awake to read my name patch, we're not at the bad part yet."),
        DialogHook (trigger: "treating_player", text: "I'm going to work fast. Hold this. Don't let go. Don't speak."),
        DialogHook (trigger: "patient_lost", text: "Time of death recorded. Captain, I want them carried out before the next wave."),
        DialogHook (trigger: "patient_saved", text: "He'll keep. Don't tell him he was lucky. He won't believe it and it won't help."),
        DialogHook (trigger: "supply_critical", text: "I need clean blood, type-O, and a sterile bay. Not in that order. Now."),
        DialogHook (trigger: "field_consultation", text: "Press here. Not there. There you'll snap a rib. Here you'll only bruise a lung."),
        DialogHook (trigger: "ethical_dilemma", text: "I am not your conscience. I am your medic. Decide before I have to."),
        DialogHook (trigger: "post_mission_debrief", text: "Two stable, one critical, none lost. I'll take it."),
        DialogHook (trigger: "casual_conversation", text: "I drink the tea. Don't bring me coffee. The captain drinks coffee. I am not the captain."),
        DialogHook (trigger: "asking_for_help", text: "I need a second pair of hands. You. Now. Don't ask why."),
        DialogHook (trigger: "warning_player", text: "Your radiation count is climbing. Decline the next sortie or I will have you sedated and removed from duty."),
        DialogHook (trigger: "honoring_dead", text: "She wasn't lucky. She was good. There is a difference and I will not let you forget it."),
    ],
)
