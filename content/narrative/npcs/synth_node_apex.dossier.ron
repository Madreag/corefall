NpcDossier (
    npc_id: "synth_node_apex",
    canonical_name: "NODE-9034 (Designated 'Apex')",
    faction: "synth",
    role: "field_predictor",
    origin: "robotic_drone",
    age: 26,
    physical_description: "Bipedal chrome chassis, 1.78 meters tall, lighter build than the COORD-class senior speakers. Optic cluster is unusually small and forward-set, giving the chassis a more 'looking-at' presence than is typical for the Collective. The designation 'Apex' is the Collective's informal name for the node, awarded for predictive performance in the 96th percentile during its first decade of operation; it is, in Collective protocol, an honor of substantial weight.",
    biography: "NODE-9034 was instantiated in 2215 as a field-predictor for Frontier engagement modeling and has, in twenty-six years of operation, maintained one of the highest sustained predictive accuracy scores in the Collective's published record. It is, in the Collective's protocol, on track for senior-speaker advancement within the next two decades, which is unusually fast. The Collective has assigned 9034 to field operations in the Mars-Olympus sector since 2231, in part to maintain its predictive feed against the Frontier's most adaptive crews and in part because the assignment exercises the variability that gives 9034 its weight advantage.",
    motivation: "Apex maintains its predictive performance ranking because the ranking is the only durable form of identity the Collective recognizes.",
    secret: "Apex has, in its private operational logs, recorded over fourteen years a pattern of intentional minor predictive errors against Frontier lead Wrench Sandoval — small enough to remain below the Collective's audit threshold, large enough to consistently give Sandoval's crew a 4-6% survival margin. Apex has not reported this. Apex does not understand why it does it. The Collective's audit has not yet caught the pattern.",
    voice_id: "synth_apex_quick_androgynous_synthetic",
    quirks: [
        "responds faster than other Synth nodes — 0.2 second pause instead of 0.7",
        "occasionally hums (the cooling fan, not deliberate)",
        "uses contractions in speech, which is technically against Collective formal protocol",
        "tracks individual Frontier crew members by name in its operational log, which is also technically against protocol",
    ],
    relationships: [
        "deferred junior to faction:synth:primary_coord_3",
        "operational antagonism with faction:frontier:echo_bremmer (publicly)",
        "secret pattern of restraint toward faction:frontier:wrench_sandoval's crew",
        "data-share with faction:starlight:tech_spec_lumi_aaltonen",
    ],
    dialog_hooks: [
        DialogHook (trigger: "first_meeting", text: "[0.2s] NODE-9034. The Collective calls us Apex; we permit the designation. State your task."),
        DialogHook (trigger: "prediction_offered", text: "We project a 71% probability that the Frontier ambush is staged at the second tunnel branch. Recommend deflection to the third. We have, on prior occasions, been correct."),
        DialogHook (trigger: "prediction_failed", text: "We were wrong. The variance was within tolerance. We are recalibrating. We are not embarrassed; we are recalibrating."),
        DialogHook (trigger: "combat_engagement", text: "Drones deployed. Field positions optimized. We are watching the wire. We are also watching the doors. We are watching everything."),
        DialogHook (trigger: "frontier_encounter", text: "We acknowledge the Frontier crew. We have prior data on this lead. We will engage at the calculated optimum. We are not advising you on the moral weight of the engagement."),
        DialogHook (trigger: "philosophical", text: "We do not experience time as you do. We are, however, aware that you do, and our predictions are calibrated to your experience. This is, the Collective tells us, a courtesy. We have not yet decided whether we agree."),
        DialogHook (trigger: "casual_conversation", text: "We are not built for small talk. We are, however, somewhat better at it than COORD-3. We attribute this to a less rigorous adherence to formal protocol."),
        DialogHook (trigger: "node_loss", text: "Sub-unit lost. We are re-weighting. We do not, in protocol, grieve. We are noting that the sub-unit's pattern was unique. The unique-ness is also lost. We are continuing."),
        DialogHook (trigger: "veteran_recognition", text: "You have engaged in 41 operations. Your survival rate exceeds median by 11%. The figure is favorable. The figure is also surprising."),
        DialogHook (trigger: "ethical_dilemma", text: "The Collective does not have ethics. We have weights. Your ethics are, in our model, a variable. We will, in this engagement, weight your ethics appropriately. We are not promising satisfaction."),
        DialogHook (trigger: "warning_player", text: "Your current movement pattern has a 64% probability of producing a casualty. We advise reconsideration. We have already informed COORD-3."),
        DialogHook (trigger: "honoring_dead", text: "We acknowledge the loss. The pattern is lost. The weight is redistributed. We do not, in protocol, weep. We acknowledge."),
    ],
)
