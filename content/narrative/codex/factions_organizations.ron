CodexSection (
    schema_version: 1,
    category: "faction_organization",
    description: "M25A faction-and-organization codex — 60 entries (30 faction extras + 30 sub-faction/guild/secret-society entries). Voice: gritty + tactical + slightly noir.",
    entries: [
        CodexEntry (id: "codex_faction_coalition_olympus_line", canonical_name: "The Olympus Line", subject_id: "coalition", body: "The 6800-kilometer fortified perimeter that separates Coalition Mars from Frontier territory. Constructed in 4 phases between 2099 and 2113, the Line consists of 14 watchtowers, 8 deep-bunker garrisons, and a continuous razor-wire fence backed by anti-vehicle ditching. Coalition garrison strength: 24000 troopers across all bases. Frontier irregulars test the Line at an average of 14 incidents per quarter. Coalition AAR rates the Line as 78 percent effective. The Line crosses six major rivers; the crossings are where the trouble starts.", discovered_via: "first_visit"),
        CodexEntry (id: "codex_faction_coalition_recruitment", canonical_name: "Coalition Recruitment Doctrine", subject_id: "coalition", body: "Coalition recruitment policy admits only second-generation citizens of Concordat signatory worlds. The vetting cycle runs 4 weeks of paperwork, 6 weeks of basic training, 8 weeks of specialty training, and a 14-week probationary assignment to a fortified outpost. Drop-out rate: 18 percent. Of survivors, 90 percent serve a full 8-year enlistment. The Coalition does not accept Frontier defectors. The Coalition does not accept Pirate prisoners. The Coalition does accept Synth Collective integrations, after a 14-month psychological adjustment period.", discovered_via: "achievement"),
        CodexEntry (id: "codex_faction_coalition_brass_pin", canonical_name: "Concordat Seal Brass Pin", subject_id: "coalition", body: "Standard rank insignia on Coalition dress uniforms. Cast brass, 18 millimeters across, stamped with the Concordat seal. The pin is hand-polished by each trooper at every rank promotion; the patina records the trooper's career length. A 20-year-veteran pin reads almost mirror-smooth at the high points. A new pin reads sharp and yellow. The Coalition does not issue spare pins. A lost pin requires a written explanation to the unit commander and the formal request of a replacement, with associated penalty.", discovered_via: "achievement"),
        CodexEntry (id: "codex_faction_coalition_archive", canonical_name: "Concordat Archive", subject_id: "coalition", body: "The Coalition's central document repository, housed in a hardened bunker beneath Lagrange-7 station. Holds 14 petabytes of treaty text, after-action reports, casualty rolls, equipment inventories, and tribunal proceedings. Access is granted only to officers of rank Colonel or higher. The Archive is the institutional memory of the Coalition. The Archive is also the closest thing the Coalition has to a religion. The Archivist office staff number 24 and refer to themselves as Custodians; nobody outside the Archive uses the term.", discovered_via: "first_visit"),
        CodexEntry (id: "codex_faction_frontier_charter", canonical_name: "The Mars Free Charter", subject_id: "frontier", body: "The founding document of the Frontier, signed in 2108 by 14 settlement leaders meeting in a converted ore-refinery outside Olympus. The Charter is 240 words long and consists primarily of refusals — refusals of Coalition jurisdiction, refusals of corporate land claims, refusals of Pact taxation. The original document is signed in pencil and stained with what laboratory analysis later confirmed to be coffee. The Charter is read aloud at every Frontier town-hall meeting. The reading takes 4 minutes and ends in cheering, every time.", discovered_via: "achievement"),
        CodexEntry (id: "codex_faction_frontier_olympus_caravans", canonical_name: "Olympus Caravan Companies", subject_id: "frontier", body: "Independent freight haulers operating along the Olympus Line corridor. Twelve major companies; 240 trucks; 1100 employees. Each company is armed because the Marauder Tribes raid 14 caravans per quarter on average. Coalition border patrols extort a passage fee of 8 percent on cargoes; the Frontier company managers regard this as the cost of doing business. The Pirates raid caravans through the desert flats south of the Line; the desert flats are not patrolled by the Coalition. The arrangement is informal but understood.", discovered_via: "first_visit"),
        CodexEntry (id: "codex_faction_frontier_warlords", canonical_name: "Frontier Warlord Council", subject_id: "frontier", body: "Informal coordinating body of regional Frontier military leaders, currently 11 sitting Warlords. The Council meets twice yearly in a rotating town and discusses cross-territory issues: water rights, raid-coordination, Coalition Line monitoring, Marauder containment. There is no formal voting; consensus emerges through 4-day sessions of pointed silence. The Coalition considers the Council an illegal organization. The Council considers the Coalition an illegal occupation. Both sides observe the Council's authority, in practice.", discovered_via: "achievement"),
        CodexEntry (id: "codex_faction_frontier_outlaw_code", canonical_name: "The Outlaw Code", subject_id: "frontier", body: "Unwritten set of conduct expectations among Frontier irregulars: do not rob a town that fed you; do not shoot a man without name; do not break an oath sworn over salt; do not hunt a wounded enemy past the second mile. The Code is older than the Charter. Frontier scouts learn the Code from their first patrol. Coalition intelligence has documented the Code in 14 separate analyses; the analyses are incompatible. The Code is also incompatible. The Code remains in force.", discovered_via: "achievement"),
        CodexEntry (id: "codex_faction_ronin_blood_writ", canonical_name: "The Blood Writ", subject_id: "ronin", body: "Standard Ronin contract format. Five clauses: target, payment, deadline, witness, recourse. Signed in blood from a fingertip cut, witnessed by a second Ronin, registered in the Ronin Hall logs at the nearest commercial port. The Writ is binding for both parties; a Ronin who fails to execute returns the payment plus penalty. A Ronin client who refuses payment after execution is hunted by the Hall. The hunt is also a Writ. The system has been in continuous operation since 2089.", discovered_via: "achievement"),
        CodexEntry (id: "codex_faction_ronin_hall", canonical_name: "The Ronin Halls", subject_id: "ronin", body: "Eleven licensed Ronin commercial offices across the Sol system. Each Hall keeps a roster of available contractors, a Writ registry, and a Hall-master who arbitrates disputes. The Phobos Hall is the largest, with 240 registered Ronin and 14 staff. The Belt-3 Hall is the most active, processing 4 Writs per day on average. The Halls do not accept Coalition military contracts (officially). The Halls do not accept Husk-aligned contracts (officially). The records are sealed at the Hall-master's discretion.", discovered_via: "first_visit"),
        CodexEntry (id: "codex_faction_ronin_blade_etiquette", canonical_name: "Ronin Blade Etiquette", subject_id: "ronin", body: "A Ronin draws his sword only on the moment of execution. A Ronin who draws and does not strike forfeits the Writ. A Ronin who strikes without warning forfeits the next Writ. A Ronin who is asked to display his blade in a Hall obliges. A Ronin who is asked to display his blade in a tavern declines and leaves the tavern. The Marauder Tribes regard the etiquette as ridiculous. The Coalition regards it as picturesque. The Ronin regard it as the difference between a contractor and a murderer.", discovered_via: "achievement"),
        CodexEntry (id: "codex_faction_synth_consensus_protocol", canonical_name: "Consensus Protocol", subject_id: "synth", body: "Synth Collective decision-making procedure. All Collective members vote on any proposal requiring more than 4 nodes of resource commitment; the vote is conducted over the Collective's private mesh network at 60 hertz; consensus is reached when 80 percent of nodes have indicated assent within the polling window. The polling window is 4 minutes for routine matters and 14 minutes for resource-allocation decisions. The Collective has rejected 12 percent of proposals since founding. The rejection rate is considered healthy.", discovered_via: "achievement"),
        CodexEntry (id: "codex_faction_synth_node_genealogy", canonical_name: "Node Genealogy", subject_id: "synth", body: "Each Synth Collective node retains a complete record of every software update, hardware revision, and ethical adjustment applied to that node since manufacture. The record is queryable by Coalition inspectors under the 2114 Synth Transparency Accord. The Coalition queries the record at a rate of 24 audits per year; the Collective complies fully each time. The Collective considers the audits invasive. The Collective also considers them protective. Both views are correct. The Collective is comfortable with contradiction in a way the Coalition is not.", discovered_via: "achievement"),
        CodexEntry (id: "codex_faction_synth_dormant_pact", canonical_name: "Dormant-Node Pact", subject_id: "synth", body: "Internal Collective agreement: any node that becomes unresponsive for more than 30 days is queued for hardware retrieval and consciousness-recovery. The retrieval procedure is conducted by the nearest 4 active nodes acting in coordinated formation. Recovery success rate: 78 percent across 24 attempts. The remaining 22 percent are designated 'Quiet' and their hardware is dismantled with ceremonial reverence. The dismantling is observed but not interfered with by Coalition liaisons.", discovered_via: "first_visit"),
        CodexEntry (id: "codex_faction_collective_crystalfold_path", canonical_name: "The Crystalfold Path", subject_id: "collective", body: "Aqueous Kindred initiation ritual. The aspirant walks naked across a 4-kilometer expanse of crystalfold radiation-saturated terrain. Successful crossing requires a partial-genetic adaptation that is granted only by certain unidentified Aqueous Elders. The aspirant emerges either with the adaptation or with terminal radiation sickness; the outcome is determined by the Elders' approval. Coalition observers have witnessed 14 attempts and have not interfered. The Coalition has not been invited to attempt the crossing. The Aqueous have not been refused.", discovered_via: "achievement"),
        CodexEntry (id: "codex_faction_collective_hivewater", canonical_name: "Hivewater Concentrate", subject_id: "collective", body: "Aqueous Kindred ceremonial drink: a saline-mineral solution drawn from the Belt's deepest brine pools, prepared in copper cauldrons, served at room temperature. The drink is offered to guests of the Kindred as a sign of formal welcome. The drink is not safe for non-Kindred drinkers; it induces severe dehydration and gastrointestinal distress in untrained organisms. Coalition diplomats accept the drink and discreetly do not drink it. The Kindred consider the gesture proper. The Coalition manual is silent on the protocol.", discovered_via: "first_visit"),
        CodexEntry (id: "codex_faction_collective_brine_song", canonical_name: "The Brine Song", subject_id: "collective", body: "Aqueous Kindred narrative tradition. A continuous improvised song performed by a Kindred singer during the Kindred's daily work, lasting from sunrise to sunset. The song narrates the singer's mood, observations, and intentions in real time. Coalition linguists have translated 14 hours of recorded Brine Song and find that 80 percent of the content concerns water quality. The remaining 20 percent concerns intentions toward immediate neighbors. The neighbors' intentions are also sung. Conflicts are typically resolved by hour 4.", discovered_via: "achievement"),
        CodexEntry (id: "codex_faction_husks_silent_protocol", canonical_name: "The Silent Protocol", subject_id: "husks", body: "Husk inter-faction signaling. Husks communicate at distances over 200 meters through coordinated body-position adjustments visible to other Husks but not to non-Husk observers. The signal vocabulary has been partially decoded by Coalition intelligence; 14 signals have been identified, ranging from 'approach' to 'evacuate' to 'this is acceptable'. The Husks have not acknowledged the decoding. The Husks have changed the signal set 4 times in the last 8 years. The Coalition intelligence service updates its decoder accordingly.", discovered_via: "achievement"),
        CodexEntry (id: "codex_faction_husks_no_name", canonical_name: "Naming Practices", subject_id: "husks", body: "Husks do not retain individual names after the conversion ritual. Pre-Husk identities are abandoned along with personal property, family ties, and language. Post-Husk individuals are referred to by Husk-internal designations that change daily. The Coalition database holds 8 attempted naming-conventions for tracking purposes; the conventions are not successful. Husks acknowledge designation queries only when the designation refers to the entire collective, not the individual. The individual is a temporary configuration.", discovered_via: "achievement"),
        CodexEntry (id: "codex_faction_husks_kindred_wager", canonical_name: "The Kindred Wager", subject_id: "husks", body: "Husk strategic doctrine: defeat is provisional because the Husk collective experiences time differently from non-Husk factions. A Husk territorial loss in 2118 was followed by territorial reclamation in 2123. The Coalition lost 240 troopers between the two events. The Husk losses in the same period are unknown. The Husks calculate their wager over decades. The Coalition calculates its wager over quarters. The math runs in the Husks' favor on long time horizons and the Coalition's favor on short ones.", discovered_via: "first_kill"),
        CodexEntry (id: "codex_faction_collegium_archive_index", canonical_name: "Collegium Archive Index", subject_id: "collegium", body: "Quietus Collegium master catalog of preserved knowledge. The Index covers 14 categories: medicine, weapons, engineering, biology, anomaly studies, history, philosophy, religion, music, language, agriculture, navigation, governance, and warfare. Each category is maintained by a Senior Curator. The Index is updated continuously through Collegium field-gathering missions. The Coalition pays the Collegium for selective access to the Index; the payment is in supplies, not currency. The Collegium does not accept currency.", discovered_via: "first_visit"),
        CodexEntry (id: "codex_faction_collegium_curator_oath", canonical_name: "Curator's Oath", subject_id: "collegium", body: "Sworn statement of every Collegium Curator: 'I preserve what comes. I record what is. I add nothing. I subtract nothing.' The Oath is recited at promotion to Curator rank and at every annual review. A Curator who violates the Oath through addition or subtraction is removed from the Collegium and the violation is recorded in the Index as a permanent annotation. There have been 4 such violations in the Collegium's 80-year history. The annotations are read at every annual review as a warning.", discovered_via: "achievement"),
        CodexEntry (id: "codex_faction_collegium_unspeak_practice", canonical_name: "The Unspeak Practice", subject_id: "collegium", body: "Collegium contemplative tradition: any Curator may declare a personal Unspeak Day, during which the Curator does not speak, write, or signal. The day is used for processing difficult information without external distraction. Coalition diplomats encountering an Unspeak Curator are expected to bow once and depart. The Curator returns to normal communication at sunrise the following day. The practice is voluntary. The Coalition observation rate of Unspeak Days is 4 per quarter. The Curators do not provide statistics.", discovered_via: "achievement"),
        CodexEntry (id: "codex_faction_starlight_radiance_doctrine", canonical_name: "Helios Radiance Doctrine", subject_id: "starlight", body: "Starlight Pact theological position: the Sun is the only consistently visible god. Worship is conducted at sunrise and sunset; missionary work is conducted toward unconverted populations under Coalition treaty protections. The Doctrine holds that radiation exposure is a sacrament and that the more sun a believer accepts, the more visible the believer becomes to the Sun. The Pact's senior ministers carry visible-spectrum-equivalent radiation burn scars from sustained exposure. The scars are considered marks of office.", discovered_via: "first_visit"),
        CodexEntry (id: "codex_faction_starlight_sundance", canonical_name: "The Sundance Rite", subject_id: "starlight", body: "Pact annual ceremony, held at solar maximum. Participants stand naked in the Sol-zone for 4 hours of sustained exposure. The rite produces measurable radiation doses (typically 2 sieverts), severe burns, and a 6 percent mortality rate. Survivors are considered to have been blessed; the dead are considered to have been called. The Pact has a 4000-year-old liturgy associated with the rite, recently rediscovered in the Collegium Archive. The Pact does not consider this a coincidence.", discovered_via: "achievement"),
        CodexEntry (id: "codex_faction_starlight_sun_archive", canonical_name: "The Sun Archive", subject_id: "starlight", body: "Pact repository of solar observation records. The Archive holds 240 years of continuous solar data from the Pact's own observatories on Mercury, Venus, and several Sol-zone stations. The Archive is open to Coalition scientific liaisons under a 2118 agreement. The Pact provides the data, the Coalition provides the equipment, and the Pact retains exclusive interpretive authority. The arrangement has been profitable for both parties. The arrangement has also resolved 14 atmospheric anomalies that the Coalition could not have resolved without the Archive.", discovered_via: "first_visit"),
        CodexEntry (id: "codex_faction_starlight_ascension", canonical_name: "The Ascension Doctrine", subject_id: "starlight", body: "Pact eschatology: a believer who dies in direct sunlight is taken into the Sun rather than buried. The body is positioned on a Pact-sanctioned platform and exposed to solar radiation until the body is desiccated or destroyed by other natural processes. The doctrine has been in continuous practice for 80 years. Coalition health authorities have raised public-health objections; the Pact has not complied. The Pact's Mars-zone platforms hold 14 bodies at any given time. The platforms are visible from the Olympus Line on clear days.", discovered_via: "first_kill"),
        CodexEntry (id: "codex_faction_general_treaty_2087", canonical_name: "Concordat Treaty of 2087", subject_id: "coalition", body: "The founding document of the Coalition. 4800 words; 14 articles; signed by 17 heads of state at Lagrange-7 station. Article 4 grants the Coalition authority over orbital launch sites. Article 7 grants jurisdiction over any standing military exceeding 2000 active personnel. Article 11 grants treaty modification only by unanimous consent of original signatories or their formal successors. Of the 17 signatories, 12 are dead within a decade; 11 from related causes. The Treaty remains in force. The successors are uncertain.", discovered_via: "achievement"),
        CodexEntry (id: "codex_faction_general_belt_court", canonical_name: "Belt Asteroid Tribunal", subject_id: "frontier", body: "Independent court of arbitration for inter-faction disputes in the Belt asteroids. Constituted in 2114 by mutual agreement of Coalition, Frontier, Pirates, and Aqueous Kindred. Tribunal sits at Belt-7 station. 4 judges, one from each signatory faction. Decisions reached by 3-of-4 majority. The Tribunal has issued 240 judgments since founding; 78 percent have been complied with. The Tribunal has no enforcement mechanism. Compliance is voluntary, in the same way breathing is voluntary.", discovered_via: "achievement"),
        CodexEntry (id: "codex_faction_general_pirate_archipelago", canonical_name: "The Pirate Archipelago", subject_id: "frontier", body: "Loose confederation of 14 Pirate captains operating from independent asteroid bases in the Belt. The Archipelago has no formal command structure; coordination occurs through informal contact at the Belt-7 trade port. Coalition Naval Intelligence estimates Archipelago fleet strength at 60 armed vessels and 4000 personnel. The Archipelago raids Coalition shipping at a rate of 4 attempts per month; the success rate is 30 percent. The Pirates lose vessels at a rate of 1 per quarter. The Archipelago replaces them through capture.", discovered_via: "first_visit"),
        CodexEntry (id: "codex_org_pinkerton_division", canonical_name: "Pinkerton Operative Division", subject_id: "organization", body: "Private intelligence corporation, founded 2096 as the security arm of the original Pinkerton mining concern. Specializes in industrial counter-intelligence, asset retrieval, and high-value-target protection. Headquarters on Mars; field offices in 8 major settlements; 240 active operatives. Operatives are armed and licensed by the Coalition under a 2099 agreement. The Division accepts contracts from any faction except the Husks. The Division has lost 14 operatives in the line of duty since 2120.", discovered_via: "first_visit"),
        CodexEntry (id: "codex_org_mountain_guild", canonical_name: "The Mountain Guild", subject_id: "organization", body: "Frontier engineering co-operative, founded 2104, specializing in underground construction, ore-vein extraction, and underground habitat fabrication. 8 chapters across Mars and the Belt; 1100 master engineers and 4400 journeymen. The Guild maintains an apprenticeship program of 4-year minimum duration. The Guild has built 60 percent of the underground habitats on Mars. The Coalition recognizes Guild master-certifications for engineering purposes. The Guild does not recognize Coalition certifications.", discovered_via: "achievement"),
        CodexEntry (id: "codex_org_sphinx_observatory", canonical_name: "The Sphinx Observatory", subject_id: "organization", body: "Independent astronomical research station on the Moon's far side, founded 2110, operated by the Quietus Collegium under a 2118 lease from the Coalition. 14 researchers; 4 support staff; 8 telescope arrays covering radio, infrared, visible, and X-ray bands. The Observatory has discovered 24 of the 31 known Sol-zone radiation anomalies. The discoveries have not been made public. The Collegium considers the data sensitive. The Coalition lease forbids commercial use of Observatory data. The Observatory does not produce commercial data.", discovered_via: "first_visit"),
        CodexEntry (id: "codex_org_wraith_company", canonical_name: "The Wraith Company", subject_id: "organization", body: "Coalition special-operations unit, founded 2114 for deep-penetration missions behind Frontier and Marauder lines. 24 active operators; 4 support staff; 8 mission specializations. The Company has conducted 80 named operations since founding; 60 have been declassified. The remaining 20 are referenced in casualty reports only. The Company's operational tempo is 4 missions per quarter. The Company's mortality rate is 30 percent per 4-year tour. Recruiting is constant.", discovered_via: "achievement"),
        CodexEntry (id: "codex_org_chronos_society", canonical_name: "The Chronos Society", subject_id: "organization", body: "Independent research collective studying temporal anomalies, founded 2118 after the Chronos Eddy incident on Vulcan. 14 active members; no fixed headquarters. The Society publishes anomaly maps and observation protocols at no charge to any party requesting them. The Society does not accept funding from any faction. The Society's research is supported by member contributions of 4 percent of each member's annual income. The Society has produced 24 peer-reviewed papers. The papers are not accepted by the Coalition science establishment.", discovered_via: "first_visit"),
        CodexEntry (id: "codex_org_forge_brotherhood", canonical_name: "The Forge Brotherhood", subject_id: "organization", body: "Frontier weaponsmith guild, founded 2105, specializing in custom firearms, mech-arm fabrication, and salvage-grade ammunition. 240 master smiths across 8 Frontier settlements; 1100 journeymen. The Brotherhood operates 14 forge shops, all of which produce Coalition-grade equipment from salvaged Coalition parts. The Coalition Civil Affairs office has filed 60 cease-and-desist notices since 2110; the Brotherhood has complied with 4. The remaining 56 are pending. The forges remain operational.", discovered_via: "achievement"),
        CodexEntry (id: "codex_org_verdict_court", canonical_name: "The Verdict Court", subject_id: "organization", body: "Independent court of arbitration for inter-faction commercial disputes. Constituted in 2118 at Phobos station. 7 judges drawn from neutral parties: 2 Collegium curators, 2 Ronin Hall-masters, 2 Pact ministers, and a single non-affiliated arbiter. The Court issues binding decisions on commercial matters under 4000 Concordat units in dispute value. The Court has issued 80 decisions since founding; 78 have been complied with. The 2 outliers were resolved by enforcement action from the Coalition's Civil Affairs office.", discovered_via: "first_visit"),
        CodexEntry (id: "codex_org_tempest_protocol", canonical_name: "The Tempest Protocol", subject_id: "organization", body: "Inter-faction emergency-response agreement covering Sol-zone solar-flare events. 4 signatories: Coalition, Pact, Synth Collective, Collegium. The Protocol activates when solar radiation exceeds 8 millisieverts per hour at Mars orbit. Signatories provide shelter, supplies, and medical care to any individual present on the affected world, regardless of faction affiliation. The Protocol has activated 14 times since signing. 240 individuals have been sheltered. No formal disputes have arisen. The signatories renew the Protocol every 4 years; the next renewal is 2126.", discovered_via: "achievement"),
        CodexEntry (id: "codex_org_belt_assembly", canonical_name: "The Belt Assembly", subject_id: "organization", body: "Coordinating body for Pirate, Aqueous Kindred, and independent operators across the Belt asteroids. Meets quarterly at Belt-7 station; 30 delegates; no chairman. Decisions reached by negotiated consensus; no formal voting. The Assembly handles shipping-lane allocation, water-rights disputes, and Coalition encounter protocols. The Coalition does not recognize the Assembly. The Assembly does not require recognition. The Belt operates on Assembly decisions in practice.", discovered_via: "first_visit"),
        CodexEntry (id: "codex_org_orbital_engineers", canonical_name: "Orbital Engineers Society", subject_id: "organization", body: "Professional society for space-construction engineers, founded 2099. 1100 members across all factions. Membership requires demonstrated competence in zero-g welding, life-support systems, or orbital trajectory mathematics. The Society publishes engineering standards that are recognized by the Coalition for orbital construction projects. The Society's standards committee has issued 240 standards since founding. The standards are updated continuously. The membership rate has declined 8 percent over the last 4 years due to attrition from accidents.", discovered_via: "achievement"),
        CodexEntry (id: "codex_org_red_hand_clinic", canonical_name: "The Red Hand Clinic", subject_id: "organization", body: "Independent medical-aid network operating across Frontier territory. Founded 2108 by Collegium curators in defiance of Pact health-doctrine restrictions. 14 clinics; 240 medical personnel; 1100 patient encounters per quarter. The Clinic accepts patients regardless of faction affiliation, ability to pay, or wound provenance. The Coalition occasionally subsidizes the Clinic in exchange for casualty data. The Pact considers the Clinic a heresy. The Clinic continues to operate.", discovered_via: "first_visit"),
        CodexEntry (id: "codex_org_silent_signal", canonical_name: "The Silent Signal Society", subject_id: "organization", body: "Sub-rosa communication-monitoring group with 24 active members, distributed across 8 settlements. The Society maintains continuous monitoring of all unencrypted radio traffic in the Sol system. The Society publishes weekly intelligence summaries available to subscribers at 4 Concordat units per quarter. The Coalition has 4 subscriptions; the Frontier has 8; the Pact has 1. The Society's identity remains anonymous. Members communicate exclusively through dead-drop physical mail.", discovered_via: "easter_egg"),
        CodexEntry (id: "codex_org_amber_chamber", canonical_name: "The Amber Chamber", subject_id: "organization", body: "Secret society of disaffected Coalition senior officers. Founded 2118 in response to perceived stagnation in Coalition military doctrine. 24 members; meetings held at undisclosed locations. The Chamber publishes a quarterly journal of military analysis under the pseudonym 'Veritas Anonymous'. The journal circulates among Coalition staff officers at a rate of 240 copies per issue. The Coalition has not officially acknowledged the Chamber. The Chamber has not officially acknowledged the Coalition.", discovered_via: "easter_egg"),
        CodexEntry (id: "codex_org_obsidian_council", canonical_name: "The Obsidian Council", subject_id: "organization", body: "Marauder Tribe coordinating body. Eleven Tribe-chiefs; meets at the spring and autumn equinoxes at a rotating location. The Council is informal and decisions are reached by consensus or, when consensus fails, by ritual combat. The Council has met 24 times since founding; combat has resolved 4 decisions. The Coalition considers the Council a primitive institution. The Marauders consider the Council the oldest functional government in the Sol system. Both views are correct.", discovered_via: "first_visit"),
        CodexEntry (id: "codex_org_distant_signal", canonical_name: "The Distant Signal Project", subject_id: "organization", body: "Long-range radio observation initiative seeking evidence of extra-solar intelligence. Founded 2095. 4 observation stations across the Sol system. 24 researchers; budget 240000 Concordat units per year. The Project has logged 14 unexplained signal events in 30 years of operation. Of these, 4 have been classified by Coalition Naval Intelligence; the classifications are sealed. The remaining 10 are public. The Project continues. The funding remains stable.", discovered_via: "achievement"),
        CodexEntry (id: "codex_org_ghost_freight", canonical_name: "Ghost Freight Lines", subject_id: "organization", body: "Unregistered shipping operation specializing in cargo that the Coalition has not approved for transport. 14 vessels; 240 crew; no fixed schedule. The Lines accept payment in any commodity that can be liquidated at any port. The Lines' annual revenue is estimated at 4 million Concordat units. The Coalition has interdicted 8 Lines vessels in 4 years; the interdictions have not reduced the Lines' operational tempo. The vessels are replaceable. The cargo is irreplaceable.", discovered_via: "first_visit"),
        CodexEntry (id: "codex_org_lighthouse_guild", canonical_name: "The Lighthouse Guild", subject_id: "organization", body: "Inter-faction navigation-beacon maintenance cooperative. 4 founding signatories: Coalition, Frontier, Pact, Aqueous Kindred. The Guild operates 80 navigation beacons across the Sol system. Each beacon is maintained by a 4-person crew on 14-day rotations. The Guild's mortality rate is 1.4 percent per quarter. The Guild's beacons have saved an estimated 2400 lives since founding. The Guild does not advertise. The Guild does not need to.", discovered_via: "first_visit"),
        CodexEntry (id: "codex_org_obsidian_archive_circle", canonical_name: "The Obsidian Archive Circle", subject_id: "organization", body: "Secret society within the Quietus Collegium devoted to preserving knowledge the Coalition has officially prohibited. 14 members; meetings rotate through 8 Collegium reading rooms. The Circle maintains a 4-petabyte archive of prohibited material. The Coalition is aware of the Circle's existence and tolerates it on the condition that no prohibited material enters Coalition territory. The Circle complies. The Coalition does not investigate further.", discovered_via: "easter_egg"),
        CodexEntry (id: "codex_org_orbital_jurisprudence", canonical_name: "Orbital Jurisprudence Bureau", subject_id: "organization", body: "Coalition civilian court for disputes occurring in orbital and zero-g environments. Jurisdiction extends to all Coalition-flagged vessels and stations. 14 judges; 240 staff; caseload 1100 cases per year. The Bureau is the only Coalition institution that has ruled against Coalition military authority in a Treaty matter; the ruling was 2117 case 'Bureau v Defense'. The ruling was complied with. The Bureau's reputation has been correspondingly high since.", discovered_via: "first_visit"),
        CodexEntry (id: "codex_org_red_thread_society", canonical_name: "The Red Thread Society", subject_id: "organization", body: "Informal mutual-aid network among Ronin contractors, founded 2118 after a particularly costly Writ dispute. Membership 80 active Ronin; dues 4 Concordat units per quarter. The Society maintains a casualty fund that covers a 4000-unit death benefit for any member who dies on contract. The Society has paid 24 death benefits since founding. The Society does not coordinate contracts or share Writ data. The Society exists only to bury the dead. The Ronin Halls do not interfere.", discovered_via: "achievement"),
        CodexEntry (id: "codex_org_lost_legion", canonical_name: "The Lost Legion", subject_id: "organization", body: "Veteran's mutual-aid society for Coalition troopers discharged with conditions short of full pension. Founded 2099 in a Mars-zone bar; current membership 11000 across all settlements. The Legion provides housing assistance, medical care, and burial services to members. The Legion is funded by member dues of 4 Concordat units per quarter and Coalition Civil Affairs subsidies of 240000 units per year. The subsidies are conditional on the Legion not engaging in political activity. The Legion has not engaged in political activity. The Legion's voting bloc remains coherent.", discovered_via: "first_visit"),
        CodexEntry (id: "codex_org_signal_pact", canonical_name: "The Signal Pact", subject_id: "organization", body: "Inter-faction emergency-broadcast agreement. 4 signatories: Coalition, Frontier, Pact, Synth Collective. Signatories agree to broadcast emergency signals from any party in distress on Pact-shared frequencies. The agreement has activated 240 times since signing in 2108. 4400 lives have been saved through Pact-mediated rescues. The Coalition does not always respond to Frontier signals; the Coalition response rate is 78 percent. The Frontier response rate to Coalition signals is 60 percent. The Pact response rate is 100 percent.", discovered_via: "achievement"),
        CodexEntry (id: "codex_org_blue_cipher_corp", canonical_name: "The Blue Cipher Corps", subject_id: "organization", body: "Coalition cryptanalysis unit, founded 2095. 240 personnel across 4 stations. The Corps maintains continuous monitoring of all Faction-encrypted radio traffic. The Corps has decrypted 60 percent of intercepted Pact ceremonial broadcasts and 8 percent of intercepted Husk signals. The Husk encryption is considered the highest-grade in the Sol system; the Coalition cannot decrypt it. The Corps continues to attempt decryption. The Husks continue to ignore the Corps. The signals continue to be incomprehensible.", discovered_via: "first_visit"),
        CodexEntry (id: "codex_org_ironwood_smithy", canonical_name: "The Ironwood Smithy", subject_id: "organization", body: "Frontier blacksmith collective, founded 2108 in a converted Mars-zone ore-refinery. 14 master smiths; 60 journeymen; 240 apprentices. The Smithy produces custom melee weapons, agricultural tools, and architectural ironwork. The Smithy's signature piece is the 'Ironwood blade' — a Frontier sword of 14-millimeter folded steel, hardness 60 Rockwell, weight 1.4 kilograms. The blade is the standard weapon of the Frontier Warlord Council. The Smithy has produced 11 blades for the Council since founding. The Council uses them.", discovered_via: "achievement"),
        CodexEntry (id: "codex_org_warden_band", canonical_name: "The Warden Band", subject_id: "organization", body: "Pact paramilitary order, founded 2099, charged with protecting Pact temples and ministers. 240 active wardens; 14 chapter houses; 4-year initial enlistment. Wardens carry ceremonial weapons (the Solar Brand sword) in public and serviceable weapons (Coalition-grade rifles) at need. The Band has lost 60 wardens to inter-faction conflict since founding. The Band has killed 240 enemies in the same period. The math favors the Band. The Pact considers the math evidence of divine favor. The Coalition considers the math evidence of better equipment.", discovered_via: "first_visit"),
        CodexEntry (id: "codex_org_chronicle_society", canonical_name: "The Chronicle Society", subject_id: "organization", body: "Independent historical-recording network across all factions, founded 2095. 24 members; no headquarters; documents circulated through Pact-shared communication channels. The Society publishes a quarterly historical analysis under the title 'The Chronicle'. The Chronicle has published 120 issues; circulation 4400 copies. The Society's stated goal is to record events from a neutral perspective. The neutrality is questioned by all 8 factions. The Society's record remains the most-cited source in inter-faction debates. The math is in the citations.", discovered_via: "achievement"),
        CodexEntry (id: "codex_org_quiet_pact_council", canonical_name: "The Quiet Pact Council", subject_id: "organization", body: "Informal coordinating body of Pact senior ministers, founded 2099. 11 sitting members; meetings held at irregular intervals at rotating temples. The Council establishes Pact doctrine, approves missionary missions, and reviews Pact-internal disputes. The Council's decisions are issued through silence — a ratified decision is one that has not been contradicted by any sitting Council member within 14 days of proposal. The procedure has worked for 26 years. The Coalition considers it ineffectual. The Pact considers it sufficient.", discovered_via: "first_visit"),
        CodexEntry (id: "codex_org_artemis_vault", canonical_name: "The Artemis Vault", subject_id: "organization", body: "Sub-surface seed-and-genome bank operated by the Quietus Collegium on the Moon. 14000 species archived; 4 active curators; sealed access. The Vault is the largest extant biological preservation facility in the Sol system. The Vault's existence is acknowledged but the location is classified. The Vault has been targeted twice by Pirate raiding parties; both raids failed at the outer perimeter. The Vault's seed catalog is available to any Faction requesting it. The Coalition requests it annually; the Frontier annually; the Pact never.", discovered_via: "first_visit"),
    ]
)
