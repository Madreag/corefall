CodexSection (
    schema_version: 1,
    category: "affliction",
    description: "M25A affliction codex — 30 entries. Per-affliction medical-field summary. Voice: gritty + tactical, drawn from Coalition combat-medic manual + Frontier survival diary + Pact infirmary log.",
    entries: [
        CodexEntry (id: "codex_affliction_bleeding", canonical_name: "Bleeding", subject_id: "bleeding", body: "Class A: capillary, oozing, 4 to 12 mL per minute. Survivable indefinitely with pressure. Class B: arterial, pulsating, 60 to 200 mL per minute. Fatal in 12 to 25 minutes without ligature. Class C: catastrophic, 400 mL per minute or higher, severed major vessel. Fatal in 4 to 8 minutes regardless of intervention. Coalition combat-medic doctrine focuses on slowing the loss. The Frontier solution is pressure plus patience. The Pact infirmary uses prayer with a tourniquet under it.", discovered_via: "first_use"),
        CodexEntry (id: "codex_affliction_burning", canonical_name: "Burns", subject_id: "burning", body: "First-degree: epidermal, red, painful, no blister. Second-degree: partial-thickness, blistering, intense pain. Third-degree: full-thickness, white or charred, no pain because the nerves are gone. A Coalition acid-suit protects to 4 seconds of full-flame contact; a Frontier wool coat protects to 1.4. The Pact has no recommendation; the Pact believes burns are a manifestation of impurity and prescribes silence. The silence is also therapeutic.", discovered_via: "first_use"),
        CodexEntry (id: "codex_affliction_concussed", canonical_name: "Concussion", subject_id: "concussed", body: "Mild traumatic brain injury — diffuse axonal stretch from rapid acceleration. Symptoms: nausea, confusion, photosensitivity, short-term motor coordination loss. Coalition concussion bands run Mild / Moderate / Severe / KO Imminent / Knocked Out. A trooper at Severe should not be holding a weapon. A trooper at Moderate often is, against medical advice. The advice is correct. The trooper is winning.", discovered_via: "first_use"),
        CodexEntry (id: "codex_affliction_poisoned", canonical_name: "Poisoning", subject_id: "poisoned", body: "Systemic toxin exposure: alkaloid, organophosphate, heavy-metal, biological. Coalition combat-medic kits include 4 antidotes covering 60 percent of field poisons; the remaining 40 percent get supportive care and time. The Marauder Tribes use a 6-poison rotation on their blades. The Coalition pharmacy stocks all 6 antidotes, in unequal quantities. The quantities reflect the rotation.", discovered_via: "first_use"),
        CodexEntry (id: "codex_affliction_shocked", canonical_name: "Electrical Shock", subject_id: "shocked", body: "Cardiac and skeletal-muscle disruption from current flow across the body. A 100-milliampere current across the chest induces ventricular fibrillation in 0.4 seconds. Coalition combat suits ground through the chest plate via a fuse-link rated to 220 volts; survival is statistically certain below the fuse limit. Above it, the chest plate is single-use and the trooper is hopeful. The fuse-link is the difference between a long career and a closed casket.", discovered_via: "first_use"),
        CodexEntry (id: "codex_affliction_frozen", canonical_name: "Frostbite", subject_id: "frozen", body: "Tissue freezing from prolonged cold exposure, ice-crystal formation rupturing cell membranes. Symptoms: numbness, white-waxy skin, eventual blackening. Europa surface temperatures of 100 kelvin freeze unprotected fingers in 60 seconds. Coalition cold-weather doctrine requires hourly extremity checks. The Frontier doctrine requires nothing. The Frontier survival rate is correspondingly lower. The Pact has no doctrine; the Pact has lost two ministers to Europa in the last decade.", discovered_via: "first_visit"),
        CodexEntry (id: "codex_affliction_drowning", canonical_name: "Drowning", subject_id: "drowning", body: "Aspiration of liquid into the airway, hypoxia onset in 60 seconds, irreversible neurological damage at 240 seconds. Coalition combat suits include a 14-minute emergency air bladder for submerged egress. Frontier suits include nothing. The Pirates drown each other intentionally as part of ship-discipline ritual; the discipline lasts 90 seconds and is enforced by a calibrated timer. The Pirates have not lost a deckhand to ritual in 8 years. They have lost two to error.", discovered_via: "first_use"),
        CodexEntry (id: "codex_affliction_vacuum_exposure", canonical_name: "Vacuum Exposure", subject_id: "vacuum_exposure", body: "Decompression on transit from pressurized to unpressurized environment. Ebullism at 6 kilopascals, ear-drum rupture, lung over-expansion if breath is held, consciousness loss in 14 seconds. Coalition mission planners assume 2 minutes of useful action in vacuum. Frontier salvage runs assume 90 seconds. The Pirates assume 60. Whoever assumes least gets the salvage. Whoever assumes wrong gets the cold storage.", discovered_via: "first_visit"),
        CodexEntry (id: "codex_affliction_radiation_sickness", canonical_name: "Acute Radiation Syndrome", subject_id: "radiation_sickness", body: "Cellular damage from ionizing-radiation exposure above 1 sievert acute dose. Symptoms: nausea, hair loss, hemorrhagic phase, infection susceptibility. A dose of 6 sieverts is fatal within 30 days; 8 sieverts within 14 days; 12 sieverts within 4. Coalition Hot Zone operations issue 80-millisievert mission limits. The Pact considers radiation a purification rite and exposes initiates to 2-sievert sub-lethal doses. The Pact has a 60 percent survival rate on initiation.", discovered_via: "first_visit"),
        CodexEntry (id: "codex_affliction_blinded", canonical_name: "Temporary Blindness", subject_id: "blinded", body: "Optic-nerve overload from flash, chemical irritation, or trauma. Duration 30 seconds to permanent. A Coalition flashbang induces 8 seconds of full blindness at 4 meters. Marauder torch ambushes induce 20 seconds. Pact ceremonial fires induce 30 seconds and are part of the ritual. The Pact ministers practice the recovery technique daily. The Coalition manual classifies the technique as 'unauthorized field training, do not adopt'.", discovered_via: "first_use"),
        CodexEntry (id: "codex_affliction_deafened", canonical_name: "Temporary Deafness", subject_id: "deafened", body: "Auditory-nerve overload from explosive pressure, sustained noise above 140 decibels, or stun-grenade exposure. Duration 4 minutes to permanent. Coalition troopers wear active-isolation headsets that attenuate above 110 dB but pass voice. Frontier troopers wear earplugs and hope. The Marauders use deafness as a tactical pause — the silence after the bang is when they advance. The Pact uses the same pause for the same reason. Both have an interest in the silence.", discovered_via: "first_use"),
        CodexEntry (id: "codex_affliction_g_force_blackout", canonical_name: "G-Force Blackout", subject_id: "g_force_blackout", body: "Cerebral blood pooling from sustained gravitational acceleration above 6 g. Onset 4 seconds at 9 g; 12 seconds at 6 g; permanent neurological damage above 14 g for 30 seconds. Coalition mech pilots train against blackout in a centrifuge through anti-g straining; sustained 9-g performance is achievable for 30 seconds. The Pirates fly faster than that. The Pirates also lose pilots faster than that. The economics work for them; nobody else.", discovered_via: "first_use"),
        CodexEntry (id: "codex_affliction_stunned", canonical_name: "Stun State", subject_id: "stunned", body: "Sensory and motor disruption from concussive blast, electrical pulse, or psychic-anomaly exposure. Duration 4 to 30 seconds. A stunned actor cannot fire a weapon, run, or follow orders. Coalition flashbang stun duration is calibrated to 8 seconds at 4 meters. The Marauder Tribes use thrown thunder-stones that produce 14-second stuns. The Coalition manual prefers the controlled grenade. The Marauders prefer the unscheduled one.", discovered_via: "first_use"),
        CodexEntry (id: "codex_affliction_limb_loss", canonical_name: "Limb Severance", subject_id: "limb_loss", body: "Traumatic amputation of arm, leg, hand, or foot. Coalition combat-medic kit includes a 14-second tourniquet application that arrests blood loss to a survivable Class B level. Survival rate with tourniquet: 70 percent. Without: 12 percent. The Frontier doctrine is to apply the tourniquet, then evacuate, then drink. The Pact doctrine is to apply the tourniquet, then sing the appropriate hymn, then evacuate. The Marauder doctrine is to leave the limb on the field; the Marauders consider this evidence of victory.", discovered_via: "first_use"),
        CodexEntry (id: "codex_affliction_internal_bleeding", canonical_name: "Internal Hemorrhage", subject_id: "internal_bleeding", body: "Blood loss into a body cavity from blunt or penetrating trauma. Symptoms: shock, falling pulse pressure, abdominal rigidity. Coalition combat-medic kits cannot treat internal bleeding in the field; the only intervention is rapid evacuation to a Tier 2 medical facility. Survival rate with 2-hour evacuation: 60 percent. Survival rate with 6-hour evacuation: 14 percent. The Frontier has no Tier 2 facilities. The Frontier survival rate is 8.", discovered_via: "first_kill"),
        CodexEntry (id: "codex_affliction_broken_bone", canonical_name: "Long-Bone Fracture", subject_id: "broken_bone", body: "Skeletal fracture of femur, tibia, humerus, or radius from blunt impact, high-velocity round, or fall. Coalition splints stabilize in 4 minutes; the splint is rated for 2 weeks of weight-bearing if the trooper is no heavier than 80 kilograms. The Frontier splint is whatever scrap was in the medic's pack. The Pact splint is a wooden rod and a hymn. All three work. The follow-up matters.", discovered_via: "first_use"),
        CodexEntry (id: "codex_affliction_lung_damage", canonical_name: "Pulmonary Damage", subject_id: "lung_damage", body: "Acute lung injury from chemical inhalation, blast overpressure, or fragmentation entry. Symptoms: shortness of breath, hemoptysis, pulmonary edema. Coalition combat-medic kits include a 4-hour supplemental-oxygen regulator and a chest-decompression needle; the needle saves the trooper at the cost of permanent capacity loss. The Marauder Tribes are not equipped for chest decompression. The Marauders have a 4 percent survival rate on tension pneumothorax. The Coalition rate is 60.", discovered_via: "first_kill"),
        CodexEntry (id: "codex_affliction_shock_cardiac", canonical_name: "Cardiac Arrest", subject_id: "shock_cardiac", body: "Cessation of effective heart contraction from electrical shock, severe hemorrhage, or massive blood-pressure drop. Coalition combat-medic kits include a defibrillator rated for 4 shocks at 200 joules each; the defibrillator weighs 3 kilograms and is carried by the senior medic. Frontier kits do not include a defibrillator; the Frontier solution is chest compressions until the medic gives up or the trooper recovers. Survival rate without defibrillator: 8 percent.", discovered_via: "first_kill"),
        CodexEntry (id: "codex_affliction_hunger", canonical_name: "Caloric Deficit", subject_id: "hunger", body: "Insufficient food intake. A Coalition trooper at 2000 calories per day maintains weight; at 1200 calories per day loses 0.4 kilograms per day. After 14 days of severe deficit, combat performance drops by 30 percent. Mars expedition rations are 2400 calories per day; Frontier salvage runs eat what they catch, which is often nothing. Pirates fight more often than they eat. Some Pirates have not been hungry in months because they have eaten well. Others have not been hungry in months because they have died.", discovered_via: "first_use"),
        CodexEntry (id: "codex_affliction_thirst", canonical_name: "Dehydration", subject_id: "thirst", body: "Insufficient water intake. Combat performance drops 8 percent at 2 percent body-weight loss; 30 percent at 5 percent; death at 14 percent. Coalition daily ration is 4 liters per trooper in temperate climates, 8 in desert deployment. Frontier rations are whatever fits in the canteen, which is 1.4 liters. The Pirate ships have no water rationing; the Pirates drink whatever spills or whatever they can catch in atmosphere. The Pirate dehydration rate is the highest of any faction.", discovered_via: "first_use"),
        CodexEntry (id: "codex_affliction_exhaustion", canonical_name: "Combat Exhaustion", subject_id: "exhaustion", body: "Accumulated physiological and psychological fatigue from sustained operations. After 72 hours of continuous combat, reaction time drops 40 percent, judgment errors increase 4-fold, and friendly-fire incidents triple. Coalition mission planning rotates units every 48 hours; the Frontier rotates every 96; the Pirates do not rotate. The Pirate combat-effectiveness curve is the highest of any faction in the first 24 hours and the lowest after 96.", discovered_via: "first_use"),
        CodexEntry (id: "codex_affliction_insanity", canonical_name: "Acute Psychosis", subject_id: "insanity", body: "Psychological break from sustained psy-storm exposure, ritual trauma, or prolonged isolation. Symptoms: paranoia, hallucination, motor disinhibition, hyper-vigilance. Coalition combat psychiatrists rate insanity in 4 stages: Mild (loss of focus), Moderate (visible paranoia), Severe (combat-ineffective), Acute (danger to squad). A Coalition unit at Acute is removed from the line. The removal procedure requires 4 troopers and a sedative dart. The dart is also rated for human use. The reason for the dual rating is in the manual.", discovered_via: "first_use"),
        CodexEntry (id: "codex_affliction_hypothermia", canonical_name: "Hypothermia", subject_id: "hypothermia", body: "Core body temperature below 35 Celsius from prolonged cold exposure. At 33 Celsius, shivering stops and judgment degrades. At 30 Celsius, consciousness fades. At 28 Celsius, cardiac fibrillation onset is likely. Coalition Europa-zone suits maintain core body temperature through a circulating-fluid liner powered by the suit reactor; the system fails at 70 percent suit damage. The Frontier issues thermal undergarments rated to 4 hours at minus 40. The Pirates raid Coalition suit stores.", discovered_via: "first_visit"),
        CodexEntry (id: "codex_affliction_hyperthermia", canonical_name: "Hyperthermia", subject_id: "hyperthermia", body: "Core body temperature above 39 Celsius from prolonged heat exposure or exertion in hot environments. At 40 Celsius, judgment degrades. At 41, heat-stroke onset. At 42, irreversible neurological damage. Coalition Vulcan-zone suits include a heat-exchange liner rated to 600 watts of sustained removal; the liner fails after 4 hours of operation. The Pact ministers train against heat-stroke through deliberate exposure during initiation. The Pact has a 4 percent initiation-death rate. They consider this acceptable.", discovered_via: "first_visit"),
        CodexEntry (id: "codex_affliction_decompression_sickness", canonical_name: "Decompression Sickness", subject_id: "decompression_sickness", body: "Dissolved nitrogen forming bubbles in the bloodstream after rapid ascent from a pressurized environment. Symptoms: joint pain, neurological deficit, paralysis, death. Coalition Europa-deep-water teams pre-breathe 100 percent oxygen for 14 minutes before ascent; the protocol cuts DCS rates by 80 percent. The Frontier divers don't pre-breathe; the Frontier divers have a 20-percent career mortality rate. The salvage they recover is worth it on average. The averaging is not by name.", discovered_via: "first_visit"),
        CodexEntry (id: "codex_affliction_chemical_inhalation", canonical_name: "Chemical Inhalation Injury", subject_id: "chemical_inhalation", body: "Acute lung damage from inhaled corrosive, toxic, or particulate-laden air. Coalition gas-masks rated to 50 ppm of common combat chemicals; the seal lasts 4 hours of active use. The Frontier solution is a wet rag tied over the face; the rag lasts 4 minutes against acid fume. The Pact maintains incense-burning rituals in chemically active zones; the incense neutralizes 30 percent of common toxins through coordinated breathing. The Pact rate is the highest of the three. The mechanism is unclear.", discovered_via: "first_visit"),
        CodexEntry (id: "codex_affliction_amputation_phantom", canonical_name: "Phantom-Limb Syndrome", subject_id: "amputation_phantom", body: "Persistent sensation of a severed limb after surgical amputation. Affects 80 percent of amputees within 4 weeks of injury. Coalition Veterans Service issues mirror-box therapy kits rated to reduce intensity by 40 percent over 8 weeks. The Frontier issues nothing. The Marauder Tribes ritualize phantom sensation as a sign of the lost limb's continued presence in the spirit world. The Pact treats phantom sensation as the body's prayer for its missing part. The Coalition treats it as a medical condition. All four have validity.", discovered_via: "first_kill"),
        CodexEntry (id: "codex_affliction_acid_burn", canonical_name: "Chemical Burn", subject_id: "acid_burn", body: "Tissue destruction from acid or alkali contact. Sulfuric acid 70 percent inflicts third-degree damage in 12 seconds of contact. Coalition combat suits resist 50 seconds; the Frontier rubber poncho resists 8. The Pact maintains acid-water shrines for ceremonial cleansing; the ministers handle 30 percent concentration acid daily and develop callus-equivalent dermal layers. The dermal layers are not heritable. The training is.", discovered_via: "first_use"),
        CodexEntry (id: "codex_affliction_panic", canonical_name: "Combat Panic", subject_id: "panic", body: "Acute sympathetic-nervous-system response to perceived life-threat. Symptoms: hyperventilation, motor lockup, judgment collapse. Coalition mission planners assume 4 percent of new troopers panic on first contact; the rate falls to 0.4 percent after 3 contacts. Frontier irregular forces panic at 14 percent on first contact; the rate falls to 8 after 3. The Marauders do not panic, because the Marauders do not train past the point of self-preservation. The Marauders also do not have a survival rate beyond their first 18 months.", discovered_via: "first_kill"),
        CodexEntry (id: "codex_affliction_overdose", canonical_name: "Stim Overdose", subject_id: "overdose", body: "Acute physiological collapse from excessive combat-stimulant use. Coalition issues an amphetamine-analog at 4-hour dosing; exceeding 4 doses in 14 hours produces cardiac arrhythmia, hyperthermia, and behavioral disinhibition. The Frontier salvages Coalition stims and resells them at 4 times retail; the Frontier resale customer often exceeds the dose, because the Frontier resale customer does not have a manual. The Coalition overdose rate is 0.4 percent per quarter. The Frontier rate is 14.", discovered_via: "first_use"),
    ]
)
