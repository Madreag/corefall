CodexSection (
    schema_version: 1,
    category: "anomaly_artifact",
    description: "M25A anomaly + artifact codex — 50 entries (30 anomalies + 20 artifacts). STALKER-style spatial-physics anomalies + their dropped artifacts. Voice: gritty + tactical + slightly noir. Field-report tone.",
    entries: [
        CodexEntry (id: "codex_anomaly_gravity_well", canonical_name: "Anomaly — Whirligig", subject_id: "anomaly_gravity_well", body: "Local gravity inversion field, 3 to 4 meter diameter, draws nearby mass to its center then ejects at terminal velocity along a randomized vector. Standard detection: a bolt thrown into the field arcs sharply. Coalition lost a full squad to a Whirligig on the Mars-Phobos ferry in 2117; AAR classified them KIA-anomaly. Approach within 12 meters at your own discretion. Withdraw at the first thrown-bolt arc. Survivors say it sounds like a refrigerator that needs replacing.", discovered_via: "first_visit"),
        CodexEntry (id: "codex_anomaly_electric_arc", canonical_name: "Anomaly — Electro", subject_id: "anomaly_electric_arc", body: "Static-discharge field, audible hum at 60 hertz, will arc to any conductor within 4 meters. Discharge potential up to 200 kilovolts at 80 amperes for 0.4 seconds. Coalition trooper armor grounds harmlessly through a fuse-link in the chest plate; the trooper survives but the chest plate is now a single-use item. The Frontier solution is rubber-soled boots and a prayer. Both work. Only one is replicable.", discovered_via: "first_visit"),
        CodexEntry (id: "codex_anomaly_time_warp", canonical_name: "Anomaly — Chronos Eddy", subject_id: "anomaly_time_warp", body: "Localized temporal distortion, slows or accelerates time within a 6-meter sphere. Coalition Survey Team Theta-3 reported a sustained 4-to-1 time dilation for 14 minutes inside a Vulcan caldera in 2123. The team aged 14 minutes; the rest of the operation aged 56. Personal effects emerged out-of-sync with the universe. Watches stopped. Cigarettes resumed burning at the wrong speed. The team requested transfer; the Coalition declined.", discovered_via: "first_visit"),
        CodexEntry (id: "codex_anomaly_chemical_pool", canonical_name: "Anomaly — Witches Brew", subject_id: "anomaly_chemical_pool", body: "Self-mixing chemical pool, composition shifts on contact with foreign matter. Approach in standard gear and the pool reads as inert; approach in a Coalition acid-spec suit and the pool becomes acid; approach in a Frontier flame-resistant poncho and the pool becomes solvent. The pool appears to identify the suit and produce its counter-agent. The mechanism is unclassified. The recommendation is to approach in something the pool has never seen.", discovered_via: "first_visit"),
        CodexEntry (id: "codex_anomaly_psy_storm", canonical_name: "Anomaly — Psy Storm", subject_id: "anomaly_psy_storm", body: "Localized neurological interference field, 50 to 200 meter radius, induces vivid auditory hallucinations and short-term motor confusion in unprotected actors. Coalition issues lead-lined helmet liners for rated zones; the liners cut the effect by 70 percent. The Marauder Tribes hold initiation rites inside Psy Storm fringes. Survivors of the rite are considered Wind-Touched and given a stripe of paint across the eyes. Most do not survive.", discovered_via: "first_visit"),
        CodexEntry (id: "codex_anomaly_bloodsucker_zone", canonical_name: "Anomaly — Hollow Zone", subject_id: "anomaly_bloodsucker_zone", body: "Region of localized sensory dampening. Audio levels drop by 18 decibels inside the zone; visual contrast flattens; thermal imaging fails. A non-anomaly creature inside the zone is functionally cloaked from any sensor that crosses the boundary. The zones are typically 8 to 12 meters across. The Marauder Tribes use them as ambush points. The Coalition issues counter-sensors that cost more than a chassis. The counter-sensors work on the second pass. Not the first.", discovered_via: "first_visit"),
        CodexEntry (id: "codex_anomaly_acid_geyser", canonical_name: "Anomaly — Acid Geyser", subject_id: "anomaly_acid_geyser", body: "Periodic subsurface vent ejecting concentrated acid spray to a height of 6 to 12 meters. Cycle period 45 to 90 seconds. Eruption duration 4 to 8 seconds. Coalition geological surveys map these on the Venus surface and on three Mars crater rims; the Frontier salvage routes ignore the maps. Salvage tonnage recovered near a Geyser per quarter: 14 tonnes. Salvager casualties per quarter: 11. The math is published.", discovered_via: "first_visit"),
        CodexEntry (id: "codex_anomaly_freezing_pool", canonical_name: "Anomaly — Cold Spot", subject_id: "anomaly_freezing_pool", body: "Spatial volume maintaining a temperature 200 kelvin below ambient. Found on Europa subsurface and twice in the Sol-zone deep-cooling stations. An actor stepping into a Cold Spot loses 4 degrees Celsius of core body temperature per second of contact. A Coalition trooper has 3 seconds before motor function degrades. A Frontier scavenger in unsealed gear has 1. The recovery time on the body is measured in days. The recovery time on the gear is measured in 'never'.", discovered_via: "first_visit"),
        CodexEntry (id: "codex_anomaly_thermal_burner", canonical_name: "Anomaly — Burner", subject_id: "anomaly_thermal_burner", body: "Hot-air column rising from a fixed point, surface temperature 800 to 1100 Celsius, column diameter 1 to 2 meters, column height up to 15 meters. Coalition thermal sensors detect at 80 meters. A Burner ignites loose fabric in 0.4 seconds and ammunition cookoff in 6. The Vulcan basaltic flats have 40 active Burners per square kilometer. The Marauders use them to refine scavenged metals. They also use them to dispose of evidence.", discovered_via: "first_visit"),
        CodexEntry (id: "codex_anomaly_springboard", canonical_name: "Anomaly — Springboard", subject_id: "anomaly_springboard", body: "Localized gravity inversion that ejects any mass crossing the boundary at 12 to 30 meters per second upward. Coalition mech operators have learned to step onto Springboards intentionally for vertical insertion. The technique is called 'bounce-and-stick' in the manual. Casualty rate per attempt: 11 percent. Casualty rate per successful insertion: 2 percent. The math is in favor of the second number. Most trooper careers end at the first.", discovered_via: "first_visit"),
        CodexEntry (id: "codex_anomaly_vortex", canonical_name: "Anomaly — Vortex", subject_id: "anomaly_vortex", body: "Rotating low-pressure cell, draws in nearby mass on a tangential vector, accelerates to lethal velocity within a 6-meter radius, then collapses to a point. Survival is impossible for organic actors caught inside. Coalition records 27 confirmed Vortex events across all habitable worlds. Of these, 24 occurred on the Vulcan surface and 3 on the Belt asteroid Theta. The remains are recovered as a fine red dust at the center of the collapse zone. Honors are mailed.", discovered_via: "first_visit"),
        CodexEntry (id: "codex_anomaly_silence_field", canonical_name: "Anomaly — Silence", subject_id: "anomaly_silence_field", body: "Localized sound-cancellation field. Inside the boundary all audio is dampened by 40 decibels; explosives detonate but produce no audible report; voices are inaudible at 2 meter distance. The Marauder Tribes call them 'church zones' and conduct executions inside them. Coalition combat doctrine requires entry into a Silence Field in single file at hand-signal protocol. Most Coalition troopers refuse the order. The few who comply do not refuse a second time.", discovered_via: "first_visit"),
        CodexEntry (id: "codex_anomaly_mirage", canonical_name: "Anomaly — Mirage", subject_id: "anomaly_mirage", body: "Visual interference field. Inside the boundary, optical and infrared sensors return false images of nearby terrain. A Coalition trooper standing in a Mirage sees an empty corridor where a wall is; a Mirage with a thermal feed reads it as warm. The Mirage is detectable only by feel — the air inside reads 4 degrees colder than ambient. Coalition tactical operating procedure includes a 'walk and reach' technique. The technique works. The training accidents are recorded separately.", discovered_via: "first_visit"),
        CodexEntry (id: "codex_anomaly_emp_pulse", canonical_name: "Anomaly — Pulse", subject_id: "anomaly_emp_pulse", body: "Spontaneous electromagnetic pulse, peak field strength 30 kilovolts per meter at the boundary, duration 0.4 milliseconds, recurrence period 30 to 600 seconds. Will disable any unshielded electronic device within a 20-meter sphere. Coalition mech operators learn to recognize the precursor reading on the gauss meter; recovery from a chassis hit takes 8 seconds of manual reboot. The Marauders use Pulses to disable Coalition pickets before raids. The pickets used to be paid more.", discovered_via: "first_visit"),
        CodexEntry (id: "codex_anomaly_psy_silence", canonical_name: "Anomaly — Quiet", subject_id: "anomaly_psy_silence", body: "Localized mental dampening; thoughts become slower and decisions feel weightless within the field. Coalition lab observations describe it as a 'cotton-headed clarity'. Combat performance inside a Quiet field drops by 30 percent for unprepared operators and rises by 15 percent for trained ones. The training takes 8 weeks and a 6 percent dropout rate. The Quietus Archive considers these fields sacred and stages contemplation rituals inside them.", discovered_via: "first_visit"),
        CodexEntry (id: "codex_anomaly_radiation_hotzone", canonical_name: "Anomaly — Hot Zone", subject_id: "anomaly_radiation_hotzone", body: "Localized region of ionizing radiation, dose rate up to 12 sieverts per hour at the center. Lethal exposure in 4 minutes for an unprotected human. Coalition radiation suits buy 45 minutes; the Frontier lead-lined poncho buys 6. The Pripyat Strain bioform thrives inside Hot Zones at 30 sieverts per hour. The bioform is not native to any known world. The Coalition manual classifies it as 'anomalous biology'. The manual does not classify it further.", discovered_via: "first_visit"),
        CodexEntry (id: "codex_anomaly_bullet_pull", canonical_name: "Anomaly — Lodestone", subject_id: "anomaly_bullet_pull", body: "Strong static magnetic field, field strength up to 4 tesla at the center, will pull ferrous ammunition off-axis within an 8-meter sphere. A Coalition 5.56 round fired through a Lodestone field drops 30 centimeters at 20 meters. Marauder snipers use Lodestones to negate Coalition long-range advantages. Coalition snipers carry copper-jacketed brass-core rounds at field rates of 1 in 80. The cost differential is 12 to 1. The hit-rate differential is the same.", discovered_via: "first_visit"),
        CodexEntry (id: "codex_anomaly_blood_rain", canonical_name: "Anomaly — Red Rain", subject_id: "anomaly_blood_rain", body: "Sporadic precipitation event, droplets are 99 percent water plus 1 percent organic compounds including hemoglobin-fragment proteins. Coalition labs cannot identify the source biology. The droplets stain skin and fabric the same way blood does and do not wash out. The Husks consider Red Rain a sign of approval. The Pact considers it a sign of judgment. The Coalition considers it a sign of unidentified atmospheric biology and issues ponchos.", discovered_via: "first_visit"),
        CodexEntry (id: "codex_anomaly_static_dust", canonical_name: "Anomaly — Static Cloud", subject_id: "anomaly_static_dust", body: "Suspended particulate cloud holding a high electrostatic charge. Walking through it induces a 4-kilovolt discharge across the suit, blanks all helmet electronics for 8 seconds. The Mars surface has 200 such clouds per square kilometer during the spring dust season. Coalition mech operators rate them as a tier-2 hazard. Frontier civilians use them as power sources by draping a Tesla coil through the cloud. The coils last 6 months. The civilians last longer than that.", discovered_via: "first_visit"),
        CodexEntry (id: "codex_anomaly_ground_quiver", canonical_name: "Anomaly — Quiver", subject_id: "anomaly_ground_quiver", body: "Subsurface harmonic resonance, ground vibrates at 14 hertz across a 30-meter ring. The vibration is at the edge of human perceptual threshold and induces nausea, disorientation, and bowel evacuation in 8 minutes of standing exposure. Coalition special teams use Quiver fields as natural perimeter alarms; the trooper on watch knows when something has wandered in by the smell. The Marauder Tribes train children to walk through Quivers without flinching. Most pass.", discovered_via: "first_visit"),
        CodexEntry (id: "codex_anomaly_invisible_wall", canonical_name: "Anomaly — Glass Wall", subject_id: "anomaly_invisible_wall", body: "Spatial barrier with no visible manifestation but absolute mechanical resistance. Will stop a 5.56 round, a chassis at full sprint, and a Coalition demolition charge of 4 kilograms TNT-equivalent. The wall is 30 centimeters thick at the median. Coalition geological surveys have mapped 14 Glass Walls across the Sol system. Each survey ends with a different number. The Walls move. Or the maps are wrong.", discovered_via: "first_visit"),
        CodexEntry (id: "codex_anomaly_drone_swarm_eddy", canonical_name: "Anomaly — Swarm Eddy", subject_id: "anomaly_drone_swarm_eddy", body: "Persistent low-altitude air current that captures and accelerates micro-drones into orbital trajectories within a 200-meter cone. Coalition reconnaissance drone losses to Swarm Eddies in 2122 totalled 380 units. The Eddies appear over Vulcan and the upper Belt asteroids without warning and last for 4 to 12 hours. Frontier scavengers harvest the captured drone payloads after the Eddy collapses. The payload-to-loss ratio favors the scavengers.", discovered_via: "first_visit"),
        CodexEntry (id: "codex_anomaly_temperature_shimmer", canonical_name: "Anomaly — Shimmer", subject_id: "anomaly_temperature_shimmer", body: "Thermal-gradient column producing visible heat haze without an apparent heat source. The column reads 4 degrees Celsius cooler than ambient on a thermometer but 40 degrees hotter on infrared imaging. The contradiction has never been resolved. Coalition thermal sensors are calibrated to report a Shimmer as an alert flag, not as a target. The Pact maintains a permanent observation post over the Vulcan Shimmer field. The post is staffed by volunteers. There has not been a shortage.", discovered_via: "first_visit"),
        CodexEntry (id: "codex_anomaly_oxygen_pocket", canonical_name: "Anomaly — Oxygen Pocket", subject_id: "anomaly_oxygen_pocket", body: "Spontaneous high-oxygen-content air mass, 35 to 40 percent O2, formation mechanism unknown. Coalition Mars surveyors have mapped 12 Oxygen Pockets across the Tharsis quadrangle. An unprotected actor breathing inside a Pocket experiences mild euphoria for the first 4 minutes and pulmonary toxicity at 60 minutes. The Frontier sells Pocket air as a recreational substance at 8 Concordat units per breath. The Coalition has not prohibited the trade. The Coalition does not approve.", discovered_via: "first_visit"),
        CodexEntry (id: "codex_anomaly_gravity_lull", canonical_name: "Anomaly — Lull", subject_id: "anomaly_gravity_lull", body: "Localized gravity reduction, surface acceleration 0.4 g inside the 8-meter sphere. An actor stepping into a Lull experiences 60 percent reduction in fall damage and 40 percent increase in jump height. Coalition special-forces tactical doctrine includes Lull-jump insertion techniques. The technique has a 6-meter horizontal reach. It also has a 22 percent landing-injury rate. The injury rate decreases with practice. The number of practitioners decreases too.", discovered_via: "first_visit"),
        CodexEntry (id: "codex_anomaly_husk_growth", canonical_name: "Anomaly — Bloom", subject_id: "anomaly_husk_growth", body: "Crystalline biomass nodule, slow-growing, indigenous to Husk territory, will spread across surfaces at 4 centimeters per hour given contact with organic matter. The Bloom secretes a neurotoxin that paralyzes adjacent organic tissue without killing it. Coalition Husk-zone operations require flame-clearance every 12 hours; the Frontier just abandons any building a Bloom reaches. The recommendation in both cases is to not let the Bloom reach the building.", discovered_via: "first_visit"),
        CodexEntry (id: "codex_anomaly_neural_buzz", canonical_name: "Anomaly — Buzz", subject_id: "anomaly_neural_buzz", body: "Localized neural interference field, induces involuntary muscle tremor in any organic actor within 14 meters. Tremor amplitude is enough to disable fine motor control; firing accuracy drops to 30 percent of baseline. Coalition issues anti-tremor pharmaceuticals to its sniper teams in Buzz-mapped territory; the drug works for 4 hours and produces side effects that include sustained mood elevation. The drug is controlled at Concordat priority level 2.", discovered_via: "first_visit"),
        CodexEntry (id: "codex_anomaly_iron_skin", canonical_name: "Anomaly — Iron Skin", subject_id: "anomaly_iron_skin", body: "Slow-acting metallic film deposition on any organic actor that lingers in the 12-meter field for more than 30 minutes. The film thickens to 4 millimeters of pure iron over 4 hours of exposure. Coalition lab studies on volunteer-test cycles show the film provides 8 megapascals of additional ballistic resistance. It also restricts joint mobility by 60 percent and is non-removable without surgical means. The Pact has six willing volunteers. They are referred to as the Iron Cohort.", discovered_via: "first_visit"),
        CodexEntry (id: "codex_anomaly_dead_air", canonical_name: "Anomaly — Dead Air", subject_id: "anomaly_dead_air", body: "Localized vacuum pocket at standard pressure. The 6-meter sphere reads as 0 kilopascals on a barometer but as 101 on a touch. Stepping inside results in immediate decompression decompression-equivalent symptoms — nitrogen narcosis, ear-drum rupture, lung over-expansion if you exhale on entry. Coalition pressure-suit operators wear external manometers calibrated to disagree with helmet sensors; the disagreement is the alarm. The training manual is 8 pages long.", discovered_via: "first_visit"),
        CodexEntry (id: "codex_anomaly_signal_amplifier", canonical_name: "Anomaly — Echo Field", subject_id: "anomaly_signal_amplifier", body: "Electromagnetic signal amplification field, boosts any radio transmission inside the 80-meter zone by 14 decibels. Coalition reconnaissance units intentionally enter Echo Fields to broadcast distress signals; the boost extends signal range from 4 kilometers to 30. The Echo Field also amplifies enemy signals, which is how the Marauder Tribes detected the Coalition Phobos relay in 2120. The relay was destroyed within the hour. The Coalition rebuilt it outside the field.", discovered_via: "first_visit"),
        CodexEntry (id: "codex_artifact_void_gem", canonical_name: "Artifact — Void Gem", subject_id: "artifact_void_gem", body: "Dense crystalline nodule recovered from Whirligig anomaly cores. Mass 240 grams; volume 14 cubic centimeters; density 17 grams per cubic centimeter, denser than osmium. Worn close to the body, the gem reduces inertial response to sudden acceleration — the wearer is harder to knock down. Coalition lab measurement: 18 percent inertial-multiplier reduction. Black market price on Phobos: 22000 Concordat units. Coalition seizure log notes 8 confirmed Void Gems in private collections.", discovered_via: "first_kill"),
        CodexEntry (id: "codex_artifact_dense_marble", canonical_name: "Artifact — Dense Marble", subject_id: "artifact_dense_marble", body: "Smooth obsidian-black sphere harvested from collapsed Vortex fields, diameter 4 centimeters, mass 180 grams. Worn on a chain around the neck. Adds a constant 1.2 kilogram load to the wearer's center of mass; this stabilizes recoil response on shoulder-fired weapons by 14 percent. The Marauders consider the Marble a sign of veterancy; a war-chief is expected to carry at least three. The Coalition lab manual classifies the Marble as 'recoil compensation device, unauthorized'.", discovered_via: "first_kill"),
        CodexEntry (id: "codex_artifact_collapse_seed", canonical_name: "Artifact — Collapse Seed", subject_id: "artifact_collapse_seed", body: "Compressed-state matter, the size of a thumbnail, the mass of a small car. Recovered from the eye of a fully-collapsed Vortex anomaly. Cannot be moved by hand; requires a hover-cradle. A Collapse Seed inside a chassis chest cavity grants 4 megapascals of additional ballistic resistance and reduces chassis mobility by 80 percent. There are 6 known Seeds. The Coalition has 4. The Pact has 1. The location of the 6th is the subject of a long-standing dispute that has so far cost three lives.", discovered_via: "first_kill"),
        CodexEntry (id: "codex_artifact_storm_battery", canonical_name: "Artifact — Storm Battery", subject_id: "artifact_storm_battery", body: "Electrical storage cell harvested from Electro anomaly cores. Capacity 4 kilowatt-hours in a 200-gram package — energy density 200 times conventional lithium. Holds charge indefinitely without leakage. Coalition power-cell rationing on Mars makes a Storm Battery worth 11 standard cells on the open market. The Frontier sometimes sells fakes. The fakes weigh 800 grams and explode on the third charge cycle. Buyers learn to bring a precision scale.", discovered_via: "first_kill"),
        CodexEntry (id: "codex_artifact_lightning_pendant", canonical_name: "Artifact — Lightning Pendant", subject_id: "artifact_lightning_pendant", body: "Metallic disc harvested from Electro anomaly fringes, surface plays a continuous 4-microampere static-discharge crackle. Worn around the neck, the Pendant grounds incoming electrical attacks through a fuse-link to atmosphere — at the cost of frying the Pendant on the third major hit. A Pact warden field-trial in 2121 produced 14 Pendant-wearers and 11 returned with intact Pendants. The third hit always wins.", discovered_via: "first_kill"),
        CodexEntry (id: "codex_artifact_chronos_shard", canonical_name: "Artifact — Chronos Shard", subject_id: "artifact_chronos_shard", body: "Crystalline sliver from a Chronos Eddy anomaly, length 4 centimeters, refracts light at a 14-degree wavelength shift not predicted by ordinary optics. Carried in a pocket, the Shard induces a 1.6-percent subjective time-dilation in the carrier — reflexes feel faster by a margin that matters in close combat. Coalition lab cannot reproduce the effect under controlled conditions. The Shard is removed from the wearer for the test. The effect remains.", discovered_via: "first_kill"),
        CodexEntry (id: "codex_artifact_lockwork_gear", canonical_name: "Artifact — Clockwork Gear", subject_id: "artifact_lockwork_gear", body: "Brass-and-steel mechanism the size of a coin, harvested from Chronos Eddy fringes, internal mechanism continues to rotate without external power source. Mechanism speed varies by ambient time-anomaly density. Carried in a pouch, the Gear maintains synchronization with chronometers across long deployments — a Coalition mech operator carrying the Gear can rejoin a synchronized op after 8 hours of dilation exposure without re-sync delay. Eleven known. Six in Coalition custody. Five missing.", discovered_via: "first_kill"),
        CodexEntry (id: "codex_artifact_acid_pearl", canonical_name: "Artifact — Acid Pearl", subject_id: "artifact_acid_pearl", body: "Iridescent green orb harvested from Witches Brew anomaly pools, diameter 3 centimeters, surface continuously secretes a neutralizing alkaline coating. Held against an acid wound, the Pearl neutralizes pH at the contact point in 14 seconds. Coalition combat-medic kits include synthetic equivalents at 4 Concordat per dose; a genuine Pearl on the black market goes for 6000. The synthetic equivalent works on most acids. The Pearl works on all of them.", discovered_via: "first_kill"),
        CodexEntry (id: "codex_artifact_solvent_globule", canonical_name: "Artifact — Solvent Globule", subject_id: "artifact_solvent_globule", body: "Translucent gel harvested from Witches Brew pools, semi-stable across 4-day storage. A globule applied to a solid surface dissolves a 12-centimeter-diameter, 4-centimeter-deep section in 8 seconds. Coalition combat engineers use Globules for silent breaching; the dissolution produces a low hiss but no smoke or light. Globules degrade rapidly; field carry duration is 72 hours from harvest. The Frontier black market price reflects the perishability.", discovered_via: "first_kill"),
        CodexEntry (id: "codex_artifact_psy_amulet", canonical_name: "Artifact — Psy Amulet", subject_id: "artifact_psy_amulet", body: "Smooth river-stone harvested from Psy Storm fringes, surface engraved by some process not yet identified, engravings change subtly between observations. Worn on a chain, the Amulet reduces hallucination intensity inside Psy Storm fields by 60 percent. Coalition Psy Storm operations issue lead-lined helmet liners as standard; the Amulet is unofficial gear traded between operators. The Coalition manual does not acknowledge the Amulet. The operators do.", discovered_via: "first_kill"),
        CodexEntry (id: "codex_artifact_hollow_idol", canonical_name: "Artifact — Hollow Idol", subject_id: "artifact_hollow_idol", body: "Bone-and-resin figurine harvested from Hollow Zone interiors, height 14 centimeters, weight 80 grams. Carried in a pouch, the Idol projects a 3-meter sphere of sensor-blanking equivalent to a low-grade Hollow Zone effect. The wearer is harder to detect by infrared, audio, and motion sensors. Coalition counter-stealth doctrine treats Idol-wearers as visual-confirmed-only targets. The Frontier issues Idols to its scout platoons. The Pirates steal Idols at a rate of 14 per quarter.", discovered_via: "first_kill"),
        CodexEntry (id: "codex_artifact_predator_fang", canonical_name: "Artifact — Predator Fang", subject_id: "artifact_predator_fang", body: "Curved tooth-shaped artifact harvested from Bloom anomaly cores, length 8 centimeters, edge sharper than honed steel. Used as a melee implement, the Fang inflicts wounds that resist coagulation — Coalition autopsies of Fang-wound victims show 4 times normal blood-loss rates. The Marauder Tribes mount Fangs on staffs as a sign of office. A war-chief with three Fangs is considered established. A war-chief with five is considered fated.", discovered_via: "first_kill"),
        CodexEntry (id: "codex_artifact_blood_marble", canonical_name: "Artifact — Blood Marble", subject_id: "artifact_blood_marble", body: "Deep-red translucent sphere harvested from Red Rain saturation zones, diameter 3 centimeters, internal fluid continues to circulate without an external pump. Carried close to the body, the Marble enhances the wearer's natural clotting response — a Coalition trooper carrying a Marble survives a Class B blood-loss event at a 40-percent improved rate. The Marble is dependent on the wearer being uninjured at the moment of injury. Once damaged, the effect ceases until the Marble has rested for 14 days.", discovered_via: "first_kill"),
        CodexEntry (id: "codex_artifact_gun_oil", canonical_name: "Artifact — Eternal Oil", subject_id: "artifact_gun_oil", body: "Amber liquid harvested from a never-identified anomaly type, sealed in a small steel canister. Composition: predominantly long-chain hydrocarbons with 4 percent trace elements not on the periodic table. Applied to a weapon action, the Oil grants 4 times normal cleaning-cycle longevity. A Coalition rifle treated with Eternal Oil maintains zero-jam performance for 4000 rounds without re-oiling. Canisters are found at a rate of 2 per Concordat quarter and trade for 8000 units each.", discovered_via: "first_kill"),
        CodexEntry (id: "codex_artifact_lucky_die", canonical_name: "Artifact — Lucky Die", subject_id: "artifact_lucky_die", body: "Six-sided die carved from an unidentified white crystal, edge length 14 millimeters. Rolled in advance of a tactical decision, the Die produces outcomes that subtly favor the roller — over a 30-roll sample, the favorable outcome rate is 58 percent, against a baseline of 50. The effect is statistically significant. The mechanism is not. The Marauder Tribes carry Lucky Dice on chains. The Coalition has confiscated 14 in evidence custody and rolls them at staff briefings.", discovered_via: "easter_egg"),
        CodexEntry (id: "codex_artifact_iron_will", canonical_name: "Artifact — Iron Will", subject_id: "artifact_iron_will", body: "Iron-bound book of Husk origin, pages contain text in an unknown script. Reading the book for 14 days produces a measurable increase in the reader's psychological pain threshold — Coalition operators carrying the Will report 30 percent less subjective pain response to wounds rated at Class A. The Will weighs 3 kilograms. It does not improve combat performance. It does improve survivability after the fact. The Pact assigns the Will to its post-trauma recovery cells.", discovered_via: "first_kill"),
        CodexEntry (id: "codex_artifact_cryo_pearl", canonical_name: "Artifact — Cryo Pearl", subject_id: "artifact_cryo_pearl", body: "Pale-blue spherical artifact harvested from Cold Spot anomaly fringes, surface temperature 220 kelvin, sustains the temperature indefinitely. Held against burn wounds, the Pearl arrests thermal damage propagation and slows tissue death. Carried at the small of the back, the Pearl cools the carrier by 4 degrees Celsius — useful in Vulcan-zone deployment, dangerous in Europa-zone. The Coalition issues Cryo Pearls as standard gear in Tharsis-rated kits. The price reflects rarity.", discovered_via: "first_kill"),
        CodexEntry (id: "codex_artifact_pyro_pearl", canonical_name: "Artifact — Pyro Pearl", subject_id: "artifact_pyro_pearl", body: "Pale-red spherical artifact harvested from Burner anomaly fringes, surface temperature 380 kelvin, sustains the temperature indefinitely. Held against frost wounds, the Pearl reverses tissue freezing and restores circulation. Carried in a pouch, the Pearl warms the carrier by 4 degrees Celsius — essential in Europa-zone deployment, dangerous in Vulcan-zone. Frontier salvage runs trade Cryo Pearls for Pyro Pearls at 1-to-1; the trades happen at the cargo bay door, never in the office.", discovered_via: "first_kill"),
        CodexEntry (id: "codex_artifact_void_lens", canonical_name: "Artifact — Void Lens", subject_id: "artifact_void_lens", body: "Glass-and-metal lens harvested from Dead Air anomaly boundaries, refracts light at angles that change with the observer's velocity. Mounted in a Coalition sniper scope, the Lens grants a 4-percent improvement in long-range accuracy at distances over 600 meters. The improvement is observable but not reproducible in lab settings; the lens reads inert when measured. The scope reads improved when fired. The math is in the hits.", discovered_via: "first_kill"),
        CodexEntry (id: "codex_artifact_swift_step", canonical_name: "Artifact — Swift Step", subject_id: "artifact_swift_step", body: "Pair of small bronze ornaments worn on the boots, harvested from Springboard anomaly fringes, surface temperature reads 4 degrees cooler than ambient regardless of conditions. The Step ornaments grant a 14-percent reduction in foot-impact force and a corresponding extension of stamina range. Coalition special-forces field trials show a 4 percent improvement in 10-kilometer time-to-arrive metrics. The Step is issue gear for Coalition recon teams in 2124.", discovered_via: "first_kill"),
        CodexEntry (id: "codex_artifact_silent_step", canonical_name: "Artifact — Silent Step", subject_id: "artifact_silent_step", body: "Pair of black-felt sole inserts harvested from Silence Field interiors, fabric absorbs 18 decibels of footstep sound without other observable effect. Coalition stealth operations issue the Silent Step to scouts and assassins; the insert lasts 80 hours of active use before the absorbent capacity is saturated and the insert reverts to ordinary cloth. The saturation process is irreversible. The supply chain is correspondingly tight.", discovered_via: "first_kill"),
        CodexEntry (id: "codex_artifact_compass_oddly", canonical_name: "Artifact — Anomaly Compass", subject_id: "artifact_compass_oddly", body: "Brass instrument the size of a pocket watch, harvested from never-identified anomaly type. The needle points consistently at the nearest active anomaly within a 200-meter radius. The Compass is the most useful navigation tool for any survey team that needs to locate and avoid anomaly fields. There are 4 known Compasses. Coalition Survey Service has one. The Frontier has one. The Pact has one. The fourth is unaccounted for and the Coalition wants it back.", discovered_via: "first_kill"),
        CodexEntry (id: "codex_artifact_sunfire_relic", canonical_name: "Artifact — Sunfire Relic", subject_id: "artifact_sunfire_relic", body: "Crystalline cylinder harvested from Sol-zone artifact-density-spike zones. Continuously emits visible-spectrum light at lumen output equivalent to a 40-watt incandescent bulb, no power source detected. Carried by hand, the Relic illuminates a 6-meter sphere. The Pact considers Sunfire Relics blessed objects and incorporates them into ceremonial robes. The Coalition catalogues them as 'light source, unknown mechanism, do not disassemble' and reports indicate 14 attempts at disassembly. All 14 attempts ended.", discovered_via: "first_kill"),
    ]
)
