CodexSection (
    schema_version: 1,
    category: "vehicle_weapon",
    description: "M25A vehicle + weapon codex — 60 entries (30 vehicle history entries + 30 weapon lore entries). Per-archetype design + service history + field reputation. Voice: gritty + tactical + Coalition technical-manual cadence.",
    entries: [
        CodexEntry (id: "codex_vehicle_corp_apc_treaded", canonical_name: "Coalition APC — Mk IV Treaded", subject_id: "corp_apc_treaded", body: "Coalition standard tracked armored personnel carrier, in service since 2104. Mass 14 tonnes; carries 8 troopers plus 2 crew. Armor: 14 millimeters rolled steel, slope-faced, defeats 5.56 at 60 meters and 7.62 at 80. Main armament: a single hull-mounted 12.7 MG with 800 rounds. Diesel-electric drive at 60 kilowatts. Range 240 kilometers on internal fuel. The Mk IV has been used in 24 named Coalition operations and lost in 8 of them. The pattern of loss is not random; the Mk IV's flaw is a fuel-tank vulnerability that hasn't been redesigned because the cost would exceed retirement.", discovered_via: "first_use"),
        CodexEntry (id: "codex_vehicle_corp_supply_truck", canonical_name: "Coalition Supply Truck", subject_id: "corp_supply_truck", body: "Coalition six-wheel logistics platform, in service since 2099. Mass 8 tonnes empty, 18 tonnes loaded; flat bed plus slatted side armor. Armor adequate against rifle-caliber rounds at 80 meters; defeats explosive fragments to 4 grams TNT-equivalent. Diesel-electric drive at 80 kilowatts. Range 400 kilometers loaded. The Supply Truck is the most common Coalition vehicle in the Mars theater; the fleet numbers 1100 active. Maintenance cost per quarter: 240 Concordat units per truck. The trucks are also the most common Marauder target. The Coalition replaces them faster than the Marauders destroy them.", discovered_via: "first_use"),
        CodexEntry (id: "codex_vehicle_corp_tank_light", canonical_name: "Coalition Light Tank — Mk III", subject_id: "corp_tank_light", body: "Coalition main battle tank, light class, in service since 2114. Mass 24 tonnes; 4-crew; tracked. Main armament: a 90-millimeter low-velocity gun with 30 rounds. Secondary: coaxial 7.62 MG and pintle-mount 12.7. Armor: 30 millimeters sloped on the front aspect, 14 on the sides. The Mk III is the Coalition's primary armor for Mars surface combat. Engaged the Frontier in 4 named operations between 2118 and 2123; lost 14 tanks across all operations. Engagement effectiveness rated 60 percent against Frontier irregular armor and 80 percent against Marauder infantry.", discovered_via: "first_use"),
        CodexEntry (id: "codex_vehicle_resistance_pickup", canonical_name: "Frontier Combat Pickup", subject_id: "resistance_pickup", body: "Frontier ad-hoc armored pickup truck, in service since 2104, no standardized variant. Typical configuration: 4-wheel drive, welded plate armor, mounted gun ring (typically a Coalition-salvaged 12.7 MG or a Frontier-fabricated 7.62 MG). Crew 4. The vehicle is the Frontier's primary combat platform; the Frontier fields an estimated 800 active pickups. Maintenance is the responsibility of the crew; the Frontier does not provide depot-level support. The Coalition has been able to destroy approximately 240 Frontier pickups per quarter; the Frontier has been able to fabricate approximately 280. The trend favors the Frontier.", discovered_via: "first_use"),
        CodexEntry (id: "codex_vehicle_resistance_buggy", canonical_name: "Frontier Combat Buggy", subject_id: "resistance_buggy", body: "Frontier open-frame combat buggy, in service since 2110. Mass 800 kilograms; 4-wheel drive; roll cage; mounted gun (typically a salvaged Coalition automatic rifle). Crew 2 to 4. The buggy is the Frontier's primary reconnaissance platform; the Frontier fields an estimated 1100 active buggies. The buggy is fast (top speed 80 kilometers per hour on hard pack), agile, and lightly armored (defeats only handgun rounds). The Coalition has lost 14 surveillance encounters to Frontier buggy raids in the last 4 years. The buggies do not survive contact with armored vehicles; they don't try.", discovered_via: "first_use"),
        CodexEntry (id: "codex_vehicle_resistance_motorcycle", canonical_name: "Frontier Combat Motorcycle", subject_id: "resistance_motorcycle", body: "Frontier two-wheel combat platform, in service since 2118. Mass 200 kilograms; single rider; off-road tires; no armor. The motorcycle is the fastest Frontier vehicle (top speed 140 kilometers per hour on hard pack) and the most fragile. The Frontier fields an estimated 240 active motorcycles. The motorcycles are used for high-speed reconnaissance, courier service, and ambush coordination. The Marauder Tribes also field motorcycles, typically salvaged from Frontier units. The Coalition does not field motorcycles, considering them tactically irrelevant.", discovered_via: "first_use"),
        CodexEntry (id: "codex_vehicle_marauder_warbuggy", canonical_name: "Marauder War-Buggy", subject_id: "marauder_warbuggy", body: "Marauder Tribe combat vehicle, no standardized design. Typical configuration: 4-wheel drive, open frame, bone-and-iron spikes welded to the front aspect, totem rails along the sides. Crew 2 to 8. The War-Buggy is the Marauder Tribes' primary mobile-warfare platform; the Tribes field an estimated 800 active War-Buggies. Each Buggy is named by its crew chief and carries that name into combat. Naming is a Marauder honor; the Coalition has classified 240 War-Buggy names in intelligence reports. The crew chief of the most-honored Buggy is considered the equivalent of a Coalition battalion commander.", discovered_via: "first_use"),
        CodexEntry (id: "codex_vehicle_marauder_warwagon", canonical_name: "Marauder War-Wagon", subject_id: "marauder_warwagon", body: "Marauder Tribe heavy combat vehicle. Mass 12 tonnes; 4-wheel drive; iron-and-bone chassis; ornate rune carvings along all surfaces. Crew 4 to 8. The War-Wagon is the Marauder Tribes' primary heavy-fire-support platform; mounts up to 4 separate weapon systems. The Tribes field an estimated 240 War-Wagons. Each War-Wagon is a tribal artifact, passed down through generations of crew chiefs. The Coalition has destroyed 14 War-Wagons in 4 years; each destruction is a major Marauder grief event. The Coalition does not count the destructions in standard kill ratios.", discovered_via: "first_use"),
        CodexEntry (id: "codex_vehicle_order_cathedral_ad", canonical_name: "Pact Cathedral Drone", subject_id: "order_cathedral_ad", body: "Pact ceremonial-vehicle / assault platform. Mass 8 tonnes; hovers via internal fusion-driven turbines; ornate gold trim and ceremonial banners along all aspects. The Drone is operated by 4 Pact ministers and carries 14 lay believers in ceremonial procession. The Drone is also armed: 2 hull-mounted laser weapons and 14 anti-personnel missile pods. The Pact maintains 24 active Cathedral Drones. The Coalition has not engaged a Cathedral Drone in combat. The Coalition has classified Cathedral Drone engagement as 'avoid if possible'; the Drone's weapons are top-tier and the political consequences of an engagement are severe.", discovered_via: "first_visit"),
        CodexEntry (id: "codex_vehicle_order_relic_carrier", canonical_name: "Pact Relic Carrier", subject_id: "order_relic_carrier", body: "Pact specialized transport for sacred relics. Mass 4 tonnes; tracked; flat bed with mounted banner mast; canopy of gold-trimmed cloth. Crew 2 (driver and a Pact minister). The Carrier transports Pact relics between temples for ceremonial purposes. The Pact maintains 14 active Relic Carriers. The Coalition does not interfere with Relic Carrier movements; the political agreement is firm. The Carriers occasionally contain hidden Pact military supplies; the Coalition has not investigated, on the theory that the relics are more politically valuable than the supplies.", discovered_via: "first_visit"),
        CodexEntry (id: "codex_vehicle_sci_research_apc", canonical_name: "Collegium Research APC", subject_id: "sci_research_apc", body: "Quietus Collegium scientific platform. Mass 14 tonnes; rectangular hull; dish-and-strut roof for sensor arrays; sensor mast extends 4 meters above the hull. Crew 4 (driver, 2 sensor technicians, 1 expedition leader). The Research APC is the Collegium's primary field-research platform; the Collegium maintains 24 active APCs. The APCs are unarmed; the Collegium does not engage in combat operations. The Coalition provides escort for Collegium APCs in contested territory under a 2118 agreement. The Coalition has lost 4 troopers protecting Collegium APCs in 4 years.", discovered_via: "first_visit"),
        CodexEntry (id: "codex_vehicle_sci_data_rover", canonical_name: "Collegium Data Rover", subject_id: "sci_data_rover", body: "Quietus Collegium light field-research vehicle. Mass 2 tonnes; 4-wheel drive; holographic-emitter mast for data transmission; one driver. The Rover is the Collegium's most mobile research platform; the Collegium maintains 240 active Rovers. The Rovers conduct surface surveys, anomaly mapping, and biological sample collection. The Coalition has lost 14 surveillance contacts to Collegium Rovers since 2118; the Rovers are too lightly armed to engage but use their speed and the Coalition's reluctance to fire on Collegium personnel to evade.", discovered_via: "first_visit"),
        CodexEntry (id: "codex_vehicle_merc_modular_apc", canonical_name: "Mercenary Modular APC", subject_id: "merc_modular_apc", body: "Independent mercenary armored personnel carrier. Mass 12 tonnes; tracked; modular side-plate armor system. Plates are interchangeable: ballistic plates for combat, sensor plates for reconnaissance, transport plates for cargo. Crew 4 plus mission-specific loadout. The vehicle is operated by 4 mercenary companies across the Sol system; total fleet 60 vehicles. The Modular APC is the most expensive standard mercenary vehicle (cost 1.4 million Concordat units); the Modular APC is also the most profitable. Mercenary companies recover the cost within 4 years of operation.", discovered_via: "first_visit"),
        CodexEntry (id: "codex_vehicle_merc_recovery_truck", canonical_name: "Mercenary Recovery Truck", subject_id: "merc_recovery_truck", body: "Independent mercenary salvage vehicle. Mass 14 tonnes; 4-wheel drive; mounted winch arm rated to 8 tonnes; flat cargo bed. Crew 4 (driver, winch operator, security, recovery specialist). The Truck is the mercenary salvage industry's primary vehicle; 240 active across all factions. The Truck recovers damaged vehicles, fallen mechs, and combat casualties. Operational rate: 4 recoveries per quarter per truck. Recovery price varies: 4000 Concordat units for an intact vehicle, 240 for a salvageable wreck, 4 for a body bag.", discovered_via: "first_visit"),
        CodexEntry (id: "codex_vehicle_pirate_skiff", canonical_name: "Pirate Combat Skiff", subject_id: "pirate_skiff", body: "Pirate orbital interceptor. Mass 4 tonnes; 4-meter length; single-pilot configuration; armed with 2 hull-mounted laser cannons. The Skiff is the Pirate combat formation's primary fighter; the Pirate clans field an estimated 1100 active Skiffs. The Skiffs are operated by single pilots on 4-hour rotations. The Pirate skiff loss rate is 1 per quarter per clan; the Pirate clans replace skiffs through capture or salvage at a rate of 1.4 per quarter. The math favors the Pirates by a small margin. The Coalition's primary anti-skiff weapon is the long-range orbital battery, mounted on Coalition stations.", discovered_via: "first_use"),
        CodexEntry (id: "codex_vehicle_pirate_armored_boat", canonical_name: "Pirate Armored Boat", subject_id: "pirate_armored_boat", body: "Pirate maritime combat vessel. Mass 24 tonnes; 14-meter length; flat-bottom hull for shallow-water operation; 4 to 6 crew. Armament varies; typical loadout: a single hull-mounted 12.7 MG, 4 boarding rifles, and a single shoulder-fired anti-armor rocket. The Boats are the primary platform for coastal Pirate operations on Earth and along Mars's seasonal lakes. The Pirate clans field an estimated 240 active Boats. The Boats are not used in orbital operations.", discovered_via: "first_use"),
        CodexEntry (id: "codex_vehicle_drone_hex_carrier", canonical_name: "Synth Hex Carrier", subject_id: "drone_hex_carrier", body: "Synth Collective passenger and cargo vehicle. Mass 4 tonnes; hexagonal hull; hover propulsion via internal fusion-driven turbines; rotating dome for sensor and weapon systems. Crew none (Synth nodes operate autonomously); capacity 14 passengers or 8 tonnes cargo. The Synth Collective maintains 240 active Hex Carriers. The Carriers are the Collective's primary mobility platform; they are also the most heavily defended Synth vehicle. Anti-Carrier engagements by Coalition forces have resulted in 4 Carrier losses since 2118; the Collective has not retaliated.", discovered_via: "first_visit"),
        CodexEntry (id: "codex_vehicle_drone_hex_assault", canonical_name: "Synth Hex Assault Drone", subject_id: "drone_hex_assault", body: "Synth Collective combat drone. Mass 2 tonnes; hexagonal hull; 4 mounted weapon barrels; targeting dome. Crew none (Synth nodes operate autonomously). The Drone is the Collective's primary combat platform; the Collective maintains 1100 active Drones. Drone weapons: 4 plasma cannons rated at 60 kilowatts of beam output. The Drone's effective range is 800 meters. The Coalition has classified the Hex Assault Drone as a tier-1 threat. Coalition engagement doctrine against Hex Assault Drones: orbital strike or massed-fire concentration.", discovered_via: "first_use"),
        CodexEntry (id: "codex_vehicle_coalition_dropship", canonical_name: "Coalition Drop-Ship", subject_id: "coalition_dropship", body: "Coalition Marine combat insertion vessel. Mass 80 tonnes; orbital-to-surface ballistic profile; 4 retro-rockets for landing deceleration. Crew 4 plus 24 troopers. The Drop-Ship is the Coalition's primary surface-insertion platform; the Coalition Naval Office maintains 240 active Drop-Ships. The Drop-Ships are heavily armed: 4 chin-mounted laser cannons and 14 anti-personnel missile pods. The Drop-Ship is the Coalition's most reliable indicator of imminent assault; the Frontier and Marauder Tribes know that the appearance of a Drop-Ship signals 30 minutes to surface contact.", discovered_via: "first_visit"),
        CodexEntry (id: "codex_vehicle_coalition_combat_walker", canonical_name: "Coalition Combat Walker", subject_id: "coalition_combat_walker", body: "Coalition mech-class infantry support vehicle. Mass 14 tonnes; bipedal configuration; pilot-operated. The Walker is the Coalition's primary close-support platform; the Coalition fields 240 active Walkers. Armor: 60 millimeters of laminated plate, defeats 12.7 to 100 meters and explosive frags to 14 kilograms TNT-equivalent. Armament: 1 shoulder-mounted 30mm autocannon, 2 hand-mounted laser cannons, 4 anti-personnel missile pods. The Walker's effective range is 800 meters; the Walker's effective speed is 8 kilometers per hour. Walker pilots train for 4 years before solo certification.", discovered_via: "first_use"),
        CodexEntry (id: "codex_vehicle_frontier_workmech", canonical_name: "Frontier Work-Mech", subject_id: "frontier_workmech", body: "Frontier civilian-converted construction mech. Mass 8 tonnes; bipedal; pilot-operated. Originally designed for mining and construction work; the Frontier has armed approximately 240 Work-Mechs for combat use. Armor: 14 millimeters scavenged plate, defeats only handgun rounds. Armament: typically a single hand-mounted weapon (often a salvaged Coalition 12.7 MG). The Work-Mech is the Frontier's primary mech-class combat platform. Effective combat range: 200 meters. Effective speed: 4 kilometers per hour. Combat survival rate against Coalition Walkers: 14 percent.", discovered_via: "first_use"),
        CodexEntry (id: "codex_vehicle_marauder_warmech", canonical_name: "Marauder War-Mech", subject_id: "marauder_warmech", body: "Marauder Tribe heavily customized mech. Mass varies (8 to 24 tonnes); bipedal or quadrupedal configurations; pilot-operated. The War-Mech is the Marauder Tribes' primary armor-class combat platform. Marauder smiths customize each War-Mech extensively with bone-and-iron decoration, weapon attachments, and ritual paint. The Tribes field an estimated 60 active War-Mechs. Each War-Mech is named, and the names are inscribed in the Tribal records. War-Mech destruction is a major Tribal grief event; the Tribes have not allowed War-Mech captures by the Coalition since 2118.", discovered_via: "first_use"),
        CodexEntry (id: "codex_vehicle_coalition_orbital_freighter", canonical_name: "Coalition Orbital Freighter", subject_id: "coalition_orbital_freighter", body: "Coalition civilian cargo vessel. Mass 4000 tonnes (loaded); rocket-driven; cargo capacity 1100 tonnes; crew 14. The Freighters carry inter-orbital cargo on regular schedules. The Coalition Naval Office maintains 240 active Freighters. The Freighters are unarmed; the Coalition Navy provides escort for high-value cargo through the Belt asteroid Pirate zones. Pirate raids on Freighters have resulted in 24 captures and 60 attempted captures in 4 years. The Coalition's recovery rate on captured cargo: 30 percent.", discovered_via: "first_use"),
        CodexEntry (id: "codex_vehicle_aqueous_diving_vessel", canonical_name: "Aqueous Diving Vessel", subject_id: "aqueous_diving_vessel", body: "Kindred maritime exploration vessel. Mass 24 tonnes; submarine configuration; crew 14. The Vessels are the Kindred's primary underwater research platform; the Kindred maintain 14 active Vessels in the Mimas methane lakes and 4 in the Europa subsurface ocean. The Vessels are pressurized for ocean operation at depths up to 400 meters. The Coalition has lost 4 surveillance contacts to Kindred Vessels in 4 years; the Vessels are equipped with sonar-confusing techniques the Coalition has not been able to defeat.", discovered_via: "first_visit"),
        CodexEntry (id: "codex_vehicle_collegium_research_balloon", canonical_name: "Collegium Research Balloon", subject_id: "collegium_research_balloon", body: "Quietus Collegium high-altitude observation platform. Mass 800 kilograms; helium-filled envelope; sensor pod with 4 measurement instruments. The Balloon is the Collegium's primary atmospheric research platform; the Collegium maintains 24 active Balloons on Mars and Venus. The Balloons operate at altitudes of 30 to 80 kilometers. The Balloons are equipped with anti-tampering systems that destroy the sensor pod if hostile manipulation is detected. The Coalition has lost 4 attempted Balloon retrievals to the anti-tampering systems.", discovered_via: "first_visit"),
        CodexEntry (id: "codex_vehicle_pact_solarsail", canonical_name: "Pact Solar-Sail Vessel", subject_id: "pact_solarsail", body: "Pact ceremonial-and-research vessel. Mass 240 tonnes; solar-sail propulsion; crew 14. The Vessels operate exclusively in inner-system orbits where solar pressure is sufficient for propulsion. The Pact maintains 8 active Solar-Sail Vessels. The Vessels are used for pilgrimage transit and solar observation. The Vessels are unarmed; the Pact does not engage in combat operations outside its temples. The Coalition has not engaged a Solar-Sail Vessel in combat. Solar-Sail Vessels are also the most fuel-efficient transit vessels in the Sol system, operating at 4 percent the cost per kilogram-kilometer of Coalition orbital freight.", discovered_via: "first_visit"),
        CodexEntry (id: "codex_vehicle_independent_courier", canonical_name: "Independent Courier Vessel", subject_id: "independent_courier", body: "Generic small-cargo vessel operated by independent merchants. Mass 4 tonnes; rocket-driven; crew 1; cargo capacity 240 kilograms. The Couriers operate on commercial routes between Mars, Phobos, and the Belt. The independent courier population is estimated at 1100 active vessels. Couriers carry high-value, low-mass cargo: pharmaceuticals, precision components, sealed documents. Courier pilots' average annual income: 14000 Concordat units. Courier pilots' average career length: 6 years. The career-ending event is typically a Pirate raid or a navigational error.", discovered_via: "first_visit"),
        CodexEntry (id: "codex_vehicle_marauder_warbarge", canonical_name: "Marauder War-Barge", subject_id: "marauder_warbarge", body: "Marauder Tribe water-borne transport. Mass 60 tonnes; wooden hull with iron plating; capacity 240 warriors plus cargo; crew 14. The War-Barge is the Tribes' primary cross-water assault platform. The Tribes maintain 24 active War-Barges, primarily on Mars seasonal lakes and the Belt asteroid water channels. The War-Barge is the Tribes' most-feared offensive capability in inter-faction warfare; the appearance of a War-Barge in Frontier waters is the standard alarm signal. The Coalition has destroyed 4 War-Barges in 4 years through orbital strikes.", discovered_via: "first_use"),
        CodexEntry (id: "codex_vehicle_synth_processor_array", canonical_name: "Synth Processor Array Vehicle", subject_id: "synth_processor_array", body: "Synth Collective mobile computing platform. Mass 4 tonnes; tracked; carries 24 Synth processing nodes plus support equipment. The Array is the Collective's primary mobile computing platform; the Collective maintains 60 active Arrays. The Arrays are used for distributed computation, network maintenance, and inter-node communication. The Arrays are unarmed (the Collective considers combat operations contrary to its consensus protocol). The Coalition has not engaged a Processor Array in combat. The Coalition has inspected 14 Arrays under the 2114 Synth Transparency Accord; no violations have been found.", discovered_via: "first_visit"),
        CodexEntry (id: "codex_vehicle_husk_assimilator_walker", canonical_name: "Husk Assimilator Walker", subject_id: "husk_assimilator_walker", body: "Husk-built mech-class assimilation platform. Mass varies (Husk fabrication is non-standardized). Bipedal configuration; armored hull; mounted equipment for active assimilation of captured biological material. The Walkers are encountered in Husk-controlled territory only. Coalition forces have engaged 4 Walkers in 4 years; the engagements ended in Coalition victory at the cost of 14 Coalition troopers per engagement. The Walkers' effective range and combat speed are not known; Coalition intelligence has not been able to capture an intact Walker for analysis.", discovered_via: "first_use"),
        CodexEntry (id: "codex_weapon_pistol_M4_standard", canonical_name: "Coalition Pistol — M4 Standard", subject_id: "pistol_M4_standard", body: "Coalition standard-issue sidearm, in service since 2099. 9mm caliber; 14-round magazine; striker-fired. Weight 1.4 kilograms loaded; barrel length 100 millimeters; effective range 50 meters. The M4 has been issued to every Coalition trooper at every rank for 24 years. Production rate: 24000 units per year at the Coalition's main armory. Reliability is rated at 1 in 1100 rounds; the Coalition manual mandates field-strip cleaning every 240 rounds. The M4's manual is 24 pages long. The first page reads: 'You will not learn to clean it from this manual. You will learn to clean it from the sergeant. Carry the manual anyway.'", discovered_via: "first_use"),
        CodexEntry (id: "codex_weapon_rifle_HK417", canonical_name: "Coalition Rifle — HK 417", subject_id: "rifle_HK_417", body: "Coalition standard-issue infantry rifle, in service since 2114. 7.62 caliber; 30-round magazine; gas-piston operated, select-fire (semi/auto). Weight 4 kilograms loaded; barrel length 400 millimeters; effective range 600 meters. The HK 417 is the Coalition's primary infantry weapon; total production since 2114 exceeds 1.4 million units. The rifle's reliability is rated at 1 jam per 1100 rounds in factory configuration; field reliability drops to 1 per 400 rounds in dusty environments. The rifle is the central object of Coalition infantry training; new troopers learn the disassembly procedure as a 60-step ritual.", discovered_via: "first_use"),
        CodexEntry (id: "codex_weapon_sniper_lapua_338", canonical_name: "Coalition Sniper Rifle — Lapua .338", subject_id: "sniper_lapua_338", body: "Coalition designated marksman rifle, in service since 2118. .338 Lapua caliber; 14-round magazine; bolt-action; manually operated. Weight 8 kilograms loaded; barrel length 660 millimeters; effective range 1400 meters. The Lapua is issued to Coalition special-operations sniper teams; total active units 240. The Lapua has been used in 14 named Coalition sniper operations; kill confirmations exceed 240 hostiles. The Lapua's optics package is a Coalition-classified design; the lens elements are produced in the Phobos Lagrange Lab.", discovered_via: "first_use"),
        CodexEntry (id: "codex_weapon_shotgun_KSG", canonical_name: "Coalition Shotgun — KSG Bullpup", subject_id: "shotgun_KSG", body: "Coalition close-quarters battle weapon, in service since 2114. 12-gauge caliber; 14-round dual magazine; pump action; bullpup configuration. Weight 4.4 kilograms loaded; barrel length 480 millimeters; effective range 30 meters. The KSG is issued to Coalition Marine boarding parties and breach-and-clear teams; total active units 800. The KSG fires Coalition-standardized 12-gauge ammunition: slug rounds, buckshot rounds, breaching rounds, and less-lethal rounds. The KSG is the Coalition's preferred weapon for orbital boarding operations.", discovered_via: "first_use"),
        CodexEntry (id: "codex_weapon_gl_M203", canonical_name: "Coalition Grenade Launcher — M203", subject_id: "GL_M203", body: "Coalition rifle-mounted grenade launcher, in service since 2110. 40mm caliber; single-shot; mounted on the HK 417 rifle. Weight 0.8 kilograms; barrel length 240 millimeters; effective range 200 meters. The M203 is issued to every Coalition infantry squad; total active units 24000. The M203 fires fragmentation grenades (lethal radius 4 meters), smoke grenades (cloud lasts 60 seconds), and flashbang grenades (effective range 4 meters). The M203 has been used in 24 named Coalition operations and accounted for 4400 confirmed kills.", discovered_via: "first_use"),
        CodexEntry (id: "codex_weapon_heavy_M2_browning", canonical_name: "Coalition Heavy MG — M2 Browning", subject_id: "heavy_M2_browning", body: "Coalition heavy machine gun, in service since 2099 (a pre-collapse design preserved in continuous Coalition use). .50 caliber; 240-round belt feed; gas-operated, fully automatic. Weight 38 kilograms; barrel length 1140 millimeters; effective range 1800 meters. The M2 is issued to Coalition heavy-weapon teams and is the standard armament on Coalition vehicles; total active units 4400. The M2 is the most-used weapon in Coalition military history; over 14000 hostile contacts have been resolved by M2 fire. The M2 is also the Coalition manual's example of timeless engineering.", discovered_via: "first_use"),
        CodexEntry (id: "codex_weapon_flamer_M9", canonical_name: "Coalition Flamer — M9", subject_id: "flamer_M9", body: "Coalition incendiary weapon, in service since 2114. Projects ignited fuel mix at 800-degree temperature; effective range 30 meters; fuel capacity 14 liters (4-minute continuous operation). Weight 14 kilograms loaded; tank-mounted on operator's back. The M9 is issued to Coalition Combat Engineering units for area denial, breach support, and Husk-zone clearing operations. The M9 is the most-feared Coalition weapon in close-quarters engagement; the Frontier and Marauder Tribes have surrendered to M9-bearing Coalition teams in 4 named engagements. The Husks do not surrender.", discovered_via: "first_use"),
        CodexEntry (id: "codex_weapon_drill_industrial", canonical_name: "Industrial Drill — Coalition Variant", subject_id: "drill_industrial", body: "Coalition dual-use industrial drill, in service since 2099. Tungsten-carbide bit; 4-kilowatt electric drive; drilling rate 4 millimeters per minute in steel. Weight 14 kilograms. The Drill is issued to Coalition Combat Engineering units for breach operations, demolition support, and obstacle removal. The Drill is also a Coalition combat weapon; against unarmored targets the Drill is lethal at 1 meter contact. The Drill is the standard weapon of Coalition Combat Engineering Sergeants who have completed advanced training; the training is voluntary and the certification rate is 4 percent.", discovered_via: "first_use"),
        CodexEntry (id: "codex_weapon_grappler_mk2", canonical_name: "Coalition Grappling Hook — Mk II", subject_id: "grappler_mk2", body: "Coalition specialized infantry tool, in service since 2114. Compressed-air launched; 30-meter range; cable rated to 240 kilograms working load. Weight 4 kilograms. The Grappler is issued to Coalition special-operations teams and is the standard tool for vertical assault on fortified positions. The Grappler is also the standard tool for orbital boarding operations; the cable is rated to support full Coalition armor in zero-g insertion. The Grappler has been used in 14 named Coalition vertical-assault operations; 240 Coalition troopers have ascended Grappler cables under fire and 14 have not survived.", discovered_via: "first_use"),
        CodexEntry (id: "codex_weapon_drone_deployer", canonical_name: "Coalition Drone Deployer", subject_id: "drone_deployer", body: "Coalition infantry-deployed reconnaissance drone launcher, in service since 2118. Launches a 200-gram micro-drone with 4-hour battery life and visual-spectrum camera. Weight 4 kilograms (launcher) plus 200 grams per drone. The Deployer is issued to Coalition special-operations reconnaissance teams; total active units 240. The drone has an effective operational range of 4 kilometers from the operator and can transmit visual data continuously. The Coalition has classified the drone's encrypted radio protocol; the Frontier has captured 14 drones in 4 years and has not decrypted the protocol.", discovered_via: "first_use"),
        CodexEntry (id: "codex_weapon_melee_combat_knife", canonical_name: "Coalition Combat Knife — Mk VII", subject_id: "combat_knife_mk7", body: "Coalition standard-issue combat knife, in service since 2099. 240-millimeter blade; high-carbon steel; 60 Rockwell hardness. Weight 480 grams including sheath. The knife is issued to every Coalition trooper at basic training. The Coalition manual mandates daily sharpening to a standard the manual does not specify. The knife is also a Coalition cultural item: Coalition retirees frequently retain their service knives as personal effects. The knife has been used in 240 hand-to-hand engagements documented in Coalition AARs over 24 years; the kill rate is 80 percent.", discovered_via: "first_use"),
        CodexEntry (id: "codex_weapon_melee_baton", canonical_name: "Coalition Riot Baton", subject_id: "baton_riot", body: "Coalition non-lethal control weapon, in service since 2104. 60-centimeter steel core with rubberized grip; weight 800 grams. The baton is issued to Coalition civil affairs and military police units; total active units 4400. The baton is the Coalition's preferred crowd-control tool. The baton's use is governed by detailed Coalition procedures; the use-of-force flowchart is 14 steps and is taught to all Coalition civil affairs officers. The baton has been used in 240 documented incidents over 4 years; injuries have been classified at 80 percent minor and 14 percent serious. Deaths: 4 in 4 years, all classified as 'accidental'.", discovered_via: "first_use"),
        CodexEntry (id: "codex_weapon_melee_hatchet", canonical_name: "Frontier Combat Hatchet", subject_id: "hatchet_frontier", body: "Frontier-fabricated heavy melee weapon. 14-centimeter blade; folded steel; weight 1.4 kilograms. The hatchet is the Frontier's primary heavy melee weapon; total active units 24000. The hatchet is also a Frontier cultural item: Frontier warlords carry hatchets as a sign of office. The hatchet is forged in 14 active Frontier smithies, including the Ironwood Smithy at the Mars settlements. The hatchet has been used in 4400 documented Frontier engagements over 14 years; the kill rate in hand-to-hand combat is 90 percent.", discovered_via: "first_use"),
        CodexEntry (id: "codex_weapon_melee_marauder_axe", canonical_name: "Marauder Obsidian Axe", subject_id: "axe_marauder_obsidian", body: "Marauder ceremonial-and-combat axe. 240-millimeter obsidian blade; bone-or-wood handle; weight 2 kilograms. The axe is forged by Marauder smiths using volcanic obsidian from the Vulcan quarries. The axe is the most prestigious Marauder weapon; ownership is reserved for war-chiefs and proven warriors. The Tribes maintain an estimated 240 axes across all 11 Tribes. The axe is the standard weapon of Marauder duel-of-honor combat. The Coalition has classified 14 axes in evidence custody from confiscated Marauder remains; the axes are held at the Coalition Archive.", discovered_via: "first_use"),
        CodexEntry (id: "codex_weapon_pact_solar_brand", canonical_name: "Pact Solar Brand Sword", subject_id: "solar_brand", body: "Pact ceremonial-and-combat sword. 800-millimeter polished-steel blade; gold-inlaid hilt; weight 2.4 kilograms. The sword is the Pact Warden Band's primary weapon. The blade is forged at the Pact's main temple on Vulcan in a ceremony that takes 14 days. The Brand is consecrated by sunlight exposure for 4 hours before issue. The Pact maintains 240 active Brands. The Brand has been used in 24 named Pact military operations; the kill rate in hand-to-hand combat is 100 percent. The Pact attributes the high rate to divine favor; the Coalition attributes it to good steel.", discovered_via: "first_use"),
        CodexEntry (id: "codex_weapon_synth_plasma_cannon", canonical_name: "Synth Plasma Cannon — Type 1", subject_id: "synth_plasma_cannon", body: "Synth Collective primary combat weapon. 60-kilowatt beam output; effective range 800 meters; rate of fire 4 shots per minute; weapon weight 24 kilograms. The Cannon is mounted on the Synth Hex Assault Drone; the Collective does not equip Synth nodes directly with the Cannon. The Cannon's beam is a controlled hydrogen plasma; the beam can penetrate 14 millimeters of rolled steel armor at 200 meters range. The Coalition has classified the Cannon as a tier-1 weapon. Coalition engagement doctrine against Cannon-equipped Synth Drones: orbital strike or massed-fire concentration.", discovered_via: "first_use"),
        CodexEntry (id: "codex_weapon_husk_assimilation_lance", canonical_name: "Husk Assimilation Lance", subject_id: "husk_assimilation_lance", body: "Husk-built bioweapon. Composition unclassified by Coalition labs. The Lance is wielded by Husk individuals in close-quarters combat. The Lance is fatal on contact; the Coalition has documented 4400 Lance contacts over 24 years, with a fatality rate of 100 percent. The Lance does not produce wounds in the conventional sense; the Coalition has classified the Lance contact mechanism as 'anomalous biology'. The Coalition has captured 14 Lances from Husk casualties; analysis has not produced understanding. The Lances degrade rapidly after capture and are not transportable.", discovered_via: "first_kill"),
        CodexEntry (id: "codex_weapon_mountaineering_pickaxe", canonical_name: "Mountaineering Pickaxe — Civilian", subject_id: "pickaxe_mountaineering", body: "Civilian-grade utility tool, distributed widely across the Sol system. 60-centimeter ash-wood haft; steel pick head; weight 1.4 kilograms. The pickaxe is the most common civilian tool on Mars and Phobos; total active units exceed 11000. The pickaxe is also the most common ad-hoc combat weapon in Frontier and Marauder Tribes settlements. The Coalition does not regulate pickaxes; the Coalition does not regulate civilian tools generally. The pickaxe has been used in 240 documented Frontier and Marauder Tribes combat incidents over 4 years.", discovered_via: "first_use"),
        CodexEntry (id: "codex_weapon_chemical_grenade_white_phosphorus", canonical_name: "Coalition White Phosphorus Grenade — M83", subject_id: "white_phosphorus", body: "Coalition incendiary-and-screening grenade, in service since 2099. 14-second burn time; 4-meter effective radius; white-phosphorus payload at 800-degree burn temperature. Weight 1.4 kilograms. The grenade is issued to Coalition Combat Engineering units for area-denial operations. The Coalition manual classifies the grenade as 'multi-use'; the grenade produces screening smoke as a primary effect and area-denial fire as a secondary effect. The grenade has been used in 240 named Coalition operations over 24 years; civilian casualties have been classified at 4 percent of total casualties.", discovered_via: "first_use"),
        CodexEntry (id: "codex_weapon_chemical_grenade_frag", canonical_name: "Coalition Fragmentation Grenade — M67", subject_id: "frag_grenade", body: "Coalition fragmentation grenade, in service since 2099 (pre-collapse design preserved in continuous Coalition use). 4-second fuse; 14-meter lethal radius; 200-gram payload of high explosive plus fragmentation jacket. Weight 400 grams. The grenade is issued to every Coalition trooper at the rate of 4 grenades per deployment; total annual production 240000 units. The grenade has been used in 4400 documented Coalition engagements over 24 years; kill rate per detonation is 78 percent within lethal radius. The grenade is the Coalition's most-issued explosive ordnance.", discovered_via: "first_use"),
        CodexEntry (id: "codex_weapon_anti_armor_rocket", canonical_name: "Coalition AT Rocket — AT8", subject_id: "at_rocket", body: "Coalition shoulder-fired anti-tank rocket, in service since 2114. 80-millimeter caliber; effective range 400 meters; explosive payload 1.4 kilograms TNT-equivalent. Weight 14 kilograms loaded; 4 kilograms unloaded. The Rocket is issued to Coalition heavy weapons teams; the Coalition maintains 4400 active units. The Rocket has been used in 240 named Coalition operations; its kill rate against light armor is 80 percent at maximum effective range. The Rocket is the Coalition's primary anti-vehicle weapon at the infantry level. Larger anti-armor weapons (the M2 Browning, the 90mm tank gun, the 30mm Walker autocannon) operate at the squad and platoon levels.", discovered_via: "first_use"),
        CodexEntry (id: "codex_weapon_smg_mp7", canonical_name: "Coalition SMG — MP7", subject_id: "smg_mp7", body: "Coalition personal defense weapon, in service since 2110. 4.6mm caliber; 20-round magazine; gas-piston operated, select-fire (semi/3-round burst/auto). Weight 1.8 kilograms loaded; barrel length 180 millimeters; effective range 200 meters. The MP7 is issued to Coalition special-operations teams and vehicle crews; total active units 24000. The MP7's compact dimensions allow concealment under standard Coalition equipment; the weapon is the Coalition's preferred undercover-operations weapon. The MP7 has been used in 14 named Coalition undercover operations; 4 of the 14 operations remain classified.", discovered_via: "first_use"),
        CodexEntry (id: "codex_weapon_concealed_carry", canonical_name: "Concealed-Carry Pistol — Various", subject_id: "concealed_carry", body: "Generic small pistols issued by various factions for non-uniformed carry. Coalition uses the M4 Compact (a shortened M4 Standard); the Frontier uses Ronin Hall-licensed civilian-pattern pistols; the Pirates use whatever fits in the smuggler's cache. The 9mm caliber is the inter-faction standard; the magazine capacity is 4 to 14 rounds. Concealed-carry pistols are legal under Coalition Civil Affairs regulations for licensed civilians. The Coalition licenses 240000 civilians annually; the Frontier does not license; the Pirates do not license; nobody refuses the pistol.", discovered_via: "first_use"),
        CodexEntry (id: "codex_weapon_collegium_dart_gun", canonical_name: "Collegium Research Dart Gun", subject_id: "collegium_dart_gun", body: "Quietus Collegium non-lethal capture weapon. Compressed-air launched; 14-meter effective range; tranquilizer dart payload. Weight 2 kilograms. The Gun is issued to Collegium field-research teams for the capture of biological samples and anomalous specimens. The Gun is also used by Collegium Curators in occasional self-defense situations; the Coalition has documented 4 such cases over 14 years, in which Collegium Curators captured rather than killed hostiles. The Coalition has classified the Dart Gun's tranquilizer chemistry; the Coalition has been unable to replicate the formula.", discovered_via: "first_use"),
        CodexEntry (id: "codex_weapon_pact_consecration_torch", canonical_name: "Pact Consecration Torch", subject_id: "pact_torch", body: "Pact ceremonial-and-incendiary tool. Wooden haft 60 centimeters; oil-soaked rag head; burn time 14 minutes; weight 800 grams. The Torch is the Pact Warden Band's primary fire-ritual tool. The Torch is also a Pact combat weapon at close range; in defensive operations against Husk-zone encroachment, the Pact has used Torches to ignite Husk biological material with documented effectiveness. The Pact maintains 4400 active Torches. The Torches are consecrated in the Pact's daily morning ritual.", discovered_via: "first_use"),
        CodexEntry (id: "codex_weapon_pirate_cutlass", canonical_name: "Pirate Cutlass", subject_id: "pirate_cutlass", body: "Pirate boarding-action sword. 240-millimeter curved blade; salvaged-steel construction; weight 1.8 kilograms. The Cutlass is the Pirate clan's primary boarding weapon. The Cutlass is also a Pirate cultural item: Pirate captains carry cutlasses as a sign of office. The Cutlass is forged in 4 active Pirate smithies across the Belt asteroids. The Pirate clans field an estimated 4400 active Cutlasses. The Coalition has classified 14 cutlasses in evidence custody from Pirate captures; the cutlasses are held at the Coalition Archive.", discovered_via: "first_use"),
        CodexEntry (id: "codex_weapon_aqueous_harpoon", canonical_name: "Aqueous Kindred Harpoon", subject_id: "aqueous_harpoon", body: "Kindred-fabricated underwater hunting weapon. 1.4-meter shaft; barbed steel head; mounted on a 4-meter retrieval line. Weight 2.4 kilograms. The Harpoon is the Kindred's primary subsistence-hunting weapon; the Kindred use it for fishing in the Mimas methane lakes and the Europa subsurface ocean. The Harpoon has been adapted for inter-faction combat: the Kindred have used the Harpoon in 24 documented coastal-conflict engagements with Pirate vessels. The Kindred consider the Harpoon's use against humans regrettable; the Kindred consider the Harpoon's use against Husks essential.", discovered_via: "first_use"),
        CodexEntry (id: "codex_weapon_breaching_charge", canonical_name: "Coalition Breaching Charge — M1", subject_id: "breaching_charge", body: "Coalition demolition device, in service since 2099. 240-gram plastic-explosive payload; 4-second fuse; adhesive backing for vertical-surface attachment. Weight 480 grams. The Charge is the Coalition's primary breach-and-clear weapon for door-and-wall opening operations. Total active units 1100. The Charge can penetrate 60 millimeters of reinforced concrete or 14 millimeters of rolled steel armor. The Charge has been used in 240 named Coalition urban-combat operations over 24 years. The Charge is also the Coalition's preferred explosive ordnance for hostage-rescue operations.", discovered_via: "first_use"),
        CodexEntry (id: "codex_weapon_ad_hoc_pipe_gun", canonical_name: "Pipe-Gun — Ad Hoc", subject_id: "pipe_gun", body: "Civilian-improvised firearm. Welded steel pipe; bolt-action firing mechanism; calibers vary (typically 12-gauge or 7.62 rifle ammunition). Weight 2 to 4 kilograms. The Pipe-Gun is the most-common firearm in Marauder and Pirate hands; total active units estimated at 240000. The Pipe-Gun is unreliable (1 jam per 14 rounds in optimal conditions; 1 jam per 4 in field conditions) but is the cheapest possible firearm. The Coalition has classified the Pipe-Gun as a regulated weapon; the Coalition does not pursue enforcement against Pipe-Gun bearers individually.", discovered_via: "first_use"),
        CodexEntry (id: "codex_weapon_collegium_capture_net", canonical_name: "Collegium Capture Net", subject_id: "collegium_net", body: "Quietus Collegium specimen-collection device. 4-meter polymer net; spring-loaded launcher; effective range 14 meters. Weight 2.4 kilograms (launcher) plus 800 grams (net). The Net is issued to Collegium field-research teams for the capture of biological specimens. The Net has been adapted by Coalition special-operations for non-lethal hostile capture; the Coalition uses the Net in 4 named operations per year on average. The Net is the only Collegium-designed device that has been licensed for Coalition military use; the licensing agreement was negotiated in 2118.", discovered_via: "first_use"),
        CodexEntry (id: "codex_weapon_anti_personnel_mine", canonical_name: "Coalition AP Mine — M16", subject_id: "ap_mine_m16", body: "Coalition anti-personnel mine, in service since 2099 (pre-collapse design). Pressure-activated; 4-meter lethal radius; 200-gram fragmentation payload. Weight 800 grams; mine diameter 80 millimeters. The Mine is the Coalition's primary perimeter-defense weapon for fortified positions. Total deployed units (active and in storage) exceed 240000. The Mine has been used in 4400 documented Coalition perimeter actions over 24 years. Civilian casualties from mines have been classified at 14 percent of total casualties; the Coalition Civil Affairs office has issued 4 standardized mine-marking protocols to reduce civilian exposure.", discovered_via: "first_use"),
        CodexEntry (id: "codex_weapon_signal_flare_marker", canonical_name: "Coalition Signal Flare", subject_id: "signal_flare", body: "Coalition non-combat marker device, in service since 2104. Magnesium-burning composition; 4-minute burn duration; visible at 14 kilometers in clear conditions. Weight 240 grams. The Flare is issued to every Coalition infantry squad at the rate of 4 flares per deployment; total annual production 24000. The Flare's primary use is mission-marker signaling: location confirmation, vehicle recovery, casualty extraction. The Flare's secondary use is anti-personnel ignition; against unarmored targets the Flare is lethal at 30-centimeter contact range. The Coalition manual classifies the secondary use as 'authorized in extremis'.", discovered_via: "first_use"),
    ]
)
