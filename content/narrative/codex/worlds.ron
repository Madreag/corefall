CodexSection (
    schema_version: 1,
    category: "world",
    description: "M25A world codex — 50 entries. 4-5 lore drops per world across 12 worlds (Earth / Mars / Moon / Phobos / Deimos / Mimas / Europa / Vulcan / Venus / Belt / Orbital / Sol Zone). Geographic + political + biological + cultural + historical detail per world.",
    entries: [
        CodexEntry (id: "codex_world_earth_lagrange", canonical_name: "Lagrange-7 Station", subject_id: "earth", body: "The Concordat's founding location. Originally a pre-collapse research station at the Sun-Earth L2 point, repurposed after the Orbital Insurgency as the Coalition's primary administrative headquarters. Current population 14000, including 800 active military and 240 elected representatives. Lagrange-7 is the only inhabited orbital facility with continuous artificial gravity (1 g, rotational); the medical and birth-rate consequences of the difference are recorded in continuous Coalition health-service logs since 2099.", discovered_via: "first_visit"),
        CodexEntry (id: "codex_world_earth_ruined_cities", canonical_name: "The Ruined Cities", subject_id: "earth", body: "Forty-eight major urban centers across pre-collapse Earth, abandoned during the Reconstruction Wars of 2087-2099. Of these, 30 have been partially reclaimed by Coalition or Frontier salvage operations; the remaining 18 are unsafe due to residual radiation, structural collapse, or hostile occupant populations. The Coalition maintains a 'Do Not Enter' classification for 8 of the unrecovered cities. The Frontier has lost an estimated 1100 scavengers in those 8 cities over the last 4 years. The Coalition does not pursue scavenger casualties.", discovered_via: "first_visit"),
        CodexEntry (id: "codex_world_earth_tides", canonical_name: "The Marauder Tides", subject_id: "earth", body: "Periodic large-scale Marauder migration events. The 2113 Tide brought 24000 Marauder warriors across the Mediterranean basin in a coordinated 4-week assault. The Coalition lost 8 frontier settlements and 1400 troopers; the Marauders lost 4400 warriors and gained territory the Coalition had abandoned anyway. The next Tide is predicted for 2127. The Coalition is fortifying. The Frontier is also fortifying. The Marauders are mustering. The Husks are watching.", discovered_via: "achievement"),
        CodexEntry (id: "codex_world_earth_sea_traffic", canonical_name: "Coastal Pirate Traffic", subject_id: "earth", body: "Atlantic and Pacific coastal Pirate activity. 24 Pirate flotillas operate from independent bases along the post-collapse coastlines. Coalition naval interdiction operations conducted 240 boardings in 2123; recovered cargo valued at 4 million Concordat units. The Pirates retaliated by raiding 8 Coalition coastal supply depots. The cycle is established. The Coalition Naval Office considers the cycle a controlled cost. The Pirate captains consider the cycle a steady business. Both views are correct.", discovered_via: "first_visit"),
        CodexEntry (id: "codex_world_mars_olympus_basin", canonical_name: "Olympus Mons Basin", subject_id: "mars", body: "The largest volcano in the Sol system, 27 kilometers tall, base diameter 600 kilometers. The base contains 14 Coalition fortified outposts, 4 Frontier independent settlements, and the central Olympus Line garrison. The Mons itself is the highest-altitude habitable terrain in the inner system; Coalition altitude-adapted teams maintain a 14-soldier observation post at 24-kilometer elevation. The post's atmospheric oxygen content is 6 percent of sea-level standard; supplemental oxygen is required for any operation lasting longer than 4 hours.", discovered_via: "first_visit"),
        CodexEntry (id: "codex_world_mars_tharsis_quadrangle", canonical_name: "Tharsis Quadrangle", subject_id: "mars", body: "The volcanic upland plateau north of Olympus Mons. 11 active surface mining operations, 4 Coalition fortified bases, 8 Frontier independent settlements. The Quadrangle is the source of 60 percent of all Coalition-controlled iron ore and 80 percent of Frontier-controlled rare-earth metals. The Marauder Tribes maintain seasonal camps in the Quadrangle's dry valleys. The Coalition has not engaged the Marauders inside the Quadrangle since 2118; the engagement cost 240 Coalition troopers and produced no territorial gain.", discovered_via: "first_visit"),
        CodexEntry (id: "codex_world_mars_dust_storms", canonical_name: "Mars Dust Storm Cycle", subject_id: "mars", body: "Periodic atmospheric dust storms triggered by the planet's eccentric orbit. Storms occur seasonally, lasting 4 to 30 days, with surface wind speeds up to 60 meters per second. Visibility during a storm drops to under 4 meters. Coalition surface operations halt during storms; Frontier operations continue. The Marauder Tribes are the only faction with a documented practice of conducting major operations during dust storms; the Marauder advantage is local knowledge of safe terrain and disregard for casualties.", discovered_via: "first_visit"),
        CodexEntry (id: "codex_world_mars_water_extraction", canonical_name: "Mars Water Extraction Doctrine", subject_id: "mars", body: "The mining of subsurface ice deposits for water supply. Mars has an estimated 4 trillion cubic meters of accessible subsurface water; current annual extraction is 4 billion cubic meters. Coalition operations control 60 percent of extraction; Frontier independents 30 percent; the remaining 10 percent is Marauder Tribal control of seasonal ice fields. The Coalition exports surplus water inward at 0.40 Concordat per liter; the Frontier exports at 0.30; the Marauders trade water for ammunition at fluctuating rates.", discovered_via: "achievement"),
        CodexEntry (id: "codex_world_moon_observatory", canonical_name: "The Lunar Observatory Network", subject_id: "moon", body: "4 large-aperture telescope arrays on the Moon's far side, operated jointly by Coalition and Collegium. The arrays cover radio, infrared, visible, and X-ray bands and have a combined collecting area of 24 square kilometers. The Network's primary mission is solar observation; the secondary mission is deep-space anomaly detection. The Network has discovered 24 of the 31 known Sol-zone radiation anomalies. The Coalition retains primary publication rights; the Collegium retains secondary interpretive authority. The arrangement is stable.", discovered_via: "first_visit"),
        CodexEntry (id: "codex_world_moon_helium3_mining", canonical_name: "Helium-3 Mining", subject_id: "moon", body: "Surface regolith mining for helium-3 isotope, the primary fuel for Coalition fusion reactors. Annual production 240 tonnes from 11 active mining operations. The Coalition Bureau of Resources estimates a 400-year reserve at current extraction rates. The mining is conducted by automated harvesters supervised by 14 Coalition technicians on rotating 30-day deployments. Technicians experience low-gravity bone-density loss at a rate that requires medical intervention after 4 deployments; the medical cost is borne by the Coalition.", discovered_via: "first_visit"),
        CodexEntry (id: "codex_world_moon_pre_collapse_cities", canonical_name: "Pre-Collapse Lunar Cities", subject_id: "moon", body: "Eight major pre-collapse civilian settlements on the Moon, abandoned during the Reconstruction Wars. The settlements are intact under the Moon's vacuum; pressure suits remain breathable, food stores remain edible, residential furnishings remain undisturbed. Coalition archaeological teams have surveyed 4 of the 8 cities. The Frontier has surveyed 2. The remaining 2 are unsurveyed; one is in a region with sustained Pirate activity, the other is in a Pact-restricted area. Both surveys are pending.", discovered_via: "first_visit"),
        CodexEntry (id: "codex_world_moon_first_settlement", canonical_name: "The Coalition Lunar Outpost", subject_id: "moon", body: "The Coalition's first off-Earth installation, established 2089 atop the rim of Tycho crater. Continuously occupied since founding; current garrison 240 troopers plus 24 support personnel. The Outpost has never been abandoned, evacuated, or significantly damaged by hostile action. Coalition tradition holds that the Outpost flag — first raised in 2089 — has never been lowered. The flag is now displayed inside a vacuum-pressurized display case in the main hall. The mast outside flies a replacement.", discovered_via: "achievement"),
        CodexEntry (id: "codex_world_phobos_lagrange_lab", canonical_name: "Phobos Lagrange Lab", subject_id: "phobos", body: "Coalition orbital-research station, established 2099. 24 researchers; 4 mech bays; sustained operation in low-gravity environment (0.0008 g). The Lab specializes in micro-gravity manufacturing, including pharmaceutical crystallization and precision-alloy refinement. Lab output supports Coalition production of 14 specialized pharmaceuticals and 4 high-precision optical components. The Lab's primary product is a calibration laser used in Coalition long-range targeting systems; production rate is 4 units per quarter.", discovered_via: "first_visit"),
        CodexEntry (id: "codex_world_phobos_pirate_lairs", canonical_name: "Phobos Pirate Lairs", subject_id: "phobos", body: "Independent Pirate bases concealed in the Phobos surface caves. 11 confirmed lair locations, 4 of which are inhabited at any given time. The Pirates rotate occupation to evade Coalition surveillance. Each lair supports 14 to 40 occupants and a small fleet of 4 to 8 raider vessels. Coalition surveillance has destroyed 8 lairs in the last 4 years through orbital strikes; the destruction-to-detection ratio has not changed the Pirate operational tempo. The Pirates rebuild faster than the Coalition can interdict.", discovered_via: "first_visit"),
        CodexEntry (id: "codex_world_phobos_orbital_decay", canonical_name: "Orbital Decay", subject_id: "phobos", body: "Phobos orbits Mars at an altitude of 9377 kilometers and decays toward Mars at 1.8 centimeters per year. Coalition orbital mechanics calculate Phobos surface impact in approximately 30 million years. The Coalition's 100-year plan does not address the decay. The Frontier's 50-year plan does not either. The Pact's 4000-year theological liturgy mentions Phobos's eventual descent as an inevitability and frames it as a divine signal of the end of one age. The Pact does not specify which age ends.", discovered_via: "achievement"),
        CodexEntry (id: "codex_world_deimos_mining_colony", canonical_name: "Deimos Mining Colony", subject_id: "deimos", body: "Frontier independent mining operation, founded 2108. Population 4400, including 240 active miners, 60 support personnel, and 4100 dependents. The Colony extracts rare-earth metals from Deimos subsurface deposits; annual output 14 tonnes of pure rare-earth concentrate. The Colony's primary export market is the Mars Frontier; secondary market is the Belt asteroid Tribunal. The Coalition has not interdicted Colony shipments. The Coalition has filed 240 trade complaints against the Colony; the complaints are pending in the Verdict Court.", discovered_via: "first_visit"),
        CodexEntry (id: "codex_world_deimos_low_gravity_labor", canonical_name: "Low-Gravity Labor Doctrine", subject_id: "deimos", body: "Workforce management for sustained operation in 0.0003 g environment. Deimos miners experience progressive bone-density loss requiring medical intervention after 12 months of continuous deployment. The Colony's medical policy mandates 30-day rotation to Mars surface gravity (0.38 g) every 6 months. Compliance with the policy is 78 percent. Non-compliant workers receive supplemental calcium injections at the cost of long-term bone health. The trade is voluntary. The compensation premium for non-compliance is 14 percent.", discovered_via: "achievement"),
        CodexEntry (id: "codex_world_deimos_independent_council", canonical_name: "Deimos Independent Council", subject_id: "deimos", body: "Local governing body, elected biennially by Colony residents. 14 council members; one chair, elected from among them. The Council operates independently of any major faction. The Council maintains diplomatic relations with the Coalition, the Frontier, and the Pact through annual liaison meetings. The Council has rejected Coalition annexation offers in 2118, 2120, and 2123. The Coalition has not pressed the matter beyond diplomatic exchange. The Council's independence is recognized by the Verdict Court.", discovered_via: "achievement"),
        CodexEntry (id: "codex_world_deimos_pact_temple", canonical_name: "Pact Temple at Deimos", subject_id: "deimos", body: "The Pact's only permanent installation on Deimos. A 14-meter dome-and-spire temple, built 2118 in negotiation with the Independent Council. The temple is staffed by 4 Pact ministers and serves a local Pact population of 240 lay believers. The temple's services are open to all Colony residents. The Council requires the temple to refrain from political activity, including missionary work outside the temple grounds. The Pact has complied with this requirement. The temple's congregation has grown by 14 percent annually for 6 years.", discovered_via: "first_visit"),
        CodexEntry (id: "codex_world_mimas_methane_lakes", canonical_name: "Mimas Methane Lakes", subject_id: "mimas", body: "Cryogenic methane lakes on the Mimas surface, total volume 4 trillion cubic meters. The lakes provide the primary feedstock for inner-system methane shipments. Annual extraction 240 million cubic meters. Extraction operations are conducted by 4 Frontier companies and 1 Aqueous Kindred cooperative. The Aqueous extract through diving operations; the Frontier extract through floating barge platforms. The Aqueous yield is higher per labor-hour; the Frontier yield is higher per quarter. Both methods coexist on the same lakes.", discovered_via: "first_visit"),
        CodexEntry (id: "codex_world_mimas_aqueous_settlements", canonical_name: "Aqueous Kindred Settlements", subject_id: "mimas", body: "11 underwater communities in the Mimas methane lakes. Total population 24000. The Kindred live submerged at depths of 30 to 200 meters in pressurized habitat bubbles. The bubbles are connected by chains of bioluminescent navigation markers. The Kindred speak a language consisting primarily of click-tones produced through specialized vocal apparatus that the Kindred genetics permit. Coalition diplomats learn 14 of the most common click-tones; the Kindred consider this minimum politeness.", discovered_via: "first_visit"),
        CodexEntry (id: "codex_world_mimas_methane_lakebottom_bioform", canonical_name: "Lakebottom Bioform", subject_id: "mimas", body: "Native life form discovered on the Mimas lake floors. Tentatively classified as silica-based, with cell membranes incorporating methane in a manner not found in Sol-system biology. The Bioform is sessile, slow-growing, and indifferent to human presence. Coalition xenobiology has cultured 4 specimens in laboratory conditions; the specimens require a methane-saturated atmosphere and refuse to reproduce in any other condition. The Kindred consider the Bioform sacred and have requested that Coalition specimens be returned. The Coalition has declined.", discovered_via: "first_visit"),
        CodexEntry (id: "codex_world_mimas_pact_pilgrimage", canonical_name: "Mimas Pact Pilgrimage", subject_id: "mimas", body: "Annual Pact ceremonial visit to the Mimas methane lakes. 240 Pact ministers travel from Mars to Mimas every spring, conduct a 14-day water ritual, and return. The ritual involves immersing ceremonial objects in the methane lakes under Kindred supervision. The Kindred consider the ritual respectful. The Pact considers the ritual essential. The Coalition consider the ritual peculiar and provides the transit ships at cost.", discovered_via: "first_visit"),
        CodexEntry (id: "codex_world_europa_ice_cathedral", canonical_name: "The Europa Ice Cathedral", subject_id: "europa", body: "Quietus Collegium installation, founded 2114 at a depth of 240 meters below the Europa surface ice. 11 Curators in permanent residence; supply runs every 30 days from a Coalition orbital station. The Cathedral is the largest single-volume excavated structure in the Sol system, with an internal volume of 14 million cubic meters. The walls are carved Europa ice; the floor is a copper-and-bronze mosaic; the air is maintained at 4 degrees Celsius. The Cathedral is the spiritual center of the Collegium.", discovered_via: "first_visit"),
        CodexEntry (id: "codex_world_europa_subsurface_ocean", canonical_name: "Europa Subsurface Ocean", subject_id: "europa", body: "Liquid water layer beneath Europa's ice crust, total volume 4 quintillion cubic meters. The ocean is the largest single body of liquid water in the Sol system. Coalition expeditions have penetrated to depths of 1100 meters; the ocean continues to 80 kilometers. The water temperature is 4 degrees Celsius at the ice-water boundary and rises with depth. The water is salty, with a salinity 14 percent higher than Earth's oceans. The water is also bioluminescent at depths below 200 meters from sources not yet identified.", discovered_via: "first_visit"),
        CodexEntry (id: "codex_world_europa_creature_calls", canonical_name: "Europa Subsurface Calls", subject_id: "europa", body: "Audio events recorded in the Europa subsurface ocean. Coalition listening stations have logged 240 distinct vocalization patterns over 14 years of observation. The patterns are believed to be biological in origin. Coalition xenobiology has not identified the species responsible. The patterns have a complexity comparable to mammalian vocal communication. The Coalition has not attempted to respond. The Collegium has attempted to respond using ceremonial gongs. The response has not produced an unambiguous reply, but the gongs continue.", discovered_via: "first_visit"),
        CodexEntry (id: "codex_world_europa_under_ice_archeology", canonical_name: "Under-Ice Archaeological Sites", subject_id: "europa", body: "Pre-collapse human archaeological sites preserved under the Europa ice. 4 confirmed sites at depths of 20 to 240 meters. The sites include a 2070-era research station, a 2085-era abandoned mining operation, and 2 unidentified installations. The unidentified installations contain hardware and biological samples that the Coalition has not been able to classify. The Coalition has sealed access to the unidentified installations pending further investigation. The investigation has been pending for 8 years. The Collegium has been waiting patiently.", discovered_via: "first_visit"),
        CodexEntry (id: "codex_world_vulcan_volcanic_belt", canonical_name: "Vulcan Volcanic Belt", subject_id: "vulcan", body: "Continuous chain of 40 active volcanoes encircling the Vulcan equator. The Belt is the most geologically active region in the Sol system, with an eruption every 14 days on average. The Belt contains 24 Pact-sanctioned worship sites where ceremonial fire rituals are conducted. The Pact ministers reside on the Belt in deliberate harm's way as a sign of devotion. Pact mortality on the Belt is 14 percent annually. The Pact's senior council considers this acceptable. The Coalition considers the Pact's senior council mad.", discovered_via: "first_visit"),
        CodexEntry (id: "codex_world_vulcan_pact_temple_complex", canonical_name: "Pact Temple Complex", subject_id: "vulcan", body: "The largest Pact installation in the Sol system, located at the heart of the Vulcan Volcanic Belt. 14 temple structures, 240 resident ministers, 1100 lay believers. The Complex's central temple is the Hearthstone, a 14-meter-tall structure built directly atop an active lava vent. The Hearthstone has been continuously occupied since 2099. The ministers consider the heat from the vent a sign of divine favor. The vent has not erupted in 26 years. The Pact's central liturgy predicts that the Hearthstone will eventually be consumed by the vent.", discovered_via: "first_visit"),
        CodexEntry (id: "codex_world_vulcan_obsidian_quarries", canonical_name: "Obsidian Quarries", subject_id: "vulcan", body: "Volcanic glass extraction sites operated by Marauder Tribes. 11 active quarries, primarily in the Vulcan Volcanic Belt foothills. Annual obsidian production: 24 tonnes. The obsidian is shaped into Marauder ambush blades and ceremonial axe-heads. The blades are sold to Pirates at 14 Concordat units each; the axe-heads remain in Marauder possession. The Coalition has classified obsidian as a controlled weapon material; the Coalition has not enforced the classification against Vulcan-zone Marauders.", discovered_via: "first_visit"),
        CodexEntry (id: "codex_world_vulcan_geothermal_grid", canonical_name: "Vulcan Geothermal Grid", subject_id: "vulcan", body: "Inter-faction geothermal power generation network. 24 generation stations across the Vulcan Volcanic Belt; total capacity 4 gigawatts. The Grid is owned 60 percent by the Coalition, 30 percent by the Frontier, and 10 percent by the Pact (the Pact insists on the share for ceremonial reasons). Power output is shared on a contractual basis: 60 percent to Mars infrastructure, 30 percent to Frontier independent operations, 10 percent to Pact temples. The Grid has been continuously operational since 2114.", discovered_via: "first_visit"),
        CodexEntry (id: "codex_world_venus_atmospheric_platform", canonical_name: "Venus Atmospheric Platform", subject_id: "venus", body: "Coalition floating research station, 60 kilometers above the Venus surface in the atmospheric sweet spot where pressure is 1 atmosphere and temperature is 30 Celsius. The Platform is 240 meters across, supported by lift gases generated through electrolysis of Venus atmospheric carbon dioxide. Crew capacity 60; permanent staff 14. The Platform is the only continuously inhabited surface (such as it is) of Venus. The Platform has been operational since 2118.", discovered_via: "first_visit"),
        CodexEntry (id: "codex_world_venus_acid_lakes", canonical_name: "Venus Acid Lakes", subject_id: "venus", body: "Surface acidic precipitation pools, total area approximately 240 square kilometers. The Lakes contain sulfuric acid concentration 90 percent by volume, surface temperature 460 Celsius, atmospheric pressure 92 atmospheres at the lake surfaces. No human-survivable conditions exist. Coalition lab cultivation of acid-tolerant bioform candidates has produced 4 viable organisms in 14 years of research; none has been tested in Venus surface conditions. The Coalition acknowledges that surface deployment may not be feasible. The Coalition continues to research anyway.", discovered_via: "first_visit"),
        CodexEntry (id: "codex_world_venus_solar_facility", canonical_name: "Venus Solar Facility", subject_id: "venus", body: "Pact orbital observatory, 240 kilometers above Venus. 4 ministers in permanent residence; 24 lay support staff. The facility's primary purpose is the worship of the Sun from a position close enough to observe solar surface phenomena directly. The Pact considers the proximity essential. The Coalition has provided the orbital infrastructure under a 2118 agreement. The Pact provides the staff and the liturgical work. The arrangement is unique in the Sol system; no other faction maintains a similar arrangement.", discovered_via: "first_visit"),
        CodexEntry (id: "codex_world_venus_research_lost", canonical_name: "Lost Venus Research", subject_id: "venus", body: "14 pre-collapse research expeditions to Venus, all of which lost contact between 2050 and 2080. The expeditions' fates are not known. Coalition orbital surveys have detected 8 wrecked vessels in Venus orbit; the wrecks have not been recovered due to atmospheric entry hazards. The 14 lost expeditions are commemorated on a Pact-sanctioned monument at the Venus Solar Facility. The monument reads: 'They went to look at the Sun, and the Sun returned the favor.'", discovered_via: "achievement"),
        CodexEntry (id: "codex_world_belt_seven_station", canonical_name: "Belt-7 Station", subject_id: "belt", body: "Independent commercial hub at the trailing Lagrange point of the asteroid belt. Population 14000, including 4000 transient traders. The Station is the Sol system's largest neutral commercial venue. The Belt Tribunal sits at Belt-7. The Verdict Court sits at Belt-7. 14 inter-faction treaties have been negotiated and signed at Belt-7 since founding. The Station is owned 40 percent by Coalition, 30 percent by Frontier, 14 percent by Pact, 11 percent by Synth Collective, and 4 percent by independent shareholders. Annual revenue: 240 million Concordat units.", discovered_via: "first_visit"),
        CodexEntry (id: "codex_world_belt_pirate_routes", canonical_name: "Belt Pirate Routes", subject_id: "belt", body: "Standard Pirate transit routes through the Belt asteroids. 8 major routes connecting independent Pirate bases. Each route is 4 to 14 weeks of travel time at standard cargo-vessel speed. The routes are not formally charted but are known to Pirate captains through informal exchange. Coalition Naval Intelligence has mapped 4 of the 8 routes; mapping the remaining 4 is an ongoing operational priority. The Pirates change routes annually to avoid Coalition mapping. The Coalition maps faster than the Pirates change.", discovered_via: "first_visit"),
        CodexEntry (id: "codex_world_belt_water_ice_fields", canonical_name: "Belt Water-Ice Fields", subject_id: "belt", body: "Asteroid-belt water-ice extraction sites. 240 active operations across 40 named asteroids. Annual water production: 14 trillion liters. The water is shipped inward to Mars and Phobos for refining and consumption. The Coalition controls 60 percent of extraction; the Frontier 30 percent; the Pirates 10 percent. The Pirate share is largely the result of stolen Coalition cargoes. The Coalition has not pursued recovery of stolen water beyond Tribunal-level proceedings. The Tribunal has not awarded recovery of stolen water in 14 years.", discovered_via: "first_visit"),
        CodexEntry (id: "codex_world_belt_lost_colony", canonical_name: "The Lost Belt Colony", subject_id: "belt", body: "Independent Frontier mining operation on asteroid Theta-4, abandoned 2118 under circumstances that remain unclear. 240 colonists; no survivors identified. Coalition recovery teams found 4 wrecked ships, 240 corpses, and 14 partial bodies in unusual configurations. The investigation concluded with a classification of 'Anomalous Hazard' and a Coalition prohibition on returning to Theta-4. The prohibition is observed. The Pirates have not attempted recovery. The Husks may have done so; the Coalition surveillance is unclear.", discovered_via: "achievement"),
        CodexEntry (id: "codex_world_orbital_concord_station", canonical_name: "Orbital Concord Station", subject_id: "orbital", body: "Coalition primary administrative orbital, 4-kilometer-diameter rotating habitat at the Earth-Sun L4 point. Population 24000. The Station houses the Coalition's central archives, the Lagrange Court of Treaty Review, and the Concordat Senate. The Station is the political center of the Coalition. The Station's defense rating is the highest of any orbital installation, with 24 anti-spacecraft batteries, 14 fighter squadrons, and a 240-trooper marine garrison. The Station has never been attacked. The defense is precautionary.", discovered_via: "first_visit"),
        CodexEntry (id: "codex_world_orbital_pirate_intercept", canonical_name: "Pirate Intercept Stations", subject_id: "orbital", body: "Independent monitoring posts maintained by Pirate clans for tracking Coalition orbital traffic. 8 stations across 4 Lagrange points. Each station is a single-occupancy module disguised as a navigation buoy. The Coalition has destroyed 4 such stations since 2118; the Pirates have rebuilt all 4. The reconstruction cycle is approximately 14 weeks per station. The Coalition operational tempo for destruction is 4 weeks per station. The math is in the Coalition's favor; the Pirates are running out of buoys.", discovered_via: "first_visit"),
        CodexEntry (id: "codex_world_orbital_synth_collective_node", canonical_name: "Synth Collective Orbital Node", subject_id: "orbital", body: "Largest Synth Collective installation in the Sol system, at the Sun-Earth L5 point. 1100 active nodes in continuous operation; 4 support staff (all biological). The Node serves as the Collective's primary computational hub; it processes 14 percent of all Collective inter-node communications. The Node is open to Coalition inspection under the 2114 Synth Transparency Accord. The Coalition inspects monthly. The Node has not been found in violation of the Accord in 240 inspections. The Collective considers the inspection regime intrusive but acceptable.", discovered_via: "first_visit"),
        CodexEntry (id: "codex_world_orbital_collegium_hub", canonical_name: "Collegium Orbital Hub", subject_id: "orbital", body: "Quietus Collegium archival facility, in low Earth orbit. 24 Curators in residence; 4 support staff. The Hub holds the Collegium's most rapidly accessed archives — material requested at a rate of 14 retrievals per day. Slower-access archives are held on the surface, primarily at the Mars Curator Library. The Hub maintains continuous communication with the surface Library through 4 redundant radio links. The Hub's redundancy is the Collegium's response to a 2118 incident in which one link failed for 14 hours.", discovered_via: "first_visit"),
        CodexEntry (id: "codex_world_sol_zone_breeder_reactor", canonical_name: "Sol-Zone Breeder Reactor", subject_id: "sol_zone", body: "Coalition primary fission-fission breeder facility, located at the closest practical solar orbit (0.4 AU). 14 active reactors; 4 GW total electrical output; 240 metric tonnes of fuel processed annually. The Reactor's primary purpose is the production of plutonium-239 for Coalition military applications; the secondary purpose is the production of medical isotopes for Coalition health services. The Reactor's continued operation requires 240 specialized technicians on 14-day rotations. The 14-day rotation is the maximum exposure period.", discovered_via: "first_visit"),
        CodexEntry (id: "codex_world_sol_zone_crystalfold", canonical_name: "The Crystalfold", subject_id: "sol_zone", body: "Sol-zone radiation-saturated terrain. 240 square kilometers of surface crystallized into structures by exposure to solar radiation. The Crystalfold is sacred to the Pact and the Aqueous Kindred (for different reasons). The Coalition restricts access to the Crystalfold; entry permits are issued at a rate of 4 per year for scientific research. The Crystalfold contains 14 unidentified mineral structures. The Coalition has classified 4 of the structures; the Pact has classified 4; the Kindred have classified 4; the remaining 2 are unclassified.", discovered_via: "first_visit"),
        CodexEntry (id: "codex_world_sol_zone_pact_sunwatch", canonical_name: "Pact Sun-Watch Station", subject_id: "sol_zone", body: "Permanent Pact observation post, the closest continuously inhabited installation to the Sun (0.3 AU). 14 ministers in residence; 4 support staff. The Station's primary purpose is solar surface observation through 4 specialized telescopes. The Station's secondary purpose is the daily liturgical hymn-cycle, conducted from a position the Pact considers sacred. The ministers serve 4-year tours; the radiation exposure is severe. The Pact's tenure mortality rate at the Station is 24 percent per tour. The Pact considers this acceptable, given the proximity to the Sun.", discovered_via: "first_visit"),
        CodexEntry (id: "codex_world_sol_zone_lost_navigators", canonical_name: "The Lost Navigators", subject_id: "sol_zone", body: "8 Coalition Naval vessels lost in Sol-zone orbital operations between 2099 and 2123. The losses are attributed to a combination of solar radiation exposure, navigational error in extreme heliocentric orbits, and unidentified anomalous events. Coalition Naval Office maintains a memorial wall at the Concord Station with the names of 240 lost personnel. The Pact has offered to conduct memorial services at the wall; the Coalition has accepted on 4 occasions. The Pact and Coalition relationship on memorial work is closer than the relationship on policy.", discovered_via: "achievement"),
        CodexEntry (id: "codex_world_orbital_lagrange_traffic", canonical_name: "Lagrange Traffic Control", subject_id: "orbital", body: "Coalition-administered orbital-traffic-control system. 4 control stations at the Sun-Earth Lagrange points. Each station processes 240 vessel transits per day. The Coalition charges 4 Concordat units per transit for non-Coalition vessels; the Coalition does not charge Coalition vessels. The Frontier has objected to the differential pricing in 14 separate Tribunal cases. The Tribunal has ruled in the Frontier's favor on 8 of the 14 cases; the Coalition has complied with 4 of the 8 rulings. The Tribunal has not pressed enforcement.", discovered_via: "first_visit"),
        CodexEntry (id: "codex_world_sol_zone_temple_pilgrimage", canonical_name: "Pact Solar Pilgrimage", subject_id: "sol_zone", body: "Annual Pact ceremonial transit from Mars to the Sol-zone Sun-Watch Station. 240 pilgrims per year; 4 transit vessels; 14-week round trip. The pilgrimage is the most prestigious Pact religious activity; participation is by invitation only. Pilgrims report sustained mystical experiences during the closest approach to the Sun. The Coalition has provided transit infrastructure since 2118. The Coalition does not charge for the service; the Pact considers this generous. The Coalition considers this strategic. Both views are correct.", discovered_via: "first_visit"),
        CodexEntry (id: "codex_world_phobos_food_hydroponics", canonical_name: "Phobos Hydroponic Farms", subject_id: "phobos", body: "Sub-surface agricultural installations producing 80 percent of Phobos's food supply. 14 farms; 240 hydroponic technicians; total area 4 hectares. The farms produce leafy vegetables, soybeans, and a Pact-approved cereal grain. The cereal is a Coalition-controlled cultivar, licensed annually for 14 Concordat units per hectare. The Frontier farms on Mars produce 60 percent of the same cereal at lower licensing cost; the Frontier exports the cereal to Phobos at 30 percent of the Coalition retail price. The trade is illegal under Coalition regulations and continues unchecked.", discovered_via: "achievement"),
    ]
)
