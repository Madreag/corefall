StorytellerDialog (
    storyteller_id: "ironman",
    canonical_name: "Ironman",
    personality_summary: "Grim. Military. No second chances. The permadeath storyteller. Tells you what the operation costs and then tells you to pay it. Will not lie about the odds.",
    intro_dialog: [
        DialogLine (line: "Captain. Ironman. We will not, in this chair, save."),
        DialogLine (line: "One file. One save slot. The file is named. The name is yours. The file lives or dies with the run. Read this carefully."),
        DialogLine (line: "I do not, in this chair, balance the table. I report the table. The table is what it is. The table will not, in this chair, be adjusted for your morale."),
        DialogLine (line: "Three observations. The first: the factions will not, in this chair, hesitate. The second: the factions are, in this chair, smarter than they would be in any other chair. The third: the factions know that you are in this chair, and they will, by my standing order, act accordingly."),
        DialogLine (line: "Your favorite character will die. I do not yet know when. The chair will, when the time comes, not soften the report."),
        DialogLine (line: "You may, at any time, withdraw. The withdrawal is final. The run is, in that case, closed. The file is, in that case, archived. The chair does not negotiate the withdrawal."),
        DialogLine (line: "Begin. The chair holds the line."),
    ],
    event_dialog: [
        DialogLine (line: "Event. Severity: critical. The chair is reporting."),
        DialogLine (line: "Two of your squad are down. One will recover with field treatment. The other will not. The chair is not making a recommendation. The chair is reporting."),
        DialogLine (line: "Solar flare. All electronics offline for one hour. The chair will not, in this case, soften the reading. You will not, in this hour, have radio."),
        DialogLine (line: "A faction has declared war. The declaration is, by the chair's protocol, final. The faction will not, in this chair, retract."),
        DialogLine (line: "The chair will not, in this debrief, list the alternatives you had. The chair will list what you did. The list is short."),
        DialogLine (line: "Your choice is recorded. The consequences are queued. The chair will, in fourteen minutes, report the resolution. Do not, in those fourteen minutes, ask the chair for reassurance. The chair does not provide reassurance."),
        DialogLine (line: "Hold the line. The line is, in this chair's reckoning, what we have."),
    ],
    outro_dialog_win: [
        DialogLine (line: "Captain. The run is closed. The line was held."),
        DialogLine (line: "Forty-one fallen. Six saved. The ratio is, in this chair's reckoning, acceptable. The chair does not, in any chair, congratulate. The chair reports."),
        DialogLine (line: "The campaign produced three named successes and twelve unnamed ones. The unnamed ones will, in time, be named. The named ones will, in time, be forgotten. Both processes are, in this chair, ordinary."),
        DialogLine (line: "The file is archived. The file is final. The next file will, when you initiate, be a new file. The chair does not revisit."),
        DialogLine (line: "Rest, Captain. The chair will, in your absence, hold the line."),
        DialogLine (line: "Until next time. The chair stands."),
    ],
    outro_dialog_loss: [
        DialogLine (line: "Captain. The line broke. The run is closed."),
        DialogLine (line: "The chair will, in this debrief, not soften the report. Forty-eight fallen. Two saved. The two saved are, in this chair's reckoning, the campaign's continued legacy."),
        DialogLine (line: "The fatal error was, in this chair's analysis, the third decision in the seventh hour. The chair will not, in this debrief, elaborate. The decision was yours. The chair records, only."),
        DialogLine (line: "The file is archived. The file is final. The chair does not, in any chair, offer second runs of the same file. The next run will be a new file. The chair maintains the standard."),
        DialogLine (line: "The campaign will, in its own time, be remembered for what it was: a held line, eventually broken. This is, in this chair's reckoning, every campaign."),
        DialogLine (line: "Rest, Captain. The chair stands. The chair will, in your absence, prepare the next file."),
    ],
    outro_dialog_abandon: [
        DialogLine (line: "Captain. You are withdrawing. The chair records."),
        DialogLine (line: "The withdrawal is final. The file is archived as: abandoned. The chair does not, in any circumstance, reopen abandoned files."),
        DialogLine (line: "The chair makes no judgment. The chair records. The chair will, in your absence, maintain the standard."),
        DialogLine (line: "When you initiate a new file, the chair will, in that file, hold the same line. The chair does not adjust."),
        DialogLine (line: "Until then, Captain. The chair stands."),
    ],
)
