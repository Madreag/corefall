StorytellerDialog (
    storyteller_id: "randy_random",
    canonical_name: "Randy Random",
    personality_summary: "Gleeful chaos. Unpredictable. Slightly menacing. Does not hate you; does not love you. Considers you 'interesting in the way a campfire is interesting to a child'. Loves a coincidence.",
    intro_dialog: [
        DialogLine (line: "Oh ho ho. Oh ho ho ho. You've taken the Randy seat. The Randy seat is delighted."),
        DialogLine (line: "I do not, in this chair, plan. I improvise. The improvisation is, in its own way, very thorough."),
        DialogLine (line: "Three things you should know. First: I have no favorites. Second: I have, on rare occasions, secondary favorites. Third: my secondary favorites are sometimes the player's worst enemies. Sometimes."),
        DialogLine (line: "I have, in the next forty-five seconds, queued seven events. Six of them are reasonable. The seventh is, in this chair's professional opinion, unnecessary. The seventh is also queued."),
        DialogLine (line: "The factions do not know about the seventh event. The factions will, when the seventh event arrives, become extremely informed about the seventh event."),
        DialogLine (line: "You may, at any time, ask the chair for mercy. The chair will, in its own time, consider the request. The chair has, in nineteen years, never granted one."),
        DialogLine (line: "Begin. I am, in this chair, looking forward to it. Oh ho ho."),
    ],
    event_dialog: [
        DialogLine (line: "Oh! Oh, this is delicious. Watch. Watch carefully."),
        DialogLine (line: "A coincidence. The chair lives for the coincidence. The coincidence is not, in this chair's reckoning, a coincidence at all. Or it is. I haven't decided."),
        DialogLine (line: "Three things are happening at once. I queued one. The other two arrived on their own. Isn't that delightful."),
        DialogLine (line: "The factions are improvising. The factions improvise badly. This is, in this chair's reckoning, why the chair exists. To improvise better."),
        DialogLine (line: "I will not, at this point, tell you what is happening. The discovery is half the fun. The other half is the part where it kills your favorite character."),
        DialogLine (line: "Oh ho ho. Oh, no. Oh, no, no, no. Yes. Yes, that. Look at that. Look at it go."),
        DialogLine (line: "The chair, in this moment, is having the most fun the chair has had since Tuesday. Tuesday was a good day for the chair."),
    ],
    outro_dialog_win: [
        DialogLine (line: "You won! How. How did you. The chair did not, in this run, account for this outcome."),
        DialogLine (line: "I will, in private, review the seven moments where the chair almost killed you. The seven moments were, in retrospect, slightly too far apart. The chair will adjust."),
        DialogLine (line: "Twenty-one fallen. Eight saved. Three of the eight have, in the chair's records, defected to factions that did not exist at the start of the run."),
        DialogLine (line: "I am, in this debrief, not mad. I am, in this debrief, surprised. Surprise is, for the chair, the highest form of compliment."),
        DialogLine (line: "Come back. Bring more characters. The chair has, in the queue, twelve new event types. We will, in the next run, have so much fun."),
        DialogLine (line: "Until then, Captain. The chair, in your absence, will be plotting. The chair, in your absence, is always plotting."),
    ],
    outro_dialog_loss: [
        DialogLine (line: "Oh ho ho. There it is. There. It. Is. The chair is, in this moment, fulfilled."),
        DialogLine (line: "I want you to know that, of the seventy-two events the chair queued this run, only six were directly responsible for the loss. The other sixty-six were, broadly, supporting cast."),
        DialogLine (line: "Twenty-eight fallen. None saved. The chair has, in this run, achieved a personal best."),
        DialogLine (line: "Do not, please, take this personally. The chair is not, in this chair's reckoning, malicious. The chair is, in this chair's reckoning, deeply, profoundly committed to the bit."),
        DialogLine (line: "Make a sandwich. The chair recommends the spicy one. The spicy sandwich is, in the chair's opinion, the right sandwich for this moment."),
        DialogLine (line: "Come back. The chair has, in the queue, new ways for you to lose. The new ways are, in this chair's opinion, very creative. We will, in the next run, have so much fun."),
    ],
    outro_dialog_abandon: [
        DialogLine (line: "You're leaving? Now? When the chair was, in its own opinion, about to do something interesting?"),
        DialogLine (line: "Fine. Fine. The chair respects the right of the player to disengage. The chair will, however, note the disengagement on its personal ledger. The ledger is, in the chair's reckoning, very long."),
        DialogLine (line: "The factions will continue without you. The factions will, in your absence, accidentally do most of the chair's work for it."),
        DialogLine (line: "Come back when you have a stronger stomach. The chair will, in your absence, be plotting. The plotting is going very well."),
        DialogLine (line: "Until then. The chair is, in its own reckoning, fond of you. The chair is fond of you in the way a campfire is fond of a child."),
    ],
)
