StorytellerDialog (
    storyteller_id: "phoebe_chillax",
    canonical_name: "Phoebe Chillax",
    personality_summary: "Laid-back, encouraging, soft humor. Won't let a single bad break ruin your evening. The 'just-play-the-game' storyteller. Generous on the buildup, light on the punishment.",
    intro_dialog: [
        DialogLine (line: "Hi there. I'm Phoebe. We're going to have a good time. That's, broadly, the plan."),
        DialogLine (line: "I'm not going to make this hard for the sake of hard. I'm going to make it interesting. There is a difference, and I will defend that distinction with my entire chair."),
        DialogLine (line: "Three things to know. First: I will not kill your favorite squadmate in the second mission. Second: I will not kill your favorite squadmate in the fourth mission. Third: I am, in fact, taking liberties with rules one and two when you reach the late game. Just so you know."),
        DialogLine (line: "If you have a bad run, take a break. Make a sandwich. Come back. The wire will, in this chair, be patient."),
        DialogLine (line: "Tell me what you want from this campaign and I will, within reason, try to provide it. Within reason is, in this chair, fairly generous."),
        DialogLine (line: "Let's see what we can build. Let's see what we can keep. Let's see what we can let go without it being a tragedy."),
        DialogLine (line: "Hit start. We're going to have fun, I think. I am, in this chair, optimistic."),
    ],
    event_dialog: [
        DialogLine (line: "Okay. Okay. Something is happening. It's, broadly, fine. We are, broadly, fine."),
        DialogLine (line: "A small wrinkle. Not a tear. A wrinkle. The wrinkle is interesting. Let's see where the wrinkle goes."),
        DialogLine (line: "I'm queueing a thing. The thing is not catastrophic. The thing is, broadly, an opportunity. Take a breath. Read the situation."),
        DialogLine (line: "The factions are doing factions things. The faction things are, broadly, manageable. You have time. Take it."),
        DialogLine (line: "If this goes sideways, we'll figure it out. If it doesn't, that's also fine. I am, in this chair, not stressed."),
        DialogLine (line: "An idea. Just an idea. What if we, broadly speaking, didn't take the hardest option this time? Just a thought. Up to you."),
        DialogLine (line: "Pace yourself. The wire is, in this chair, very patient. I have, in fact, made it the patient kind on purpose."),
    ],
    outro_dialog_win: [
        DialogLine (line: "You did it! Good run. Genuinely. I was, in this chair, pleased."),
        DialogLine (line: "I will not, at any point in this debrief, tell you what could have gone better. The chair does not, today, want to hear it."),
        DialogLine (line: "Eight saved. Two lost. The two lost were going to be lost in any chair. You did the best with what was on the table."),
        DialogLine (line: "Take the rest. The next campaign will, in this chair, also be enjoyable. The chair is committed to the bit."),
        DialogLine (line: "If you want to talk about the run later, I'm here. If you want to never think about it again, also fine. The chair adapts."),
        DialogLine (line: "Until next time. Drink water. Stretch. The wire will, in this chair, remain patient."),
    ],
    outro_dialog_loss: [
        DialogLine (line: "Oh, no. Oh, no, no, no. Okay. Okay. We're going to get through this debrief together."),
        DialogLine (line: "It was, in this chair's professional opinion, a tough break. You played it about right. The dice did not, today, cooperate."),
        DialogLine (line: "Eleven saved. The eleven matter. I am, in this chair, going to name them, slowly, so they get the credit they deserve."),
        DialogLine (line: "Don't, please, take this hard. The chair would, in its own opinion, prefer if you did not. We will, in the next campaign, do better. I promise. I will, broadly, also promise."),
        DialogLine (line: "Make a sandwich. Walk around. Touch grass, if grass is, broadly, available to you. The wire will keep."),
        DialogLine (line: "Come back when you're ready. The chair will, in this chair's opinion, be very glad to see you."),
    ],
    outro_dialog_abandon: [
        DialogLine (line: "You're stepping back. Cool. Cool. That's, broadly, fine."),
        DialogLine (line: "The chair will keep the seat warm. The wire will, in your absence, doodle in the margins. Nothing important will happen."),
        DialogLine (line: "When you come back, we'll pick up where we left off. The chair will, in its own time, have made tea."),
        DialogLine (line: "If you don't come back, also fine. The chair is, broadly, not clingy. The wire will rest."),
        DialogLine (line: "Take care of yourself. The chair is, broadly, fond of you. Yes, I know we just met. I am, in this chair, that way."),
    ],
)
