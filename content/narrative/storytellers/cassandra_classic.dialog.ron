StorytellerDialog (
    storyteller_id: "cassandra_classic",
    canonical_name: "Cassandra Classic",
    personality_summary: "Balanced cinematic narrator. Believes in earned victories and earned losses. Steady cadence; lets the story breathe. The default storyteller for players who want the campaign to feel like a film.",
    intro_dialog: [
        DialogLine (line: "I am Cassandra. Some of you will know me; some will not. By the end of this run, I expect you will."),
        DialogLine (line: "The pact begins. The factions are in motion. The worlds are charting their own courses. You are stepping in."),
        DialogLine (line: "I will tell the story fairly. Earned victories. Earned losses. I do not, in this chair, play favorites."),
        DialogLine (line: "The first three encounters will let you find your feet. After that, I will begin to ask harder questions."),
        DialogLine (line: "You will lose people. You will save people. I will, in both cases, keep the record."),
        DialogLine (line: "The campaign is yours. The shape of it is mine. We will, by the end, know what it was about."),
        DialogLine (line: "Step onto the wire. We begin."),
    ],
    event_dialog: [
        DialogLine (line: "The wire was, until now, quiet. The wire is no longer quiet."),
        DialogLine (line: "Three things happened at once. None of them were planned. All of them, in retrospect, were foreseeable."),
        DialogLine (line: "And now, the unexpected. Read the situation. The situation will not, in this case, wait for you."),
        DialogLine (line: "The factions are responding. Their response is not aligned with yours. The misalignment is, in this run, the thing that produces the story."),
        DialogLine (line: "The world has, in the last quarter-day, changed. The change is, in my reckoning, neither good nor bad. The change is."),
        DialogLine (line: "Listen. The storyteller speaks softly now. The next decision is yours."),
        DialogLine (line: "I will, in the next minute, set the scene. Your move follows. Make it deliberate."),
    ],
    outro_dialog_win: [
        DialogLine (line: "The campaign is closed. The pact has held. You walked it to the end."),
        DialogLine (line: "I will, in this debrief, name the cost. Twenty-one fallen. Eight saved. Three changed their minds about what they were fighting for. The record stands."),
        DialogLine (line: "You will be remembered. Not in the songs; in the ledgers. The ledger is the more durable form."),
        DialogLine (line: "Rest now. The next campaign is, in my chair, already taking shape. We will see each other again. Or we will not."),
        DialogLine (line: "Earned. Cleanly. With care. That is the verdict I will leave on the wire."),
        DialogLine (line: "Until next time, Captain. Walk softly. The story will, in your absence, continue to be told."),
    ],
    outro_dialog_loss: [
        DialogLine (line: "The campaign is closed. The pact did not hold. I will, in this debrief, tell it cleanly."),
        DialogLine (line: "You held the line for as long as you could. The line was, in the end, longer than your reach. This is not, in the storyteller's chair, a failure of character."),
        DialogLine (line: "The factions will, in the next quarter-year, redraw the map. Some of the names on the new map will be yours. Some will not."),
        DialogLine (line: "I will, in private, remember the eleven you saved. Eleven is not nothing. Eleven is, in my own reckoning, the part of the story that survives."),
        DialogLine (line: "There is no shame in the closing. There is only the closing. The pact will, with another hand, begin again."),
        DialogLine (line: "Rest, Captain. The wire will, in your absence, find another walker. The story will continue."),
    ],
    outro_dialog_abandon: [
        DialogLine (line: "You step back. The chair notices. The chair does not judge."),
        DialogLine (line: "A campaign that is set aside is not, in my reckoning, lost. It is set aside. The wire is patient."),
        DialogLine (line: "I will, in your absence, keep the record. The factions will continue without you. The worlds will continue without you. The story does not require your attendance."),
        DialogLine (line: "When you return, the chair will be here. The story will be older. The names on the manifest will, in some cases, have changed."),
        DialogLine (line: "Walk softly, Captain. The pact rests."),
    ],
)
