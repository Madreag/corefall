Achievements (
    schema_version: 1,
    description: "M25A achievement string registry. 75 launch achievements across combat / survival / engineering / medical / faction / boss / collection / multiplayer / storyteller / hidden / accessibility / modding categories at bronze / silver / gold / platinum tiers.",
    entries: [
        Achievement (id: "ach_first_blood", canonical_name: "First Blood", description: "Kill your first hostile.", criteria: "event.combat.kill_count >= 1", category: "combat", tier: "bronze", flavor: "Welcome to Corefall. The bullet went faster than the regret."),
        Achievement (id: "ach_century_club", canonical_name: "Century Club", description: "Kill 100 hostiles in a single mission.", criteria: "event.combat.kill_count_mission >= 100", category: "combat", tier: "silver", flavor: "Statistically, you missed 47 of them. We are not telling you which."),
        Achievement (id: "ach_first_headshot", canonical_name: "Aim High", description: "Score your first headshot kill.", criteria: "event.combat.headshot_kill >= 1", category: "combat", tier: "bronze", flavor: "The Coalition sniper manual says aim center mass. The Coalition sniper manual has never met you."),
        Achievement (id: "ach_thirty_headshots", canonical_name: "Thirty Hat-Tricks", description: "Score 30 headshot kills.", criteria: "event.combat.headshot_kill_total >= 30", category: "combat", tier: "silver", flavor: "Thirty stories told in less than a second each. The librarians weep."),
        Achievement (id: "ach_pistol_mastery", canonical_name: "Sidearm Specialist", description: "Score 500 kills with sidearms.", criteria: "event.combat.weapon_class_kills.pistol >= 500", category: "combat", tier: "gold", flavor: "The Coalition issued you a backup weapon. You made it the main one."),
        Achievement (id: "ach_rifle_mastery", canonical_name: "Rifleman", description: "Score 1000 kills with assault rifles.", criteria: "event.combat.weapon_class_kills.rifle >= 1000", category: "combat", tier: "gold", flavor: "The HK 417 is rated to one jam per 1100 rounds. Yours has 0.4 percent more jams than that. The bullet still arrives."),
        Achievement (id: "ach_sniper_mastery", canonical_name: "Marksman", description: "Score 100 sniper kills at distances over 600 meters.", criteria: "event.combat.sniper_long_range_kills >= 100", category: "combat", tier: "gold", flavor: "The bullet drops two centimeters per hundred meters. The target dropped completely."),
        Achievement (id: "ach_shotgun_mastery", canonical_name: "Twelve-Gauge Specialist", description: "Score 200 shotgun kills.", criteria: "event.combat.weapon_class_kills.shotgun >= 200", category: "combat", tier: "silver", flavor: "Close-quarters is wherever you decide it is."),
        Achievement (id: "ach_heavy_mastery", canonical_name: "Heavy Gunner", description: "Score 1000 kills with heavy weapons.", criteria: "event.combat.weapon_class_kills.heavy >= 1000", category: "combat", tier: "gold", flavor: "The M2 Browning has been in continuous Coalition service since 2099. You are why."),
        Achievement (id: "ach_melee_mastery", canonical_name: "Up Close and Personal", description: "Score 50 melee kills.", criteria: "event.combat.melee_kills >= 50", category: "combat", tier: "silver", flavor: "Some conversations cannot be had at a distance."),
        Achievement (id: "ach_no_deaths_mission", canonical_name: "Clean Run", description: "Complete a mission without losing any squad members.", criteria: "event.mission.squad_intact_on_complete == true", category: "combat", tier: "silver", flavor: "Every name still on the roster, every story still being written."),
        Achievement (id: "ach_no_deaths_campaign", canonical_name: "Veteran's Eye", description: "Complete a 10-mission campaign without losing any squad members.", criteria: "event.campaign.squad_intact_complete >= 10", category: "combat", tier: "platinum", flavor: "Ten missions. Same names. The same brass pins, polished a little smoother each time."),
        Achievement (id: "ach_dual_wield", canonical_name: "Two-Gun Sermon", description: "Score 100 kills while dual-wielding.", criteria: "event.combat.dual_wield_kills >= 100", category: "combat", tier: "silver", flavor: "The Coalition manual prohibits the technique. The Coalition manual has not visited the firing range recently."),
        Achievement (id: "ach_grenade_specialist", canonical_name: "Explosive Diplomacy", description: "Score 200 kills with grenades.", criteria: "event.combat.grenade_kills >= 200", category: "combat", tier: "silver", flavor: "The argument was settled. The settlement was four meters wide."),
        Achievement (id: "ach_critical_hit_streak", canonical_name: "Lucky Twenty", description: "Score 20 consecutive critical hits.", criteria: "event.combat.consecutive_critical_hits >= 20", category: "combat", tier: "gold", flavor: "The Coalition statistician's report on this incident reads 'this should not have happened'. It happened."),
        Achievement (id: "ach_survive_thirty_minutes", canonical_name: "Half-Hour Standoff", description: "Survive for 30 minutes in a hostile world without resupply.", criteria: "event.survival.unaided_survival_seconds >= 1800", category: "survival", tier: "bronze", flavor: "The first thirty minutes are luck. The next thirty are skill. You did the luck."),
        Achievement (id: "ach_survive_two_hours", canonical_name: "The Long Game", description: "Survive for 2 hours in a hostile world without resupply.", criteria: "event.survival.unaided_survival_seconds >= 7200", category: "survival", tier: "silver", flavor: "You are now a Frontier veteran by Coalition definition. The Frontier disagrees. Both are correct."),
        Achievement (id: "ach_survive_solo_eight", canonical_name: "Solo Eight", description: "Complete 8 missions as a solo operator.", criteria: "event.campaign.solo_completions >= 8", category: "survival", tier: "gold", flavor: "Squad of one. Casualty rate of one. Survival rate that depends on the next decision."),
        Achievement (id: "ach_survive_boss_unscathed", canonical_name: "Untouchable", description: "Defeat a boss without taking damage.", criteria: "event.combat.boss_kill_no_damage == true", category: "survival", tier: "platinum", flavor: "The boss had 30 phases. You took zero hits. The boss is still wondering what happened."),
        Achievement (id: "ach_survive_anomaly_zone", canonical_name: "Anomaly Walker", description: "Spend 30 minutes in an anomaly zone without anomaly damage.", criteria: "event.survival.anomaly_zone_clean_seconds >= 1800", category: "survival", tier: "gold", flavor: "You learned to throw bolts before you learned to read. Both still serve."),
        Achievement (id: "ach_survive_orbital_breach", canonical_name: "Vacuum Veteran", description: "Survive an orbital atmospheric breach.", criteria: "event.survival.atmosphere_breach_survived == true", category: "survival", tier: "silver", flavor: "Coalition mission planners assumed two minutes of useful consciousness. You needed ninety seconds."),
        Achievement (id: "ach_survive_mars_dust_storm", canonical_name: "Storm Survivor", description: "Complete a mission during a Mars dust storm.", criteria: "event.survival.mars_storm_mission_completed == true", category: "survival", tier: "silver", flavor: "The wind sounded like the manual. Then it sounded like a sergeant. Then it stopped."),
        Achievement (id: "ach_module_repair_first", canonical_name: "Wrench Hand", description: "Complete your first chassis module repair.", criteria: "event.engineering.modules_repaired >= 1", category: "engineering", tier: "bronze", flavor: "The chassis is alive again. So are you. Both temporarily."),
        Achievement (id: "ach_module_repair_hundred", canonical_name: "Field Engineer", description: "Complete 100 chassis module repairs.", criteria: "event.engineering.modules_repaired >= 100", category: "engineering", tier: "silver", flavor: "The Mountain Guild would offer you an apprenticeship. It would take four years. You don't have four years."),
        Achievement (id: "ach_reactor_stabilize", canonical_name: "Reactor Whisperer", description: "Stabilize a critical reactor before meltdown.", criteria: "event.engineering.reactor_stabilizations >= 1", category: "engineering", tier: "gold", flavor: "The temperature came down. The fuel rods stopped glowing. Everyone went home. Most went home."),
        Achievement (id: "ach_base_built", canonical_name: "Foundation Stone", description: "Complete construction of your first fortified base.", criteria: "event.engineering.bases_completed >= 1", category: "engineering", tier: "bronze", flavor: "The walls are concrete. The ceiling is overhead. The neighbors are reconsidering their plans."),
        Achievement (id: "ach_base_built_eight", canonical_name: "Settlement Builder", description: "Complete construction of 8 fortified bases.", criteria: "event.engineering.bases_completed >= 8", category: "engineering", tier: "gold", flavor: "Eight footprints across the system. Eight teams of welders. Eight scars on the planet's surface."),
        Achievement (id: "ach_chassis_modular_swap", canonical_name: "Modular Tinker", description: "Swap a chassis module mid-mission.", criteria: "event.engineering.modules_hot_swapped >= 1", category: "engineering", tier: "bronze", flavor: "The manual says the procedure takes 12 minutes. You did it in four. The manual is now wrong."),
        Achievement (id: "ach_medkit_first_use", canonical_name: "First Aid", description: "Use a medkit for the first time.", criteria: "event.medical.medkit_uses >= 1", category: "medical", tier: "bronze", flavor: "The bleeding stopped. The shaking continued. Both are normal."),
        Achievement (id: "ach_medkit_revive", canonical_name: "Pulse Restored", description: "Revive a downed squad member.", criteria: "event.medical.allies_revived >= 1", category: "medical", tier: "silver", flavor: "Mendez sat up. Mendez asked what year it was. Mendez asked about Park. You answered all three."),
        Achievement (id: "ach_medic_specialist", canonical_name: "Combat Medic", description: "Revive 30 downed squad members across multiple missions.", criteria: "event.medical.allies_revived_total >= 30", category: "medical", tier: "gold", flavor: "The Coalition Veterans Service has thirty letters with your name on the recommendation line. They are filed alphabetically. You are filed under the highest concentration of names per file."),
        Achievement (id: "ach_no_medkit_run", canonical_name: "Cold Comfort", description: "Complete a mission without using a single medkit.", criteria: "event.medical.medkit_uses_mission == 0 && event.mission.completed == true", category: "medical", tier: "silver", flavor: "The Frontier doctrine is to apply pressure and patience. You applied the pressure. The patience was not yours."),
        Achievement (id: "ach_max_squad_health", canonical_name: "Healthy Squad", description: "Complete a mission with every squad member at full HP.", criteria: "event.medical.squad_full_hp_on_complete == true", category: "medical", tier: "gold", flavor: "Mendez did not bleed. Park did not melt. Jenkins did not yell. A statistical impossibility achieved."),
        Achievement (id: "ach_amputation_field", canonical_name: "Field Surgeon", description: "Successfully amputate a damaged limb mid-mission.", criteria: "event.medical.field_amputations_successful >= 1", category: "medical", tier: "silver", flavor: "The trooper kept the limb in a pocket for sentimental reasons. The Coalition manual classifies this as 'authorized but not encouraged'."),
        Achievement (id: "ach_faction_max_rep_coalition", canonical_name: "Concordat Citizen", description: "Reach maximum reputation with the Coalition.", criteria: "event.faction.rep_max.coalition == true", category: "faction", tier: "gold", flavor: "Your name is on a brass pin somewhere. The brass has been polished. The pin is unworn. You are not."),
        Achievement (id: "ach_faction_max_rep_frontier", canonical_name: "Frontier Free", description: "Reach maximum reputation with the Frontier.", criteria: "event.faction.rep_max.frontier == true", category: "faction", tier: "gold", flavor: "A Frontier town named a tavern after you. The tavern has 14 stools. Yours is the one nearest the door."),
        Achievement (id: "ach_faction_max_rep_ronin", canonical_name: "Hall-Honored Ronin", description: "Reach maximum reputation with the Ronin.", criteria: "event.faction.rep_max.ronin == true", category: "faction", tier: "gold", flavor: "The Ronin Hall has a roster. Your name is on it in red ink. Most of the red ink is wet."),
        Achievement (id: "ach_faction_max_rep_synth", canonical_name: "Network Node", description: "Reach maximum reputation with the Synth Collective.", criteria: "event.faction.rep_max.synth == true", category: "faction", tier: "gold", flavor: "The Collective consensus has integrated your decision patterns. The Coalition Civil Affairs office has reviewed the integration. The integration was approved at the 4-minute polling window."),
        Achievement (id: "ach_faction_max_rep_collective", canonical_name: "Kindred Friend", description: "Reach maximum reputation with the Aqueous Kindred.", criteria: "event.faction.rep_max.collective == true", category: "faction", tier: "gold", flavor: "The Kindred sang a verse for you in the Brine Song. The verse runs eight measures. The water carried it for thirty kilometers."),
        Achievement (id: "ach_faction_max_rep_husks", canonical_name: "Husk Recognition", description: "Reach maximum reputation with the Husks.", criteria: "event.faction.rep_max.husks == true", category: "faction", tier: "platinum", flavor: "The Husks do not have reputation in any conventional sense. The Coalition statisticians cannot explain your number. They have stopped trying."),
        Achievement (id: "ach_faction_max_rep_collegium", canonical_name: "Curator's Guest", description: "Reach maximum reputation with the Quietus Collegium.", criteria: "event.faction.rep_max.collegium == true", category: "faction", tier: "gold", flavor: "The Collegium Archive has annotated your file with the words 'add nothing. subtract nothing.' The annotation is itself an addition. The Collegium has not removed it."),
        Achievement (id: "ach_faction_max_rep_starlight", canonical_name: "Sun-Blessed", description: "Reach maximum reputation with the Helios Pact.", criteria: "event.faction.rep_max.starlight == true", category: "faction", tier: "gold", flavor: "A Pact minister consecrated your weapon. The weapon is now slightly warmer to the touch. The effect is not reproducible."),
        Achievement (id: "ach_boss_hollow_king", canonical_name: "Killed the King", description: "Defeat The Hollow King.", criteria: "event.boss.kills.hollow_king >= 1", category: "boss", tier: "gold", flavor: "The Coalition Mars statisticians have updated the Hollow King survival rate to 'first observed kill'. The page is in your name."),
        Achievement (id: "ach_boss_frozen_heart", canonical_name: "Heart-Stopper", description: "Defeat The Frozen Heart.", criteria: "event.boss.kills.frozen_heart >= 1", category: "boss", tier: "gold", flavor: "The Europa subsurface ocean is twenty kilometers deep. The Heart was at eight. Your boots were at fourteen."),
        Achievement (id: "ach_boss_crimson_tide", canonical_name: "Tide-Breaker", description: "Defeat The Crimson Tide.", criteria: "event.boss.kills.crimson_tide >= 1", category: "boss", tier: "gold", flavor: "The Mars dust settled. The reform never happened. Phase four was canceled by phase three's failure."),
        Achievement (id: "ach_boss_eclipse_walker", canonical_name: "Eclipse Ended", description: "Defeat The Eclipse Walker.", criteria: "event.boss.kills.eclipse_walker >= 1", category: "boss", tier: "gold", flavor: "Microgravity is a tactical disadvantage. You weighted yourself with three Dense Marbles."),
        Achievement (id: "ach_boss_last_star", canonical_name: "Last Star Out", description: "Defeat The Last Star.", criteria: "event.boss.kills.last_star >= 1", category: "boss", tier: "platinum", flavor: "Five phases. Five biomes. Five separate reasons the boss should have won. Each reason held for less than four minutes."),
        Achievement (id: "ach_anomaly_all_seen", canonical_name: "Witness", description: "Encounter all named anomaly types.", criteria: "event.collection.anomalies_witnessed_count >= 30", category: "collection", tier: "gold", flavor: "Coalition Survey Service maintains 31 anomaly classifications. Your field log holds 30 of them. The thirty-first is theoretical."),
        Achievement (id: "ach_artifact_all_collected", canonical_name: "Curator", description: "Collect all named artifact types.", criteria: "event.collection.artifacts_collected_count >= 20", category: "collection", tier: "platinum", flavor: "Twenty artifacts. Five locations classified. Fifteen unclassified. The Collegium has been respectful."),
        Achievement (id: "ach_codex_complete", canonical_name: "Read the Manual", description: "Collect all 300 codex entries.", criteria: "event.collection.codex_entries_complete == true", category: "collection", tier: "platinum", flavor: "The Concordat Archive has a section on troopers who completed the codex. The section contains your name and 14 others. The other 14 are dead."),
        Achievement (id: "ach_world_all_visited", canonical_name: "System Traveler", description: "Visit all 12 worlds.", criteria: "event.collection.worlds_visited_count >= 12", category: "collection", tier: "platinum", flavor: "Twelve worlds. Twelve climates. Twelve attempts to kill you. Eleven survived to the next world."),
        Achievement (id: "ach_recipe_all_unlocked", canonical_name: "Master Crafter", description: "Unlock all crafting recipes.", criteria: "event.collection.recipes_unlocked_count >= 50", category: "collection", tier: "gold", flavor: "Fifty recipes. Twenty thousand hours of practice. One mission that exceeded all of them."),
        Achievement (id: "ach_npc_all_dialog_complete", canonical_name: "Conversationalist", description: "Complete all dialog hooks with all 24 named NPCs.", criteria: "event.collection.npc_dialog_complete_count >= 24", category: "collection", tier: "gold", flavor: "Twenty-four people told you twenty-four versions of the same story. Yours was the twenty-fifth. They told it back."),
        Achievement (id: "ach_mp_first_lan", canonical_name: "Local Network", description: "Host or join your first LAN mission.", criteria: "event.multiplayer.lan_mission_count >= 1", category: "multiplayer", tier: "bronze", flavor: "The router lights blinked. The packets flowed. The friend on the other end yelled."),
        Achievement (id: "ach_mp_four_squad", canonical_name: "Four-Person Squad", description: "Complete a mission with a 4-player squad.", criteria: "event.multiplayer.squad_4_completions >= 1", category: "multiplayer", tier: "silver", flavor: "Four players. Four voices. Four overlapping plans. One mission objective completed somehow."),
        Achievement (id: "ach_mp_mmo_first_connect", canonical_name: "Persistent Universe", description: "Connect to a Corefall MMO server for the first time.", criteria: "event.multiplayer.mmo_login_count >= 1", category: "multiplayer", tier: "bronze", flavor: "The server welcomed you. The server welcomed 4400 others. Most are not in your line of sight."),
        Achievement (id: "ach_mp_lan_party_hundred", canonical_name: "Party Veteran", description: "Complete 100 hours of multiplayer time.", criteria: "event.multiplayer.total_hours >= 100", category: "multiplayer", tier: "silver", flavor: "One hundred hours of yelling at squadmates. One hundred hours of being yelled at. The math balances."),
        Achievement (id: "ach_storyteller_cassandra", canonical_name: "Classic Run", description: "Complete a 10-mission campaign under Cassandra Classic.", criteria: "event.storyteller.runs.cassandra_classic >= 10", category: "storyteller", tier: "silver", flavor: "Cassandra balanced the campaign. You balanced the budget. Both were close calls."),
        Achievement (id: "ach_storyteller_phoebe", canonical_name: "Chillax Run", description: "Complete a 10-mission campaign under Phoebe Chillax.", criteria: "event.storyteller.runs.phoebe_chillax >= 10", category: "storyteller", tier: "silver", flavor: "Phoebe sat in the background. The mission rolled forward. Nobody died. The Coalition statistical office is suspicious."),
        Achievement (id: "ach_storyteller_randy", canonical_name: "Random Run", description: "Complete a 10-mission campaign under Randy Random.", criteria: "event.storyteller.runs.randy_random >= 10", category: "storyteller", tier: "gold", flavor: "Randy threw fourteen separate events at you. Fourteen events. Ten missions. The math does not work. You finished anyway."),
        Achievement (id: "ach_storyteller_ironman", canonical_name: "Iron Run", description: "Complete a 10-mission campaign under Ironman.", criteria: "event.storyteller.runs.ironman >= 10", category: "storyteller", tier: "platinum", flavor: "No respawns. No second chances. Ten missions of bleeding-out scenarios. Your name remained on the roster."),
        Achievement (id: "ach_storyteller_sandbox", canonical_name: "Sandbox Player", description: "Complete a 10-mission campaign under Sandbox.", criteria: "event.storyteller.runs.sandbox >= 10", category: "storyteller", tier: "bronze", flavor: "No events. No urgency. No reason to do anything. You did everything anyway."),
        Achievement (id: "ach_hidden_easter_one", canonical_name: "Bolt Thrower", description: "Find the hidden bolt cache.", criteria: "event.hidden.bolt_cache_found == true", category: "hidden", tier: "silver", flavor: "Fourteen bolts. Fourteen anomaly zones. Fourteen successful throws. The Concordat tradition is honored."),
        Achievement (id: "ach_hidden_easter_two", canonical_name: "The Memorial", description: "Visit the Concordat memorial on Lagrange-7.", criteria: "event.hidden.lagrange_memorial_visited == true", category: "hidden", tier: "silver", flavor: "Seventeen names in brass paint. The paint is sixty-eight years old. The names are still in brass paint."),
        Achievement (id: "ach_hidden_easter_three", canonical_name: "The Old Codex", description: "Locate the pre-collapse Coalition manual cache.", criteria: "event.hidden.precollapse_manual_found == true", category: "hidden", tier: "gold", flavor: "The manual is dated 2086. The cover reads 'do not destroy under any circumstances'. The cover has been complied with."),
        Achievement (id: "ach_hidden_easter_four", canonical_name: "The Phantom Signal", description: "Receive the unexplained signal.", criteria: "event.hidden.phantom_signal_received == true", category: "hidden", tier: "platinum", flavor: "Coalition Naval Intelligence logged the signal at 04:47 Mars time. The signal repeated for 4 minutes. The signal has not repeated since."),
        Achievement (id: "ach_acc_a_text_scale", canonical_name: "Larger Print Edition", description: "Complete a mission with text scale set above 1.5x.", criteria: "event.accessibility.text_scale_above_1_5_missions >= 1", category: "accessibility", tier: "bronze", flavor: "The Coalition manual is now legible from across the room. The room is also more legible."),
        Achievement (id: "ach_acc_a_reduce_motion", canonical_name: "Steady Visuals", description: "Complete a mission with reduce-motion enabled.", criteria: "event.accessibility.reduce_motion_missions >= 1", category: "accessibility", tier: "bronze", flavor: "Less juice, same simulation. The decisions remained yours."),
        Achievement (id: "ach_acc_a_captions", canonical_name: "Caption Reader", description: "Complete a mission with captions enabled.", criteria: "event.accessibility.captions_enabled_missions >= 1", category: "accessibility", tier: "bronze", flavor: "Every voice line, every chatter snippet, in text. The story is the same. The medium is more accessible."),
        Achievement (id: "ach_acc_a_high_contrast", canonical_name: "Sharp Lines", description: "Complete a mission with high-contrast mode enabled.", criteria: "event.accessibility.high_contrast_missions >= 1", category: "accessibility", tier: "bronze", flavor: "Black and white and red where it counts. The Pact ministers approve."),
        Achievement (id: "ach_acc_a_controller_only", canonical_name: "Controller Trooper", description: "Complete a mission using only a controller (no keyboard or mouse).", criteria: "event.accessibility.controller_only_missions >= 1", category: "accessibility", tier: "silver", flavor: "Steam Deck pioneers, Coalition recognition is overdue. The Concordat Archive has a folder titled 'Console Operators'. It is mostly empty."),
        Achievement (id: "ach_modding_first_mod", canonical_name: "First Modification", description: "Install your first Workshop mod.", criteria: "event.modding.workshop_mods_installed >= 1", category: "modding", tier: "bronze", flavor: "The Forge Brotherhood would offer you an apprenticeship. The apprenticeship pays in tools."),
        Achievement (id: "ach_modding_published_mod", canonical_name: "Published Author", description: "Publish your first Workshop mod.", criteria: "event.modding.workshop_mods_published >= 1", category: "modding", tier: "silver", flavor: "Your file is in the public archive. The Collegium has indexed it. The Coalition has reviewed it. The Frontier has downloaded it."),
        Achievement (id: "ach_modding_thousand_downloads", canonical_name: "Subscribed", description: "Have one of your mods reach 1000 subscribers.", criteria: "event.modding.mod_max_subscribers >= 1000", category: "modding", tier: "gold", flavor: "One thousand subscribers. One thousand opinions. The Coalition would say this is the cost of doing business. The Coalition is in the subscriber list."),
        Achievement (id: "ach_master_strategist", canonical_name: "Master Strategist", description: "Complete 50 missions with a full success rate (no objectives failed).", criteria: "event.campaign.full_success_count >= 50", category: "combat", tier: "platinum", flavor: "Fifty mission folders, fifty green stamps. The Coalition's mission planning office requests your input on doctrine. You charge for the consult."),
    ]
)
