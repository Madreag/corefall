{
  "scenario": "m1_actor_range",
  "tick_rate_hz": 60,
  "description": "M1 sharp aim build + invalidation cause coverage. Per CCCP AHuman.cpp:1779 sharp aim builds when STABLE/slow/equipped, and snaps to zero on jump/reload/swap/movement/knockdown/unstable. This script exercises each invalidation cause so cf-replay captures the full grammar. Comments inline are encoded into method+params metadata; cf-e2e's ControlScript parser requires a `method` field on every step so structural comments live in the description above instead of as separate JSON entries.",
  "steps": [
    { "method": "scenario.reset", "params": {} },
    { "method": "act.player.aim", "params": { "x": 1.0, "y": 0.0 } },

    { "method": "act.player.sharp_aim", "params": { "active": true } },
    { "method": "sim.run_for_ticks", "params": { "ticks": 60 } },
    { "method": "observe.once", "params": {} },

    { "method": "act.player.jump", "params": {} },
    { "method": "sim.run_for_ticks", "params": { "ticks": 60 } },

    { "method": "act.player.sharp_aim", "params": { "active": true } },
    { "method": "sim.run_for_ticks", "params": { "ticks": 60 } },
    { "method": "act.player.reload", "params": {} },
    { "method": "sim.run_for_ticks", "params": { "ticks": 120 } },

    { "method": "act.player.sharp_aim", "params": { "active": true } },
    { "method": "sim.run_for_ticks", "params": { "ticks": 60 } },
    { "method": "act.player.select_item", "params": { "slot": 1 } },
    { "method": "sim.run_for_ticks", "params": { "ticks": 6 } },
    { "method": "act.player.select_item", "params": { "slot": 0 } },
    { "method": "sim.run_for_ticks", "params": { "ticks": 30 } },

    { "method": "act.player.sharp_aim", "params": { "active": true } },
    { "method": "sim.run_for_ticks", "params": { "ticks": 60 } },
    { "method": "act.player.move", "params": { "x": 1.0, "y": 0.0 } },
    { "method": "sim.run_for_ticks", "params": { "ticks": 60 } },
    { "method": "act.player.move", "params": { "x": 0.0, "y": 0.0 } },
    { "method": "sim.run_for_ticks", "params": { "ticks": 60 } },

    { "method": "act.player.sharp_aim", "params": { "active": false } },
    { "method": "sim.run_for_ticks", "params": { "ticks": 60 } },
    { "method": "observe.once", "params": {} }
  ]
}
