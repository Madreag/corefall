{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RunForTicksParams",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "ticks": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "write_run_bundle": {
      "type": [
        "boolean",
        "null"
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "schema_version",
    "ticks"
  ]
}
