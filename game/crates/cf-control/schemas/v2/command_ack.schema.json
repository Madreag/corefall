{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CommandAck",
  "type": "object",
  "properties": {
    "effective_tick": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "schema_version": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "status": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "effective_tick"
  ]
}
