{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ActorView",
  "description": "Public projection of one actor for the observe envelope. Mirrors\n`cf_actor::ActorObservation` with extra fields (rifle ammo / cooldown / reload\nstate) the engine wires through.",
  "type": "object",
  "properties": {
    "aim": {
      "type": "array",
      "items": {
        "type": "number",
        "format": "float"
      },
      "maxItems": 2,
      "minItems": 2
    },
    "bloom_factor": {
      "type": "number",
      "format": "float",
      "default": 1.0
    },
    "body_silhouette": {
      "description": "M4A: per-zone body silhouette projection (head/torso/arms/legs hp%).\n`placeholder=true` for legacy actors without a chassis.",
      "$ref": "#/$defs/BodySilhouetteView",
      "default": {
        "arm_left_hp_pct": 1.0,
        "arm_right_hp_pct": 1.0,
        "head_hp_pct": 1.0,
        "leg_left_hp_pct": 1.0,
        "leg_right_hp_pct": 1.0,
        "placeholder": true,
        "torso_hp_pct": 1.0
      }
    },
    "chassis": {
      "description": "pilot state, eject window). `None` for legacy actors without a chassis.",
      "anyOf": [
        {
          "$ref": "#/$defs/ChassisView"
        },
        {
          "type": "null"
        }
      ]
    },
    "climb_active": {
      "type": "boolean",
      "default": false
    },
    "controllable": {
      "type": "boolean"
    },
    "cover_state": {
      "description": "trench segment variant) per VAL-M9B-CFCTL-003 + VAL-M9B-COVERMATRIX-001.\nOne of `Exposed | Partial | Full`. Defaults to `Exposed` for actors\non open ground (no trench segment under foot).",
      "type": "string",
      "default": "Exposed"
    },
    "crouch_active": {
      "type": "boolean",
      "default": false
    },
    "dying_dwell_ticks_remaining": {
      "type": "integer",
      "format": "uint32",
      "default": 0,
      "minimum": 0
    },
    "hp": {
      "type": "number",
      "format": "float"
    },
    "hp_max": {
      "type": "number",
      "format": "float"
    },
    "id": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "inventory": {
      "description": "slot order (4 entries for M1; \"empty\" for unset slots). Mirrors\n`cf_actor::ActorObservation.inventory` so consumers reading\n`observe.frame.actors[]` see the same payload as `observe.actor`.",
      "type": "array",
      "default": [],
      "items": {
        "type": "string"
      }
    },
    "jet_active": {
      "type": "boolean",
      "default": false
    },
    "knockdown_ticks_remaining": {
      "type": "integer",
      "format": "uint32",
      "default": 0,
      "minimum": 0
    },
    "mass_kg": {
      "type": "number",
      "format": "float",
      "default": 80.0
    },
    "mission_critical": {
      "type": "boolean",
      "default": false
    },
    "module_strip": {
      "description": "M4A: chassis module strip projection. **M5**: `placeholder=false` when\nsourced from a real chassis; `placeholder=true` for the M4A flat-rifle\nderivation.",
      "$ref": "#/$defs/ModuleStripView",
      "default": {
        "modules": [],
        "placeholder": false
      }
    },
    "on_ground": {
      "type": "boolean"
    },
    "origin_id": {
      "type": "string",
      "default": "human"
    },
    "position": {
      "type": "array",
      "items": {
        "type": "number",
        "format": "float"
      },
      "maxItems": 2,
      "minItems": 2
    },
    "recoil_accumulator": {
      "type": "number",
      "format": "float",
      "default": 0.0
    },
    "rifle_ammo": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint32",
      "minimum": 0
    },
    "rifle_capacity": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint32",
      "minimum": 0
    },
    "rifle_fire_cooldown_ticks": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint32",
      "minimum": 0
    },
    "rifle_reload_remaining_ticks": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint32",
      "minimum": 0
    },
    "rifle_reload_total_ticks": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint32",
      "minimum": 0
    },
    "selected_item": {
      "type": "string"
    },
    "selected_slot": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "sharp_aim_progress": {
      "type": "number",
      "format": "float",
      "default": 0.0
    },
    "stability": {
      "type": "number",
      "format": "float",
      "default": 1.0
    },
    "stability_recovery_rate": {
      "type": "number",
      "format": "float",
      "default": 0.019999999552965164
    },
    "stance": {
      "description": "M4A: derived stance label (idle/walking/running/airborne/downed/dead/...).\n`cfctl observe` consumers + AI agents read this without a screenshot.",
      "type": "string",
      "default": "idle"
    },
    "status": {
      "type": "string"
    },
    "team": {
      "type": "string"
    },
    "velocity": {
      "type": "array",
      "items": {
        "type": "number",
        "format": "float"
      },
      "maxItems": 2,
      "minItems": 2
    }
  },
  "required": [
    "id",
    "team",
    "controllable",
    "position",
    "velocity",
    "aim",
    "on_ground",
    "status",
    "hp",
    "hp_max",
    "selected_slot",
    "selected_item"
  ],
  "$defs": {
    "BodySilhouetteView": {
      "description": "M4A body silhouette projection (mirrors `cf_actor::BodySilhouette`).",
      "type": "object",
      "properties": {
        "arm_left_hp_pct": {
          "type": "number",
          "format": "float"
        },
        "arm_right_hp_pct": {
          "type": "number",
          "format": "float"
        },
        "head_hp_pct": {
          "type": "number",
          "format": "float"
        },
        "leg_left_hp_pct": {
          "type": "number",
          "format": "float"
        },
        "leg_right_hp_pct": {
          "type": "number",
          "format": "float"
        },
        "placeholder": {
          "type": "boolean"
        },
        "torso_hp_pct": {
          "type": "number",
          "format": "float"
        }
      },
      "required": [
        "head_hp_pct",
        "torso_hp_pct",
        "arm_left_hp_pct",
        "arm_right_hp_pct",
        "leg_left_hp_pct",
        "leg_right_hp_pct",
        "placeholder"
      ]
    },
    "ChassisModuleView": {
      "type": "object",
      "properties": {
        "bound_zone": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "integrity": {
          "type": "number",
          "format": "float"
        },
        "kind": {
          "type": "string"
        },
        "last_reason": {
          "type": "string"
        },
        "state": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "state",
        "bound_zone",
        "integrity",
        "last_reason"
      ]
    },
    "ChassisView": {
      "type": "object",
      "properties": {
        "bleed_rate_per_sec": {
          "description": "for the actor. Drives the HUD bleeding indicator.",
          "type": "number",
          "format": "float",
          "default": 0.0
        },
        "destroyed_zones": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "eject_ticks_remaining": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "eject_ticks_total": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "integrity": {
          "type": "number",
          "format": "float"
        },
        "kind": {
          "type": "string"
        },
        "limb_states": {
          "description": "chassis zone with the current [`cf_physics::ZoneState`] label, plus\nthe bleed_rate per-second derived from the zone's state.",
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/LimbStateView"
          }
        },
        "mass_kg": {
          "type": "number",
          "format": "float"
        },
        "modules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ChassisModuleView"
          }
        },
        "pilot_state": {
          "type": "string"
        },
        "ragdoll_state": {
          "description": "`activating` / `active` / `static_collapse`). Mirrors\n[`cf_physics::RagdollState`].",
          "type": "string",
          "default": "animated"
        },
        "salvaged_module_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "spec_id": {
          "type": "string"
        },
        "stage": {
          "type": "string"
        },
        "tutorial_safety": {
          "type": "boolean"
        },
        "weapon_jammed": {
          "type": "boolean"
        },
        "zones": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ChassisZoneView"
          }
        }
      },
      "required": [
        "spec_id",
        "kind",
        "stage",
        "pilot_state",
        "weapon_jammed",
        "tutorial_safety",
        "mass_kg",
        "zones",
        "modules",
        "integrity",
        "eject_ticks_remaining",
        "eject_ticks_total",
        "destroyed_zones",
        "salvaged_module_ids"
      ]
    },
    "ChassisZoneView": {
      "type": "object",
      "properties": {
        "core_integrity": {
          "type": "number",
          "format": "float"
        },
        "destroyed": {
          "type": "boolean"
        },
        "external_integrity": {
          "type": "number",
          "format": "float"
        },
        "internal_integrity": {
          "type": "number",
          "format": "float"
        },
        "wound_integrity": {
          "type": "number",
          "format": "float"
        },
        "zone": {
          "type": "string"
        },
        "zone_integrity": {
          "type": "number",
          "format": "float"
        }
      },
      "required": [
        "zone",
        "external_integrity",
        "internal_integrity",
        "core_integrity",
        "wound_integrity",
        "destroyed",
        "zone_integrity"
      ]
    },
    "LimbStateView": {
      "type": "object",
      "properties": {
        "bleed_multiplier": {
          "type": "number",
          "format": "float"
        },
        "bleeds": {
          "type": "boolean"
        },
        "functional_consequence_active": {
          "type": "boolean"
        },
        "state": {
          "type": "string"
        },
        "zone": {
          "type": "string"
        }
      },
      "required": [
        "zone",
        "state",
        "functional_consequence_active",
        "bleeds",
        "bleed_multiplier"
      ]
    },
    "ModuleStateView": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "state": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "label",
        "state",
        "kind"
      ]
    },
    "ModuleStripView": {
      "description": "M4A module strip projection (mirrors `cf_actor::ModuleStrip`).",
      "type": "object",
      "properties": {
        "modules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ModuleStateView"
          }
        },
        "placeholder": {
          "type": "boolean"
        }
      },
      "required": [
        "modules",
        "placeholder"
      ]
    }
  }
}
