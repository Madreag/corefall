{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ActorView",
  "description": "Public projection of one actor for the observe envelope. Mirrors\n`cf_actor::ActorObservation` with extra fields (rifle ammo / cooldown / reload\nstate) the engine wires through.",
  "type": "object",
  "properties": {
    "aim": {
      "type": "array",
      "items": {
        "type": "number",
        "format": "float"
      },
      "maxItems": 2,
      "minItems": 2
    },
    "bloom_factor": {
      "description": "**M1**: most-recent reticle bloom factor (`Soldat Sprites.pas:4870`).",
      "type": "number",
      "format": "float",
      "default": 1.0
    },
    "body_silhouette": {
      "description": "M4A: per-zone body silhouette projection (head/torso/arms/legs hp%).\n**M5**: `placeholder=false` when sourced from a real chassis body graph;\n`placeholder=true` for legacy actors without a chassis.",
      "$ref": "#/$defs/BodySilhouetteView",
      "default": {
        "arm_left_hp_pct": 1.0,
        "arm_right_hp_pct": 1.0,
        "head_hp_pct": 1.0,
        "leg_left_hp_pct": 1.0,
        "leg_right_hp_pct": 1.0,
        "placeholder": true,
        "torso_hp_pct": 1.0
      }
    },
    "chassis": {
      "description": "**M5**: full chassis projection (per-zone integrity, modules, stage,\npilot state, eject window). `None` for legacy actors without a chassis.",
      "anyOf": [
        {
          "$ref": "#/$defs/ChassisView"
        },
        {
          "type": "null"
        }
      ]
    },
    "climb_active": {
      "type": "boolean",
      "default": false
    },
    "controllable": {
      "type": "boolean"
    },
    "crouch_active": {
      "description": "**M5**: per-tick movement-intent flags surfaced to AI / HUD.",
      "type": "boolean",
      "default": false
    },
    "dying_dwell_ticks_remaining": {
      "description": "**M1**: DYING dwell ticks remaining (CCCP `Actor.cpp:1229`).",
      "type": "integer",
      "format": "uint32",
      "default": 0,
      "minimum": 0
    },
    "hp": {
      "type": "number",
      "format": "float"
    },
    "hp_max": {
      "type": "number",
      "format": "float"
    },
    "id": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "jet_active": {
      "type": "boolean",
      "default": false
    },
    "knockdown_ticks_remaining": {
      "description": "**M1**: knockdown recovery ticks remaining (0 when not stunned).",
      "type": "integer",
      "format": "uint32",
      "default": 0,
      "minimum": 0
    },
    "mass_kg": {
      "description": "**M1**: physical mass (kg). Drives mass_factor in physics + stability cost.",
      "type": "number",
      "format": "float",
      "default": 80.0
    },
    "mission_critical": {
      "description": "**M1**: mission_critical flag (caps damage at DOWNED when true).",
      "type": "boolean",
      "default": false
    },
    "module_strip": {
      "description": "M4A: chassis module strip projection. **M5**: `placeholder=false` when\nsourced from a real chassis; `placeholder=true` for the M4A flat-rifle\nderivation.",
      "$ref": "#/$defs/ModuleStripView",
      "default": {
        "modules": [],
        "placeholder": false
      }
    },
    "on_ground": {
      "type": "boolean"
    },
    "origin_id": {
      "description": "**M5**: actor origin tag (`human`, `robot`, `android`).",
      "type": "string",
      "default": "human"
    },
    "position": {
      "type": "array",
      "items": {
        "type": "number",
        "format": "float"
      },
      "maxItems": 2,
      "minItems": 2
    },
    "recoil_accumulator": {
      "description": "**M1**: alternating-recoil accumulator value (CCCP `HDFirearm.cpp:891`).",
      "type": "number",
      "format": "float",
      "default": 0.0
    },
    "rifle_ammo": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint32",
      "minimum": 0
    },
    "rifle_capacity": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint32",
      "minimum": 0
    },
    "rifle_fire_cooldown_ticks": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint32",
      "minimum": 0
    },
    "rifle_reload_remaining_ticks": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint32",
      "minimum": 0
    },
    "rifle_reload_total_ticks": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint32",
      "minimum": 0
    },
    "selected_item": {
      "type": "string"
    },
    "selected_slot": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "sharp_aim_progress": {
      "description": "**M1**: sharp-aim progress (0..1).",
      "type": "number",
      "format": "float",
      "default": 0.0
    },
    "stability": {
      "description": "**M1**: stability scalar (0.0 = disrupted, 1.0 = solid).",
      "type": "number",
      "format": "float",
      "default": 1.0
    },
    "stability_recovery_rate": {
      "description": "**M1**: per-tick stability recovery rate.",
      "type": "number",
      "format": "float",
      "default": 0.019999999552965164
    },
    "stance": {
      "description": "M4A: derived stance label (idle/walking/running/airborne/downed/dead/...).\n`cfctl observe` consumers + AI agents read this without a screenshot.",
      "type": "string",
      "default": "idle"
    },
    "status": {
      "type": "string"
    },
    "team": {
      "type": "string"
    },
    "velocity": {
      "type": "array",
      "items": {
        "type": "number",
        "format": "float"
      },
      "maxItems": 2,
      "minItems": 2
    }
  },
  "required": [
    "id",
    "team",
    "controllable",
    "position",
    "velocity",
    "aim",
    "on_ground",
    "status",
    "hp",
    "hp_max",
    "selected_slot",
    "selected_item"
  ],
  "$defs": {
    "BodySilhouetteView": {
      "description": "M4A body silhouette projection (mirrors `cf_actor::BodySilhouette`).",
      "type": "object",
      "properties": {
        "arm_left_hp_pct": {
          "type": "number",
          "format": "float"
        },
        "arm_right_hp_pct": {
          "type": "number",
          "format": "float"
        },
        "head_hp_pct": {
          "type": "number",
          "format": "float"
        },
        "leg_left_hp_pct": {
          "type": "number",
          "format": "float"
        },
        "leg_right_hp_pct": {
          "type": "number",
          "format": "float"
        },
        "placeholder": {
          "type": "boolean"
        },
        "torso_hp_pct": {
          "type": "number",
          "format": "float"
        }
      },
      "required": [
        "head_hp_pct",
        "torso_hp_pct",
        "arm_left_hp_pct",
        "arm_right_hp_pct",
        "leg_left_hp_pct",
        "leg_right_hp_pct",
        "placeholder"
      ]
    },
    "ChassisModuleView": {
      "type": "object",
      "properties": {
        "bound_zone": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "integrity": {
          "type": "number",
          "format": "float"
        },
        "kind": {
          "type": "string"
        },
        "last_reason": {
          "type": "string"
        },
        "state": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "state",
        "bound_zone",
        "integrity",
        "last_reason"
      ]
    },
    "ChassisView": {
      "description": "**M5**: chassis projection for `cfctl observe` / `inspect`.",
      "type": "object",
      "properties": {
        "destroyed_zones": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "eject_ticks_remaining": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "eject_ticks_total": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "integrity": {
          "type": "number",
          "format": "float"
        },
        "kind": {
          "type": "string"
        },
        "mass_kg": {
          "type": "number",
          "format": "float"
        },
        "modules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ChassisModuleView"
          }
        },
        "pilot_state": {
          "type": "string"
        },
        "salvaged_module_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "spec_id": {
          "type": "string"
        },
        "stage": {
          "type": "string"
        },
        "tutorial_safety": {
          "type": "boolean"
        },
        "weapon_jammed": {
          "type": "boolean"
        },
        "zones": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ChassisZoneView"
          }
        }
      },
      "required": [
        "spec_id",
        "kind",
        "stage",
        "pilot_state",
        "weapon_jammed",
        "tutorial_safety",
        "mass_kg",
        "zones",
        "modules",
        "integrity",
        "eject_ticks_remaining",
        "eject_ticks_total",
        "destroyed_zones",
        "salvaged_module_ids"
      ]
    },
    "ChassisZoneView": {
      "type": "object",
      "properties": {
        "core_integrity": {
          "type": "number",
          "format": "float"
        },
        "destroyed": {
          "type": "boolean"
        },
        "external_integrity": {
          "type": "number",
          "format": "float"
        },
        "internal_integrity": {
          "type": "number",
          "format": "float"
        },
        "wound_integrity": {
          "type": "number",
          "format": "float"
        },
        "zone": {
          "type": "string"
        },
        "zone_integrity": {
          "type": "number",
          "format": "float"
        }
      },
      "required": [
        "zone",
        "external_integrity",
        "internal_integrity",
        "core_integrity",
        "wound_integrity",
        "destroyed",
        "zone_integrity"
      ]
    },
    "ModuleStateView": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "state": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "label",
        "state",
        "kind"
      ]
    },
    "ModuleStripView": {
      "description": "M4A module strip projection (mirrors `cf_actor::ModuleStrip`).",
      "type": "object",
      "properties": {
        "modules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ModuleStateView"
          }
        },
        "placeholder": {
          "type": "boolean"
        }
      },
      "required": [
        "modules",
        "placeholder"
      ]
    }
  }
}
