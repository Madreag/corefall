{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Settings",
  "type": "object",
  "required": [
    "captions",
    "high_contrast",
    "reduced_flash",
    "reduced_motion",
    "reduced_shake",
    "ui_scale"
  ],
  "properties": {
    "captions": {
      "type": "boolean"
    },
    "high_contrast": {
      "type": "boolean"
    },
    "reduced_flash": {
      "type": "boolean"
    },
    "reduced_motion": {
      "type": "boolean"
    },
    "reduced_shake": {
      "type": "boolean"
    },
    "ui_scale": {
      "type": "number",
      "format": "float"
    }
  }
}
