{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Settings",
  "type": "object",
  "properties": {
    "captions": {
      "type": "boolean"
    },
    "high_contrast": {
      "type": "boolean"
    },
    "reduced_flash": {
      "type": "boolean"
    },
    "reduced_motion": {
      "type": "boolean"
    },
    "reduced_shake": {
      "type": "boolean"
    },
    "ui_scale": {
      "type": "number",
      "format": "float"
    }
  },
  "required": [
    "ui_scale",
    "high_contrast",
    "captions",
    "reduced_motion",
    "reduced_shake",
    "reduced_flash"
  ]
}
