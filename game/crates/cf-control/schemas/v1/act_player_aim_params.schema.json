{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ActPlayerAimParams",
  "description": "`act.player.aim` — set the player's aim vector (will be normalized).",
  "type": "object",
  "required": [
    "schema_version",
    "x",
    "y"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0.0
    },
    "x": {
      "type": "number",
      "format": "float"
    },
    "y": {
      "type": "number",
      "format": "float"
    }
  },
  "additionalProperties": false
}
