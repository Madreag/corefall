{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ActPlayerQuickActionSliceParams",
  "description": "**M14A**: `act.player.quick_action_slice` — commit a radial slice (1-8).",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "slice": {
      "type": "integer",
      "format": "uint8",
      "maximum": 255,
      "minimum": 0
    }
  },
  "additionalProperties": false,
  "required": [
    "schema_version",
    "slice"
  ]
}
