{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ObserveActorParams",
  "description": "**M1**: `observe.actor` — return full `ActorView` (with M1 fields) for the\nplayer by default, or for `actor_id` when supplied.",
  "type": "object",
  "properties": {
    "actor_id": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint64",
      "minimum": 0
    },
    "schema_version": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    }
  },
  "additionalProperties": false,
  "required": [
    "schema_version"
  ]
}
