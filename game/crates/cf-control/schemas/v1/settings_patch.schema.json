    "hardcore_mode": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "high_contrast": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "hit_stop_enabled": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "hold_behavior": {
      "type": [
        "string",
        "null"
      ]
    },
    "hold_threshold_ms": {
      "description": "M4A: hold threshold in milliseconds (50..2000).",
      "type": [
        "integer",
        "null"
      ],
      "format": "uint32",
      "minimum": 0
    },
