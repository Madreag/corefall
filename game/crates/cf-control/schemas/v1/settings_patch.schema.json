{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SettingsPatch",
  "type": "object",
  "properties": {
    "accel": {
      "description": "**M1 Gap F1**: configurable feel cvars. All values must be finite\nand (where applicable) positive; `apply_settings_patch` rejects\ninvalid patches via `validation_error`.",
      "type": [
        "number",
        "null"
      ],
      "format": "float"
    },
    "ai_debug": {
      "description": "**M1.5**: AI debug overlay. `true` raises the floating intent label\nabove every reactive guard; `false` hides it. Defaults to current\nstate when omitted (Option-based settings patch).",
      "type": [
        "boolean",
        "null"
      ]
    },
    "ai_difficulty": {
      "description": "**M1.5 G6**: AI difficulty preset id. Valid values:\n`\"cakewalk\" | \"tough_crowd\" | \"veteran\"`. The engine looks up the\npreset in `cf-ai::DifficultyPreset::builtin(id)` and applies it to\nevery `ReactiveGuard` in the world.",
      "type": [
        "string",
        "null"
      ]
    },
    "aim_assist": {
      "description": "**M8**: aim assist mode (`off | steady_aim |\nauto_aim_with_damage_penalty`).",
      "type": [
        "string",
        "null"
      ]
    },
    "camera_motion": {
      "description": "**M11**: camera-motion granularity (`reduced | standard`).",
      "type": [
        "string",
        "null"
      ]
    },
    "caption_background_opacity": {
      "description": "**M11**: caption background opacity (0.0..=1.0).",
      "type": [
        "number",
        "null"
      ],
      "format": "float"
    },
    "caption_categories": {
      "description": "**M11**: caption category subset.",
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "caption_mode": {
      "description": "**M11**: captions verbosity mode (snake_case wire form\n`off | critical_only | standard | expanded`).",
      "type": [
        "string",
        "null"
      ]
    },
    "captions": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "cinematic_kills": {
      "description": "**M8**: cinematic kill cam toggle.",
      "type": [
        "boolean",
        "null"
      ]
    },
    "color_cue_mode": {
      "description": "**M8**: color blind / contrast palette mode (snake_case wire form\n`default | colorblind_safe | protanopia | deuteranopia | tritanopia\n| monochrome_test`).",
      "type": [
        "string",
        "null"
      ]
    },
    "comic_death_recap": {
      "description": "**M12**: comic death-recap toggle. When `true`, the death recap\nrenders as a 4-panel comic-style cause chain; when `false` (default),\nthe M10 replay viewer + cause-chain walker is used.",
      "type": [
        "boolean",
        "null"
      ]
    },
    "comic_style_overlay": {
      "description": "**M12**: comic-style overlay mode (`full | subtle | off`). Defaults to\n`subtle` in `Settings`; the patch lets the player drop to `off` or\nescalate to `full` from the settings UI. Per spec § Comic-style\nframing — opt-in juice, not core identity.",
      "type": [
        "string",
        "null"
      ]
    },
    "compass_enabled": {
      "description": "**M8**: compass enable toggle.",
      "type": [
        "boolean",
        "null"
      ]
    },
    "contrast_mode": {
      "description": "**M11**: contrast palette mode (snake_case wire form\n`standard | high_contrast_dark | high_contrast_light`).",
      "type": [
        "string",
        "null"
      ]
    },
    "damage_direction_enabled": {
      "description": "**M8**: damage-direction indicator enable toggle.",
      "type": [
        "boolean",
        "null"
      ]
    },
    "damage_numbers": {
      "description": "**M8**: damage numbers cosmetic toggle.",
      "type": [
        "boolean",
        "null"
      ]
    },
    "debug_enabled": {
      "description": "**M8**: master debug-overlay gate (production builds).",
      "type": [
        "boolean",
        "null"
      ]
    },
    "debug_explainer_level": {
      "description": "**M11**: debug-explainer level (`player | designer | raw`).",
      "type": [
        "string",
        "null"
      ]
    },
    "fog_of_war_on": {
      "description": "**M8**: fog-of-war on.",
      "type": [
        "boolean",
        "null"
      ]
    },
    "friction": {
      "type": [
        "number",
        "null"
      ],
      "format": "float"
    },
    "friendly_fire_on": {
      "description": "**M8**: friendly fire on.",
      "type": [
        "boolean",
        "null"
      ]
    },
    "game_speed_assist": {
      "description": "**M8**: slow-motion accessibility mode (snake_case wire form\n`off | slowdown_75 | slowdown_25 | full_pause`).",
      "type": [
        "string",
        "null"
      ]
    },
    "gravity": {
      "type": [
        "number",
        "null"
      ],
      "format": "float"
    },
    "hardcore_mode": {
      "description": "**M8**: hardcore composite mode.",
      "type": [
        "boolean",
        "null"
      ]
    },
    "high_contrast": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "hit_stop_enabled": {
      "description": "**M8**: hit-stop toggle.",
      "type": [
        "boolean",
        "null"
      ]
    },
    "hold_behavior": {
      "description": "**M11**: hold-behavior variant (`hold | toggle | press_to_cycle`).",
      "type": [
        "string",
        "null"
      ]
    },
    "hold_threshold_ms": {
      "description": "M4A: hold threshold in milliseconds (50..2000).",
      "type": [
        "integer",
        "null"
      ],
      "format": "uint32",
      "minimum": 0
    },
    "hold_to_confirm": {
      "description": "M4A: ACC-A-05 hold-to-press alternative.",
      "type": [
        "boolean",
        "null"
      ]
    },
    "input_profile": {
      "description": "**M11**: input profile (snake_case wire form\n`keyboard_mouse | controller | keyboard_only | custom`).",
      "type": [
        "string",
        "null"
      ]
    },
    "jump_force": {
      "type": [
        "number",
        "null"
      ],
      "format": "float"
    },
    "key_bindings": {
      "description": "M4A: ACC-A-05 per-action key binding overrides. When `Some(...)` the\npatch REPLACES the entire table (not merged) so a remap UI clearing\nevery binding can ship the empty map. When `None`, the existing\ntable is preserved.",
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "type": "string"
      }
    },
    "key_remap_enabled": {
      "description": "M4A: ACC-A-05 remap toggle.",
      "type": [
        "boolean",
        "null"
      ]
    },
    "killcam_enabled": {
      "description": "**M8**: killcam toggle.",
      "type": [
        "boolean",
        "null"
      ]
    },
    "language": {
      "description": "**M8**: language code (`en` baseline; Tier-A 11 reserved for\nT-ACC-PLUS BP9+).",
      "type": [
        "string",
        "null"
      ]
    },
    "limited_ammo": {
      "description": "**M8**: limited-ammo modifier.",
      "type": [
        "boolean",
        "null"
      ]
    },
    "mini_map_enabled": {
      "description": "**M8**: master mini-map enable toggle.",
      "type": [
        "boolean",
        "null"
      ]
    },
    "mini_map_zoom": {
      "description": "**M8**: mini-map zoom (0.25..=4.0).",
      "type": [
        "number",
        "null"
      ],
      "format": "float"
    },
    "no_minimap": {
      "description": "**M8**: hide the mini-map (overrides `mini_map_enabled`).",
      "type": [
        "boolean",
        "null"
      ]
    },
    "no_respawn": {
      "description": "**M8**: no-respawn modifier.",
      "type": [
        "boolean",
        "null"
      ]
    },
    "objective_help": {
      "description": "**M11**: objective-help verbosity (`minimal | standard | verbose`).",
      "type": [
        "string",
        "null"
      ]
    },
    "permadeath": {
      "description": "**M8**: permadeath modifier.",
      "type": [
        "boolean",
        "null"
      ]
    },
    "recoil_decay_per_tick": {
      "type": [
        "number",
        "null"
      ],
      "format": "float"
    },
    "reduce_camera_shake_pct": {
      "description": "**M1 / DR-055**: camera shake reduction. Clamped to `[0, 1]`.\n`1.0` = no shake (accessibility floor).",
      "type": [
        "number",
        "null"
      ],
      "format": "float"
    },
    "reduced_flash": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "reduced_motion": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "reduced_shake": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "remap_groups": {
      "description": "**M11**: remap-action group subset.",
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "scope_zoom_fov": {
      "description": "**M8**: scope ADS FOV in degrees (5..=90).",
      "type": [
        "number",
        "null"
      ],
      "format": "float"
    },
    "screen_shake_scale": {
      "description": "**M11**: screen-shake scale (0.0..=1.0; multiplicative).",
      "type": [
        "number",
        "null"
      ],
      "format": "float"
    },
    "sharp_aim_build_ticks": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint32",
      "minimum": 0
    },
    "speedrun_mode": {
      "description": "**M8**: speedrun mode toggle.",
      "type": [
        "boolean",
        "null"
      ]
    },
    "text_scale": {
      "description": "**M8**: text scale (0.5..=4.0; mirrors `ui_scale`).",
      "type": [
        "number",
        "null"
      ],
      "format": "float"
    },
    "tick_rate_hz": {
      "description": "**M1**: tick-rate observable. Clamped to `>= 1`. The engine does not\nlive-retick on patch; this mirrors the engine's configured tick rate\nso cfctl `observe.settings` is round-trippable.",
      "type": [
        "integer",
        "null"
      ],
      "format": "uint32",
      "minimum": 0
    },
    "time_limit": {
      "description": "**M8**: time-limit modifier.",
      "type": [
        "boolean",
        "null"
      ]
    },
    "ui_density": {
      "description": "**M8**: HUD density preset (`compact | normal | spacious`).",
      "type": [
        "string",
        "null"
      ]
    },
    "ui_scale": {
      "type": [
        "number",
        "null"
      ],
      "format": "float"
    },
    "walk_threshold": {
      "type": [
        "number",
        "null"
      ],
      "format": "float"
    }
  },
  "additionalProperties": false
}
