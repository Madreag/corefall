        "object",
        "null"
      ],
      "additionalProperties": {
        "type": "string"
      }
    },
    "key_remap_enabled": {
      "description": "M4A: ACC-A-05 remap toggle.",
      "type": [
        "boolean",
        "null"
      ]
    },
    "killcam_enabled": {
      "type": [
        "boolean",
        "null"
      ]
    },
