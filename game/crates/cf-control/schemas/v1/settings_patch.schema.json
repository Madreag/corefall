{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SettingsPatch",
  "type": "object",
  "properties": {
    "accel": {
      "description": "and (where applicable) positive; `apply_settings_patch` rejects\ninvalid patches via `validation_error`.",
      "type": [
        "number",
        "null"
      ],
      "format": "float"
    },
    "ai_debug": {
      "description": "above every reactive guard; `false` hides it. Defaults to current\nstate when omitted (Option-based settings patch).",
      "type": [
        "boolean",
        "null"
      ]
    },
    "ai_difficulty": {
      "description": "`\"cakewalk\" | \"tough_crowd\" | \"veteran\"`. The engine looks up the\npreset in `cf-ai::DifficultyPreset::builtin(id)` and applies it to\nevery `ReactiveGuard` in the world.",
      "type": [
        "string",
        "null"
      ]
    },
    "aim_assist": {
      "description": "auto_aim_with_damage_penalty`).",
      "type": [
        "string",
        "null"
      ]
    },
    "camera_motion": {
      "type": [
        "string",
        "null"
      ]
    },
    "caption_background_opacity": {
      "type": [
        "number",
        "null"
      ],
      "format": "float"
    },
    "caption_categories": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "caption_mode": {
      "description": "`off | critical_only | standard | expanded`).",
      "type": [
        "string",
        "null"
      ]
    },
    "captions": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "cinematic_kills": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "color_cue_mode": {
      "description": "`default | colorblind_safe | protanopia | deuteranopia | tritanopia\n| monochrome_test`).",
      "type": [
        "string",
        "null"
      ]
    },
    "comic_death_recap": {
      "description": "renders as a 4-panel comic-style cause chain; when `false` (default),\nthe M10 replay viewer + cause-chain walker is used.",
      "type": [
        "boolean",
        "null"
      ]
    },
    "comic_style_overlay": {
      "description": "`subtle` in `Settings`; the patch lets the player drop to `off` or\nescalate to `full` from the settings UI. Per spec § Comic-style\nframing — opt-in juice, not core identity.",
      "type": [
        "string",
        "null"
      ]
    },
    "compass_enabled": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "contrast_mode": {
      "description": "`standard | high_contrast_dark | high_contrast_light`).",
      "type": [
        "string",
        "null"
      ]
    },
    "damage_direction_enabled": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "damage_numbers": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "debug_enabled": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "debug_explainer_level": {
      "type": [
        "string",
        "null"
      ]
    },
    "fog_of_war_on": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "friction": {
      "type": [
        "number",
        "null"
      ],
      "format": "float"
    },
    "friendly_fire_on": {
