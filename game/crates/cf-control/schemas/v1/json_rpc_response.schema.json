{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "JsonRpcResponse",
  "type": "object",
  "properties": {
    "error": {
      "anyOf": [
        {
          "$ref": "#/$defs/JsonRpcError"
        },
        {
          "type": "null"
        }
      ]
    },
    "id": {
      "$ref": "#/$defs/JsonRpcId"
    },
    "jsonrpc": {
      "type": "string"
    },
    "result": true
  },
  "required": [
    "jsonrpc",
    "id"
  ],
  "$defs": {
    "JsonRpcError": {
      "type": "object",
      "properties": {
        "code": {
          "type": "integer",
          "format": "int32"
        },
        "data": true,
        "message": {
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ]
    },
    "JsonRpcId": {
      "anyOf": [
        {
          "type": "integer",
          "format": "int64"
        },
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
