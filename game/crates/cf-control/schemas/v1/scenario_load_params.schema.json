{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ScenarioLoadParams",
  "type": "object",
  "properties": {
    "scenario": {
      "type": "string"
    },
    "schema_version": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "seed": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint64",
      "minimum": 0
    }
  },
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scenario"
  ]
}
