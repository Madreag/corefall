{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ScenarioLoadParams",
  "type": "object",
  "required": [
    "scenario",
    "schema_version"
  ],
  "properties": {
    "scenario": {
      "type": "string"
    },
    "schema_version": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0.0
    },
    "seed": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint64",
      "minimum": 0.0
    }
  },
  "additionalProperties": false
}
