{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ObserveSettings",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "settings": {
      "$ref": "#/$defs/Settings"
    }
  },
  "required": [
    "schema_version",
    "settings"
  ],
  "$defs": {
    "Settings": {
      "type": "object",
      "properties": {
        "captions": {
          "type": "boolean"
        },
        "high_contrast": {
          "type": "boolean"
        },
        "reduced_flash": {
          "type": "boolean"
        },
        "reduced_motion": {
          "type": "boolean"
        },
        "reduced_shake": {
          "type": "boolean"
        },
        "ui_scale": {
          "type": "number",
          "format": "float"
        }
      },
      "required": [
        "ui_scale",
        "high_contrast",
        "captions",
        "reduced_motion",
        "reduced_shake",
        "reduced_flash"
      ]
    }
  }
}
