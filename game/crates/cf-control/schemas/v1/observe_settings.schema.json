{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ObserveSettings",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "settings": {
      "$ref": "#/$defs/Settings"
    }
  },
  "required": [
    "schema_version",
    "settings"
  ],
  "$defs": {
    "AimAssist": {
      "description": "off / steady_aim / auto_aim_with_damage_penalty.",
      "oneOf": [
        {
          "description": "No aim assist.",
          "type": "string",
          "const": "off"
        },
        {
          "description": "Reduces reticle wobble while aiming.",
          "type": "string",
          "const": "steady_aim"
        },
        {
          "description": "Snaps reticle slightly toward target; -15% damage.",
          "type": "string",
          "const": "auto_aim_with_damage_penalty"
        }
      ]
    },
    "CameraMotion": {
      "description": "finer follow-camera control).",
      "oneOf": [
        {
          "description": "Reduced — suppress follow-camera + recoil-camera animation.",
          "type": "string",
          "const": "reduced"
        },
        {
          "description": "Standard — full camera motion (default).",
          "type": "string",
          "const": "standard"
        }
      ]
    },
    "CaptionMode": {
      "description": "as captions in the HUD strip.",
      "oneOf": [
        {
          "description": "Captions disabled (no caption strip rendered).",
          "type": "string",
          "const": "off"
        },
        {
          "description": "Only critical-severity events surface.",
          "type": "string",
          "const": "critical_only"
        },
        {
          "description": "Critical + warning (default when captions are on).",
          "type": "string",
          "const": "standard"
        },
        {
          "description": "Critical + warning + info (verbose).",
          "type": "string",
          "const": "expanded"
        }
      ]
    },
    "ColorCueMode": {
      "description": "Accessibility extras — Default / ColorblindSafe / Protanopia /\nDeuteranopia / Tritanopia / MonochromeTest.",
      "oneOf": [
        {
          "description": "Default game palette.",
          "type": "string",
          "const": "default"
        },
        {
          "description": "Colorblind-safe palette (yellow + blue replacing red + green).",
          "type": "string",
          "const": "colorblind_safe"
        },
        {
          "description": "Protanopia (red-blind) palette.",
          "type": "string",
          "const": "protanopia"
        },
        {
          "description": "Deuteranopia (green-blind) palette.",
          "type": "string",
          "const": "deuteranopia"
        },
        {
          "description": "Tritanopia (blue-blind) palette.",
          "type": "string",
          "const": "tritanopia"
        },
        {
          "description": "Monochrome test palette (greyscale).",
          "type": "string",
          "const": "monochrome_test"
        }
      ]
    },
    "ComicStyleOverlay": {
      "description": "Drives `cf-ui::comic_overlay::ComicOverlayMode` at runtime.",
      "oneOf": [
        {
          "description": "Speech bubbles for chatter + onomatopoeia on impacts + comic-panel\nboss intros + comic death recap available behind toggle.",
          "type": "string",
          "const": "full"
        },
        {
          "description": "Default — speech bubbles for storyteller events only; no\nonomatopoeia stamps; comic death recap available behind toggle.",
          "type": "string",
          "const": "subtle"
        },
        {
          "description": "Disabled — no comic framing renders anywhere; chatter is plain\ncaptions; death recap is M10 timeline only.",
          "type": "string",
          "const": "off"
        }
      ]
    },
    "ContrastMode": {
      "description": "`high_contrast: bool` with a tri-state enum (Standard / HighContrastDark /\nHighContrastLight) per spec § Settings tree.",
      "oneOf": [
        {
          "description": "Standard palette (default).",
          "type": "string",
          "const": "standard"
        },
        {
          "description": "High-contrast dark — pure white text on solid black.",
          "type": "string",
          "const": "high_contrast_dark"
        },
        {
          "description": "High-contrast light — pure black text on solid white.",
          "type": "string",
          "const": "high_contrast_light"
        }
      ]
    },
    "DebugExplainerLevel": {
      "oneOf": [
        {
          "description": "Player-friendly plain-language explanations (default).",
          "type": "string",
          "const": "player"
        },
        {
          "description": "Designer-level explanations with tuning numbers.",
          "type": "string",
          "const": "designer"
        },
        {
          "description": "Raw engine event payloads (verbose).",
          "type": "string",
          "const": "raw"
        }
      ]
    },
    "GameSpeedAssist": {
      "description": "Camera + game feel — Off / Slowdown75 / Slowdown25 / FullPause.",
      "oneOf": [
        {
          "description": "Sim runs at native rate.",
          "type": "string",
          "const": "off"
        },
        {
          "description": "Sim runs at 75% speed (cosmetic; replay-deterministic).",
          "type": "string",
          "const": "slowdown75"
        },
        {
          "description": "Sim runs at 25% speed.",
          "type": "string",
          "const": "slowdown25"
        },
        {
          "description": "Sim runs at 0% (menu only).",
          "type": "string",
          "const": "full_pause"
        }
      ]
    },
    "HoldBehavior": {
      "oneOf": [
        {
          "description": "Press-and-hold semantics (default; matches `hold_to_confirm=true`).",
          "type": "string",
          "const": "hold"
        },
        {
          "description": "Toggle on/off — press once to enable, again to disable.",
          "type": "string",
          "const": "toggle"
        },
        {
          "description": "Press-to-cycle — each press advances through a state ring.",
          "type": "string",
          "const": "press_to_cycle"
        }
      ]
    },
    "InputProfile": {
      "oneOf": [
        {
          "description": "Keyboard + mouse (default).",
          "type": "string",
          "const": "keyboard_mouse"
        },
        {
          "description": "Controller (XInput / SDL gamepad).",
          "type": "string",
          "const": "controller"
        },
        {
          "description": "Keyboard only — no mouse / no controller.",
          "type": "string",
          "const": "keyboard_only"
        },
        {
          "description": "Custom — player has rebound mixed inputs.",
          "type": "string",
          "const": "custom"
        }
      ]
    },
    "ObjectiveHelp": {
      "type": "string",
      "enum": [
        "minimal",
        "standard",
        "verbose"
      ]
    },
    "PersonalPowerConfig": {
      "description": "M17 § \"Settings + configuration surface\" — per-origin personal-power +\noxygen + robot-thermal toggles. PvE survival enables these; some PvP modes\ndisable them.",
      "type": "object",
      "properties": {
        "auto_shed_threshold_pct": {
          "type": "integer",
          "format": "uint32",
          "default": 30,
          "minimum": 0
        },
        "battery_drain_multiplier": {
          "type": "number",
          "format": "float",
          "default": 1.0
        },
        "enable_battery_management": {
          "type": "boolean",
          "default": true
        },
        "enable_oxygen_simulation": {
          "type": "boolean",
          "default": true
        },
        "enable_player_powered_armor": {
          "type": "boolean",
          "default": true
        },
        "enable_robot_inert_recovery": {
          "type": "boolean",
          "default": true
        },
        "enable_robot_thermal": {
          "type": "boolean",
          "default": true
        },
        "hot_swap_speed_multiplier": {
          "type": "number",
          "format": "float",
          "default": 1.0
        },
        "oxygen_consumption_multiplier": {
          "type": "number",
          "format": "float",
          "default": 1.0
        }
      }
    },
    "RaceConfig": {
      "description": "M17 § \"Configuration surface (per M38)\" — 10-race origin toggles.",
      "type": "object",
      "properties": {
        "enable_all_10_races": {
          "type": "boolean",
          "default": true
        },
        "enable_dehydration": {
          "type": "boolean",
          "default": true
        },
        "enable_dormancy": {
          "type": "boolean",
          "default": true
        },
        "enable_oxygen_poisoning": {
          "type": "boolean",
          "default": true
        },
        "race_specific_ai_doctrine": {
          "type": "boolean",
          "default": true
        },
        "race_specific_recipe_unlocks": {
          "type": "boolean",
          "default": true
        },
        "starter_race_recommendations_per_world": {
          "description": "Per-world starter-race recommendations (world id → origin id).",
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "default": {}
        }
      }
    },
    "Settings": {
      "type": "object",
      "properties": {
        "accel": {
          "description": "mirrors `cf-actor::sim::ActorTuning::default().ground_acceleration`.",
          "type": "number",
          "format": "float",
          "default": 1500.0
        },
        "ai_debug": {
          "description": "every reactive guard (\"ALERT: heard_shot\", \"ENGAGED\", \"RELOADING\").\nToggled via `--ai-debug` CLI flag on cf-app and `act.settings.set\n{ ai_debug: true }` through cfctl.",
          "type": "boolean",
          "default": false
        },
        "ai_difficulty": {
          "description": "matching `cf-ai::DifficultyPreset` to every `ReactiveGuard` whenever\nthis changes.",
          "type": "string",
          "default": "tough_crowd"
        },
        "aim_assist": {
          "$ref": "#/$defs/AimAssist",
          "default": "off"
        },
        "camera_motion": {
          "$ref": "#/$defs/CameraMotion",
          "default": "standard"
        },
        "caption_background_opacity": {
          "type": "number",
          "format": "float",
          "default": 0.800000011920929
        },
        "caption_categories": {
          "description": "[`SUPPORTED_CAPTION_CATEGORIES`]). Default 4 of 6.",
          "type": "array",
          "default": [
            "accessibility",
            "ai",
            "combat",
            "mission"
          ],
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "caption_mode": {
          "description": "Expanded). Filters which events surface as captions.",
          "$ref": "#/$defs/CaptionMode",
          "default": "off"
        },
        "captions": {
          "type": "boolean"
        },
        "cinematic_captions_enabled": {
          "description": "ribbon. Defaults to `captions` (M11 mode) but exposed as a\nseparate flag so cfctl tests can toggle the cinematic surface\nindependently of the gameplay caption strip. Per spec § \"the\nM12A `caption_visible` predicate gates the subtitle ribbon\".",
          "type": "boolean",
          "default": true
        },
        "cinematic_kills": {
          "type": "boolean",
          "default": true
        },
        "color_cue_mode": {
          "$ref": "#/$defs/ColorCueMode",
          "default": "default"
        },
        "comic_death_recap": {
          "description": "cause chain. When `false` (default), the M10 replay viewer +\ncause-chain walker is used. Gated by `comic_style_overlay != Off`.",
          "type": "boolean",
          "default": false
        },
        "comic_style_overlay": {
          "description": "speech bubbles, onomatopoeia stamps, comic-panel boss intros, and\nthe comic death-recap availability. Default is `Subtle` per spec\n§ Comic-style framing — opt-in juice, not core identity.",
          "$ref": "#/$defs/ComicStyleOverlay",
          "default": "subtle"
        },
        "compass_enabled": {
          "type": "boolean",
          "default": true
        },
        "contrast_mode": {
          "description": "`high_contrast: bool`. Standard / HighContrastDark / HighContrastLight.",
          "$ref": "#/$defs/ContrastMode",
          "default": "standard"
        },
        "damage_direction_enabled": {
          "type": "boolean",
          "default": true
        },
        "damage_numbers": {
          "type": "boolean",
          "default": false
        },
        "debug_enabled": {
          "description": "7 cf-debug overlays only render when `debug_enabled = true`. Dev\nbuilds bypass the gate.",
          "type": "boolean",
          "default": false
        },
        "debug_explainer_level": {
          "$ref": "#/$defs/DebugExplainerLevel",
          "default": "player"
        },
        "debug_overlays": {
          "description": "per `cf_debug::DebugOverlay::as_str`). Mirrors the cf-debug\n`DebugOverlayState` so cfctl `observe.debug.overlays` round-trips.",
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "fog_of_war_on": {
          "type": "boolean",
          "default": true
        },
        "friction": {
          "description": "`cf-actor::sim::ActorTuning::default().ground_friction`.",
          "type": "number",
          "format": "float",
          "default": 1200.0
        },
        "friendly_fire_on": {
          "type": "boolean",
          "default": false
        },
        "game_speed_assist": {
          "description": "FullPause). Cosmetic per M4; replay-deterministic.",
          "$ref": "#/$defs/GameSpeedAssist",
          "default": "off"
        },
        "gravity": {
          "description": "`cf-physics` (units / s²; negative pulls toward the floor). Default\n`-980.0`.",
          "type": "number",
          "format": "float",
          "default": -980.0
        },
        "hardcore_mode": {
          "type": "boolean",
          "default": false
        },
        "high_contrast": {
          "type": "boolean"
        },
        "hit_stop_enabled": {
          "type": "boolean",
          "default": true
        },
        "hold_behavior": {
          "$ref": "#/$defs/HoldBehavior",
          "default": "hold"
        },
        "hold_threshold_ms": {
          "description": "M4A: hold threshold in milliseconds. Default 250 ms; clamped to\n`[50..2000]` by `apply_settings_patch`.",
          "type": "integer",
          "format": "uint32",
          "default": 250,
          "minimum": 0
        },
        "hold_to_confirm": {
          "description": "M4A: hold-to-press alternative for tap-to-press actions (ACC-A-05).\nWhen `true`, edge-triggered actions (jump / fire / reload / dig /\nreset / select_slot_*) require holding the key/button for\n`hold_threshold_ms` before firing instead of triggering on the press\nedge. Default: off (tap semantics). cf-app's `ingest_player_input`\nhonors this through the `HoldTracker` resource; cfctl-driven\ndispatches bypass the hold gate (control-plane is already explicit\npress/release semantics).",
          "type": "boolean",
          "default": false
        },
        "input_profile": {
          "$ref": "#/$defs/InputProfile",
          "default": "keyboard_mouse"
        },
        "jump_force": {
          "description": "`cf-actor::sim::ActorTuning::default().jump_impulse`.",
          "type": "number",
          "format": "float",
          "default": 420.0
        },
        "key_bindings": {
          "description": "M4A: per-action key binding overrides. Action names are limited to\n[`SUPPORTED_KEY_BINDING_ACTIONS`]; KeyCode names are limited to\n[`SUPPORTED_KEY_CODE_NAMES`]. Empty by default; `act.settings.set`\nreplaces the table only after validation so unsupported remaps reject\nat the control boundary instead of silently falling back in cf-app.",
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "default": {}
        },
        "key_remap_enabled": {
          "description": "M4A: when `true`, cf-app's keyboard layer reads its action bindings\nfrom `key_bindings` instead of the built-in defaults. When `false`,\nthe built-in defaults apply (Space=jump, Enter|J=fire, R=reload,\nG=dig, L=reset, 1..4=select_slot_0..3). The remap UI editor lands\nat M8; M4A ships the cfctl-settable surface so the contract is\nbehavior-testable today.",
          "type": "boolean",
          "default": false
        },
        "killcam_enabled": {
          "type": "boolean",
          "default": true
        },
        "language": {
          "description": "T-ACC-PLUS BP9+).",
          "type": "string",
          "default": "en"
        },
        "limited_ammo": {
          "type": "boolean",
          "default": false
        },
        "mini_map_enabled": {
          "type": "boolean",
          "default": true
        },
        "mini_map_zoom": {
          "type": "number",
          "format": "float",
          "default": 1.0
        },
        "no_minimap": {
          "type": "boolean",
          "default": false
        },
        "no_respawn": {
          "type": "boolean",
          "default": false
        },
        "objective_help": {
          "$ref": "#/$defs/ObjectiveHelp",
          "default": "standard"
        },
        "permadeath": {
          "type": "boolean",
          "default": false
        },
        "personal_power": {
          "description": "M17 § per-origin personal-power + oxygen + robot-thermal config.",
          "$ref": "#/$defs/PersonalPowerConfig",
          "default": {
            "auto_shed_threshold_pct": 30,
            "battery_drain_multiplier": 1.0,
            "enable_battery_management": true,
            "enable_oxygen_simulation": true,
            "enable_player_powered_armor": true,
            "enable_robot_inert_recovery": true,
            "enable_robot_thermal": true,
            "hot_swap_speed_multiplier": 1.0,
            "oxygen_consumption_multiplier": 1.0
          }
        },
        "race": {
          "description": "M17 § 10-race origin toggles.",
          "$ref": "#/$defs/RaceConfig",
          "default": {
            "enable_all_10_races": true,
            "enable_dehydration": true,
            "enable_dormancy": true,
            "enable_oxygen_poisoning": true,
            "race_specific_ai_doctrine": true,
            "race_specific_recipe_unlocks": true,
            "starter_race_recommendations_per_world": {}
          }
        },
        "recoil_decay_per_tick": {
          "description": "(CCCP `HDFirearm.cpp:891`). Default `0.05`.",
          "type": "number",
          "format": "float",
          "default": 0.05000000074505806
        },
        "reduce_camera_shake_pct": {
          "description": "multiplied by `(1.0 - reduce_camera_shake_pct)`. 0.0 = full shake,\n1.0 = no shake. Clamped to `[0, 1]` by `apply_settings_patch`.",
          "type": "number",
          "format": "float",
          "default": 0.0
        },
        "reduced_flash": {
          "type": "boolean"
        },
        "reduced_g_force_blackout": {
          "description": "M17 § \"G-Force HUD blackout\" accessibility — caps the concussion\nvignette/blackout at the Moderate band (no Severe tunneling / KO\nblackout) for photosensitive / motion-sensitive players. Default off.",
          "type": "boolean",
          "default": false
        },
        "reduced_motion": {
          "type": "boolean"
        },
        "reduced_shake": {
          "type": "boolean"
        },
        "remap_groups": {
          "description": "[`SUPPORTED_REMAP_GROUPS`]). Default `[gameplay]`.",
          "type": "array",
          "default": [
            "gameplay"
          ],
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "scope_zoom_fov": {
          "type": "number",
          "format": "float",
          "default": 30.0
        },
        "screen_shake_scale": {
          "description": "0.0 = no shake). Multiplicative on camera punch + recoil shake.\nReplaces the inverse-sense `reduce_camera_shake_pct`; the legacy\nfield is preserved for back-compat (mirror updated whenever this\nchanges via `apply_settings_patch`).",
          "type": "number",
          "format": "float",
          "default": 1.0
        },
        "sharp_aim_build_ticks": {
          "description": "`AHuman.cpp:1779`). Default `30` (~0.5s at 60Hz).",
          "type": "integer",
          "format": "uint32",
          "default": 30,
          "minimum": 0
        },
        "speedrun_mode": {
          "description": "markers; mission resolves immediately on objectives).",
          "type": "boolean",
          "default": false
        },
        "storyteller": {
          "description": "(`cassandra_classic` | `phoebe_chillax` | `randy_random` |\n`ironman` | `sandbox`). Forward-compat with M25's director-driven\nstoryteller selection. cf-shell + cfctl set this via\n`act.settings.set`; cf-cinematic reads it at every kernel engage\nper spec § \"The cinematic player reads the active storyteller\nfrom M25 director state and applies its profile globally.\"",
          "type": "string",
          "default": "cassandra_classic"
        },
        "text_scale": {
          "description": "distinct field per spec § Settings menu Accessibility tab).",
          "type": "number",
          "format": "float",
          "default": 1.0
        },
        "tick_rate_hz": {
          "description": "`tick_rate_hz` so cfctl `observe.settings` round-trips a single\nauthoritative value. Defaults to 60.",
          "type": "integer",
          "format": "uint32",
          "default": 60,
          "minimum": 0
        },
        "time_limit": {
          "type": "boolean",
          "default": false
        },
        "ui_density": {
          "$ref": "#/$defs/UiDensity",
          "default": "comfortable"
        },
        "ui_scale": {
          "type": "number",
          "format": "float"
        },
        "walk_threshold": {
          "description": "actor counts as \"slow enough\" to keep building sharp aim. Default 1.5.",
          "type": "number",
          "format": "float",
          "default": 1.5
        }
      },
      "required": [
        "ui_scale",
        "high_contrast",
        "captions",
        "reduced_motion",
        "reduced_shake",
        "reduced_flash"
      ]
    },
    "UiDensity": {
      "description": "Compact / Comfortable / Spacious. M11 added `Comfortable` as the canonical\ndefault-density name (was `Normal` under M8 — accepted as an alias).",
      "oneOf": [
        {
          "description": "Compact — denser HUD layout.",
          "type": "string",
          "const": "compact"
        },
        {
          "description": "Comfortable — default density (M11 canonical name; alias `normal`).",
          "type": "string",
          "const": "comfortable"
        },
        {
          "description": "Spacious — looser HUD spacing.",
          "type": "string",
          "const": "spacious"
        }
      ]
    }
  }
}
