{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ObserveFrame",
  "type": "object",
  "required": [
    "events",
    "events_since",
    "run_id",
    "run_status",
    "scenario",
    "schema_version",
    "settings",
    "sim_time_ms",
    "tick"
  ],
  "properties": {
    "events": {
      "type": "array",
      "items": true
    },
    "events_since": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0.0
    },
    "run_id": {
      "type": "string"
    },
    "run_status": {
      "$ref": "#/definitions/RunStatus"
    },
    "scenario": {
      "type": "string"
    },
    "schema_version": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0.0
    },
    "settings": {
      "$ref": "#/definitions/ObserveSettings"
    },
    "sim_time_ms": {
      "type": "number",
      "format": "double"
    },
    "tick": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0.0
    }
  },
  "definitions": {
    "ObserveSettings": {
      "type": "object",
      "required": [
        "schema_version",
        "settings"
      ],
      "properties": {
        "schema_version": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "settings": {
          "$ref": "#/definitions/Settings"
        }
      }
    },
    "RunStatus": {
      "type": "string",
      "enum": [
        "running",
        "paused",
        "stepping",
        "ended"
      ]
    },
    "Settings": {
      "type": "object",
      "required": [
        "captions",
        "high_contrast",
        "reduced_flash",
        "reduced_motion",
        "reduced_shake",
        "ui_scale"
      ],
      "properties": {
        "captions": {
          "type": "boolean"
        },
        "high_contrast": {
          "type": "boolean"
        },
        "reduced_flash": {
          "type": "boolean"
        },
        "reduced_motion": {
          "type": "boolean"
        },
        "reduced_shake": {
          "type": "boolean"
        },
        "ui_scale": {
          "type": "number",
          "format": "float"
        }
      }
    }
  }
}
