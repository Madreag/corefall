{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ObserveFrame",
  "type": "object",
  "properties": {
    "actors": {
      "description": "M1: typed projection of every actor in the world. Empty in M0 scenarios.",
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/ActorView"
      }
    },
    "breaches": {
      "description": "M1.5: breach strips in the scenario. Empty for sandbox scenarios.",
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/BreachView"
      }
    },
    "enemies": {
      "description": "M1.5: reactive guards and their last-tick view. Empty for sandbox scenarios.",
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/EnemyView"
      }
    },
    "events": {
      "type": "array",
      "items": true
    },
    "events_since": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "mission": {
      "description": "M1.5: mission state machine projection. `None` for sandbox scenarios.",
      "anyOf": [
        {
          "$ref": "#/$defs/MissionView"
        },
        {
          "type": "null"
        }
      ]
    },
    "player_actor_id": {
      "description": "Convenience pointer to the player actor in `actors` by id, if any.",
      "type": [
        "integer",
        "null"
      ],
      "format": "uint64",
      "default": null,
      "minimum": 0
    },
    "run_id": {
      "type": "string"
    },
    "run_status": {
      "$ref": "#/$defs/RunStatus"
    },
    "scenario": {
      "type": "string"
    },
    "schema_version": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "settings": {
      "$ref": "#/$defs/ObserveSettings"
    },
    "sim_time_ms": {
      "type": "number",
      "format": "double"
    },
    "tick": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "tick",
    "sim_time_ms",
    "run_status",
    "scenario",
    "events_since",
    "events",
    "settings"
  ],
  "$defs": {
    "ActorView": {
      "description": "Public projection of one actor for the observe envelope. Mirrors\n`cf_actor::ActorObservation` with extra fields (rifle ammo / cooldown / reload\nstate) the engine wires through.",
      "type": "object",
      "properties": {
        "aim": {
          "type": "array",
          "items": {
            "type": "number",
            "format": "float"
          },
          "maxItems": 2,
          "minItems": 2
        },
        "controllable": {
          "type": "boolean"
        },
        "hp": {
          "type": "number",
          "format": "float"
        },
        "hp_max": {
          "type": "number",
          "format": "float"
        },
        "id": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "on_ground": {
          "type": "boolean"
        },
        "position": {
          "type": "array",
          "items": {
            "type": "number",
            "format": "float"
          },
          "maxItems": 2,
          "minItems": 2
        },
        "rifle_ammo": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "rifle_capacity": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "rifle_fire_cooldown_ticks": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "rifle_reload_remaining_ticks": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "rifle_reload_total_ticks": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "selected_item": {
          "type": "string"
        },
        "selected_slot": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "status": {
          "type": "string"
        },
        "team": {
          "type": "string"
        },
        "velocity": {
          "type": "array",
          "items": {
            "type": "number",
            "format": "float"
          },
          "maxItems": 2,
          "minItems": 2
        }
      },
      "required": [
        "id",
        "team",
        "controllable",
        "position",
        "velocity",
        "aim",
        "on_ground",
        "status",
        "hp",
        "hp_max",
        "selected_slot",
        "selected_item"
      ]
    },
    "BreachView": {
      "type": "object",
      "properties": {
        "bbox_max": {
          "type": "array",
          "items": {
            "type": "number",
            "format": "float"
          },
          "maxItems": 2,
          "minItems": 2
        },
        "bbox_min": {
          "type": "array",
          "items": {
            "type": "number",
            "format": "float"
          },
          "maxItems": 2,
          "minItems": 2
        },
        "broken": {
          "type": "boolean"
        },
        "dig_range": {
          "type": "number",
          "format": "float"
        },
        "hp": {
          "type": "number",
          "format": "float"
        },
        "id": {
          "type": "string"
        },
        "material": {
          "type": "string"
        },
        "max_hp": {
          "type": "number",
          "format": "float"
        },
        "refusal_reason": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "material",
        "bbox_min",
        "bbox_max",
        "hp",
        "max_hp",
        "broken",
        "dig_range"
      ]
    },
    "EnemyView": {
      "type": "object",
      "properties": {
        "actor": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "aim": {
          "type": "array",
          "items": {
            "type": "number",
            "format": "float"
          },
          "maxItems": 2,
          "minItems": 2
        },
        "aim_settle_remaining_ticks": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "alert_dwell_remaining_ticks": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "ammo": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "fire_cooldown_ticks": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "last_tactic": {
          "type": "string"
        },
        "mag_capacity": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "reload_remaining_ticks": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "state": {
          "type": "string"
        }
      },
      "required": [
        "actor",
        "state",
        "last_tactic",
        "ammo",
        "mag_capacity",
        "fire_cooldown_ticks",
        "reload_remaining_ticks",
        "aim_settle_remaining_ticks",
        "alert_dwell_remaining_ticks",
        "aim"
      ]
    },
    "MissionView": {
      "description": "M1.5 mission projection (re-exposed via JsonSchema-friendly types).",
      "type": "object",
      "properties": {
        "active_objective": {
          "type": [
            "string",
            "null"
          ]
        },
        "elapsed_ticks": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "last_event_label": {
          "type": "string"
        },
        "last_event_tick": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "loss_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "objectives": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ObjectiveView"
          }
        },
        "result": {
          "type": "string"
        },
        "ticks_remaining": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "time_limit_ticks": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "result",
        "elapsed_ticks",
        "time_limit_ticks",
        "objectives",
        "last_event_tick",
        "last_event_label"
      ]
    },
    "ObjectiveView": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "optional": {
          "type": "boolean"
        },
        "status": {
          "type": "string"
        },
        "target_actor": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "target_breach": {
          "type": [
            "string",
            "null"
          ]
        },
        "zone_max": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "number",
            "format": "float"
          },
          "maxItems": 2,
          "minItems": 2
        },
        "zone_min": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "number",
            "format": "float"
          },
          "maxItems": 2,
          "minItems": 2
        }
      },
      "required": [
        "id",
        "kind",
        "status",
        "optional"
      ]
    },
    "ObserveSettings": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "settings": {
          "$ref": "#/$defs/Settings"
        }
      },
      "required": [
        "schema_version",
        "settings"
      ]
    },
    "RunStatus": {
      "type": "string",
      "enum": [
        "running",
        "paused",
        "stepping",
        "ended"
      ]
    },
    "Settings": {
      "type": "object",
      "properties": {
        "captions": {
          "type": "boolean"
        },
        "high_contrast": {
          "type": "boolean"
        },
        "reduced_flash": {
          "type": "boolean"
        },
        "reduced_motion": {
          "type": "boolean"
        },
        "reduced_shake": {
          "type": "boolean"
        },
        "ui_scale": {
          "type": "number",
          "format": "float"
        }
      },
      "required": [
        "ui_scale",
        "high_contrast",
        "captions",
        "reduced_motion",
        "reduced_shake",
        "reduced_flash"
      ]
    }
  }
}
