{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ActPlayerMaintainProstheticParams",
  "description": "on an installed prosthetic. Resets wear_pct to 0 + clears the\nmalfunction flag.",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "target_actor_id": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "zone": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "required": [
    "schema_version",
    "target_actor_id",
    "zone"
  ]
}
