{
  "$schema": "http://json-schema.org/draft-2020-12/schema",
  "$id": "cf-material/material_def.v1",
  "title": "MaterialDef",
  "description": "One material entry in the canonical registry. Schema v1 (M2). Future-compat fields (heat_capacity, ignition_temperature, etc.) are optional and read by M5.6 active material kernel.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "display_name",
    "hardness",
    "diggable",
    "anchorable",
    "hazard",
    "path_cost",
    "density",
    "color_hex",
    "description"
  ],
  "properties": {
    "id": { "type": "integer", "minimum": 0, "maximum": 255 },
    "name": { "type": "string", "minLength": 1 },
    "display_name": { "type": "string", "minLength": 1 },
    "hardness": { "type": "number" },
    "diggable": { "type": "boolean" },
    "anchorable": { "type": "boolean" },
    "hazard": { "type": "boolean" },
    "path_cost": { "type": "number", "minimum": 0 },
    "density": { "type": "number" },
    "color_hex": { "type": "string", "pattern": "^[0-9a-fA-F]{6}$" },
    "description": { "type": "string" },
    "drillable": { "type": ["boolean", "null"] },
    "blastable": { "type": ["boolean", "null"] },
    "beam_cuttable": { "type": ["boolean", "null"] },
    "projectile_passable": { "type": ["boolean", "null"] },
    "actor_passable": { "type": ["boolean", "null"] },
    "blocks_line_of_sight": { "type": ["boolean", "null"] },
    "damage_per_tick": { "type": ["number", "null"] },
    "damage_kind": { "type": ["string", "null"] },
    "stickiness": { "type": ["number", "null"] },
    "restitution": { "type": ["number", "null"] },
    "friction": { "type": ["number", "null"] },
    "structural_integrity": { "type": ["number", "null"] },
    "priority": { "type": ["integer", "null"] },
    "piling": { "type": ["boolean", "null"] },
    "settle_material": { "type": ["integer", "null"], "minimum": 0 },
    "spawn_material": { "type": ["integer", "null"], "minimum": 0 },
    "is_scrap": { "type": ["boolean", "null"] },
    "uses_own_color": { "type": ["boolean", "null"] },
    "ui_overlay_color": { "type": ["string", "null"] },
    "render_priority": { "type": ["integer", "null"] },
    "heat_capacity": { "type": ["number", "null"] },
    "thermal_conductivity": { "type": ["number", "null"] },
    "temperature": { "type": ["number", "null"] },
    "ignition_temperature": { "type": ["number", "null"] },
    "burn_rate": { "type": ["number", "null"] },
    "oxygen_requirement": { "type": ["number", "null"] },
    "burn_products": { "type": "array", "items": { "type": "integer", "minimum": 0 } },
    "phase_changes": { "type": "array" },
    "conductivity": { "type": ["number", "null"] },
    "wetting": { "type": ["number", "null"] },
    "reaction_tags": { "type": "array", "items": { "type": "string" } },
    "ai_affordances": { "type": "array", "items": { "type": "string" } }
  }
}
