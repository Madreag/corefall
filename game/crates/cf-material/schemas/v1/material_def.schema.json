{
  "$schema": "http://json-schema.org/draft-2020-12/schema",
  "$id": "cf-material/material_def.v1",
  "title": "MaterialDef",
  "description": "One material entry in the canonical registry. Schema v1 (M2). M5.6 added active-material kernel fields; M12B added acoustic registry; M14E/M14F added structural fields; M15C added the full thermodynamic + chemistry schema (state, density_kg_per_m3, specific_heat_capacity_j_per_kg_k, thermal_conductivity_w_per_m_k, melt/freeze/boil/ignition_temp_k, molar_mass_g_per_mol, toxicity, corrosiveness, radioactivity, electrical_conductivity, viscosity_pa_s, surface_tension_n_per_m, default_mass_per_tile_kg, max_mass_per_tile_kg, reactions[], container_rules).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "display_name",
    "hardness",
    "diggable",
    "anchorable",
    "hazard",
    "path_cost",
    "density",
    "color_hex",
    "description"
  ],
  "properties": {
    "id": { "type": "integer", "minimum": 0, "maximum": 65535 },
    "name": { "type": "string", "minLength": 1 },
    "display_name": { "type": "string", "minLength": 1 },
    "hardness": { "type": "number" },
    "diggable": { "type": "boolean" },
    "anchorable": { "type": "boolean" },
    "hazard": { "type": "boolean" },
    "path_cost": { "type": "number", "minimum": 0 },
    "density": { "type": "number" },
    "color_hex": { "type": "string", "pattern": "^[0-9a-fA-F]{6}$" },
    "description": { "type": "string" },
    "drillable": { "type": ["boolean", "null"] },
    "blastable": { "type": ["boolean", "null"] },
    "beam_cuttable": { "type": ["boolean", "null"] },
    "projectile_passable": { "type": ["boolean", "null"] },
    "actor_passable": { "type": ["boolean", "null"] },
    "blocks_line_of_sight": { "type": ["boolean", "null"] },
    "damage_per_tick": { "type": ["number", "null"] },
    "damage_kind": { "type": ["string", "null"] },
    "stickiness": { "type": ["number", "null"] },
    "restitution": { "type": ["number", "null"] },
    "friction": { "type": ["number", "null"] },
    "structural_integrity": { "type": ["number", "null"] },
    "priority": { "type": ["integer", "null"] },
    "piling": { "type": ["boolean", "null"] },
    "settle_material": { "type": ["integer", "null"], "minimum": 0 },
    "spawn_material": { "type": ["integer", "null"], "minimum": 0 },
    "is_scrap": { "type": ["boolean", "null"] },
    "uses_own_color": { "type": ["boolean", "null"] },
    "ui_overlay_color": { "type": ["string", "null"] },
    "render_priority": { "type": ["integer", "null"] },
    "heat_capacity": { "type": ["number", "null"] },
    "thermal_conductivity": { "type": ["number", "null"] },
    "temperature": { "type": ["number", "null"] },
    "ignition_temperature": { "type": ["number", "null"] },
    "burn_rate": { "type": ["number", "null"] },
    "oxygen_requirement": { "type": ["number", "null"] },
    "burn_products": { "type": "array", "items": { "type": "integer", "minimum": 0 } },
    "phase_changes": { "type": "array" },
    "conductivity": { "type": ["number", "null"] },
    "wetting": { "type": ["number", "null"] },
    "reaction_tags": { "type": "array", "items": { "type": "string" } },
    "ai_affordances": { "type": "array", "items": { "type": "string" } },
    "echo_coefficient": { "type": ["number", "null"] },
    "decay_band": { "type": ["string", "null"] },
    "acoustic_transmission_loss_db": { "type": ["number", "null"] },
    "low_pass_cutoff_hz": { "type": ["number", "null"] },
    "structural_support_strength": { "type": ["integer", "null"], "minimum": 0 },
    "lateral_yield_strength": { "type": ["integer", "null"], "minimum": 0 },
    "state": {
      "type": ["string", "null"],
      "enum": ["solid", "liquid", "gas", "powder", "plasma", "energy_field", null]
    },
    "density_kg_per_m3": { "type": ["number", "null"], "minimum": 0 },
    "specific_heat_capacity_j_per_kg_k": { "type": ["number", "null"], "minimum": 0 },
    "thermal_conductivity_w_per_m_k": { "type": ["number", "null"], "minimum": 0 },
    "melt_temp_k": { "type": ["number", "null"] },
    "freeze_temp_k": { "type": ["number", "null"] },
    "boil_temp_k": { "type": ["number", "null"] },
    "ignition_temp_k": { "type": ["number", "null"] },
    "molar_mass_g_per_mol": { "type": ["number", "null"], "minimum": 0 },
    "toxicity": { "type": ["number", "null"], "minimum": 0 },
    "corrosiveness": { "type": ["number", "null"], "minimum": 0 },
    "radioactivity": { "type": ["number", "null"], "minimum": 0 },
    "electrical_conductivity": { "type": ["number", "null"], "minimum": 0 },
    "viscosity_pa_s": { "type": ["number", "null"], "minimum": 0 },
    "surface_tension_n_per_m": { "type": ["number", "null"], "minimum": 0 },
    "default_mass_per_tile_kg": { "type": ["number", "null"], "minimum": 0 },
    "max_mass_per_tile_kg": { "type": ["number", "null"], "minimum": 0 },
    "reactions": { "type": "array" },
    "container_rules": { "type": ["object", "null"] }
  }
}
