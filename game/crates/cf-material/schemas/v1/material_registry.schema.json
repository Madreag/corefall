{
  "$schema": "http://json-schema.org/draft-2020-12/schema",
  "$id": "cf-material/material_registry.v1",
  "title": "MaterialRegistry",
  "description": "Canonical material registry (DR-007 launch set, M2). schema_version=1; materials[] must include the 8 launch ids 0..=7.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "materials"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "description": { "type": "string" },
    "materials": {
      "type": "array",
      "minItems": 8,
      "items": { "$ref": "material_def.schema.json" }
    }
  }
}
