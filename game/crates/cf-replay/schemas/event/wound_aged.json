{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://corefall/event/wound.aged.v0.1",
  "title": "wound.aged",
  "description": "M14G § Per-tick aging pass — fires on bandage soak-through, scab formation, scar progression, and Frostbite3rd → Necrosis transitions. `new_state` is gated to a closed enum so consumers can render visible-state transitions deterministically. Honors VAL-M14G-015/019/024/025/037/041.",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "schema_version": { "const": "prototype-recorder-event.v0.1" },
    "category": { "const": "wound" },
    "event_type": { "const": "aged" },
    "actor_id": { "type": ["integer", "null"] },
    "tick": { "type": "integer", "minimum": 0 },
    "payload": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "actor_id": { "type": "integer" },
        "tick": { "type": "integer", "minimum": 0 },
        "zone": { "type": "string" },
        "wound_id": { "type": "integer", "minimum": 0 },
        "new_state": {
          "type": "string",
          "enum": [
            "bandage_soaked",
            "scab_forming",
            "scab_complete",
            "scar_forming",
            "necrotic"
          ]
        }
      },
      "required": ["actor_id", "tick", "zone", "wound_id", "new_state"]
    }
  },
  "required": ["schema_version", "category", "event_type", "tick", "payload"]
}
