{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://corefall/event/armor.spalling.v0.1",
  "title": "armor.spalling",
  "description": "M5 § armor.* family — declarative event schema locked at v0.1. Spalling formula (locked): if damage_to_armor > armor.spalling_threshold, spawn 1-3 fragments at random angles within 30° forward cone, each carrying 0.2-0.5 of original damage. Producer fills at M13. Additive-only per M4 DR-002.",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "schema_version": { "const": "prototype-recorder-event.v0.1" },
    "category": { "const": "armor" },
    "event_type": { "const": "spalling" },
    "actor_id": { "type": ["integer", "null"] },
    "tick": { "type": "integer", "minimum": 0 },
    "payload": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "item_id": { "type": "integer" },
        "zone": { "type": "string", "enum": ["head", "torso", "arm_left", "arm_right", "forearm_left", "forearm_right", "hand_left", "hand_right", "leg_left", "leg_right", "shin_left", "shin_right", "foot_left", "foot_right", "backpack"] },
        "layer": { "type": "string", "enum": ["External", "Internal", "Core"] },
        "fragment_count": { "type": "integer", "minimum": 0 },
        "damage_per_fragment": { "type": "number" },
        "cause_event_id": { "type": "string" }
      },
      "required": ["item_id", "zone", "layer", "fragment_count", "damage_per_fragment", "cause_event_id"]
    }
  },
  "required": ["schema_version", "category", "event_type", "tick", "payload"]
}
