{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://corefall/event/psych.comorbidity_detected.v0.1",
  "title": "psych.comorbidity_detected",
  "description": "M16C § A comorbid condition pair is detected on an actor (PTSD + Depression common; Addiction + Withdrawal mandatory; Insomnia comorbid with most). `primary` is the index condition; `comorbid` is the co-present partner.",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "schema_version": { "const": "prototype-recorder-event.v0.1" },
    "category": { "const": "psych" },
    "event_type": { "const": "comorbidity_detected" },
    "actor_id": { "type": ["integer", "null"] },
    "tick": { "type": "integer", "minimum": 0 },
    "payload": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "actor_id": { "type": "integer" },
        "tick": { "type": "integer", "minimum": 0 },
        "primary": { "type": "string", "enum": ["ptsd", "anxiety_disorder", "depression", "addiction", "withdrawal", "insomnia", "panic_disorder", "acute_stress_reaction"] },
        "comorbid": { "type": "string", "enum": ["ptsd", "anxiety_disorder", "depression", "addiction", "withdrawal", "insomnia", "panic_disorder", "acute_stress_reaction"] }
      },
      "required": ["actor_id", "tick", "primary", "comorbid"]
    }
  },
  "required": ["schema_version", "category", "event_type", "tick", "payload"]
}
