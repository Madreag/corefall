{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://corefall/event/armor.reactive_armor_consumed.v0.1",
  "title": "armor.reactive_armor_consumed",
  "description": "M5 § armor.* family — declarative event schema locked at v0.1. Fires when an ERA / Schürzen / reactive panel is permanently consumed (no longer protects). Producer fills at M13 + M14. Additive-only per M4 DR-002.",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "schema_version": { "const": "0.1" },
    "category": { "const": "armor" },
    "event_type": { "const": "reactive_armor_consumed" },
    "actor_id": { "type": ["integer", "null"] },
    "tick": { "type": "integer", "minimum": 0 },
    "payload": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "item_id": { "type": "integer" },
        "zone": { "type": "string", "enum": ["head", "torso", "arm_left", "arm_right", "forearm_left", "forearm_right", "hand_left", "hand_right", "leg_left", "leg_right", "shin_left", "shin_right", "foot_left", "foot_right", "backpack"] },
        "panel_id": { "type": ["integer", "string"] }
      },
      "required": ["item_id", "zone", "panel_id"]
    }
  },
  "required": ["schema_version", "category", "event_type", "tick", "payload"]
}
