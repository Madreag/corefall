{
  "$schema": "http://json-schema.org/draft-2020-12/schema",
  "$id": "cf-replay/event/ai_plan_composed.v1",
  "title": "ai.plan_composed",
  "description": "Emitted when the player composes a multi-step plan for a squadmate via act.player.compose_plan. Up to 8 steps per spec § Plan Composer.",
  "type": "object",
  "required": ["actor_id", "step_count", "steps"],
  "properties": {
    "actor_id": { "type": "integer", "minimum": 0 },
    "step_count": { "type": "integer", "minimum": 0, "maximum": 8 },
    "steps": {
      "type": "array",
      "minItems": 0,
      "maxItems": 8,
      "items": { "type": "string" }
    }
  }
}
