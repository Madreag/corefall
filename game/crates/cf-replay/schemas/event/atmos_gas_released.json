{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://corefall/event/atmos.gas_released.v0.1",
  "title": "atmos.gas_released",
  "description": "M5 § atmos.* family — declarative event schema locked at v0.1. Gas enum (locked): O2, N2, CO2, volatiles, pollutant, H2, N2O, H2O, O3, He. ignition_risk is 0.0..1.0 (multiplier for combustion ignition probability). Producer fills at M19. Additive-only per M4 DR-002.",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "schema_version": { "const": "prototype-recorder-event.v0.1" },
    "category": { "const": "atmos" },
    "event_type": { "const": "gas_released" },
    "actor_id": { "type": ["integer", "null"] },
    "tick": { "type": "integer", "minimum": 0 },
    "payload": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "atm_id": { "type": ["integer", "string"] },
        "gas": { "type": "string", "enum": ["O2", "N2", "CO2", "volatiles", "pollutant", "H2", "N2O", "H2O", "O3", "He"] },
        "moles": { "type": "number" },
        "source": { "type": "string" },
        "ignition_risk": { "type": "number", "minimum": 0.0, "maximum": 1.0 }
      },
      "required": ["atm_id", "gas", "moles", "source", "ignition_risk"]
    }
  },
  "required": ["schema_version", "category", "event_type", "tick", "payload"]
}
