{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://corefall/event/prosthetic.malfunctioned.v0.1",
  "title": "prosthetic.malfunctioned",
  "description": "M14I § Prosthetic loop — fires when a prosthetic's wear_pct crosses the malfunction threshold (default 0.6). Functional restoration drops to 0.5× until the maintenance pass restores it.",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "schema_version": { "const": "prototype-recorder-event.v0.1" },
    "category": { "const": "prosthetic" },
    "event_type": { "const": "malfunctioned" },
    "actor_id": { "type": ["integer", "null"] },
    "tick": { "type": "integer", "minimum": 0 },
    "payload": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "actor_id": { "type": "integer" },
        "tick": { "type": "integer", "minimum": 0 },
        "kind": { "type": "string" },
        "zone": { "type": "string" },
        "wear_pct": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "required": ["actor_id", "tick", "kind", "zone", "wear_pct"]
    }
  },
  "required": ["schema_version", "category", "event_type", "tick", "payload"]
}
