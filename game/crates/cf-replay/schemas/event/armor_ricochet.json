{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://corefall/event/armor.ricochet.v0.1",
  "title": "armor.ricochet",
  "description": "M5 § armor.* family — declarative event schema locked at v0.1. Fires when an incoming round's impact angle exceeds the per-ammo ricochet threshold; deflection_vector is the post-bounce direction. Producer fills at M13 + M14. Additive-only per M4 DR-002.",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "schema_version": { "const": "0.1" },
    "category": { "const": "armor" },
    "event_type": { "const": "ricochet" },
    "actor_id": { "type": ["integer", "null"] },
    "tick": { "type": "integer", "minimum": 0 },
    "payload": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "impact_angle": { "type": "number" },
        "ricochet_probability": { "type": "number", "minimum": 0.0 },
        "was_ricocheted": { "type": "boolean" },
        "deflection_vector": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 2,
          "maxItems": 2
        }
      },
      "required": ["impact_angle", "ricochet_probability", "was_ricocheted", "deflection_vector"]
    }
  },
  "required": ["schema_version", "category", "event_type", "tick", "payload"]
}
