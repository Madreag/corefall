{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://corefall/event/atmos.electrolysis_started.v0.1",
  "title": "atmos.electrolysis_started",
  "description": "M5 § atmos.* family — declarative event schema locked at v0.1. Fires when an electrolyzer module begins splitting water into O2 + H2. Rates are kg/s. Producer fills at M19. Additive-only per M4 DR-002.",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "schema_version": { "const": "0.1" },
    "category": { "const": "atmos" },
    "event_type": { "const": "electrolysis_started" },
    "actor_id": { "type": ["integer", "null"] },
    "tick": { "type": "integer", "minimum": 0 },
    "payload": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "electrolyzer_id": { "type": ["integer", "string"] },
        "input_water_kg_per_s": { "type": "number", "minimum": 0.0 },
        "output_o2_kg_per_s": { "type": "number", "minimum": 0.0 },
        "output_h2_kg_per_s": { "type": "number", "minimum": 0.0 }
      },
      "required": ["electrolyzer_id", "input_water_kg_per_s", "output_o2_kg_per_s", "output_h2_kg_per_s"]
    }
  },
  "required": ["schema_version", "category", "event_type", "tick", "payload"]
}
