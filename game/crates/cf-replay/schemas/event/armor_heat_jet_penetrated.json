{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://corefall/event/armor.heat_jet_penetrated.v0.1",
  "title": "armor.heat_jet_penetrated",
  "description": "M5 § armor.* family — declarative event schema locked at v0.1. Fires when a HEAT (high-explosive anti-tank) round's shaped-charge jet penetrates armor to a given depth. Producer fills at M13 + M14. Additive-only per M4 DR-002.",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "schema_version": { "const": "prototype-recorder-event.v0.1" },
    "category": { "const": "armor" },
    "event_type": { "const": "heat_jet_penetrated" },
    "actor_id": { "type": ["integer", "null"] },
    "tick": { "type": "integer", "minimum": 0 },
    "payload": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "item_id": { "type": "integer" },
        "zone": { "type": "string", "enum": ["head", "torso", "arm_left", "arm_right", "forearm_left", "forearm_right", "hand_left", "hand_right", "leg_left", "leg_right", "shin_left", "shin_right", "foot_left", "foot_right", "backpack"] },
        "layer": { "type": "string", "enum": ["External", "Internal", "Core"] },
        "jet_depth_mm": { "type": "number", "minimum": 0.0 }
      },
      "required": ["item_id", "zone", "layer", "jet_depth_mm"]
    }
  },
  "required": ["schema_version", "category", "event_type", "tick", "payload"]
}
