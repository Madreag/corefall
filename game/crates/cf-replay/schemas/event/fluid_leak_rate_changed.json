{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://corefall/event/fluid.leak_rate_changed.v0.1",
  "title": "fluid.leak_rate_changed",
  "description": "M5 § fluid.* family — declarative event schema locked at v0.1. Fires when an existing leak's rate is mutated (e.g. pressure drops as reservoir empties, or a partial seal slows it). Producer fills at M13. Additive-only per M4 DR-002.",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "schema_version": { "const": "0.1" },
    "category": { "const": "fluid" },
    "event_type": { "const": "leak_rate_changed" },
    "actor_id": { "type": ["integer", "null"] },
    "tick": { "type": "integer", "minimum": 0 },
    "payload": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "actor_id": { "type": "integer" },
        "fluid_kind": { "type": "string", "enum": ["oil", "coolant", "fuel", "electrolyte"] },
        "from_rate": { "type": "number" },
        "to_rate": { "type": "number" },
        "reason": { "type": "string" }
      },
      "required": ["actor_id", "fluid_kind", "from_rate", "to_rate", "reason"]
    }
  },
  "required": ["schema_version", "category", "event_type", "tick", "payload"]
}
