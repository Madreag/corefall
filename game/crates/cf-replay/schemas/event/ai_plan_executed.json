{
  "$schema": "http://json-schema.org/draft-2020-12/schema",
  "$id": "cf-replay/event/ai_plan_executed.v1",
  "title": "ai.plan_executed",
  "description": "Emitted when the player issues 'GO' on a composed plan; all queued plans fire simultaneously.",
  "type": "object",
  "required": ["plan_count"],
  "properties": {
    "plan_count": { "type": "integer", "minimum": 0 },
    "actor_ids": {
      "type": "array",
      "items": { "type": "integer", "minimum": 0 }
    }
  }
}
