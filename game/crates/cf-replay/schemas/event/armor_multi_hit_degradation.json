{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://corefall/event/armor.multi_hit_degradation.v0.1",
  "title": "armor.multi_hit_degradation",
  "description": "M5 § armor.* family — declarative event schema locked at v0.1. Fires for ceramic + composite armor types that lose hardness over multiple impacts even before the layer is destroyed. Producer fills at M13. Additive-only per M4 DR-002.",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "schema_version": { "const": "0.1" },
    "category": { "const": "armor" },
    "event_type": { "const": "multi_hit_degradation" },
    "actor_id": { "type": ["integer", "null"] },
    "tick": { "type": "integer", "minimum": 0 },
    "payload": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "item_id": { "type": "integer" },
        "zone": { "type": "string", "enum": ["head", "torso", "arm_left", "arm_right", "forearm_left", "forearm_right", "hand_left", "hand_right", "leg_left", "leg_right", "shin_left", "shin_right", "foot_left", "foot_right", "backpack"] },
        "layer": { "type": "string", "enum": ["External", "Internal", "Core"] },
        "hits_received": { "type": "integer", "minimum": 0 },
        "hardness_remaining": { "type": "number", "minimum": 0.0 }
      },
      "required": ["item_id", "zone", "layer", "hits_received", "hardness_remaining"]
    }
  },
  "required": ["schema_version", "category", "event_type", "tick", "payload"]
}
