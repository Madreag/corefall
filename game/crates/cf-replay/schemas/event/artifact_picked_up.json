{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://corefall/event/artifact.picked_up.v0.1",
  "title": "artifact.picked_up",
  "description": "M16 § Artifact loot. Fires when an actor picks up an artifact from the world; subsequent artifact.carried_bonus_applied surfaces the bonus snapshot. Producer fills at M16. Additive-only per M4 DR-002.",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "schema_version": { "const": "prototype-recorder-event.v0.1" },
    "category": { "const": "artifact" },
    "event_type": { "const": "picked_up" },
    "actor_id": { "type": ["integer", "null"] },
    "tick": { "type": "integer", "minimum": 0 },
    "payload": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "instance_id": { "type": "integer" },
        "spec_id": { "type": "string" },
        "actor_id": { "type": "integer" },
        "rarity": { "type": "string", "enum": ["common", "magic", "rare", "legendary", "unique"] }
      },
      "required": ["instance_id", "spec_id", "actor_id", "rarity"]
    }
  },
  "required": ["schema_version", "category", "event_type", "tick", "payload"]
}
