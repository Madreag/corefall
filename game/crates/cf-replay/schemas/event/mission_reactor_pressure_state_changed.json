{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://corefall/event/mission.reactor_pressure_state_changed.v0.1",
  "title": "mission.reactor_pressure_state_changed",
  "description": "M9 § Reactor pressure state machine — emitted on every pressure-state band crossing. Thresholds: Nominal (hp>=75%), Stressed (50%-75%), Critical (25%-50%), Venting (>0%-25%), Destroyed (=0). HUD reads this for the REACTOR: <STATE> line + color tint. Additive-only per M4 DR-002.",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "schema_version": { "const": "prototype-recorder-event.v0.1" },
    "category": { "const": "mission" },
    "event_type": { "const": "reactor_pressure_state_changed" },
    "actor_id": { "type": ["integer", "null"] },
    "tick": { "type": "integer", "minimum": 0 },
    "payload": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "reactor_id": { "type": "string" },
        "from": { "type": "string", "enum": ["Nominal", "Stressed", "Critical", "Venting", "Destroyed"] },
        "to": { "type": "string", "enum": ["Nominal", "Stressed", "Critical", "Venting", "Destroyed"] },
        "hp_percent": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "reason": { "type": "string" },
        "parent_event_id": { "type": ["string", "null"] }
      },
      "required": ["reactor_id", "from", "to", "hp_percent", "reason"]
    }
  },
  "required": ["schema_version", "category", "event_type", "tick", "payload"]
}
