{
  "$schema": "http://json-schema.org/draft-2020-12/schema",
  "$id": "cf-replay/event/squad_breach_chain_complete.v1",
  "title": "squad.breach_chain_complete",
  "description": "Emitted after the last actor clears the threshold during a breach chain. Spec M7B § Breach-Stack-Frag-Clear chain.",
  "type": "object",
  "required": ["squad_id", "door_id"],
  "properties": {
    "squad_id": {"type": "integer", "minimum": 0},
    "door_id": {"type": "integer", "minimum": 0},
    "completed_tick": {"type": ["integer", "null"], "minimum": 0},
    "duration_ticks": {"type": ["integer", "null"], "minimum": 0},
    "actor_ids": {"type": "array"}
  },
  "additionalProperties": true
}
