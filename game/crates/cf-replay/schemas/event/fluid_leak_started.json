{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://corefall/event/fluid.leak_started.v0.1",
  "title": "fluid.leak_started",
  "description": "M5 § fluid.* family — declarative event schema locked at v0.1. 4 fluid reservoirs (locked): oil (oil_reservoir), coolant (coolant_pump), fuel (fuel_tank), electrolyte (power_core). Producer fills at M13 (chassis fluid system) + M14 (collision puncture). Additive-only per M4 DR-002.",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "schema_version": { "const": "0.1" },
    "category": { "const": "fluid" },
    "event_type": { "const": "leak_started" },
    "actor_id": { "type": ["integer", "null"] },
    "tick": { "type": "integer", "minimum": 0 },
    "payload": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "actor_id": { "type": "integer" },
        "fluid_kind": { "type": "string", "enum": ["oil", "coolant", "fuel", "electrolyte"] },
        "source_module_id": { "type": ["integer", "string"] },
        "leak_rate": { "type": "number" },
        "position": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 2,
          "maxItems": 2
        }
      },
      "required": ["actor_id", "fluid_kind", "source_module_id", "leak_rate", "position"]
    }
  },
  "required": ["schema_version", "category", "event_type", "tick", "payload"]
}
