{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://corefall/event/flask.thrown.v0.1",
  "title": "flask.thrown",
  "description": "M15 § Flask system — flask thrown event. Fires when a player or AI throws a flask and it breaks on impact. The engine paints `splash_pixel_budget` pixels of `contents_material` within `splash_radius_px` of `impact_pos`. Producer: cf-flask::throw_flask. Additive-only per M4 DR-002.",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "schema_version": { "const": "prototype-recorder-event.v0.1" },
    "category": { "const": "flask" },
    "event_type": { "const": "thrown" },
    "actor_id": { "type": ["integer", "null"] },
    "tick": { "type": "integer", "minimum": 0 },
    "payload": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "flask_id": { "type": "integer", "minimum": 0 },
        "thrower_id": { "type": "integer", "minimum": 0 },
        "kind": { "type": "string", "enum": ["water", "oil", "acid", "fuel", "heal_potion", "poison", "alchemy_mix"] },
        "contents_material": { "type": "integer", "minimum": 0, "maximum": 255 },
        "impact_pos": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 2,
          "maxItems": 2
        },
        "volume_ml": { "type": "number", "minimum": 0 },
        "splash_radius_px": { "type": "number", "minimum": 0 },
        "splash_pixel_budget": { "type": "integer", "minimum": 0 }
      },
      "required": ["flask_id", "thrower_id", "kind", "contents_material", "impact_pos", "volume_ml", "splash_radius_px", "splash_pixel_budget"]
    }
  },
  "required": ["schema_version", "category", "event_type", "tick", "payload"]
}
