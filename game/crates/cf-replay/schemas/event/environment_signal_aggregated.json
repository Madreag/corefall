{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://corefall/event/environment.signal_aggregated.v0.1",
  "title": "environment.signal_aggregated",
  "description": "M5 § environment.* family — declarative event schema locked at v0.1. Full per-actor 11-slice bundle. Cosmetic-batchable (DR-052) — heavy payload, the cosmetic flag excludes this from determinism.sim_checksum so cause-chains stay light. Producer fills at M20. Additive-only per M4 DR-002.",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "schema_version": { "const": "prototype-recorder-event.v0.1" },
    "category": { "const": "environment" },
    "event_type": { "const": "signal_aggregated" },
    "actor_id": { "type": ["integer", "null"] },
    "tick": { "type": "integer", "minimum": 0 },
    "cosmetic": { "const": true },
    "payload": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "actor_id": { "type": "integer" },
        "tick": { "type": "integer", "minimum": 0 },
        "signal": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "schema_version": { "type": "integer", "minimum": 1 },
            "active_hazards": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": ["Hypoxic", "CombustibleAtmosphere", "ToxicAtmosphere", "BreachDecomp", "Hyperthermic", "Hypothermic", "Radiation", "LowVisibility", "Glare", "EmDisruption", "WindForce", "DrowningHazard", "VacuumNoVoice", "CommsBlackout", "GravityShift"]
              }
            }
          },
          "required": ["schema_version", "active_hazards"]
        }
      },
      "required": ["actor_id", "tick", "signal"]
    }
  },
  "required": ["schema_version", "category", "event_type", "tick", "payload"]
}
