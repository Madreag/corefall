{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://corefall/event/disease.vaccinated.v0.1",
  "title": "disease.vaccinated",
  "description": "M16B § Vaccine administered. Fires on each vaccine dose. `immune` becomes true once the full dose course is complete; `remaining_duration_seconds` reflects the immunity record's remaining protection window (default 5 in-game years).",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "schema_version": { "const": "prototype-recorder-event.v0.1" },
    "category": { "const": "disease" },
    "event_type": { "const": "vaccinated" },
    "actor_id": { "type": ["integer", "null"] },
    "tick": { "type": "integer", "minimum": 0 },
    "payload": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "actor_id": { "type": "integer" },
        "tick": { "type": "integer", "minimum": 0 },
        "pathogen": { "type": "string", "enum": ["slimelung", "food_poisoning", "radiation_sickness", "common_cold", "flu", "pneumonia", "tuberculosis", "cholera", "typhoid", "rabies", "tetanus", "bubonic_plague", "anthrax", "cancer", "mental_illness", "sepsis", "influenza_pandemic"] },
        "vaccine_id": { "type": "string" },
        "doses_taken": { "type": "integer", "minimum": 0 },
        "doses_required": { "type": "integer", "minimum": 0 },
        "immune": { "type": "boolean" },
        "remaining_duration_seconds": { "type": "number", "minimum": 0 }
      },
      "required": ["actor_id", "tick", "pathogen", "vaccine_id"]
    }
  },
  "required": ["schema_version", "category", "event_type", "tick", "payload"]
}
