{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://corefall/event/surgery.completed.v0.1",
  "title": "surgery.completed",
  "description": "M14H § Surgery 5-phase minigame — fires when the final Recover phase completes and the surgery session terminates successfully. wounds_treated / steps_passed summarize the Operate-phase outcome.",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "schema_version": { "const": "prototype-recorder-event.v0.1" },
    "category": { "const": "surgery" },
    "event_type": { "const": "completed" },
    "actor_id": { "type": ["integer", "null"] },
    "tick": { "type": "integer", "minimum": 0 },
    "payload": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "actor_id": { "type": "integer" },
        "tick": { "type": "integer", "minimum": 0 },
        "wounds_treated": { "type": "integer", "minimum": 0 },
        "steps_passed": { "type": "integer", "minimum": 0 }
      },
      "required": ["actor_id", "tick", "wounds_treated", "steps_passed"]
    }
  },
  "required": ["schema_version", "category", "event_type", "tick", "payload"]
}
