{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://corefall/event/resource.drain_rate_changed.v0.1",
  "title": "resource.drain_rate_changed",
  "description": "M17 § resource.* family — an actor resource drain rate changed (from_rate → to_rate), optionally driven by an affliction. Producer fills at M17. Additive-only per M4 DR-002.",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "schema_version": { "const": "prototype-recorder-event.v0.1" },
    "category": { "const": "resource" },
    "event_type": { "const": "drain_rate_changed" },
    "actor_id": { "type": ["integer", "null"] },
    "tick": { "type": "integer", "minimum": 0 },
    "payload": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "actor_id": { "type": "integer" },
        "kind": { "type": "string", "enum": ["blood", "oil", "power", "caloric", "bio_fluid", "oxygen_supply", "battery_charge", "internal_shock", "stamina"] },
        "from_rate": { "type": "number" },
        "to_rate": { "type": "number" },
        "source_affliction_id": { "type": ["string", "null"] }
      },
      "required": ["actor_id", "kind", "from_rate", "to_rate"]
    }
  },
  "required": ["schema_version", "category", "event_type", "tick", "payload"]
}
