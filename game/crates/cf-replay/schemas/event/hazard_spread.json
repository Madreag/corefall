{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://corefall/event/hazard.spread.v0.1",
  "title": "hazard.spread",
  "description": "M5 § hazard.* family — declarative event schema locked at v0.1. Fires when a hazard tile crosses into a neighbor tile (per-tick batched). Producer fills at M16. Additive-only per M4 DR-002.",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "schema_version": { "const": "prototype-recorder-event.v0.1" },
    "category": { "const": "hazard" },
    "event_type": { "const": "spread" },
    "actor_id": { "type": ["integer", "null"] },
    "tick": { "type": "integer", "minimum": 0 },
    "payload": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "from_pos": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 2,
          "maxItems": 2
        },
        "to_pos": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 2,
          "maxItems": 2
        },
        "kind": { "type": "string", "enum": ["fire", "smoke", "electric", "wet", "hot", "cold", "acid", "radiation", "toxic"] },
        "intensity": { "type": "number" },
        "rate": { "type": "number" }
      },
      "required": ["from_pos", "to_pos", "kind", "intensity", "rate"]
    }
  },
  "required": ["schema_version", "category", "event_type", "tick", "payload"]
}
