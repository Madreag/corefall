{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "system_run_finished.v0.1",
  "title": "system.run_finished payload",
  "description": "M4 § Expected outcome + system events. Fired once at the last tick declaring the lifecycle outcome.",
  "type": "object",
  "required": ["outcome", "exit_code"],
  "properties": {
    "outcome": { "type": "string", "enum": ["clean", "panic", "abort"] },
    "exit_code": { "type": "integer" },
    "ticks_run": { "type": "integer", "minimum": 0 },
    "wall_seconds": { "type": "number", "minimum": 0 },
    "final_sim_checksum": { "type": ["string", "null"] }
  }
}
