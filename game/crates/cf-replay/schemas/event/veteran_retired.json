{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://corefall/event/veteran.retired.v0.1",
  "title": "veteran.retired",
  "description": "M14I § Veteran retirement — fires when an actor at retirement_age+5 elects to retire via act.player.retire_veteran. The retired veteran becomes an advisor NPC with reduced combat availability + full narrative role.",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "schema_version": { "const": "prototype-recorder-event.v0.1" },
    "category": { "const": "veteran" },
    "event_type": { "const": "retired" },
    "actor_id": { "type": ["integer", "null"] },
    "tick": { "type": "integer", "minimum": 0 },
    "payload": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "actor_id": { "type": "integer" },
        "tick": { "type": "integer", "minimum": 0 },
        "age_in_game_years": { "type": "number", "minimum": 0 }
      },
      "required": ["actor_id", "tick"]
    }
  },
  "required": ["schema_version", "category", "event_type", "tick", "payload"]
}
