{
  "$schema": "http://json-schema.org/draft-2020-12/schema",
  "$id": "cf-replay/event/mg_nest_uncrewed.v1",
  "title": "fortification.mg_nest_uncrewed",
  "description": "M9C: act.player.uncrew_fortification OR actor death OR nest destruction releases the binding. Placeholder authored by m9c-1; full payload (actor_id, nest_id, reason, tick_index) lands in m9c-2 / m9c-6. Non-cosmetic.",
  "type": "object",
  "required": ["tick_index"],
  "properties": {
    "actor_id": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "nest_id": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "reason": {
      "type": "string",
      "enum": ["voluntary", "actor_killed", "nest_destroyed"]
    },
    "tick_index": {
      "type": "integer",
      "minimum": 0
    },
    "cosmetic": {
      "type": "boolean",
      "const": false,
      "default": false
    }
  },
  "additionalProperties": true
}
