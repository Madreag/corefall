{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://corefall/event/atmos.breach_detected.v0.1",
  "title": "atmos.breach_detected",
  "description": "M5 § atmos.* family — declarative event schema locked at v0.1. Fires when a sealed atmosphere is breached (wall hole, vent, door failure). breach_size_m2 is the hole area; decompression_rate_pa_per_s is the resulting pressure-bleed rate (forwards into breach_decomp affliction). Producer fills at M19. Additive-only per M4 DR-002.",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "schema_version": { "const": "prototype-recorder-event.v0.1" },
    "category": { "const": "atmos" },
    "event_type": { "const": "breach_detected" },
    "actor_id": { "type": ["integer", "null"] },
    "tick": { "type": "integer", "minimum": 0 },
    "payload": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "atm_id": { "type": ["integer", "string"] },
        "breach_size_m2": { "type": "number", "minimum": 0.0 },
        "source": { "type": "string" },
        "decompression_rate_pa_per_s": { "type": "number" }
      },
      "required": ["atm_id", "breach_size_m2", "source", "decompression_rate_pa_per_s"]
    }
  },
  "required": ["schema_version", "category", "event_type", "tick", "payload"]
}
