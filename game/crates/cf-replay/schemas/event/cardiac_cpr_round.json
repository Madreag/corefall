{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://corefall/event/cardiac.cpr_round.v0.1",
  "title": "cardiac.cpr_round",
  "description": "M14H § CPR loop — fires per completed 20s CPR round. consecutive_cpr_rounds drives the next defib roll's success-probability boost (+10% per round).",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "schema_version": { "const": "prototype-recorder-event.v0.1" },
    "category": { "const": "cardiac" },
    "event_type": { "const": "cpr_round" },
    "actor_id": { "type": ["integer", "null"] },
    "tick": { "type": "integer", "minimum": 0 },
    "payload": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "actor_id": { "type": "integer" },
        "tick": { "type": "integer", "minimum": 0 },
        "round_index": { "type": "integer", "minimum": 1 },
        "consecutive_cpr_rounds": { "type": "integer", "minimum": 0 }
      },
      "required": ["actor_id", "tick", "round_index", "consecutive_cpr_rounds"]
    }
  },
  "required": ["schema_version", "category", "event_type", "tick", "payload"]
}
