{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "snapshot_actor.v0.1",
  "title": "snapshot.snapshot_actor payload",
  "description": "M4 § Snapshot writer. Per-actor checkpoint emitted at scene start + every objective transition. M14 audit pass 3 (GAP-M4-07): the `required` list was previously [\"actor\", \"kind\"] only; per M4 spec the full payload contract is `actor, kind, team, controllable, position, velocity, aim, status, hp, hp_max, selected_slot, stability, sharp_aim_progress, mass_kg`. Required list expanded to match.",
  "type": "object",
  "required": [
    "actor",
    "kind",
    "team",
    "controllable",
    "position",
    "velocity",
    "aim",
    "status",
    "hp",
    "hp_max",
    "selected_slot",
    "stability",
    "sharp_aim_progress",
    "mass_kg"
  ],
  "properties": {
    "actor": { "type": ["integer", "string"] },
    "kind": { "type": "string" },
    "team": { "type": "string" },
    "controllable": { "type": "boolean" },
    "position": { "type": "array", "minItems": 2, "maxItems": 2 },
    "velocity": { "type": "array", "minItems": 2, "maxItems": 2 },
    "aim": { "type": "array", "minItems": 2, "maxItems": 2 },
    "status": { "type": "string" },
    "stance": { "type": "string" },
    "hp": { "type": "number" },
    "hp_max": { "type": "number" },
    "selected_slot": { "type": "integer" },
    "inventory_summary": { "type": "array" },
    "stability": { "type": "number" },
    "sharp_aim_progress": { "type": "number" },
    "mass_kg": { "type": "number" },
    "body_silhouette": { "type": ["object", "null"] }
  }
}
