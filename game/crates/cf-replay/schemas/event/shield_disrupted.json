{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://corefall/event/shield.disrupted.v0.1",
  "title": "shield.disrupted",
  "description": "M5 § shield.* family — declarative event schema locked at v0.1. Fires when a shield is forced into the Disrupted status by an external effect (e.g. EMP). duration_s is how long until regen-eligible. Producer fills at M13+. Additive-only per M4 DR-002.",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "schema_version": { "const": "0.1" },
    "category": { "const": "shield" },
    "event_type": { "const": "disrupted" },
    "actor_id": { "type": ["integer", "null"] },
    "tick": { "type": "integer", "minimum": 0 },
    "payload": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "actor_id": { "type": "integer" },
        "duration_s": { "type": "number", "minimum": 0.0 },
        "cause": { "type": "string" }
      },
      "required": ["actor_id", "duration_s", "cause"]
    }
  },
  "required": ["schema_version", "category", "event_type", "tick", "payload"]
}
