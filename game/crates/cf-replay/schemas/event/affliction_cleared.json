{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://corefall/event/affliction.cleared.v0.1",
  "title": "affliction.cleared",
  "description": "M5 § affliction.* family — declarative event schema locked at v0.1. Fires when an affliction is removed from an actor. The `kind` enum mirrors affliction.applied (23 kinds incl. M5-A1 `blinded`). reason enum: time (natural expiration), medikit (player/teammate intervention), environment (e.g. cold extinguishing fire), death (cascade clear on actor death). Producer fills at M16. Additive-only per M4 DR-002.",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "schema_version": { "const": "prototype-recorder-event.v0.1" },
    "category": { "const": "affliction" },
    "event_type": { "const": "cleared" },
    "actor_id": { "type": ["integer", "null"] },
    "tick": { "type": "integer", "minimum": 0 },
    "payload": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "actor_id": { "type": "integer" },
        "kind": { "type": "string", "enum": ["burning", "wet", "electrified", "poisoned", "hypoxic", "combustible_atmosphere", "breach_decomp", "hyperthermic", "hypothermic", "radiation", "concussed", "deafened", "blinded", "bleeding", "internal_shock", "low_battery", "coolant_leaking", "oil_leaking", "overheating", "hunger", "thirst", "sleep_dep", "sanity_low", "vacuum_exposure", "shocked", "frozen", "drowning", "pain"] },
        "reason": { "type": "string", "enum": ["time", "medikit", "environment", "death"] }
      },
      "required": ["actor_id", "kind", "reason"]
    }
  },
  "required": ["schema_version", "category", "event_type", "tick", "payload"]
}
