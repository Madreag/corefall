{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://corefall/event/affliction.applied.v0.1",
  "title": "affliction.applied",
  "description": "M5 § affliction.* family — declarative event schema locked at v0.1. 23 affliction kinds (locked names; M16 fills mechanics; M5-A1 adds blinded for M6 flash grenade): burning, wet, electrified, poisoned, hypoxic, combustible_atmosphere, breach_decomp, hyperthermic, hypothermic, radiation, concussed, deafened, blinded, bleeding, internal_shock, low_battery, coolant_leaking, oil_leaking, overheating, hunger, thirst, sleep_dep, sanity_low. Producer fills at M16. Additive-only per M4 DR-002.",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "schema_version": { "const": "prototype-recorder-event.v0.1" },
    "category": { "const": "affliction" },
    "event_type": { "const": "applied" },
    "actor_id": { "type": ["integer", "null"] },
    "tick": { "type": "integer", "minimum": 0 },
    "payload": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "actor_id": { "type": "integer" },
        "kind": { "type": "string", "enum": ["burning", "wet", "electrified", "poisoned", "hypoxic", "combustible_atmosphere", "breach_decomp", "hyperthermic", "hypothermic", "radiation", "concussed", "deafened", "blinded", "bleeding", "internal_shock", "low_battery", "coolant_leaking", "oil_leaking", "overheating", "hunger", "thirst", "sleep_dep", "sanity_low"] },
        "source_event_id": { "type": "string" },
        "expected_duration_ticks": { "type": "integer", "minimum": 0 },
        "severity_0_1": { "type": "number", "minimum": 0.0, "maximum": 1.0 }
      },
      "required": ["actor_id", "kind", "source_event_id", "expected_duration_ticks", "severity_0_1"]
    }
  },
  "required": ["schema_version", "category", "event_type", "tick", "payload"]
}
