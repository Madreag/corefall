{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://corefall/event/wound.escalated.v0.1",
  "title": "wound.escalated",
  "description": "M14G § Per-Wound-Type Granularity — fires when a producer escalates an existing wound (e.g., Burn1st → Burn2nd, Frostbite1st → Frostbite3rd). Payload carries the old and new WoundKind names + severities so consumers can render visible-state transitions. Honors VAL-M14G-013/014/036.",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "schema_version": { "const": "prototype-recorder-event.v0.1" },
    "category": { "const": "wound" },
    "event_type": { "const": "escalated" },
    "actor_id": { "type": ["integer", "null"] },
    "tick": { "type": "integer", "minimum": 0 },
    "payload": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "actor_id": { "type": "integer" },
        "tick": { "type": "integer", "minimum": 0 },
        "zone": { "type": "string" },
        "old_kind": {
          "type": "string",
          "enum": [
            "LacerationLight",
            "LacerationModerate",
            "LacerationSevere",
            "Puncture",
            "StabThrough",
            "GunshotEntry",
            "GunshotExit",
            "GunshotThrough",
            "ShrapnelEmbedded",
            "ShrapnelThrough",
            "BruiseLight",
            "BruiseHeavy",
            "CrushLimb",
            "Concussion",
            "FractureSimple",
            "FractureCompound",
            "FractureComminuted",
            "Dislocation",
            "SprainStrain",
            "Burn1st",
            "Burn2nd",
            "Burn3rd",
            "Frostbite1st",
            "Frostbite2nd",
            "Frostbite3rd",
            "AcidBurn",
            "ChemicalBurn",
            "EyeInjury",
            "EarInjury",
            "DentalDamage"
          ]
        },
        "new_kind": {
          "type": "string",
          "enum": [
            "LacerationLight",
            "LacerationModerate",
            "LacerationSevere",
            "Puncture",
            "StabThrough",
            "GunshotEntry",
            "GunshotExit",
            "GunshotThrough",
            "ShrapnelEmbedded",
            "ShrapnelThrough",
            "BruiseLight",
            "BruiseHeavy",
            "CrushLimb",
            "Concussion",
            "FractureSimple",
            "FractureCompound",
            "FractureComminuted",
            "Dislocation",
            "SprainStrain",
            "Burn1st",
            "Burn2nd",
            "Burn3rd",
            "Frostbite1st",
            "Frostbite2nd",
            "Frostbite3rd",
            "AcidBurn",
            "ChemicalBurn",
            "EyeInjury",
            "EarInjury",
            "DentalDamage"
          ]
        },
        "old_severity": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "new_severity": { "type": "number", "minimum": 0.0, "maximum": 1.0 }
      },
      "required": ["actor_id", "tick", "zone", "old_kind", "new_kind", "old_severity", "new_severity"]
    }
  },
  "required": ["schema_version", "category", "event_type", "tick", "payload"]
}
