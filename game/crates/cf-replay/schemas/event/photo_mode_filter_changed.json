{
  "$schema": "http://json-schema.org/draft-2020-12/schema",
  "$id": "cf-replay/event/photo_mode_filter_changed.v1",
  "title": "photo_mode.filter_changed",
  "description": "Emitted when the active photo filter cycles. Spec § Photo mode — 4 launch filters (sepia / B&W / color grading / cyberpunk neon).",
  "type": "object",
  "required": ["from", "to"],
  "properties": {
    "from": { "type": "string", "enum": ["none", "sepia", "black_and_white", "color_grade", "cyberpunk_neon"] },
    "to": { "type": "string", "enum": ["none", "sepia", "black_and_white", "color_grade", "cyberpunk_neon"] }
  }
}
