{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://corefall/event/disease.recovered.v0.1",
  "title": "disease.recovered",
  "description": "M16B § Recovery from a disease. Fires when an infection resolves through the Recovering stage to Recovered. `cured` is true when a treatment course drove recovery (vs natural resolution). `granted_immunity` is true when the recovery left a natural immunity record.",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "schema_version": { "const": "prototype-recorder-event.v0.1" },
    "category": { "const": "disease" },
    "event_type": { "const": "recovered" },
    "actor_id": { "type": ["integer", "null"] },
    "tick": { "type": "integer", "minimum": 0 },
    "payload": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "actor_id": { "type": "integer" },
        "tick": { "type": "integer", "minimum": 0 },
        "pathogen": { "type": "string", "enum": ["slimelung", "food_poisoning", "radiation_sickness", "common_cold", "flu", "pneumonia", "tuberculosis", "cholera", "typhoid", "rabies", "tetanus", "bubonic_plague", "anthrax", "cancer", "mental_illness", "sepsis", "influenza_pandemic"] },
        "cured": { "type": "boolean" },
        "granted_immunity": { "type": "boolean" }
      },
      "required": ["actor_id", "tick", "pathogen"]
    }
  },
  "required": ["schema_version", "category", "event_type", "tick", "payload"]
}
