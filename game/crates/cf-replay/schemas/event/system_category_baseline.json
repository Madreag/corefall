{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "system_category_baseline.v0.1",
  "title": "system.category_baseline payload",
  "description": "M4 § Event taxonomy. Fired once at run start declaring every event category. Active categories carry first_event_type; registered categories carry ladder_at pointing at the owning milestone.",
  "type": "object",
  "required": ["schema_version", "categories", "total", "active"],
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1 },
    "categories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "status"],
        "properties": {
          "name": { "type": "string" },
          "status": { "type": "string", "enum": ["active", "registered"] },
          "first_event_type": { "type": "string" },
          "ladder_at": { "type": "string" }
        }
      }
    },
    "total": { "type": "integer", "minimum": 1 },
    "active": { "type": "integer", "minimum": 0 }
  }
}
