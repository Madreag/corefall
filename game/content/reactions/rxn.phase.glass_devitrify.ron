// M15D § rxn.phase.glass_devitrify — SiO2(l) + cold -> glass(s) (volcanic glass)
(
    id: "rxn.phase.glass_devitrify",
    display_name: "Glass Devitrification",
    inputs: [
        (material: "molten_silica", moles: 1.0, molar_mass_g_per_mol: Some(60.084)),
    ],
    outputs: [
        (material: "glass", moles: 1.0, molar_mass_g_per_mol: Some(60.084)),
    ],
    delta_h_kj_per_mol: -10.0,
    activation_energy_kj_per_mol: 0.0,
    rate_constant_per_s: 0.3,
    min_temperature_k: None,
    min_pressure_kpa: None,
    catalyst: None,
    variant: PerCell,
    emits_event: true,
    propagates: false,
    auto_ignite: false,
)
