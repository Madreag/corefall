    delta_h_kj_per_mol: -566.0,
    activation_energy_kj_per_mol: 30.0,
    rate_constant_per_s: 1.0,
    min_temperature_k: Some(873.0),
    min_pressure_kpa: None,
    catalyst: None,
    variant: Both,
