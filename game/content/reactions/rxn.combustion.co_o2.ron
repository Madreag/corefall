// M15D § rxn.combustion.co_o2 — 2 CO + O2 -> 2 CO2 (incomplete-combust finisher)
(
    id: "rxn.combustion.co_o2",
    display_name: "Carbon Monoxide Combustion",
    inputs: [
        (material: "carbon_monoxide", moles: 2.0, molar_mass_g_per_mol: Some(28.010)),
