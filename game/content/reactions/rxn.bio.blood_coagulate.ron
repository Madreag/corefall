// M15D § rxn.bio.blood_coagulate — blood + air(>30s) -> coag_blood (forensic)
(
    id: "rxn.bio.blood_coagulate",
    display_name: "Blood Coagulates",
    inputs: [
        (material: "blood", moles: 1.0, molar_mass_g_per_mol: Some(18.015)),
    ],
    outputs: [
        (material: "coag_blood", moles: 1.0, molar_mass_g_per_mol: Some(18.015)),
    ],
    delta_h_kj_per_mol: -2.0,
    activation_energy_kj_per_mol: 0.0,
    rate_constant_per_s: 0.05,
    min_temperature_k: Some(293.0),
    min_pressure_kpa: None,
    catalyst: Some("air"),
    variant: PerPixel,
    emits_event: true,
    propagates: false,
    auto_ignite: false,
)
