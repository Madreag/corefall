// M15D § rxn.corrosion.acid_zinc — 2 HCl + Zn -> ZnCl2 + H2
(
    id: "rxn.corrosion.acid_zinc",
    display_name: "Acid on Zinc",
    // CA semantics: zinc is input_a so the zinc pixel transforms to
    // the output (the `rust` visual proxy carries ZnCl2's mass for
    // spec mass-balance correctness).
    inputs: [
        (material: "zinc", moles: 1.0, molar_mass_g_per_mol: Some(65.380)),
        (material: "acid", moles: 2.0, molar_mass_g_per_mol: Some(36.461)),
    ],
    outputs: [
        (material: "rust",     moles: 1.0, molar_mass_g_per_mol: Some(136.286)),
        (material: "hydrogen", moles: 1.0, molar_mass_g_per_mol: Some(2.016)),
    ],
    delta_h_kj_per_mol: -154.0,
    activation_energy_kj_per_mol: 16.0,
    rate_constant_per_s: 0.6,
    min_temperature_k: Some(273.0),
    min_pressure_kpa: None,
    catalyst: None,
    variant: PerPixel,
    emits_event: true,
    propagates: true,
    auto_ignite: false,
)
