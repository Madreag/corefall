        (material: "water",          moles: 2.0, molar_mass_g_per_mol: Some(18.015)),
    ],
    delta_h_kj_per_mol: -200.0,
    activation_energy_kj_per_mol: 35.0,
    rate_constant_per_s: 0.05,
    min_temperature_k: Some(333.0),
    min_pressure_kpa: None,
    catalyst: None,
    variant: PerPixel,
