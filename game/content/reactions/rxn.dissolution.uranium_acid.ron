    id: "rxn.dissolution.uranium_acid",
    display_name: "Uranium + Nitric Acid",
    inputs: [
        (material: "uranium",     moles: 1.0, molar_mass_g_per_mol: Some(238.029)),
        (material: "nitric_acid", moles: 4.0, molar_mass_g_per_mol: Some(63.013)),
    ],
    outputs: [
