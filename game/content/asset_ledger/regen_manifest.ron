// M4A: per-pipeline regen manifest. Pipelines append entries here as they
// ship; the regenerator reads the manifest to look up the canonical regen
// command and the model_version pin. Schema locked at v1.0.0.

(
    schema_version: "1.0.0",
    pipelines: [
        (
            pipeline_id: "M9A_svg_v1",
            owner_milestone: "M9A",
            regen_command: "cf-tools-svg-gen --asset-id $ASSET_ID --seed $SEED --out $OUTPUT_PATH",
            model_version: "llm:gpt-4o-mini@2026-05",
            deterministic: true,
            freeze_path_suffix: ".frozen",
            notes: "SVG output is deterministic per prompt+seed; freeze-then-store is fallback.",
        ),
        (
            pipeline_id: "M12A_llm_audio_v1",
            owner_milestone: "M12A",
            regen_command: "cf-tools-sfx-gen --asset-id $ASSET_ID --seed $SEED --out $OUTPUT_PATH",
            model_version: "llm:audio-prompt-v1",
            deterministic: true,
            freeze_path_suffix: ".frozen",
            notes: "M12A LLM-generated SFX placeholder; deterministic per seed.",
        ),
        (
            pipeline_id: "M32A_comfyui_v1",
            owner_milestone: "M32A",
            regen_command: "cf-tools-comfyui --asset-id $ASSET_ID --seed $SEED --workflow $WORKFLOW --out $OUTPUT_PATH",
            model_version: "Flux.1-dev@2026-05",
            deterministic: false,
            freeze_path_suffix: ".frozen",
            notes: "ComfyUI Tier 2 output is GPU-dependent; freeze-then-store is the canonical regen path.",
        ),
        (
            pipeline_id: "M37A_voice_v1",
            owner_milestone: "M37A",
            regen_command: "cf-tools-voice-gen --asset-id $ASSET_ID --seed $SEED --speaker $SPEAKER --out $OUTPUT_PATH",
            model_version: "Stable-Audio-Open-1.0",
            deterministic: false,
            freeze_path_suffix: ".frozen",
            notes: "Voice synth is non-deterministic across hardware; freeze-then-store is canonical.",
        ),
        (
            pipeline_id: "M37A_music_v1",
            owner_milestone: "M37A",
            regen_command: "cf-tools-music-gen --asset-id $ASSET_ID --seed $SEED --out $OUTPUT_PATH",
            model_version: "Stable-Audio-Open-1.0",
            deterministic: false,
            freeze_path_suffix: ".frozen",
            notes: "Music synth uses freeze-then-store.",
        ),
        (
            pipeline_id: "M38A_localization_v1",
            owner_milestone: "M38A",
            regen_command: "cf-tools-locale --asset-id $ASSET_ID --locale $LOCALE --out $OUTPUT_PATH",
            model_version: "translation-llm@2026-05",
            deterministic: true,
            freeze_path_suffix: ".frozen",
            notes: "LLM translation pinned per locale; deterministic per seed+source-hash.",
        ),
        (
            pipeline_id: "M18A_animation_v1",
            owner_milestone: "M18A",
            regen_command: "cf-tools-anim --asset-id $ASSET_ID --seed $SEED --out $OUTPUT_PATH",
            model_version: "AnimateDiff@2026-05",
            deterministic: false,
            freeze_path_suffix: ".frozen",
            notes: "Animation strip output uses freeze-then-store.",
        ),
        (
            pipeline_id: "M24A_particle_v1",
            owner_milestone: "M24A",
            regen_command: "cf-tools-particle --asset-id $ASSET_ID --seed $SEED --out $OUTPUT_PATH",
            model_version: "particle-svg-v1",
            deterministic: true,
            freeze_path_suffix: ".frozen",
            notes: "Particle textures use deterministic SVG/canvas; freeze-then-store fallback.",
        ),
        (
            pipeline_id: "M25A_narrative_v1",
            owner_milestone: "M25A",
            regen_command: "cf-tools-narrative --asset-id $ASSET_ID --seed $SEED --out $OUTPUT_PATH",
            model_version: "llm:gpt-4o@2026-05",
            deterministic: true,
            freeze_path_suffix: ".frozen",
            notes: "Codex entries pinned per LLM model_version + seed.",
        ),
        (
            pipeline_id: "M45A_cosmetic_v1",
            owner_milestone: "M45A",
            regen_command: "cf-tools-cosmetic --asset-id $ASSET_ID --seed $SEED --out $OUTPUT_PATH",
            model_version: "cosmetic-pack-v1",
            deterministic: true,
            freeze_path_suffix: ".frozen",
            notes: "Cosmetic skins / scars / faction variants.",
        ),
        (
            pipeline_id: "M48A_polish_v1",
            owner_milestone: "M48A",
            regen_command: "cf-tools-polish --asset-id $ASSET_ID --out $OUTPUT_PATH",
            model_version: "human-polish",
            deterministic: true,
            freeze_path_suffix: ".frozen",
            notes: "Polish is hand-tweaked; freeze-then-store is the only regen path.",
        ),
        (
            pipeline_id: "M48B_marketing_v1",
            owner_milestone: "M48B",
            regen_command: "cf-tools-marketing --asset-id $ASSET_ID --seed $SEED --out $OUTPUT_PATH",
            model_version: "marketing-pack-v1",
            deterministic: false,
            freeze_path_suffix: ".frozen",
            notes: "Marketing assets (key art, Steam capsules, social cards, store screenshots); freeze-then-store.",
        ),
        (
            pipeline_id: "Mod_Supplied_v1",
            owner_milestone: "M4A",
            regen_command: "cf-mod ledger regenerate $ASSET_ID",
            model_version: "mod-supplied",
            deterministic: false,
            freeze_path_suffix: ".frozen",
            notes: "Mod-supplied content uses freeze-then-store; mod author asserts determinism.",
        ),
    ],
)
