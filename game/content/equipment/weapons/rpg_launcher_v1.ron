// **M14C** — Reference HEAT-capable launcher.
//
// `primary_round: heat` so the magazine pops HEAT rounds; `ammo_spec_id`
// points to `content/ammo/heat_round_v1.ron`. The bare `heat` identifier
// matches `RoundKind` (serde `rename_all = "snake_case"`) — RON serde
// expects the unit-variant identifier, not the quoted string form.
(
  id: "rpg_launcher_v1",
  display_name: "RPG Launcher v1",
  primary_round: heat,
  ammo_spec_id: "heat_round_v1",
  mag_capacity: 1,
  reload_seconds: 4.5,
  fire_interval_seconds: 1.0,
  projectile_speed: 320.0,
  damage_per_hit: 0.0,
  // M15B+ § Real HEAT chemistry: ~10 kg warhead + shaped-charge jet
  // (sharpness 0.7). Penetration impulse = mass × velocity × sharpness.
  bullet_mass_kg: 10.0,
  bullet_sharpness: 0.7,
)
