  display_name: "Micro Reactor Defense",
  description: "M2.5 fun-proof slice per spec/native-implementation-backlog M2.5-001..M2.5-006. Spawn at the reactor core; dig a trench around it using M2 chunked terrain; survive a 60-second wave from one reactive guard who fires at the reactor. Win = reactor survives the timer; loss = reactor destroyed. Reuses M1.5 cf-mission + cf-ai unchanged; the M2 chunked-terrain trench is the reason the loop is fun.",
  seed: 47,
  duration_ticks: Some(7200),
  region: (anchor: (0.0, 0.0), width: 1280.0, height: 720.0),
  gravity: -980.0,
  floor_y: 16.0,
  teams: [],
  actors: [
    (id: 1, team: "blue", spawn: (200.0, 32.0), controllable: true, hp: 100.0,
      inventory: (rifle: Some("rifle_m1_default")), half_extents: Some((8.0, 16.0))),
    (id: 2, team: "red", spawn: (1180.0, 32.0), controllable: false, hp: 80.0,
      inventory: (rifle: None), aim: Some((-1.0, 0.0)),
      half_extents: Some((8.0, 16.0)),
      enemy: Some((
        kind: Some("reactive_guard"),
        miss_chance: Some(0.5),
        damage_per_hit: Some(8.0),
        burst_pause_seconds: Some(0.55),
        sight_radius: Some(1200.0),
