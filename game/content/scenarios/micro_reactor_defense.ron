      // player chooses to dig (carve count > 0 while preserving cover) or to
      // expose the reactor (loss path).
      (kind: "fill_aabb", min: (760.0, 16.0), max: (920.0, 96.0), material: "dirt"),
      // metal-nohook anchor west of the reactor (refusal teaching path).
      (kind: "fill_aabb", min: (480.0, 16.0), max: (512.0, 96.0), material: "metal_nohook"),
