  terrain: Some((
    width_px: 1280,
    height_px: 720,
    anchor: Some((0.0, 0.0)),
    default_material: "air",
    stamps: [
      // floor
      (kind: "fill_aabb", min: (0.0, 0.0), max: (1280.0, 16.0), material: "concrete"),
      // dirt shield mound between the guard (east) and the reactor (centre).
      // While intact this mound STOPS projectiles cold via projectile-vs-terrain
